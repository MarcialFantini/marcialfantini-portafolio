---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import { hasPublishedPosts } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: string;
  noindex?: boolean;
}

const {
  title: titleProp,
  description = site.description,
  ogImage = "/og-default.png",
  pageType = "website",
  noindex = false,
} = Astro.props;

const showRss = await hasPublishedPosts();

const siteURL = Astro.site ?? new URL("https://www.marcialfantini.site");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const isHome = Astro.url.pathname === "/";

// Home: titulo fijo. Resto: "<Pagina> | Marcial Fantini" (normaliza el sufijo " — Marcial Fantini").
const HOME_TITLE = `${site.name} | Software a medida para PyMEs`;
const suffix = ` | ${site.name}`;
const title = isHome
  ? HOME_TITLE
  : !titleProp
    ? HOME_TITLE
    : titleProp.endsWith(` — ${site.name}`)
      ? titleProp.slice(0, -(` — ${site.name}`).length) + suffix
      : titleProp.includes(site.name)
        ? titleProp
        : titleProp + suffix;

const ogImageURL = new URL(ogImage, siteURL).toString();
const ogAlt = `${site.name}: ${site.tagline}. Software a medida para PyMEs.`;
const logoURL = new URL("/icon-512.png", siteURL).toString();

import servicios from "../data/servicios.json";
const socialLinks = Object.values(site.social).filter(Boolean);
const professionalService = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": site.name,
  "url": siteURL.toString(),
  "logo": logoURL,
  "image": ogImageURL,
  "description": site.description,
  "slogan": site.tagline,
  "email": site.email,
  "availableLanguage": "es-AR",
  "areaServed": [
    { "@type": "City", "name": "Córdoba" },
    { "@type": "Country", "name": "Argentina" },
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Córdoba",
    "addressCountry": "AR",
  },
  "sameAs": socialLinks,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios",
    "itemListElement": servicios.map((s) => ({
      "@type": "Offer",
      "url": new URL(`/servicios/${s.id}`, siteURL).toString(),
      "itemOffered": { "@type": "Service", "name": s.titulo, "description": s.descripcion },
    })),
  },
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0d14" />
    <link rel="preload" href="/fonts/gambarino-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    {showRss && <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />}

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <ClientRouter />

    <!-- ProfessionalService structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(professionalService)} />

    <!-- Website structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": site.name,
      "url": Astro.site?.toString() ?? "/",
    })} />
  </head>
  <body class="min-h-[100dvh] flex flex-col antialiased">
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/rise.ts";
      import "../scripts/robots.ts";
    </script>
  </body>
</html>
