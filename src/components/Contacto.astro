---
import site from "../data/site.json";
import diagnostico from "../data/diagnostico.json";

// The site is static, so the query string is never available here: ?servicio= and the
// quiz answers are read by the inline script below (progressive enhancement).
const AUDIT_OPTION = "Diagnóstico gratis";
const initialSubject = "Consulta desde marcialfantini.site";
// Quiz question ids and texts, to turn ?tiempo=...&sistema=... into a prefilled message.
const quiz = diagnostico.preguntas.map((q) => ({ id: q.id, texto: q.texto }));

const email = site.email;
const endpoint = site.formEndpoint || "";
const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";
---

<section id="contacto" class="ct" aria-label="Contacto">
  <div class="ct__side">
    <slot name="before" />

    <div class="ct__alt">
    {whatsappUrl && (
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn ct__wa">
        Escribime por WhatsApp
      </a>
    )}

    <div>
      <p>{whatsappUrl ? "O por email:" : "Escribime por email:"} <a id="email-link" href={`mailto:${email}`} class="ct__mail">{email}</a></p>
      <button type="button" id="copy-email-btn" class="ct__copy">
        <span id="copy-email-label">Copiar email</span>
      </button>
    </div>

    <div>
      <p><strong>Diagnóstico gratis de 30 minutos.</strong> Te respondo en 24 h hábiles.</p>
      <p class="ct__small">
        {site.location}. Uso tus datos solo para responderte. Más en la <a href="/privacidad">política de privacidad</a>.
      </p>
    </div>
    </div>
  </div>

  <form id="contact-form" novalidate class="ct__form" aria-label="Formulario de contacto">
    <div class="ct__field">
      <label for="name">Nombre</label>
      <input type="text" id="name" name="name" required autocomplete="name" aria-describedby="name-error" />
      <p id="name-error" class="ct__err hidden" role="alert"></p>
    </div>

    <div class="ct__field">
      <label for="contacto">Email o WhatsApp</label>
      <input type="text" id="contacto" name="contacto" required maxlength="200" autocomplete="email" aria-describedby="contacto-hint contacto-error" />
      <p id="contacto-hint" class="ct__hint">Te respondo por donde prefieras.</p>
      <p id="contacto-error" class="ct__err hidden" role="alert"></p>
    </div>

    <div class="ct__field">
      <label for="message">¿Qué problema querés resolver?</label>
      <textarea id="message" name="message" required rows={5} aria-describedby="message-error"></textarea>
      <p id="message-error" class="ct__err hidden" role="alert"></p>
    </div>

    <!-- Filled from ?servicio= by the script below; feeds the subject line -->
    <input type="hidden" id="servicio" name="servicio" value="" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

    <button type="submit" id="contact-submit" class="btn ct__submit">
      <span id="contact-submit-label">{endpoint ? "Enviar mensaje" : "Abrir mi app de email"}</span>
     
    </button>

    <p id="contact-status" class="hidden" role="status" aria-live="polite"></p>

    <p class="ct__small">
      {endpoint
        ? "Te respondo en 24 h hábiles. "
        : "Al tocar el botón se abre tu app de email con el mensaje armado: tenés que enviarlo desde ahí. "}
      También podés escribirme directo a <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </form>
</section>

<script is:inline
  define:vars={{
    toEmail: email,
    initialSubject,
    endpoint,
    quiz,
    auditOption: AUDIT_OPTION,
  }}
>
  (function () {
    // Static site: the query string only exists in the browser.
    const params = new URLSearchParams(window.location.search);

    // ?servicio= travels as a hidden field and sets the subject. "Auditoría gratis" is kept for old links.
    const servicioEl = document.getElementById('servicio');
    const rawParam = (params.get('servicio') || '').trim().slice(0, 120);
    if (servicioEl instanceof HTMLInputElement && rawParam) {
      servicioEl.value = rawParam === 'Auditoría gratis' ? auditOption : rawParam;
    }

    // Quiz answers (?tiempo=...&sistema=...) arrive from the diagnostic chapter, with or
    // without JS there. They become the first draft of the message, as plain text.
    const messageEl = document.getElementById('message');
    if (messageEl instanceof HTMLTextAreaElement && !messageEl.value) {
      const lines = quiz
        .map((q) => [q.texto, (params.get(q.id) || '').trim().slice(0, 160)])
        .filter((pair) => pair[1])
        .map((pair) => '- ' + pair[0] + ' ' + pair[1]);
      if (lines.length) messageEl.value = 'Hice el diagnóstico en la web:\n' + lines.join('\n') + '\n\n';
    }

    const form = document.getElementById('contact-form');
    const submit = document.getElementById('contact-submit');
    const submitLabel = document.getElementById('contact-submit-label');
    const status = document.getElementById('contact-status');
    const idleLabel = submitLabel ? submitLabel.textContent : '';

    const setStatus = (kind, text) => {
      if (!status) return;
      status.textContent = text;
      status.className =
        '' +
        (kind === 'success'
          ? 'bg-[var(--color-ok-bg)] text-[var(--color-ok-ink)]'
          : kind === 'error'
            ? 'bg-[var(--color-err-bg)] text-[var(--color-err-ink)]'
            : 'bg-[var(--color-surface)] text-[var(--color-fg)]');
    };

    const fieldError = (id, text) => {
      const el = document.getElementById(id + '-error');
      const input = document.getElementById(id);
      if (el) {
        el.textContent = text;
        el.classList.toggle('hidden', !text);
      }
      if (input) input.setAttribute('aria-invalid', text ? 'true' : 'false');
    };

    // Same rules as api/contact.ts: the contact field takes an email or a phone (6 to 15 digits).
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const isPhone = (value) => {
      const digits = value.replace(/\D/g, '').length;
      return /^\+?[\d\s().-]+$/.test(value) && digits >= 6 && digits <= 15;
    };

    const validate = (data) => {
      const name = String(data.get('name') ?? '').trim();
      const contacto = String(data.get('contacto') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const okContact = EMAIL_RE.test(contacto) || isPhone(contacto);
      fieldError('name', name ? '' : 'Decime tu nombre.');
      fieldError('contacto', okContact ? '' : 'Dejame un email o un número de WhatsApp válido.');
      fieldError('message', message ? '' : 'Contame qué problema querés resolver.');
      return Boolean(name && okContact && message);
    };

    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        if (!validate(data)) return;
        // Honeypot: si un bot lo completó, no enviamos nada.
        if (String(data.get('_gotcha') ?? '')) return;

        const name = String(data.get('name')).trim();
        const contacto = String(data.get('contacto')).trim();
        const servicio = String(data.get('servicio') ?? '');
        const message = String(data.get('message')).trim();
        const subject = servicio
          ? `[${servicio}] Mensaje de ${name || 'contacto'}`
          : initialSubject;

        if (!endpoint) {
          // Sin endpoint configurado: abrimos la app de email, sin simular un envío.
          const body =
            `${message}\n\n---\nNombre: ${name}\nContacto: ${contacto}\nServicio: ${servicio || 'no especificado'}\n`;
          // Analytics hook: no-op unless the cookieless script is loaded (see Layout.astro).
          window.plausible?.('Form sent', { props: { via: 'mailto' } });
          setStatus('info', 'Se abrió tu app de email. Tenés que enviar el mensaje desde ahí.');
          window.location.href =
            `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          return;
        }

        data.set('_subject', subject);
        if (submit) submit.disabled = true;
        if (submitLabel) submitLabel.textContent = 'Enviando...';
        setStatus('info', 'Enviando tu mensaje...');
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          setStatus('success', 'Recibí tu mensaje. Te respondo en 24 h hábiles.');
          window.plausible?.('Form sent', { props: { via: 'endpoint' } });
          form.reset();
          // reset() does not clear hidden inputs, so the service from the URL stays for a second message.
        } catch (e) {
          setStatus('error', `No se pudo enviar el mensaje. Probá de nuevo o escribime a ${toEmail}.`);
        } finally {
          if (submit) submit.disabled = false;
          if (submitLabel) submitLabel.textContent = idleLabel;
        }
      });
    }

    // Copy email
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-email-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(toEmail);
          copyLabel.textContent = '¡Copiado!';
          copyBtn.setAttribute('aria-live', 'polite');
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        } catch (e) {
          copyLabel.textContent = 'No se pudo copiar';
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        }
      });
    }
  })();
</script>

<style>
  /* Layout: the page places this inside a colour Field. The form sits on a paper panel; the side column
     carries the page's "what happens next" sequence (slot "before") and the secondary routes. */
  .ct { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .ct__side { display: grid; gap: clamp(2rem, 4vw, 3rem); align-content: start; }
  .ct__alt { display: grid; gap: 1.5rem; align-content: start; }
  .ct__alt p { margin: 0; }
  .ct__wa { justify-self: start; background: var(--color-field-night); color: var(--color-paper); }
  .ct__wa:hover { background: var(--color-ink); color: var(--color-field-lime); }
  .ct__mail { font-weight: 500; word-break: break-all; color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .ct__copy {
    margin-top: 0.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    background: var(--color-paper);
    color: var(--color-fg);
    border: 0;
    font: inherit;
    font-size: var(--step-small);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-quart), transform 160ms var(--ease-out-quart);
  }
  .ct__copy:hover { background: var(--color-field-lime); }
  .ct__copy:active { transform: scale(0.97); }
  .ct__side strong { font-weight: 500; }
  .ct__small { margin-top: 0.75rem; font-size: var(--step-small); }
  .ct__side .ct__small a { color: inherit; }

  .ct__form { display: grid; gap: 1.5rem; padding: clamp(1.25rem, 4vw, 2.5rem); background: var(--color-paper); min-width: 0; }
  .ct__field { min-width: 0; }
  .ct__field label { display: block; margin-bottom: 0.5rem; font-weight: 500; }
  .ct__field input,
  .ct__field textarea {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    background: var(--color-surface);
    color: var(--color-fg);
    border: 0;
    border-radius: 0;
    font: inherit;
    transition: background-color 160ms var(--ease-out-quart);
  }
  .ct__field textarea { min-height: 9rem; resize: vertical; }
  .ct__field input:hover, .ct__field textarea:hover { background: var(--color-surface-2); }
  .ct__field input:focus-visible, .ct__field textarea:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 0; }
  .ct__field [aria-invalid="true"] { outline: 2px solid var(--color-err-line); outline-offset: 0; }
  .ct__hint { margin-top: 0.4rem; font-size: var(--step-small); }
  .ct__err { margin-top: 0.4rem; font-size: var(--step-small); color: var(--color-err-ink); }
  .ct__submit { justify-self: stretch; min-height: 3.75rem; }
  #contact-status { padding: 0.75rem 1rem; }

  @media (min-width: 640px) {
    .ct__submit { justify-self: start; }
  }
  @media (min-width: 1024px) {
    .ct { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(3rem, 5vw, 5rem); align-items: start; }
    .ct__side { grid-column: 1; grid-row: 1; }
    .ct__form { grid-column: 2; grid-row: 1; }
  }
</style>
