---
import site from "../data/site.json";
import servicios from "../data/servicios.json";

const GENERIC_OPTION = "Quiero hablar de mi proyecto";
const rawParam = Astro.url.searchParams.get("servicio");
const isAudit = rawParam === "Auditoría gratis";
// Cualquier valor que no sea un servicio conocido (p. ej. la auditoría gratis) cae en la opción genérica.
const servicioParam =
  rawParam && servicios.some((s) => s.titulo === rawParam) ? rawParam : rawParam ? GENERIC_OPTION : null;
const initialSubject = isAudit
  ? "Quiero la auditoría gratis de 15 min"
  : servicioParam
    ? `Consulta sobre ${servicioParam}`
    : "Consulta desde marcialfantini.site";

const email = site.email;
const endpoint = site.formEndpoint || "";
const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";
const { compact = false } = Astro.props;
---

<section
  id="contacto"
  class="surface-night relative py-20 md:py-28"
  aria-label="Contacto"
>
  <div class="container-page relative z-[1] grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start space-y-8">
      {!compact && (
      <div>
        <p class="eyebrow mb-4">Contacto</p>
        <h2 class="display-lg">
          Contanos qué querés <span class="display-accent">vender online.</span>
        </h2>
      </div>
      )}

      {whatsappUrl && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="tactile sd-reveal flex w-full min-h-14 items-center justify-center gap-2 px-6 py-4 rounded-control bg-[var(--color-dorado)] text-[var(--color-on-gold)] font-mono text-[12px] uppercase tracking-[0.18em] font-bold hover:bg-[var(--color-ivory)]"
        >
          Escribinos por WhatsApp <span aria-hidden="true">↗</span>
        </a>
      )}

      <div class="sd-reveal">
        <p class="field-label">{whatsappUrl ? "O por email" : "Email directo"}</p>
        <a
          id="email-link"
          href={`mailto:${email}`}
          class="block font-display text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-ink)] hover:text-[var(--color-dorado)] break-all py-1"
        >
          {email}
        </a>
        <button
          type="button"
          id="copy-email-btn"
          class="tactile mt-2 inline-flex min-h-11 items-center gap-2 px-4 py-2 rounded-control border border-[var(--color-hair-strong)] text-[var(--color-ink)] font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-dorado)] hover:text-[var(--color-dorado)] focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <span aria-hidden="true" id="copy-email-icon">⎘</span>
          <span id="copy-email-label">Copiar email</span>
        </button>
      </div>

      <div class="sd-reveal">
        <p class="text-base md:text-lg text-[var(--color-ink)] leading-snug font-medium">
          Auditoría gratis de 15 minutos. Te respondemos en 24 h hábiles.
        </p>
        <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
          {site.location}. Usamos tus datos solo para responderte. Más en nuestra{" "}
          <a href="/privacidad" class="underline underline-offset-2 hover:text-[var(--color-dorado)]">política de privacidad</a>.
        </p>
      </div>
    </div>

    <form
      id="contact-form"
      novalidate
      class="contact-form sd-reveal lg:border-l lg:border-[var(--color-hair)] lg:pl-14"
      aria-label="Formulario de contacto"
    >
      <div class="space-y-7">
        <div>
          <label for="name" class="field-label">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            aria-describedby="name-error"
            class="field"
          />
          <p id="name-error" class="field-error hidden" role="alert"></p>
        </div>

        <div>
          <label for="email" class="field-label">Tu email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-describedby="email-error"
            class="field"
          />
          <p id="email-error" class="field-error hidden" role="alert"></p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
          <div>
            <label for="servicio" class="field-label">Servicio (opcional)</label>
            <select id="servicio" name="servicio" class="field">
              <option value="">Elegí uno</option>
              {
                servicios.map((s) => (
                  <option value={s.titulo} selected={servicioParam === s.titulo}>
                    {s.titulo}
                  </option>
                ))
              }
              <option value={GENERIC_OPTION} selected={servicioParam === GENERIC_OPTION}>
                {GENERIC_OPTION}
              </option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="presupuesto" class="field-label">Presupuesto (opcional)</label>
            <select id="presupuesto" name="presupuesto" class="field">
              <option value="">Elegí un rango</option>
              <option value="Hasta USD 500">Hasta USD 500</option>
              <option value="USD 500 - 1.500">USD 500 - 1.500</option>
              <option value="Más de USD 1.500">Más de USD 1.500</option>
              <option value="No lo sé todavía">No lo sé todavía</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="field-label">Contanos brevemente qué necesitás</label>
          <textarea
            id="message"
            name="message"
            required
            rows={4}
            aria-describedby="message-error"
            class="field"
          ></textarea>
          <p id="message-error" class="field-error hidden" role="alert"></p>
        </div>

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        <button
          type="submit"
          id="contact-submit"
          class="tactile w-full min-h-14 inline-flex items-center justify-center gap-2 px-6 py-4 rounded-control bg-[var(--color-ivory)] text-[var(--color-navy-950)] font-mono text-[12px] uppercase tracking-[0.18em] font-bold hover:bg-[var(--color-neon)] disabled:opacity-60 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <span id="contact-submit-label">{endpoint ? "Enviar mensaje" : "Abrir mi app de email"}</span>
          <span aria-hidden="true">→</span>
        </button>

        <p
          id="contact-status"
          class="hidden text-sm leading-relaxed rounded-control px-4 py-3"
          role="status"
          aria-live="polite"
        ></p>

        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          {endpoint
            ? "Te respondemos en 24 h hábiles. "
            : "Al tocar el botón se abre tu app de email con el mensaje armado: tenés que enviarlo desde ahí. "}
          También podés escribirnos directo a{" "}
          <a
            href={`mailto:${email}`}
            class="underline underline-offset-2 hover:text-[var(--color-dorado)]">
            {email}
          </a>.
        </p>
      </div>
    </form>
  </div>
</section>

<script is:inline
  define:vars={{
    toEmail: email,
    initialSubject,
    endpoint,
  }}
>
  (function () {
    // El sitio es estático: ?servicio= solo se lee en el cliente. Valores desconocidos
    // (p. ej. "Auditoría gratis") caen en la opción genérica.
    const select = document.getElementById('servicio');
    const param = new URLSearchParams(window.location.search).get('servicio');
    if (select instanceof HTMLSelectElement && param) {
      const known = Array.from(select.options).some((o) => o.value === param);
      select.value = known ? param : 'Quiero hablar de mi proyecto';
    }

    const form = document.getElementById('contact-form');
    const submit = document.getElementById('contact-submit');
    const submitLabel = document.getElementById('contact-submit-label');
    const status = document.getElementById('contact-status');
    const idleLabel = submitLabel ? submitLabel.textContent : '';

    const setStatus = (kind, text) => {
      if (!status) return;
      status.textContent = text;
      status.className =
        'text-sm leading-relaxed rounded-control px-4 py-3 ' +
        (kind === 'success'
          ? 'bg-[var(--color-ok-bg)] text-[var(--color-ok-ink)]'
          : kind === 'error'
            ? 'bg-[var(--color-err-bg)] text-[var(--color-err-ink)]'
            : 'bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)]');
    };

    const fieldError = (id, text) => {
      const el = document.getElementById(id + '-error');
      const input = document.getElementById(id);
      if (el) {
        el.textContent = text;
        el.classList.toggle('hidden', !text);
      }
      if (input) input.setAttribute('aria-invalid', text ? 'true' : 'false');
    };

    const validate = (data) => {
      const name = String(data.get('name') ?? '').trim();
      const mail = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const okMail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail);
      fieldError('name', name ? '' : 'Decinos tu nombre.');
      fieldError('email', okMail ? '' : 'Ingresá un email válido.');
      fieldError('message', message ? '' : 'Contanos brevemente qué necesitás.');
      return Boolean(name && okMail && message);
    };

    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        if (!validate(data)) return;
        // Honeypot: si un bot lo completó, no enviamos nada.
        if (String(data.get('_gotcha') ?? '')) return;

        const name = String(data.get('name')).trim();
        const fromEmail = String(data.get('email')).trim();
        const servicio = String(data.get('servicio') ?? '');
        const message = String(data.get('message')).trim();
        const subject = servicio
          ? `[${servicio}] Mensaje de ${name || 'contacto'}`
          : initialSubject;

        if (!endpoint) {
          // Sin endpoint configurado: abrimos la app de email, sin simular un envío.
          const body =
            `${message}\n\n---\nNombre: ${name}\nEmail: ${fromEmail}\nServicio: ${servicio || 'no especificado'}\nPresupuesto: ${String(data.get('presupuesto') ?? '') || 'no especificado'}\n`;
          setStatus('info', 'Abrimos tu app de email. Tenés que enviar el mensaje desde ahí.');
          window.location.href =
            `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          return;
        }

        data.set('_subject', subject);
        if (submit) submit.disabled = true;
        if (submitLabel) submitLabel.textContent = 'Enviando...';
        setStatus('info', 'Enviando tu mensaje...');
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          setStatus('success', 'Recibimos tu mensaje. Te respondemos en 24 h hábiles.');
          form.reset();
        } catch (e) {
          setStatus('error', `No pudimos enviar el mensaje. Probá de nuevo o escribinos a ${toEmail}.`);
        } finally {
          if (submit) submit.disabled = false;
          if (submitLabel) submitLabel.textContent = idleLabel;
        }
      });
    }

    // Copy email
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-email-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(toEmail);
          copyLabel.textContent = '¡Copiado!';
          copyBtn.setAttribute('aria-live', 'polite');
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        } catch (e) {
          copyLabel.textContent = 'No se pudo copiar';
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        }
      });
    }
  })();
</script>
