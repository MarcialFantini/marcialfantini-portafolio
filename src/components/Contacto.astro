---
import site from "../data/site.json";
import SectionAnchor from "./SectionAnchor.astro";

const servicioParam = Astro.url.searchParams.get("servicio");
const initialSubject = servicioParam
  ? `Consulta sobre ${servicioParam}`
  : "Consulta desde marcialfantini.com";
const initialBody = servicioParam
  ? `Hola Marcial,\n\nQuiero conversar sobre el servicio "${servicioParam}".\n\nMi nombre:\nMi empresa/negocio:\nQué necesito resolver:\n\nGracias.`
  : "Hola Marcial,\n\nQuiero conversar sobre un proyecto.\n\nMi nombre:\nMi empresa/negocio:\nQué necesito resolver:\n\nGracias.";

const email = site.email;
const gmailCompose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(initialSubject)}&body=${encodeURIComponent(initialBody)}`;
const outlookCompose = `https://outlook.live.com/mail/0/deeplink/compose?to=${encodeURIComponent(email)}&subject=${encodeURIComponent(initialSubject)}&body=${encodeURIComponent(initialBody)}`;
---

<section
  id="contacto"
  class="relative py-20 md:py-28 bg-gradient-azul text-[var(--color-blanco-humo)] border-y border-[var(--color-azul-deep)] overflow-hidden"
  aria-label="Contacto"
>
  <div class="container-page relative z-[1]">
    <div class="max-w-3xl mb-14 reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        06 · Contacto
      </p>
      <h2 class="font-impact text-[clamp(2.5rem,6vw,5rem)] leading-[0.92] text-white mb-6">
        Hablemos sobre <span class="text-[var(--color-dorado)]">tu proyecto.</span>
      </h2>
      <p class="text-lg text-white/85 leading-relaxed max-w-2xl">
        Si tenés una PyME que necesita presencia digital seria o un producto a medida, mandame un mensaje.
        Respondo en menos de 24h hábiles con una primera lectura y, si tiene sentido, agendamos una llamada
        de 30 minutos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-8 lg:gap-12 reveal">
      <div class="space-y-7">
        <div class="rounded-lg bg-[var(--color-blanco-humo)] text-[var(--color-ink)] p-7 border-l-4 border-[var(--color-dorado)]">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">
            Email directo
          </p>
          <a
            id="email-link"
            href={`mailto:${email}`}
            class="font-display text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-azul)] hover:text-[var(--color-azul-deep)] break-all"
          >
            {email}
          </a>
          <div class="mt-4 flex flex-wrap gap-2">
            <button
              type="button"
              id="copy-email-btn"
              class="tactile inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul)] hover:text-white"
            >
              <span aria-hidden="true" id="copy-email-icon">⎘</span>
              <span id="copy-email-label">Copiar email</span>
            </button>
            <a
              href={gmailCompose}
              target="_blank"
              rel="noopener noreferrer"
              class="tactile inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-[var(--color-border)] text-[var(--color-ink-soft)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-azul)] hover:text-[var(--color-azul)]"
            >
              Abrir en Gmail <span aria-hidden="true">↗</span>
            </a>
            <a
              href={outlookCompose}
              target="_blank"
              rel="noopener noreferrer"
              class="tactile inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-[var(--color-border)] text-[var(--color-ink-soft)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-azul)] hover:text-[var(--color-azul)]"
            >
              Abrir en Outlook <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="mt-3 text-xs text-[var(--color-mute)] leading-relaxed">
            Tu cliente de email local también funciona. El mailto abre con el mensaje pre-armado.
          </p>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/70 mb-2">
            Ubicación
          </p>
          <p class="text-white font-medium">{site.location}</p>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/70 mb-3">
            Conectá
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href={site.social.github}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">GitHub <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.linkedin}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">LinkedIn <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.twitter}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">Twitter <span aria-hidden="true">↗</span></a>
            </li>
          </ul>
        </div>
      </div>

      <form
        id="contact-form"
        class="rounded-lg bg-[var(--color-blanco-humo)] text-[var(--color-ink)] p-7 md:p-10"
        aria-label="Formulario de contacto"
      >
        <div class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Tu email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] transition-colors"
            />
          </div>

          <div>
            <label for="servicio" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Servicio que te interesa (opcional)
            </label>
            <select
              id="servicio"
              name="servicio"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] transition-colors"
            >
              <option value="">Elegí uno</option>
              <option value="Sistema de Ventas Online" selected={servicioParam === 'Sistema de Ventas Online'}>
                Sistema de Ventas Online
              </option>
              <option value="Tienda Express 30d" selected={servicioParam === 'Tienda Express 30d'}>
                Tienda Express 30d
              </option>
              <option value="Rescate de Conversión" selected={servicioParam === 'Rescate de Conversión'}>
                Rescate de Conversión
              </option>
              <option value="Automatizaciones que Pagan" selected={servicioParam === 'Automatizaciones que Pagan'}>
                Automatizaciones que Pagan
              </option>
              <option value="Otro">Otro / no estoy seguro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Contame brevemente qué necesitás
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={5}
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] resize-y transition-colors"
            ></textarea>
          </div>

          <button
            type="submit"
            class="tactile w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-md bg-[var(--color-azul)] text-white font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul-deep)]"
          >
            Abrir mi cliente de email
            <span aria-hidden="true">→</span>
          </button>

          <p class="text-xs text-[var(--color-mute)] leading-relaxed">
            Sin backend. Al enviar se abre tu cliente de email con todo pre-armado. También
            podés escribirme directo a{" "}
            <a
              href={`mailto:${email}`}
              class="text-[var(--color-azul)] underline hover:text-[var(--color-dorado)]">
              {email}
            </a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline
  define:vars={{
    toEmail: email,
    initialSubject,
    initialBody,
  }}
>
  (function () {
    const form = document.getElementById('contact-form');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '');
        const fromEmail = String(data.get('email') ?? '');
        const servicio = String(data.get('servicio') ?? '');
        const message = String(data.get('message') ?? '');

        const subject = servicio
          ? `[${servicio}] Mensaje de ${name || 'contacto'}`
          : initialSubject;

        const body =
          `${message}\n\n` +
          `---\n` +
          `Nombre: ${name}\n` +
          `Email: ${fromEmail}\n` +
          `Servicio: ${servicio || 'no especificado'}\n`;

        const mailto = `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        window.location.href = mailto;
      });
    }

    // Copy email
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-email-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(toEmail);
          copyLabel.textContent = '¡Copiado!';
          copyBtn.setAttribute('aria-live', 'polite');
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        } catch (e) {
          copyLabel.textContent = 'No se pudo copiar';
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        }
      });
    }
  })();
</script>