---
import site from "../data/site.json";
import servicios from "../data/servicios.json";

const GENERIC_OPTION = "Quiero hablar de mi proyecto";
const rawParam = Astro.url.searchParams.get("servicio");
const isAudit = rawParam === "Auditoría gratis";
// Cualquier valor que no sea un servicio conocido (p. ej. la auditoría gratis) cae en la opción genérica.
const servicioParam =
  rawParam && servicios.some((s) => s.titulo === rawParam) ? rawParam : rawParam ? GENERIC_OPTION : null;
const initialSubject = isAudit
  ? "Quiero la auditoría gratis de 15 min"
  : servicioParam
    ? `Consulta sobre ${servicioParam}`
    : "Consulta desde marcialfantini.com";

const email = site.email;
const endpoint = site.formEndpoint || "";
const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";
const { compact = false } = Astro.props;
---

<section
  id="contacto"
  class="relative py-20 md:py-28 bg-gradient-azul text-[var(--color-blanco-humo)] border-y border-[var(--color-azul-deep)] overflow-hidden"
  aria-label="Contacto"
>
  <div class="container-page relative z-[1]">
    {!compact && (
    <div class="max-w-3xl mb-14 reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        Contacto
      </p>
      <h2 class="font-impact text-[clamp(2.5rem,6vw,5rem)] leading-[0.92] text-white mb-6">
        Hablemos sobre <span class="text-[var(--color-dorado)]">tu proyecto.</span>
      </h2>
      <p class="text-lg text-white/85 leading-relaxed max-w-2xl">
        Si tenés una PyME que necesita presencia digital seria o un producto a medida, escribinos.
        Te respondemos en 24 h hábiles. Si querés, arrancamos con una auditoría gratis de 15 minutos.
      </p>
    </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-8 lg:gap-12 reveal">
      <div class="space-y-7">
        {whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile flex w-full items-center justify-center gap-2 px-6 py-4 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[12px] uppercase tracking-[0.18em] font-bold hover:bg-white"
          >
            Escribinos por WhatsApp <span aria-hidden="true">↗</span>
          </a>
        )}
        <div class="rounded-lg bg-[var(--color-blanco-humo)] text-[var(--color-ink)] p-7 border-l-4 border-[var(--color-dorado)]">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">
            {whatsappUrl ? "O por email" : "Email directo"}
          </p>
          <a
            id="email-link"
            href={`mailto:${email}`}
            class="font-display text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-azul)] hover:text-[var(--color-azul-deep)] break-all"
          >
            {email}
          </a>
          <div class="mt-4 flex flex-wrap gap-2">
            <button
              type="button"
              id="copy-email-btn"
              class="tactile inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul)] hover:text-white"
            >
              <span aria-hidden="true" id="copy-email-icon">⎘</span>
              <span id="copy-email-label">Copiar email</span>
            </button>
          </div>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/70 mb-2">
            Ubicación
          </p>
          <p class="text-white font-medium">{site.location}</p>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/70 mb-3">
            Conectá
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href={site.social.github}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">GitHub <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.linkedin}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">LinkedIn <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.twitter}
                class="tactile text-white hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">X <span aria-hidden="true">↗</span></a>
            </li>
          </ul>
        </div>
      </div>

      <form
        id="contact-form"
        novalidate
        class="rounded-lg bg-[var(--color-blanco-humo)] text-[var(--color-ink)] p-7 md:p-10"
        aria-label="Formulario de contacto"
      >
        <div class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              aria-describedby="name-error"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] transition-colors"
            />
            <p id="name-error" class="hidden mt-1.5 text-sm text-red-700" role="alert"></p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Tu email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              aria-describedby="email-error"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] transition-colors"
            />
            <p id="email-error" class="hidden mt-1.5 text-sm text-red-700" role="alert"></p>
          </div>

          <div>
            <label for="servicio" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Servicio que te interesa (opcional)
            </label>
            <select
              id="servicio"
              name="servicio"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] transition-colors"
            >
              <option value="">Elegí uno</option>
              {
                servicios.map((s) => (
                  <option value={s.titulo} selected={servicioParam === s.titulo}>
                    {s.titulo}
                  </option>
                ))
              }
              <option value={GENERIC_OPTION} selected={servicioParam === GENERIC_OPTION}>
                {GENERIC_OPTION}
              </option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Contanos brevemente qué necesitás
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={5}
              aria-describedby="message-error"
              class="w-full px-4 py-3 rounded-md border border-[var(--color-border)] bg-white text-[var(--color-ink)] placeholder:text-[var(--color-mute)] resize-y transition-colors"
            ></textarea>
            <p id="message-error" class="hidden mt-1.5 text-sm text-red-700" role="alert"></p>
          </div>

          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />

          <button
            type="submit"
            id="contact-submit"
            class="tactile w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-md bg-[var(--color-azul)] text-white font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul-deep)] disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="contact-submit-label">{endpoint ? "Enviar mensaje" : "Abrir mi app de email"}</span>
            <span aria-hidden="true">→</span>
          </button>

          <p
            id="contact-status"
            class="hidden text-sm leading-relaxed rounded-md px-4 py-3"
            role="status"
            aria-live="polite"
          ></p>

          <p class="text-xs text-[var(--color-mute)] leading-relaxed">
            {endpoint
              ? "Te respondemos en 24 h hábiles. "
              : "Al tocar el botón se abre tu app de email con el mensaje armado: tenés que enviarlo desde ahí. "}
            También podés escribirnos directo a{" "}
            <a
              href={`mailto:${email}`}
              class="text-[var(--color-azul)] underline hover:text-[var(--color-dorado)]">
              {email}
            </a>.
          </p>
          <p class="text-xs text-[var(--color-mute)] leading-relaxed">
            Usamos tus datos solo para responderte. Más en nuestra{" "}
            <a href="/privacidad" class="text-[var(--color-azul)] underline hover:text-[var(--color-dorado)]">política de privacidad</a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline
  define:vars={{
    toEmail: email,
    initialSubject,
    endpoint,
  }}
>
  (function () {
    // El sitio es estático: ?servicio= solo se lee en el cliente. Valores desconocidos
    // (p. ej. "Auditoría gratis") caen en la opción genérica.
    const select = document.getElementById('servicio');
    const param = new URLSearchParams(window.location.search).get('servicio');
    if (select instanceof HTMLSelectElement && param) {
      const known = Array.from(select.options).some((o) => o.value === param);
      select.value = known ? param : 'Quiero hablar de mi proyecto';
    }

    const form = document.getElementById('contact-form');
    const submit = document.getElementById('contact-submit');
    const submitLabel = document.getElementById('contact-submit-label');
    const status = document.getElementById('contact-status');
    const idleLabel = submitLabel ? submitLabel.textContent : '';

    const setStatus = (kind, text) => {
      if (!status) return;
      status.textContent = text;
      status.className =
        'text-sm leading-relaxed rounded-md px-4 py-3 ' +
        (kind === 'success'
          ? 'bg-green-100 text-green-900'
          : kind === 'error'
            ? 'bg-red-100 text-red-900'
            : 'bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)]');
    };

    const fieldError = (id, text) => {
      const el = document.getElementById(id + '-error');
      const input = document.getElementById(id);
      if (el) {
        el.textContent = text;
        el.classList.toggle('hidden', !text);
      }
      if (input) input.setAttribute('aria-invalid', text ? 'true' : 'false');
    };

    const validate = (data) => {
      const name = String(data.get('name') ?? '').trim();
      const mail = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const okMail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail);
      fieldError('name', name ? '' : 'Decinos tu nombre.');
      fieldError('email', okMail ? '' : 'Ingresá un email válido.');
      fieldError('message', message ? '' : 'Contanos brevemente qué necesitás.');
      return Boolean(name && okMail && message);
    };

    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        if (!validate(data)) return;
        // Honeypot: si un bot lo completó, no enviamos nada.
        if (String(data.get('_gotcha') ?? '')) return;

        const name = String(data.get('name')).trim();
        const fromEmail = String(data.get('email')).trim();
        const servicio = String(data.get('servicio') ?? '');
        const message = String(data.get('message')).trim();
        const subject = servicio
          ? `[${servicio}] Mensaje de ${name || 'contacto'}`
          : initialSubject;

        if (!endpoint) {
          // Sin endpoint configurado: abrimos la app de email, sin simular un envío.
          const body =
            `${message}\n\n---\nNombre: ${name}\nEmail: ${fromEmail}\nServicio: ${servicio || 'no especificado'}\n`;
          setStatus('info', 'Abrimos tu app de email. Tenés que enviar el mensaje desde ahí.');
          window.location.href =
            `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          return;
        }

        data.set('_subject', subject);
        if (submit) submit.disabled = true;
        if (submitLabel) submitLabel.textContent = 'Enviando...';
        setStatus('info', 'Enviando tu mensaje...');
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          setStatus('success', 'Recibimos tu mensaje. Te respondemos en 24 h hábiles.');
          form.reset();
        } catch (e) {
          setStatus('error', `No pudimos enviar el mensaje. Probá de nuevo o escribinos a ${toEmail}.`);
        } finally {
          if (submit) submit.disabled = false;
          if (submitLabel) submitLabel.textContent = idleLabel;
        }
      });
    }

    // Copy email
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-email-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(toEmail);
          copyLabel.textContent = '¡Copiado!';
          copyBtn.setAttribute('aria-live', 'polite');
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        } catch (e) {
          copyLabel.textContent = 'No se pudo copiar';
          setTimeout(() => { copyLabel.textContent = 'Copiar email'; }, 2200);
        }
      });
    }
  })();
</script>
