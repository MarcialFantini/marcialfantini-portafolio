---
import site from "../data/site.json";
import SectionAnchor from "./SectionAnchor.astro";

const servicioParam = Astro.url.searchParams.get("servicio");
const initialSubject = servicioParam
  ? `Consulta sobre ${servicioParam}`
  : "Consulta desde marcialfantini.com";
const initialBody = servicioParam
  ? `Hola Marcial,\n\nQuiero conversar sobre el servicio "${servicioParam}".\n\nMi nombre:\nMi empresa/negocio:\nQué necesito resolver:\n\nGracias.`
  : "Hola Marcial,\n\nQuiero conversar sobre un proyecto.\n\nMi nombre:\nMi empresa/negocio:\nQué necesito resolver:\n\nGracias.";
---

<section
  id="contacto"
  class="relative py-20 md:py-28 bg-gradient-cool border-y border-[var(--color-ink)] overflow-hidden isolate"
  aria-label="Contacto"
>
  <span class="section-indicator absolute top-6 right-6 md:top-10 md:right-10 text-[var(--color-ink)] z-[3]" aria-hidden="true">
    Get in touch
  </span>

  <div class="container-page relative z-[1]">
    <div class="max-w-3xl mb-14 reveal">
      <SectionAnchor number="08" label="CONTACTO" />
      <h2 class="font-impact text-[clamp(2.5rem,7vw,6rem)] uppercase leading-[0.92] text-[var(--color-ink)] mt-3 mb-6 [text-shadow:_0_2px_12px_rgba(0,0,0,0.18)]">
        Hablemos sobre <span class="text-white">tu proyecto.</span>
      </h2>
      <p class="text-lg text-[var(--color-ink)] leading-relaxed max-w-2xl font-medium">
        Si tenés una PyME que necesita presencia digital seria o un producto a medida, mandame un
        mensaje. Respondo en menos de 24h hábiles con una primera lectura y, si tiene sentido,
        agendamos una llamada de 30 minutos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-8 lg:gap-12 reveal">
      <div class="space-y-8">
        <div class="relative rounded-2xl bg-[var(--color-blanco)] shadow-xl border-2 border-[var(--color-azul)] p-7 overflow-hidden">
          <div class="absolute -top-3 -right-3 px-3 py-1 rounded-full bg-[var(--color-azul)] text-[var(--color-ink)] font-mono text-[9px] uppercase tracking-[0.22em] font-bold rotate-3">
            Más rápido
          </div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">
            Agendá directo
          </p>
          <h3 class="font-impact text-2xl uppercase leading-[0.98] text-[var(--color-ink)] mb-3">
            15min de auditoría gratis.
          </h3>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-5">
            Sin compromiso. Miro tu sitio, te digo 3 cosas concretas para mejorarlo y si tiene sentido seguir, agendamos un segundo encuentro más profundo.
          </p>
          <a
            href="https://cal.com/marcialfantini/auditoria-15min"
            target="_blank"
            rel="noopener noreferrer"
            class="tactile w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-[var(--color-azul)] text-[var(--color-ink)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-[var(--color-azul-deep)]"
          >
            Agendar en Cal.com
            <span aria-hidden="true">→</span>
          </a>
          <p class="mt-3 text-xs text-[var(--color-mute)] leading-relaxed text-center">
            Link a Cal.com — configurá tu URL real en <code class="font-mono text-[10px] bg-[var(--color-blanco-humo)] px-1.5 py-0.5 rounded">Contacto.astro</code>
          </p>
        </div>

        <div class="rounded-2xl bg-[var(--color-blanco)] shadow-lg p-7">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">
            Email directo
          </p>
          <a
            href={`mailto:${site.email}`}
            class="font-display text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-azul)] hover:text-[var(--color-azul-deep)] break-all"
          >
            {site.email}
          </a>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)] mb-2">
            Ubicación
          </p>
          <p class="text-[var(--color-ink)] font-medium">{site.location}</p>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)] mb-3">
            Redes
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href={site.social.github}
                class="tactile text-[var(--color-ink)] hover:text-[var(--color-azul)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">GitHub <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.linkedin}
                class="tactile text-[var(--color-ink)] hover:text-[var(--color-azul)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">LinkedIn <span aria-hidden="true">↗</span></a>
            </li>
            <li>
              <a
                href={site.social.twitter}
                class="tactile text-[var(--color-ink)] hover:text-[var(--color-azul)] inline-flex items-center gap-1.5 font-medium"
                rel="noopener noreferrer"
                target="_blank">Twitter <span aria-hidden="true">↗</span></a>
            </li>
          </ul>
        </div>
      </div>

      <form
        id="contact-form"
        class="relative rounded-2xl bg-[var(--color-blanco)] shadow-lg border-2 border-[var(--color-ink)] p-7 md:p-10 text-[var(--color-ink)]"
        aria-label="Formulario de contacto"
      >
        <div class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-blanco)] text-[var(--color-ink)] placeholder:text-[var(--color-mute)] focus:border-[var(--color-azul)] focus:outline-none focus:ring-4 focus:ring-[var(--color-azul)]/20 transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-blanco)] text-[var(--color-ink)] placeholder:text-[var(--color-mute)] focus:border-[var(--color-azul)] focus:outline-none focus:ring-4 focus:ring-[var(--color-azul)]/20 transition-colors"
            />
          </div>

          <div>
            <label for="servicio" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Servicio que te interesa
            </label>
            <select
              id="servicio"
              name="servicio"
              class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-blanco)] text-[var(--color-ink)] focus:border-[var(--color-azul)] focus:outline-none focus:ring-4 focus:ring-[var(--color-azul)]/20 transition-colors"
            >
              <option value="">Elegí uno (opcional)</option>
              <option value="Producto web a medida" selected={servicioParam === 'Producto web a medida'}>
                Producto web a medida
              </option>
              <option value="E-commerce con pasarela" selected={servicioParam === 'E-commerce con pasarela'}>
                E-commerce con pasarela
              </option>
              <option value="Optimización de performance" selected={servicioParam === 'Optimización de performance'}>
                Optimización de performance
              </option>
              <option
                value="Integraciones y automatizaciones"
                selected={servicioParam === 'Integraciones y automatizaciones'}>
                Integraciones y automatizaciones
              </option>
              <option value="Otro">Otro / no estoy seguro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[var(--color-ink)] mb-1.5">
              Contame brevemente qué necesitás
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={5}
              class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-blanco)] text-[var(--color-ink)] placeholder:text-[var(--color-mute)] resize-y focus:border-[var(--color-azul)] focus:outline-none focus:ring-4 focus:ring-[var(--color-azul)]/20 transition-colors"
            ></textarea>
          </div>

          <button
            type="submit"
            class="tactile w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-[var(--color-azul)] text-[var(--color-blanco-humo)] font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul-deep)]"
          >
            Enviar mensaje
            <span aria-hidden="true">→</span>
          </button>

          <p class="text-xs text-[var(--color-mute)] leading-relaxed">
            Sin backend: este formulario abre tu cliente de email con el mensaje pre-armado. También
            podés escribirme directo a{" "}
            <a
              href={`mailto:${site.email}`}
              class="text-[var(--color-ink-soft)] underline hover:text-[var(--color-azul)]">
              {site.email}
            </a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline
  define:vars={{
    toEmail: site.email,
    initialSubject,
    initialBody,
  }}
>
  const form = document.getElementById('contact-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const email = String(data.get('email') ?? '');
      const servicio = String(data.get('servicio') ?? '');
      const message = String(data.get('message') ?? '');

      const subject = servicio
        ? `[${servicio}] Mensaje de ${name || 'contacto'}`
        : initialSubject;

      const body =
        `${message}\n\n` +
        `---\n` +
        `Nombre: ${name}\n` +
        `Email: ${email}\n` +
        `Servicio: ${servicio || 'no especificado'}\n`;

      const mailto = `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
    });
  }
</script>