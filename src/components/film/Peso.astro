---
import site from "../../data/site.json";

// x/y: % del stage (centro del chip). d: cuándo entra (0..1). dy: deriva en px. r: rotación final en grados.
const chips = [
  { t: "12 mensajes sin responder", x: 32, y: 20, d: 0.06, dy: 46, r: -5 },
  { t: "Sin sitio web", x: 69, y: 28, d: 0.14, dy: 38, r: 4 },
  { t: "Clientes que no vuelven", x: 50, y: 38, d: 0.22, dy: 52, r: -2 },
  { t: "Invisible en Google", x: 33, y: 52, d: 0.3, dy: 40, r: 6 },
  { t: "¿Tenés página?", x: 68, y: 60, d: 0.38, dy: 34, r: -6 },
  { t: "Todo por WhatsApp", x: 46, y: 70, d: 0.46, dy: 44, r: 3 },
  { t: "Presupuestos perdidos", x: 70, y: 80, d: 0.54, dy: 30, r: -4 },
  { t: "La competencia, primero", x: 31, y: 84, d: 0.62, dy: 36, r: 5 },
];
---

<div class="film-scene peso" data-film-scene="peso" data-chapter="Inicio" style="--film-len: 320">
  <div class="film-stage peso__stage">
    <div class="peso__bg" aria-hidden="true"></div>

    <div class="peso__chips" aria-hidden="true">
      {
        chips.map((c) => (
          <span
            class="film-chip peso__chip film-will"
            style={`--x:${c.x};--y:${c.y};--d:${c.d};--dy:${c.dy};--r:${c.r}`}
          >
            {c.t}
          </span>
        ))
      }
    </div>

    <div class="peso__press" aria-hidden="true"></div>
    <div class="peso__vignette" aria-hidden="true"></div>

    <div class="peso__title film-will">
      <p class="peso__eyebrow">
        <span class="peso__mark">MF</span>
        {site.location} · Desarrollo full-stack freelance
      </p>
      <h1 class="peso__h1">
        Software que cierra <span class="text-glow-gold">más ventas</span> para PyMEs.
      </h1>
      <p class="peso__lead">
        Mensajes sin responder, nada en Google, clientes que no vuelven. Eso pesa.
      </p>
      <span class="peso__hint" aria-hidden="true">Scrolleá</span>
    </div>
  </div>
</div>

<style>
  .peso__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(700px 420px at 50% 0%, rgba(27, 43, 92, 0.9), transparent 70%),
      linear-gradient(180deg, var(--color-navy-900) 0%, var(--color-navy-950) 100%);
  }
  .peso__chips {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .peso__chip {
    --v: clamp(0, calc((var(--p) - var(--d)) * 3.5), 1);
    opacity: var(--v);
    transform: translate3d(-50%, calc(-50% + (1 - var(--v)) * 44px + var(--p) * var(--dy) * 1px), 0)
      rotate(calc(var(--r) * 1deg * (0.35 + var(--e) * 0.65)))
      scale(calc(0.85 + var(--v) * 0.15 + var(--e) * 0.08));
    border-color: rgba(246, 241, 228, calc(0.14 + var(--e) * 0.2));
  }
  /* El peso literal: una masa oscura que baja desde arriba */
  .peso__press {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    height: calc(var(--e) * 46svh);
    background: linear-gradient(180deg, #050a1c 0%, rgba(5, 10, 28, 0.85) 45%, transparent 100%);
    pointer-events: none;
  }
  .peso__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse at 50% 55%, transparent 35%, rgba(3, 7, 20, 0.9) 100%);
    opacity: calc(0.25 + var(--e) * 0.75);
    pointer-events: none;
  }
  .peso__title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h, 4.6rem) + 1rem) 1.25rem 2rem;
    text-align: center;
    opacity: max(0, calc(1 - var(--e) * 1.8));
    transform: translate3d(0, calc(var(--e) * -9svh), 0) scale(calc(1 - var(--e) * 0.06));
    pointer-events: none;
  }
  .peso__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 1rem 0.375rem 0.375rem;
    border: 1px solid rgba(246, 241, 228, 0.15);
    border-radius: 999px;
    background: rgba(246, 241, 228, 0.05);
    font-size: 0.75rem;
    color: var(--color-ivory-dim);
  }
  .peso__mark {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--color-neon);
    color: var(--color-navy-950);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
  }
  .peso__h1 {
    margin-top: 1.5rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.3rem, min(9.4vw, 13svh), 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
    text-wrap: balance;
  }
  .peso__lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1rem, 3.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ivory-dim);
  }
  .peso__hint {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(246, 241, 228, 0.45);
  }
  @media (min-width: 768px) {
    .peso__eyebrow { font-size: 0.8125rem; }
  }
  /* Viewports bajos (ventanas anchas y chatas): comprimir para no pasar bajo el header */
  @media (max-height: 700px) {
    .peso__h1 { margin-top: 1rem; }
    .peso__lead { margin-top: 1rem; }
    .peso__hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .peso__chips {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      padding: 0 1.25rem 3rem;
    }
    .peso__chip {
      position: static;
      opacity: 1;
      transform: none;
    }
    .peso__title {
      position: relative;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      padding-bottom: 2rem;
    }
    .peso__press,
    .peso__hint { display: none; }
    .peso__vignette { opacity: 0.5; }
    .peso__stage { display: flex; flex-direction: column; justify-content: center; }
  }
</style>
