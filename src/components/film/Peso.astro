---
import { filmChips as chips } from "../../data/film-chips";

const { from, to } = Astro.props;
---

<div class="film-layer peso is-active" data-film-scene="peso" data-from={from} data-to={to}>
  <div class="film-body peso__stage">
    <div class="peso__bg" aria-hidden="true"></div>

    <div class="peso__chips" aria-hidden="true">
      {
        chips.map((c) => (
          <span
            class="film-chip peso__chip film-will"
            style={`--x:${c.x};--y:${c.y};--d:${c.d};--dy:${c.dy};--r:${c.r}`}
          >
            {c.t}
          </span>
        ))
      }
    </div>

    <div class="peso__press" aria-hidden="true"></div>
    <div class="peso__vignette" aria-hidden="true"></div>

    <div class="peso__title film-will">
      <h1 class="peso__h1">
        Sitios web que traen <span class="text-glow-gold">clientes</span> a tu PyME.
      </h1>
      <p class="peso__lead">
        Te piden el link y no tenés. Te escriben de noche y nadie contesta. En Google aparece tu competencia.
      </p>
      <a href="/contacto?servicio=Auditor%C3%ADa%20gratis" class="peso__cta btn-sunset film-halo film-btn">
        Agendá tu auditoría gratis de 15 min
      </a>
    </div>
  </div>
</div>

<style>
  .peso__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(700px 420px at 50% 0%, rgba(27, 43, 92, 0.9), transparent 70%),
      linear-gradient(180deg, var(--color-navy-900) 0%, var(--color-navy-950) 100%);
  }
  .peso__chips {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .peso__chip {
    --v: clamp(0, calc((var(--p) - var(--d)) * 5), 1);
    opacity: var(--v);
    transform: translate3d(-50%, calc(-50% + (1 - var(--v)) * 44px + var(--p) * var(--dy) * 1px), 0)
      rotate(calc(var(--r) * 1deg * (0.35 + var(--e) * 0.65)))
      scale(calc(0.85 + var(--v) * 0.15 + var(--e) * 0.08));
    border-color: rgba(246, 241, 228, calc(0.14 + var(--e) * 0.2));
  }
  /* El peso literal: una masa oscura que baja desde arriba */
  .peso__press {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    height: 46svh;
    transform: scaleY(var(--e));
    transform-origin: top;
    background: linear-gradient(180deg, #050a1c 0%, rgba(5, 10, 28, 0.85) 45%, transparent 100%);
    pointer-events: none;
  }
  .peso__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse at 50% 55%, transparent 35%, rgba(3, 7, 20, 0.9) 100%);
    opacity: calc(0.25 + var(--e) * 0.75);
    pointer-events: none;
  }
  .peso__title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h, 4.6rem) + 1rem) 1.25rem 2rem;
    text-align: center;
    opacity: max(0, calc(1 - var(--e) * 2.2));
    transform: translate3d(0, calc(var(--e) * -9svh), 0) scale(calc(1 - var(--e) * 0.06));
    pointer-events: none;
  }
  .peso__h1 {
    max-width: 17ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.3rem, min(9.4vw, 13svh), 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
    text-wrap: balance;
  }
  .peso__lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1rem, 3.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ivory-dim);
  }
  /* CTA del hero: clicable mientras el titular es visible; la capa entera no recibe punteros */
  .peso__cta {
    margin-top: 2rem;
    pointer-events: auto;
  }
  /* Titular ya apagado (opacity 0): fuera del orden de tab y del arbol de accesibilidad visual */
  .peso.is-late .peso__title { visibility: hidden; }
  .peso.is-late .peso__cta,
  .peso.is-done .peso__cta { pointer-events: none; }
  /* Viewports bajos (ventanas anchas y chatas): comprimir para no pasar bajo el header */
  @media (max-height: 700px) {
    .peso__lead { margin-top: 1rem; }
    .peso__cta { margin-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .peso__chips {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      padding: 0 1.25rem 3rem;
    }
    .peso__chip {
      position: static;
      opacity: 1;
      transform: none;
    }
    .peso__title {
      position: relative;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      padding-bottom: 2rem;
    }
    .peso__press { display: none; }
    .peso__vignette { opacity: 0.5; }
    .peso__stage { display: flex; flex-direction: column; justify-content: center; }
  }
</style>
