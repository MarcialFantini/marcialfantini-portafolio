---
import site from "../../data/site.json";

const { from, to } = Astro.props;
---

<div class="film-layer cierre" data-film-scene="cierre" data-from={from} data-to={to}>
  <div class="film-body cierre__stage">
    <div class="cierre__bg" aria-hidden="true"></div>
    <div class="cierre__glow" aria-hidden="true"></div>

    <div class="cierre__content">
      <h2 class="cierre__h2">
        <span class="cierre__line film-will" style="--s:0.03">Vos atendés tu negocio.</span>
        <span class="cierre__line film-will" style="--s:0.1">El sitio <span class="text-gold">hace el resto</span>.</span>
      </h2>
      <ul class="cierre__gains">
        <li class="cierre__gain film-will" style="--s:0.2">Que te encuentren cuando te buscan</li>
        <li class="cierre__gain film-will" style="--s:0.27">Precio claro antes de empezar</li>
      </ul>
      <p class="cierre__sub film-will">
        Empezá con 15 minutos gratis: te digo qué cambiaría en tu sitio para que consigas más consultas.
      </p>
      <div class="cierre__cta film-will">
        <a href="/contacto?servicio=Auditor%C3%ADa%20gratis" class="btn-solid film-btn">
          Agendá tu auditoría gratis
        </a>
        {site.whatsapp && (
          <a
            href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="cierre__mail"
          >escribime por WhatsApp</a>
        )}
        <a href={`mailto:${site.email}`} class="cierre__mail">{site.whatsapp ? "o por email a" : "o escribime a"} {site.email}</a>
      </div>
    </div>

    <!-- Costura: navy -> color de página, para entrar a los paneles claros sin corte -->
    <div class="film-seam" aria-hidden="true"></div>
  </div>
</div>

<style>
  .cierre__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: var(--color-navy-950);
  }
  .cierre__glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(560px 380px at 50% 48%, rgba(255, 210, 74, 0.06), transparent 70%);
    opacity: clamp(0, calc(var(--p) * 3), 1);
    pointer-events: none;
  }
  .cierre__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.25rem 9rem;
    text-align: center;
  }
  .cierre__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 8vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
  }
  .cierre__line {
    --v: clamp(0, calc((var(--p) - var(--s)) * 7), 1);
    display: block;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3svh), 0);
  }
  .cierre__gains {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 3.2vw, 0.95rem);
    color: var(--color-ivory-dim);
  }
  .cierre__gain {
    --v: clamp(0, calc((var(--p) - var(--s)) * 7), 1);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3svh), 0);
  }
  .cierre__sub {
    --v: clamp(0, calc((var(--p) - 0.34) * 7), 1);
    margin-top: 1.5rem;
    max-width: 30rem;
    font-size: clamp(1rem, 3.6vw, 1.2rem);
    line-height: 1.5;
    color: var(--color-ivory-dim);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 2svh), 0);
  }
  .cierre__cta {
    --v: clamp(0, calc((var(--p) - 0.42) * 6), 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3svh), 0);
    pointer-events: none;
  }
  .cierre.is-late .cierre__cta { pointer-events: auto; }
  .cierre__mail {
    font-size: 0.9rem;
    color: var(--color-ivory-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .cierre__mail:hover { color: var(--color-neon); }

  /* Costura larga navy -> color de página: ~34svh con paradas suavizadas (sin banda dura),
     empieza antes y llega a opacidad plena sobre el final del scroll. Opera en claro y oscuro
     porque el destino es --color-page. */
  .film-seam {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34svh;
    z-index: 1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-page) 0%, transparent) 0%,
      color-mix(in srgb, var(--color-page) 6%, transparent) 18%,
      color-mix(in srgb, var(--color-page) 22%, transparent) 38%,
      color-mix(in srgb, var(--color-page) 50%, transparent) 58%,
      color-mix(in srgb, var(--color-page) 80%, transparent) 78%,
      color-mix(in srgb, var(--color-page) 96%, transparent) 92%,
      var(--color-page) 100%
    );
    opacity: clamp(0, calc((var(--p) - 0.4) * 3), 1);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cierre__content { position: relative; padding-block: 4rem; }
    .cierre__line,
    .cierre__gain,
    .cierre__sub,
    .cierre__cta {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .cierre__glow { opacity: 1; }
    .film-seam { opacity: 1; height: 24svh; }
  }
</style>
