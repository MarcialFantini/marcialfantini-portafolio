---
import metricas from "../../data/metricas.json";
import testimonios from "../../data/testimonios.json";

const { from, to } = Astro.props;

// Prueba real: dos testimonios de testimonios.json, citados literal (primera oración de `quote`).
const ids = ["lucia-fernandez", "martin-acosta"];
const quotes = ids
  .map((id) => testimonios.find((t) => t.id === id))
  .filter((t): t is (typeof testimonios)[number] => !!t)
  .map((t) => ({
    texto: t.quote.split(/(?<=\.)\s/)[0],
    metric: t.metric,
    nombre: t.nombre,
    cargo: `${t.role}, ${t.empresa}`,
  }));
---

<div class="film-layer alivio" data-film-scene="alivio" data-from={from} data-to={to}>
  <div class="film-body alivio__stage">
    <div class="alivio__bg" aria-hidden="true"></div>
    <div class="alivio__glow" aria-hidden="true"></div>

    <div class="alivio__content">
      <h2 class="alivio__h2">
        <span class="alivio__line film-will" style="--s:0.04">Resultados <span class="text-glow-gold">reales</span>.</span>
        <span class="alivio__line film-will" style="--s:0.12">De negocios como el tuyo.</span>
      </h2>

      <ul class="alivio__kpis">
        {
          metricas.map((m, i) => (
            <li class="alivio__kpi film-will" style={`--s:${0.2 + i * 0.07};--i:${i}`}>
              <span class="alivio__num">
                {m.value}
                {m.sufijo}
              </span>
              <span class="alivio__label">{m.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="alivio__quotes">
        {
          quotes.map((q, i) => (
            <figure class="alivio__quote film-will" style={`--s:${0.56 + i * 0.1}`}>
              <blockquote>“{q.texto}”</blockquote>
              <p class="alivio__metric">{q.metric}</p>
              <figcaption>
                <strong>{q.nombre}</strong> · {q.cargo}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .alivio__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: linear-gradient(180deg, var(--color-navy-950) 0%, var(--color-navy-900) 100%);
  }
  .alivio__glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(600px 420px at 50% 45%, rgba(246, 241, 228, 0.09), transparent 70%);
    opacity: var(--e);
    pointer-events: none;
  }
  .alivio__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4.5rem 1.25rem 4rem;
    text-align: center;
  }
  .alivio__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 7.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
  }
  .alivio__line {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    display: block;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3svh), 0);
    filter: blur(calc((1 - var(--v)) * 6px));
  }
  .alivio__kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    width: min(100%, 44rem);
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .alivio__kpi {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    opacity: var(--v);
    /* "Sube": arranca más abajo y se asienta con la curva suave */
    transform: translate3d(0, calc((1 - var(--v)) * 9svh), 0);
  }
  .alivio__num {
    display: block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.5rem, 6.4vw, 3rem);
    line-height: 1;
    color: var(--color-neon);
    text-shadow: 0 0 calc(var(--v) * 22px) rgba(255, 210, 74, 0.4);
  }
  .alivio__label {
    display: block;
    margin-top: 0.4rem;
    font-size: clamp(0.62rem, 2.5vw, 0.9rem);
    line-height: 1.2;
    color: var(--color-ivory-dim);
  }
  .alivio__quotes {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 44rem);
    margin-top: 1.5rem;
    text-align: left;
  }
  /* En móvil entra solo el primer testimonio: el segundo no entra en el alto del viewport */
  .alivio__quote:nth-child(n + 2) { display: none; }
  .alivio__quote {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    margin: 0;
    padding: 0.8rem 0.95rem;
    border: 1px solid rgba(255, 210, 74, 0.28);
    border-radius: 12px;
    background: rgba(27, 43, 92, 0.55);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 5svh), 0);
  }
  .alivio__quote blockquote {
    margin: 0;
    font-size: clamp(0.85rem, 3.3vw, 1.05rem);
    line-height: 1.4;
    color: var(--color-ivory);
  }
  .alivio__metric {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 2.8vw, 0.85rem);
    font-weight: 700;
    color: var(--color-neon);
  }
  .alivio__quote figcaption {
    margin-top: 0.25rem;
    font-size: clamp(0.66rem, 2.5vw, 0.8rem);
    line-height: 1.3;
    color: var(--color-ivory-dim);
  }
  .alivio__quote figcaption strong { color: var(--color-ivory); }
  @media (min-width: 768px) {
    .alivio__kpis { margin-top: 2rem; gap: 1rem; }
    .alivio__quotes { grid-template-columns: 1fr 1fr; margin-top: 2rem; }
    .alivio__quote:nth-child(n + 2) { display: block; }
    .alivio__quote { padding: 1rem 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .alivio__content { position: relative; padding-block: 4rem; }
    .alivio__line,
    .alivio__kpi,
    .alivio__quote {
      opacity: 1;
      transform: none;
      filter: none;
    }
    .alivio__quote:nth-child(n + 2) { display: block; }
    .alivio__glow { opacity: 1; }
  }
</style>
