---
const { from, to } = Astro.props;

// Qué recupera el cliente: resultados de proceso, sin cifras ni testimonios.
const alivios = [
  "Tiempo para atender tu negocio",
  "Tranquilidad: el sitio trabaja aunque no estés",
  "Que te encuentren cuando te buscan",
  "Consultas que llegan solas",
];

const pasos = [
  { n: "1", t: "Hablamos 15 min" },
  { n: "2", t: "Te pasamos propuesta con precio claro" },
  { n: "3", t: "Armamos y te entregamos con 2 rondas de revisión" },
];
---

<div class="film-layer alivio" data-film-scene="alivio" data-from={from} data-to={to}>
  <div class="film-body alivio__stage">
    <div class="alivio__bg" aria-hidden="true"></div>
    <div class="alivio__glow" aria-hidden="true"></div>

    <div class="alivio__content">
      <h2 class="alivio__h2">
        <span class="alivio__line film-will" style="--s:0.03">Vos atendés tu negocio.</span>
        <span class="alivio__line film-will" style="--s:0.1">El sitio <span class="text-gold">hace el resto</span>.</span>
      </h2>

      <ul class="alivio__gains">
        {
          alivios.map((a, i) => (
            <li class="alivio__gain film-will" style={`--s:${0.18 + i * 0.07}`}>
              {a}
            </li>
          ))
        }
      </ul>

      <ol class="alivio__steps">
        {
          pasos.map((p, i) => (
            <li class="alivio__step film-will" style={`--s:${0.46 + i * 0.1}`}>
              <span class="alivio__n">{p.n}</span>
              <span class="alivio__t">{p.t}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>

<style>
  .alivio__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: linear-gradient(180deg, var(--color-navy-950) 0%, var(--color-navy-900) 100%);
  }
  .alivio__glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(600px 420px at 50% 45%, rgba(246, 241, 228, 0.09), transparent 70%);
    opacity: var(--e);
    pointer-events: none;
  }
  .alivio__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4.5rem 1.25rem 4rem;
    text-align: center;
  }
  .alivio__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 7.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
  }
  .alivio__line {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    display: block;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3svh), 0);
  }
  .alivio__gains {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    width: min(100%, 44rem);
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .alivio__gain {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 6svh), 0);
    font-size: clamp(0.9rem, 3.6vw, 1.15rem);
    line-height: 1.3;
    color: var(--color-ivory);
  }
  .alivio__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    width: min(100%, 44rem);
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .alivio__step {
    --v: clamp(0, calc((var(--p) - var(--s)) * 6), 1);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(255, 210, 74, 0.28);
    border-radius: 12px;
    background: rgba(27, 43, 92, 0.55);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 5svh), 0);
  }
  .alivio__n {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.1rem, 4.5vw, 1.6rem);
    line-height: 1;
    color: var(--color-neon);
  }
  .alivio__t {
    font-size: clamp(0.8rem, 3.2vw, 1rem);
    line-height: 1.3;
    color: var(--color-ivory);
  }
  @media (min-width: 768px) {
    .alivio__gains { grid-template-columns: 1fr 1fr; margin-top: 2rem; gap: 0.6rem 1.5rem; }
    .alivio__steps { grid-template-columns: repeat(3, 1fr); margin-top: 2rem; gap: 1rem; }
    .alivio__step { padding: 0.9rem 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .alivio__content { position: relative; padding-block: 4rem; }
    .alivio__line,
    .alivio__gain,
    .alivio__step {
      opacity: 1;
      transform: none;
    }
    .alivio__glow { opacity: 1; }
  }
</style>
