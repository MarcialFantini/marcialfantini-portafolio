---
// Mismas posiciones que Peso: la escena arranca con el ruido ya acumulado y lo colapsa.
// En el solapamiento del seam esta capa aparece (opacity) justo encima de Peso:
// el estado visual inicial coincide con el final de Peso, así que no se ven chips duplicados.
import servicios from "../../data/servicios.json";

const { from, to } = Astro.props;
const shards = [
  { t: "12 mensajes sin responder", x: 32, y: 20, dy: 46, r: -5 },
  { t: "Sin sitio web", x: 69, y: 28, dy: 38, r: 4 },
  { t: "Clientes que no vuelven", x: 50, y: 38, dy: 52, r: -2 },
  { t: "Google muestra a la competencia", x: 33, y: 52, dy: 40, r: 6 },
  { t: "¿Tenés página?", x: 68, y: 60, dy: 34, r: -6 },
  { t: "Todo por WhatsApp", x: 46, y: 70, dy: 44, r: 3 },
  { t: "Presupuestos perdidos", x: 70, y: 80, dy: 30, r: -4 },
  { t: "“Pasame el link”", x: 31, y: 84, dy: 36, r: 5 },
];

// Ancla de precio: el mínimo real de los rangos "USD a – b" de servicios.json
const minUsd = Math.min(
  ...servicios
    .map((s) => /USD\s*([\d.]+)/.exec(s.precioOrientativo)?.[1])
    .filter((n): n is string => !!n)
    .map((n) => Number(n.replace(/\./g, "")))
);
const minLabel = `USD ${minUsd.toLocaleString("es-AR")}`;
---

<div class="film-layer giro" data-film-scene="giro" data-from={from} data-to={to}>
  <div class="film-body giro__stage">
    <div class="giro__bg" aria-hidden="true"></div>

    <div class="giro__shards" aria-hidden="true">
      {
        shards.map((c) => (
          <span class="film-chip giro__shard film-will" style={`--x:${c.x};--y:${c.y};--dy:${c.dy};--r:${c.r}`}>
            {c.t}
          </span>
        ))
      }
    </div>

    <div class="giro__flash film-will" aria-hidden="true"></div>
    <div class="giro__sweep film-will" aria-hidden="true"></div>
    <div class="giro__halo" aria-hidden="true"></div>

    <div class="giro__content">
      <h2 class="giro__h2">
        <span class="giro__line film-will" style="--s:0.16">Un sitio que vende</span>
        <span class="giro__line film-will" style="--s:0.26"><span class="text-glow-gold">mientras dormís</span>.</span>
      </h2>
      <p class="giro__sub film-will">
        Empezá con una auditoría gratis de 15 minutos: te decimos qué te falta para que te encuentren y te escriban.
      </p>
      <p class="giro__price film-will">Proyectos desde {minLabel} · precios orientativos</p>
      <div class="giro__cta film-will">
        <a href="/contacto?servicio=Auditor%C3%ADa%20gratis" class="btn-sunset">
          Agendá tu auditoría gratis de 15 min
        </a>
        <a href="#servicios-precios" class="btn-ghost">Ver servicios y precios</a>
      </div>
    </div>
  </div>
</div>

<style>
  .giro__bg {
    position: absolute;
    inset: 0;
    z-index: -4;
    background: linear-gradient(180deg, var(--color-navy-950) 0%, var(--color-navy-900) 60%, var(--color-navy-700) 100%);
  }
  .giro__shards {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .giro__shard {
    --k: clamp(0, calc(var(--p) / 0.2), 1);
    opacity: calc(1 - var(--k));
    border-color: rgba(255, 210, 74, calc(0.2 + var(--k) * 0.5));
    transform: translate3d(
        calc(-50% + (50 - var(--x)) * var(--k) * 1vw),
        calc(-50% + var(--dy) * 1px * (1 - var(--k)) + (50 - var(--y)) * var(--k) * 1svh),
        0
      )
      rotate(calc(var(--r) * 1deg * (1 - var(--k))))
      scale(calc(1.08 * (1 - var(--k))));
  }
  /* Destello neón: sube, pica y se apaga */
  .giro__flash {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background: radial-gradient(circle at 50% 50%, rgba(255, 233, 160, 0.95) 0%, rgba(255, 210, 74, 0.55) 22%, transparent 58%);
    opacity: clamp(0, min(calc(var(--p) / 0.07), calc((0.28 - var(--p)) / 0.2)), 1);
    transform: scale(calc(0.35 + var(--p) * 2.6));
    pointer-events: none;
  }
  .giro__sweep {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: 0;
    z-index: -1;
    width: 55%;
    background: linear-gradient(90deg, transparent, rgba(255, 210, 74, 0.38), rgba(255, 246, 214, 0.55), rgba(255, 210, 74, 0.38), transparent);
    opacity: clamp(0, min(calc((var(--p) - 0.03) / 0.07), calc((0.42 - var(--p)) / 0.14)), 1);
    transform: translate3d(calc(-130% + clamp(0, calc((var(--p) - 0.03) / 0.4), 1) * 340%), 0, 0) skewX(-18deg);
    pointer-events: none;
  }
  .giro__halo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(520px 340px at 50% 48%, rgba(246, 241, 228, 0.1), transparent 70%);
    opacity: clamp(0, calc((var(--p) - 0.18) * 4), 1);
    pointer-events: none;
  }
  .giro__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.25rem 3rem;
    text-align: center;
  }
  .giro__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 9vw, 5.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-transform: none;
    color: var(--color-ivory);
  }
  .giro__line {
    --v: clamp(0, calc((var(--p) - var(--s)) * 7), 1);
    display: block;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 3.5svh), 0);
    filter: blur(calc((1 - var(--v)) * 8px));
  }
  .giro__sub {
    --v: clamp(0, calc((var(--p) - 0.36) * 7), 1);
    margin-top: 1.25rem;
    max-width: 32rem;
    font-size: clamp(1rem, 3.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ivory-dim);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 2svh), 0);
  }
  .giro__price {
    --v: clamp(0, calc((var(--p) - 0.48) * 7), 1);
    margin-top: 1rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(255, 210, 74, 0.4);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 3vw, 0.9rem);
    color: var(--color-neon);
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 2svh), 0);
  }
  .giro__cta {
    --v: clamp(0, calc((var(--p) - 0.6) * 6), 1);
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: var(--v);
    transform: translate3d(0, calc((1 - var(--v)) * 2svh), 0);
    pointer-events: none;
  }
  .giro.is-late .giro__cta { pointer-events: auto; }
  @media (min-width: 640px) {
    .giro__cta { flex-direction: row; }
  }

  @media (prefers-reduced-motion: reduce) {
    .giro__shards,
    .giro__flash,
    .giro__sweep { display: none; }
    .giro__content { position: relative; padding-block: 4rem; }
    .giro__line,
    .giro__sub,
    .giro__price,
    .giro__cta {
      opacity: 1;
      transform: none;
      filter: none;
      pointer-events: auto;
    }
    .giro__halo { opacity: 1; }
  }
</style>
