---
import Robot from "./Robot.astro";
/* "Cómo trabajamos": el mapa del proceso de un cliente de ejemplo se transforma fase a fase.
   Fase 0 = cómo trabajan hoy (manual). Cada nodo pasa a "en sistema" en la fase indicada por `live`. */

type Icon = "chat" | "sheet" | "paper" | "invoice";
const pasos: { id: string; t: string; hoy: string; icon: Icon; prio: number; live: number; delay: number; pain?: boolean; integ?: boolean }[] = [
  { id: "pedidos", t: "Pedidos", hoy: "WhatsApp", icon: "chat", prio: 2, live: 3, delay: 0.6, pain: true },
  { id: "stock", t: "Stock", hoy: "Excel", icon: "sheet", prio: 1, live: 3, delay: 0, pain: true },
  { id: "armado", t: "Armado", hoy: "Papel", icon: "paper", prio: 3, live: 3, delay: 1.2 },
  { id: "facturacion", t: "Facturación", hoy: "Sistema contable", icon: "invoice", prio: 4, live: 4, delay: 0, integ: true },
  { id: "informes", t: "Informes", hoy: "Excel", icon: "sheet", prio: 5, live: 4, delay: 0.5 },
];

const fases = [
  {
    t: "Diagnóstico",
    d: "Relevamos cómo trabaja tu equipo hoy: qué herramientas usan, en qué orden y dónde se traba.",
    out: "Mapa del proceso actual",
    when: "30 min, gratis",
  },
  {
    t: "Propuesta cerrada",
    d: "Priorizamos por impacto: primero lo que más duele. Alcance, etapas, plazos y precio por escrito.",
    out: "Plan por etapas",
    when: "Antes de empezar",
  },
  {
    t: "Entregas por etapa",
    d: "Cada parte entra en uso antes de empezar la siguiente. El resto sigue funcionando como siempre.",
    out: "Módulos en uso real",
    when: "Etapa por etapa",
  },
  {
    t: "Puesta en marcha",
    d: "Capacitamos al equipo, migramos los datos y acompañamos el arranque. El código y los datos son tuyos.",
    out: "Operación conectada + soporte",
    when: "Y después, soporte",
  },
];
---

<section class="relative py-20 md:py-28" aria-labelledby="metodo-title">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-end">
      <h2 id="metodo-title" class="display-lg lg:col-span-8 max-w-[20ch]">
        Partimos de cómo trabaja tu equipo. <span class="display-accent">El sistema se adapta a eso.</span>
      </h2>
      <p class="lg:col-span-4 text-[var(--color-ink-soft)] text-base md:text-lg leading-relaxed">
        Lo ponemos en marcha por etapas: cada parte entra en uso antes de empezar la siguiente, sin frenar la operación.
      </p>
    </div>

    <div class="mt" data-method data-phase="1">
      <figure class="mt__map" aria-label="Ejemplo: el proceso de una distribuidora pasando a software por etapas">
        <figcaption class="mt__cap">
          <span>Tu proceso · ejemplo de una distribuidora</span>
          <span class="mt__legend" aria-hidden="true">
            <span class="lg-i"><i class="lg lg--manual"></i>Manual</span>
            <span class="lg-i"><i class="lg lg--mapped"></i>Relevado</span>
            <span class="lg-i"><i class="lg lg--live"></i>En sistema</span>
          </span>
        </figcaption>

        <div class="mt-bot" aria-hidden="true">
          <span class="mt-bot__r"><Robot pose="carry" size={68} /></span>
        </div>

        <ol class="mt__flow">
          {
            pasos.map((p, i) => (
              <>
                <li
                  class="nd"
                  data-live={p.live}
                  data-delay={p.delay}
                  data-pain={p.pain ? "1" : undefined}
                >
                  <span class="nd__prio" aria-hidden="true">{p.prio}</span>
                  <span class="nd__pain" aria-hidden="true"></span>
                  <span class="nd__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="nd__tool">
                      {p.icon === "chat" && <path d="M4 5h16v11H9l-5 4z" />}
                      {p.icon === "sheet" && <path d="M4 4h16v16H4zM4 9h16M4 14h16M10 4v16" />}
                      {p.icon === "paper" && <path d="M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h5" />}
                      {p.icon === "invoice" && <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6" />}
                    </svg>
                    <svg viewBox="0 0 24 24" class="nd__gem">
                      <path d="M6 3h12l4 6-10 12L2 9z" />
                      <path d="M2 9h20M9 3 7.5 9 12 21l4.5-12L15 3" />
                    </svg>
                  </span>
                  <span class="nd__t">{p.t}</span>
                  <span class="nd__s">
                    <span class="nd__hoy">Hoy: {p.hoy}</span>
                    <span class="nd__on">{p.integ ? "Integrado" : "En sistema"}</span>
                  </span>
                </li>
                {i < pasos.length - 1 && (
                  <li class="cn" aria-hidden="true">
                    <span class="cn__line"></span>
                    <span class="cn__pkt"></span>
                  </li>
                )}
              </>
            ))
          }
        </ol>
      </figure>

      <div class="mt__steps" role="tablist" aria-label="Fases del trabajo">
        {
          fases.map((f, i) => (
            <button
              type="button"
              role="tab"
              id={`fase-tab-${i + 1}`}
              class="ph"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`fase-${i + 1}`}
              tabindex={i === 0 ? 0 : -1}
              data-phase-btn={i + 1}
            >
              <span class="ph__n">Fase {i + 1}</span>
              <span class="ph__t">{f.t}</span>
              <span class="ph__bar" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>

      {
        fases.map((f, i) => (
          <div class="mt__detail" role="tabpanel" id={`fase-${i + 1}`} aria-labelledby={`fase-tab-${i + 1}`} hidden={i !== 0}>
            <p class="mt__d">{f.d}</p>
            <dl class="mt__meta">
              <div>
                <dt>Entregable</dt>
                <dd>{f.out}</dd>
              </div>
              <div>
                <dt>Cuándo</dt>
                <dd>{f.when}</dd>
              </div>
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initMethod(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-phase-btn]"));
    const panels = tabs.map((t) => root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!);
    const nodes = Array.from(root.querySelectorAll<HTMLElement>(".nd"));
    const conns = Array.from(root.querySelectorAll<HTMLElement>(".cn"));
    let phase = 1;

    // Pinta el mapa para una fase. Los nodos que entran en uso en esta fase lo hacen escalonados.
    const paint = (p: number) => {
      root.dataset.phase = String(p);
      root.dataset.botMood = p === 4 ? "party" : "";
      const live = nodes.map((n) => p >= Number(n.dataset.live));
      nodes.forEach((n, i) => {
        const entering = live[i] && p === Number(n.dataset.live);
        n.style.setProperty("--d", entering && !reduce ? `${n.dataset.delay}s` : "0s");
        n.classList.toggle("is-live", live[i]);
      });
      conns.forEach((c, i) => {
        const on = live[i] && live[i + 1];
        const d = Math.max(Number(nodes[i].dataset.delay), Number(nodes[i + 1].dataset.delay));
        c.style.setProperty("--d", on && !reduce ? `${d + 0.3}s` : "0s");
        c.classList.toggle("is-live", on);
      });
    };

    const select = (p: number, focus = false) => {
      phase = p;
      tabs.forEach((t, i) => {
        const on = i + 1 === p;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[p - 1].focus();
      paint(p);
    };

    const stopAuto = () => root.classList.add("is-manual");
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        stopAuto();
        select(i + 1);
      });
      t.addEventListener("keydown", (e) => {
        const map: Record<string, number> = {
          ArrowRight: (phase % tabs.length) + 1,
          ArrowLeft: ((phase + tabs.length - 2) % tabs.length) + 1,
          Home: 1,
          End: tabs.length,
        };
        const n = map[e.key];
        if (!n) return;
        e.preventDefault();
        stopAuto();
        select(n, true);
      });
      // La barra de la fase activa marca el tiempo; al terminar avanza (y vuelve a empezar tras la última)
      t.querySelector(".ph__bar")!.addEventListener("animationend", () => {
        if (!root.classList.contains("is-manual") && i + 1 === phase) select((phase % tabs.length) + 1);
      });
    });

    if (reduce) stopAuto();

    // Primera vez en pantalla: arranca desde "cómo trabajan hoy" y pasa a relevado
    let seen = false;
    new IntersectionObserver(([e]) => {
      root.classList.toggle("is-paused", !e.isIntersecting);
      if (e.isIntersecting && !seen) {
        seen = true;
        if (reduce) return;
        paint(0);
        window.setTimeout(() => paint(phase), 500);
      }
    }, { threshold: 0.3 }).observe(root);
    document.addEventListener("visibilitychange", () => root.classList.toggle("is-hidden", document.hidden));
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-method]").forEach(initMethod);
  });
</script>

<style>
  .mt {
    --gold: #f5c542;
    --warn: #c98a10;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ---------- Mapa del proceso ---------- */
  .mt__map {
    margin: 0;
    padding: clamp(1.1rem, 2vw, 1.75rem);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-hair);
    background:
      linear-gradient(color-mix(in srgb, var(--color-ink) 4%, transparent) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 4%, transparent) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--color-page);
  }
  .mt__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-soft);
  }
  .mt__legend { display: inline-flex; align-items: center; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .lg-i { display: inline-flex; align-items: center; gap: 0.45rem; white-space: nowrap; }
  .lg { display: inline-block; width: 12px; height: 12px; border-radius: 3px; }
  .lg--manual { border: 1.5px dashed var(--color-hair-strong); }
  .lg--mapped { border: 1.5px solid var(--color-ink); background: var(--color-blanco); }
  .lg--live { border: 1.5px solid var(--color-ink); background: var(--gold); }

  .mt__flow {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .mt__flow {
      grid-template-columns:
        minmax(0, 1fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr);
      align-items: center;
      margin-top: 2rem;
    }
  }

  /* Nodo: manual (fase 0) -> relevado -> en sistema */
  .nd {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-blanco);
    color: var(--color-ink);
    transition:
      background-color 500ms var(--ease-out-expo),
      border-color 500ms var(--ease-out-expo),
      box-shadow 500ms var(--ease-out-expo),
      transform 500ms var(--ease-out-expo);
  }
  @media (min-width: 900px) {
    .nd { grid-template-columns: minmax(0, 1fr); row-gap: 0.4rem; padding: 1.1rem 1rem 1rem; min-height: 9.5rem; align-content: start; }
  }
  .nd__icon { grid-row: span 2; position: relative; width: 36px; height: 36px; }
  @media (min-width: 900px) { .nd__icon { grid-row: auto; margin-bottom: 0.35rem; } }
  .nd__icon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 7px;
    border-radius: 9px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: opacity 400ms var(--ease-out-expo), transform 500ms var(--ease-out-expo);
  }
  .nd__tool { background: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .nd__gem { background: var(--color-ink); stroke: var(--gold) !important; opacity: 0; transform: scale(0.6) rotate(-20deg); }
  .nd__t { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.1; }
  .nd__s { position: relative; display: grid; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; }
  .nd__s > span { grid-area: 1 / 1; transition: opacity 350ms ease, transform 450ms var(--ease-out-expo); }
  .nd__hoy { color: var(--color-ink-soft); }
  .nd__on { opacity: 0; transform: translateY(6px); font-weight: 700; color: var(--color-ink); }

  /* Prioridad (desde la propuesta) y punto de dolor (diagnóstico/propuesta) */
  .nd__prio {
    position: absolute;
    top: -10px;
    right: 10px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: var(--color-action);
    color: #ffd24a;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 300ms ease, transform 450ms var(--ease-out-expo);
  }
  .nd__pain {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warn);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .mt[data-phase="1"] .nd[data-pain] .nd__pain,
  .mt[data-phase="2"] .nd[data-pain]:not(.is-live) .nd__pain { opacity: 1; animation: pain 1.6s ease-in-out infinite; }
  @keyframes pain {
    50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--warn) 20%, transparent); }
  }
  .mt:is([data-phase="2"], [data-phase="3"]) .nd:not(.is-live) .nd__prio { opacity: 1; transform: none; }

  /* Fase 0: así trabajan hoy */
  .mt[data-phase="0"] .nd {
    border-style: dashed;
    border-color: var(--color-hair-strong);
    background: transparent;
    color: var(--color-ink-soft);
  }

  /* En sistema */
  .nd.is-live {
    background: var(--gold);
    border-color: var(--color-ink);
    color: #0f1a3a;
    box-shadow: 0 10px 24px -14px rgba(15, 26, 58, 0.6);
    transform: translateY(-3px);
  }
  .nd.is-live .nd__tool { opacity: 0; transform: scale(0.6) rotate(20deg); }
  .nd.is-live .nd__gem { opacity: 1; transform: none; background: #0f1a3a; }
  .nd.is-live .nd__hoy { opacity: 0; transform: translateY(-6px); }
  .nd.is-live .nd__on { opacity: 1; transform: none; color: #0f1a3a; }
  /* Retraso escalonado (--d) para todo lo que cambia cuando el nodo entra en sistema */
  .nd, .nd__s > span, .nd__icon svg { transition-delay: var(--d, 0s); }

  /* Conector: punteado mientras es manual; dorado y con paquetes cuando ambos extremos están en sistema */
  .cn { position: relative; height: 1.75rem; container-type: size; }
  @media (min-width: 900px) { .cn { height: 2px; } }
  .cn__line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 1.5px dashed var(--color-hair-strong);
    transition: border-color 400ms ease;
    transition-delay: var(--d, 0s);
  }
  @media (min-width: 900px) {
    .cn__line { left: 0; right: 0; top: 0; bottom: auto; border-left: 0; border-top: 1.5px dashed var(--color-hair-strong); }
  }
  .cn.is-live .cn__line { border-color: var(--color-ink); border-style: solid; }
  .cn__pkt {
    position: absolute;
    left: calc(50% - 4px);
    top: -4px;
    width: 9px;
    height: 9px;
    background: var(--gold);
    border: 1.5px solid var(--color-ink);
    rotate: 45deg;
    opacity: 0;
  }
  @media (min-width: 900px) { .cn__pkt { left: -4px; top: -4px; } }
  .cn.is-live .cn__pkt { animation: pkt-y 1.4s ease-in-out var(--d, 0s) infinite; }
  @media (min-width: 900px) { .cn.is-live .cn__pkt { animation-name: pkt-x; } }
  @keyframes pkt-y {
    0% { transform: translateY(0); opacity: 0; }
    20%, 80% { opacity: 1; }
    100% { transform: translateY(100cqh); opacity: 0; }
  }
  @keyframes pkt-x {
    0% { transform: translateX(0); opacity: 0; }
    20%, 80% { opacity: 1; }
    100% { transform: translateX(100cqw); opacity: 0; }
  }

  /* Mascota: avanza por el proceso según la fase activa */
  .mt-bot { position: relative; height: 68px; margin-top: 1rem; container-type: inline-size; }
  .mt-bot__r {
    position: absolute;
    left: 0;
    bottom: -8px;
    transform: translateX(calc((100cqw - 68px) * var(--p, 0)));
    transition: transform 1.4s var(--ease-out-expo);
  }
  .mt[data-phase="2"] .mt-bot__r { --p: 0.25; }
  .mt[data-phase="3"] .mt-bot__r { --p: 0.5; }
  .mt[data-phase="4"] .mt-bot__r { --p: 1; }
  .mt-bot + .mt__flow { margin-top: 0.75rem; }

  /* ---------- Fases ---------- */
  .mt__steps {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (min-width: 768px) { .mt__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ph {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 0.9rem 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--color-hair);
    background: var(--color-blanco);
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms, background-color 250ms var(--ease-out-quart);
  }
  .ph:hover { border-color: var(--color-hair-strong); }
  .ph:focus-visible { outline: 2px solid var(--color-azul); outline-offset: 2px; }
  .ph:active { transform: translateY(1px); }
  .ph[aria-selected="true"] { background: var(--color-action); border-color: var(--color-action); color: #f6f1e4; }
  .ph__n { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-soft); }
  .ph[aria-selected="true"] .ph__n { color: #ffd24a; }
  .ph__t { font-family: var(--font-display); font-weight: 700; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem); letter-spacing: -0.02em; line-height: 1.15; }
  .ph__bar {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.55rem;
    height: 2px;
    border-radius: 2px;
    background: #ffd24a;
    transform: scaleX(0);
    transform-origin: left;
  }
  .ph[aria-selected="true"] .ph__bar { animation: ph-timer 6s linear forwards; }
  .mt.is-manual .ph__bar { animation: none !important; transform: scaleX(0); }
  @keyframes ph-timer { to { transform: scaleX(1); } }

  .mt__detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2.5rem;
    margin-top: 1.25rem;
    padding: 0 0.25rem;
    animation: detail-in 450ms var(--ease-out-expo) both;
  }
  @media (min-width: 768px) { .mt__detail { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; } }
  @keyframes detail-in { from { opacity: 0; transform: translateY(6px); } }
  .mt__d { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem); line-height: 1.55; color: var(--color-ink); max-width: 52ch; text-wrap: pretty; }
  .mt__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0; }
  .mt__meta dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-soft); }
  .mt__meta dd { margin: 0.3rem 0 0; font-weight: 600; color: var(--color-ink); }

  /* Pausa fuera de pantalla o pestaña oculta */
  .mt:is(.is-paused, .is-hidden) :is(.ph__bar, .cn__pkt, .nd__pain) { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .mt *, .mt *::before { transition: none !important; animation: none !important; }
    .cn.is-live .cn__pkt { opacity: 1; }
  }
</style>
