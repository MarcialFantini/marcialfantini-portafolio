---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const gradients = ["warm", "cool", "vivid"] as const;
---

<section class="relative py-20 md:py-28 border-b border-[var(--color-border)] bg-[var(--color-blanco)] overflow-hidden">
  <div class="container-page">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12 reveal">
      <div>
        <span class="section-indicator text-[var(--color-mute)]">
          Ensayo · Notas
        </span>
        <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-ink)] mt-4 max-w-xl">
          Lo que aprendí <span class="text-[var(--color-azul)]">en el camino.</span>
        </h2>
      </div>
      <a
        href="/blog"
        class="tactile font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-[var(--color-ink)] hover:text-[var(--color-azul)] inline-flex items-center gap-1.5"
      >
        Ver todos <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal-stagger">
      {
        posts.map((post, i) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group tactile block rounded-xl bg-[var(--color-blanco-humo)] shadow-sm border border-[var(--color-border)] transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-azul)] h-full overflow-hidden"
            >
              <div
                class={`placeholder-image placeholder-image--${gradients[i % gradients.length]} h-40 relative overflow-hidden`}
                aria-hidden="true"
              >
                <div class="absolute inset-0 dots-overlay opacity-50"></div>
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="font-impact text-7xl text-white/15 select-none tabular-nums leading-none">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-4 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                  <FormattedDate date={post.data.pubDate} format="short" />
                  <span class="w-1 h-1 rounded-full bg-[var(--color-border)]" aria-hidden="true"></span>
                  <span class="text-[var(--color-azul)] font-semibold">{post.data.category}</span>
                </div>

                <h3 class="font-impact text-xl md:text-2xl uppercase leading-[1] tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-azul)] transition-colors mb-3">
                  {post.data.title}
                </h3>

                <p class="text-sm text-[var(--color-ink-soft)] leading-snug line-clamp-3 mb-5">
                  {post.data.description}
                </p>

                <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] pt-4 border-t border-[var(--color-border)]">
                  <span>{post.data.readingTime} min</span>
                  <span class="text-[var(--color-azul)] font-semibold">Leer →</span>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>