---
import { getCollection } from "astro:content";
import site from "../data/site.json";

const proyectos = (await getCollection("proyectos")).sort((a, b) => a.id.localeCompare(b.id));

// Tiles estilo "app icon": inicial del proyecto sobre colores de marca
const palette = [
  { bg: "#1B2B5C", fg: "#FFFFFF" },
  { bg: "#C8A24E", fg: "#0F1A3A" },
  { bg: "#FFFFFF", fg: "#1B2B5C" },
  { bg: "#243A75", fg: "#E0B96B" },
  { bg: "#F5EFE0", fg: "#A6843A" },
  { bg: "#0F1A3A", fg: "#C8A24E" },
];
const tiles = proyectos.map((p, i) => ({
  href: `/proyectos/${p.id}`,
  label: p.data.title,
  letter: p.data.title.replace(/^(landing|tienda|panel|sistema|catálogo|catalogo|blog)\s+/i, "").charAt(0).toUpperCase(),
  ...palette[(i * 5 + Math.floor(i / 3)) % palette.length],
}));

const rows = [0, 1, 2].map((r) => {
  const list = tiles.filter((_, i) => i % 3 === r);
  // repetir para llenar el ancho y permitir loop sin salto
  return [...list, ...list, ...list, ...list];
});

const pills = [
  { v: "8+", l: "años" },
  { v: "40+", l: "proyectos" },
  { v: "100%", l: "entregas a tiempo" },
];
---

<section
  data-scene
  class="relative isolate overflow-hidden text-[var(--color-ink)] bg-[#0F1A3A] text-white"
  aria-label="Hero"
>
  <div class="scene-sky absolute inset-0 -z-10" style="background: radial-gradient(900px 420px at 50% -8%, rgba(200,162,78,0.22), transparent 70%), linear-gradient(180deg, #0F1A3A 0%, #1B2B5C 100%);"></div>

  <div class="container-page relative z-[1] pt-14 md:pt-20 pb-10 text-center">
    <p class="reveal inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 py-1.5 pl-1.5 pr-4 text-[12px] md:text-[13px] text-white/80 backdrop-blur">
      <span class="grid h-6 w-6 place-items-center rounded-full bg-[var(--color-dorado)] font-impact text-[10px] text-[#0F1A3A]">MF</span>
      {site.location} · Desarrollo full-stack freelance
    </p>

    <h1 class="scene-title mx-auto mt-6 max-w-4xl font-display font-semibold tracking-[-0.045em] leading-[1.02] text-white" style="font-size: clamp(2.4rem, 6.2vw, 5rem); text-transform: none;">
      <span class="mask-line" style="--i:0"><span>Software que cierra</span></span>
      <span class="mask-line" style="--i:1"><span><span class="text-sunset">más ventas</span> para PyMEs.</span></span>
    </h1>

    <p class="reveal mx-auto mt-6 max-w-2xl text-base md:text-lg text-white/70 leading-relaxed">
      Sitios, e-commerce y automatizaciones para estudios, ferreterías y distribuidoras.
      Cobro por proyecto, con KPI pactado.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/contacto?servicio=Auditor%C3%ADa%20gratis" class="btn-sunset">
        Reservá una auditoría de 15 min
      </a>
      <a href="/proyectos" class="btn-ghost">Ver proyectos</a>
    </div>

    <ul class="reveal mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-white/55">
      {
        pills.map((p) => (
          <li>
            <span class="text-[var(--color-dorado)] tabular-nums">{p.v}</span> {p.l}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Pared de tiles: 3 filas que se desplazan en sentido alterno -->
  <div class="tile-wall relative z-[1] pb-12 md:pb-16" aria-label="Proyectos entregados">
    {
      rows.map((row, r) => (
        <div class="tile-row" data-dir={r % 2 === 0 ? "l" : "r"} style={`--off:${r * -34}px`}>
          <div class="tile-track">
            {[0, 1].map(() => (
              <div class="tile-set">
                {row.map((t) => (
                  <a href={t.href} class="tile" style={`background:${t.bg};color:${t.fg}`} aria-label={t.label} title={t.label}>
                    <span>{t.letter}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24" style="background: linear-gradient(to bottom, transparent, var(--color-page));" aria-hidden="true"></div>
  </div>
</section>
