---
import site from "../data/site.json";
---

<section
  class="relative bg-gradient-azul text-[var(--color-blanco-humo)] border-b border-[var(--color-azul-deep)] overflow-hidden"
  aria-label="Hero"
>
  <div class="container-page pt-16 md:pt-24 pb-24 md:pb-32 relative z-[1]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
      <div class="lg:col-span-8 reveal-stagger">
        <p class="font-mono text-[11px] md:text-xs uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-6 md:mb-8 flex items-center gap-3">
          <span class="tick-dorado" style="background-color: var(--color-dorado);"></span>
          {site.location} · {site.availability}
        </p>

        <h1 class="font-impact leading-[0.92] tracking-[-0.04em] text-[clamp(2.5rem,7vw,5.5rem)] text-white">
          <span class="block">Software que</span>
          <span class="block">cierra <span class="text-[var(--color-dorado)]">más ventas</span></span>
          <span class="block">para PyMEs <span class="text-[var(--color-dorado)]">argentinas.</span></span>
        </h1>

        <p class="mt-7 md:mt-9 max-w-2xl text-base md:text-lg text-white/85 leading-relaxed">
          Construyo sitios, e-commerce y automatizaciones para estudios, ferreterías,
          distribuidoras y marcas que ya no aguantan otra plantilla de WordPress.
          Cobro por proyecto con KPI pactado.
        </p>

        <div class="mt-9 md:mt-12 flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href="/contacto?servicio=Auditor%C3%ADa%20gratis"
            class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white"
          >
            Reservá una auditoría 15min
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/servicios"
            class="tactile inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-white/85 hover:text-[var(--color-dorado)] border-b border-white/30 hover:border-[var(--color-dorado)] pb-1"
          >
            Ver servicios y precios
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="lg:col-span-4 reveal">
        <dl class="border-t border-white/15 pt-6 grid grid-cols-2 gap-y-6 gap-x-4">
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/60 leading-tight">
              Años en producción
            </dt>
            <dd class="font-impact text-3xl md:text-4xl text-white tabular-nums mt-2">
              8<span class="text-[var(--color-dorado)]">+</span>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/60 leading-tight">
              Proyectos entregados
            </dt>
            <dd class="font-impact text-3xl md:text-4xl text-white tabular-nums mt-2">
              40<span class="text-[var(--color-dorado)]">+</span>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/60 leading-tight">
              PyMEs activas
            </dt>
            <dd class="font-impact text-3xl md:text-4xl text-white tabular-nums mt-2">
              12
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/60 leading-tight">
              Entregas a tiempo
            </dt>
            <dd class="font-impact text-3xl md:text-4xl text-white tabular-nums mt-2">
              100<span class="text-[var(--color-dorado)]">%</span>
            </dd>
          </div>
        </dl>
        <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.22em] text-white/50 leading-relaxed">
          Stack: Astro · TypeScript · Tailwind v4 · Vercel/Cloudflare.
          Sin frameworks de moda, sin retainer obligatorio.
        </p>
      </aside>
    </div>
  </div>

  <span
    class="absolute bottom-5 right-5 md:bottom-8 md:right-8 font-mono text-[10px] uppercase tracking-[0.22em] text-white/40 hidden md:block"
    aria-hidden="true"
  >
    {site.name} · since 2017
  </span>
</section>