---
import site from "../data/site.json";
import CornerBrackets from "./CornerBrackets.astro";
---

<section
  class="relative pt-16 md:pt-24 pb-28 md:pb-40 overflow-hidden bg-gradient-warm border-b-2 border-[var(--color-ink)] isolate hero-scrim"
  aria-label="Hero"
>
  <img
    src="https://picsum.photos/seed/marcial-workspace-hero/1920/1080"
    alt=""
    role="presentation"
    class="cover-image cover-image--hero"
    loading="eager"
    decoding="async"
  />
  <div class="hero-warm-tint" aria-hidden="true"></div>
  <span class="section-indicator absolute top-6 left-6 md:top-10 md:left-10 text-[var(--color-ink)]/70 z-[3]" aria-hidden="true">
    Since 2016 · Córdoba AR
  </span>

  <div class="container-page relative z-[1]">
    <div class="relative max-w-5xl reveal-stagger p-0 md:p-10" style="color: var(--color-ink);">
      <CornerBrackets color="var(--color-azul)" size={24} offset={-4} />
      <p class="font-mono text-[11px] md:text-xs uppercase tracking-[0.22em] text-[var(--color-ink)] mb-7 md:mb-9 flex items-center gap-3">
        <span class="tick-orange"></span>
        {site.location} · {site.availability}
      </p>

      <h1 class="font-impact text-white leading-[0.88] tracking-[-0.02em] uppercase [text-shadow:_0_2px_16px_rgba(0,0,0,0.6)]">
        <span class="block text-[clamp(1.75rem,7.5vw,5.5rem)] leading-[0.95]">PyMEs argentinas que pasaron</span>
        <span class="block text-[clamp(1.75rem,7.5vw,5.5rem)] leading-[0.95] mt-1">de <span class="text-[var(--color-azul)]">no-rankear</span> a</span>
        <span class="block text-[clamp(2.25rem,11vw,8rem)] leading-[0.92] mt-1 text-[var(--color-azul)]">
          vender todos los días<span>.</span>
        </span>
      </h1>

      <p class="mt-8 md:mt-10 font-mono text-sm md:text-base text-white max-w-2xl leading-relaxed [text-shadow:_0_1px_8px_rgba(0,0,0,0.7)]">
        Construyo sitios para e-commerce, servicios profesionales y retail argentino.
      </p>

      <p class="mt-5 text-base md:text-lg text-white max-w-2xl leading-relaxed font-medium [text-shadow:_0_1px_6px_rgba(0,0,0,0.65)]">
        Hola, soy <strong class="text-white font-semibold">{site.name}</strong>. Desarrollo a medida.
        Si tu sitio web no está vendiendo todos los días, <span class="text-[var(--color-azul)] font-semibold">te está costando clientes</span>.
      </p>

      <div class="mt-7 md:mt-9 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-blanco)]/10 backdrop-blur-sm border border-white/20 font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-white">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-azul)] animate-pulse" aria-hidden="true"></span>
        +12 PyMEs confiaron · +40 proyectos en producción · 8+ años
      </div>

      <div class="mt-9 md:mt-11 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <a
          href="/contacto?servicio=Auditoría%20gratis"
          class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[var(--color-azul)] text-[var(--color-ink)] font-semibold hover:bg-[var(--color-azul-deep)] border-2 border-[var(--color-azul)]"
        >
          Auditoría gratis 15min
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="#servicios"
          class="tactile inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-azul)] border-b border-[var(--color-ink)] hover:border-[var(--color-azul)] pb-1"
        >
          Ver servicios
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div
    class="float-card float-card--ink hidden lg:flex items-center gap-3"
    style="top: clamp(60px, 10vh, 100px); right: clamp(20px, 5vw, 60px); transform: rotate(-3deg);"
    aria-label="Watch reel — preview"
  >
    <span
      class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-azul)] text-[var(--color-ink)] shrink-0"
      aria-hidden="true"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
        <path d="M3 1.5L12 7L3 12.5V1.5Z" />
      </svg>
    </span>
    <div class="leading-tight">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-azul)]">
        Watch reel
      </p>
      <p class="font-display font-semibold text-sm text-[var(--color-blanco-humo)]">
        90 segundos
      </p>
    </div>
  </div>

  <div
    class="float-card float-card--orange float-bob float-bob--rotate-2 hidden lg:flex items-center gap-3 px-5 py-4"
    style="bottom: clamp(20px, 5vh, 60px); right: clamp(20px, 5vw, 80px);"
    aria-label="CTA — hablemos"
  >
    <a
      href="/contacto"
      class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-[var(--color-blanco-humo)]"
    >
      Hablemos de tu proyecto
      <span aria-hidden="true" class="text-base">→</span>
    </a>
  </div>
</section>