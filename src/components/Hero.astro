---
import site from "../data/site.json";
---

<section
  class="relative pt-12 md:pt-20 pb-20 md:pb-28 overflow-hidden border-b border-[var(--color-border)]"
  aria-label="Hero"
>
  <div
    aria-hidden="true"
    class="absolute top-0 right-0 w-[40rem] h-[40rem] -translate-y-1/2 translate-x-1/4 opacity-[0.08] pointer-events-none"
    style="background: radial-gradient(circle at center, var(--color-dorado) 0%, transparent 70%);"
  >
  </div>

  <div class="container-page relative">
    <div class="max-w-4xl">
      <p
        class="font-mono text-xs md:text-sm uppercase tracking-[0.25em] text-[var(--color-mute)] mb-6 flex items-center gap-3"
      >
        <span class="inline-block w-8 h-px bg-[var(--color-dorado)]"></span>
        {site.location} · {site.availability}
      </p>

      <h1 class="font-display font-bold text-[var(--color-ink)] mb-8 leading-[0.95]">
        Construyo software
        <span class="block text-[var(--color-azul)]">que entrega resultados</span>
        <span class="block">medibles.</span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--color-ink-soft)] max-w-2xl leading-relaxed mb-10">
        Hola, soy <strong class="text-[var(--color-ink)]">{site.name}</strong>. Desarrollador
        freelance especializado en productos digitales para PyMEs. Si querés conversar sobre un
        proyecto que mueve la aguja de tu negocio, estás en el lugar correcto.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href="/proyectos"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-[var(--color-ink)] text-[var(--color-blanco-humo)] font-medium hover:bg-[var(--color-azul)] transition-colors"
        >
          Ver proyectos
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md border border-[var(--color-border)] bg-[var(--color-blanco)] text-[var(--color-ink)] font-medium hover:border-[var(--color-dorado)] hover:text-[var(--color-dorado)] transition-colors"
        >
          Hablemos
        </a>
      </div>

      <p class="mt-12 font-mono text-sm text-[var(--color-mute)] flex flex-wrap gap-x-6 gap-y-2 items-center">
        <span>8+ años en producción</span>
        <span class="w-px h-3 bg-[var(--color-border)]"></span>
        <span>40+ proyectos entregados</span>
        <span class="w-px h-3 bg-[var(--color-border)]"></span>
        <span>Astro · TypeScript · Tailwind</span>
      </p>
    </div>
  </div>
</section>
