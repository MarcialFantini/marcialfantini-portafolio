---
import site from "../data/site.json";
---

<section
  class="relative pt-16 md:pt-24 pb-28 md:pb-40 overflow-hidden bg-gradient-warm border-b border-[var(--color-ink)] isolate hero-scrim"
  aria-label="Hero"
>
  <span class="section-indicator absolute top-6 left-6 md:top-10 md:left-10 text-[var(--color-ink)]/70 z-[3]" aria-hidden="true">
    Since 2016 · Córdoba AR
  </span>

  <div class="container-page relative z-[1]">
    <div class="max-w-5xl reveal-stagger">
      <p class="font-mono text-[11px] md:text-xs uppercase tracking-[0.22em] text-[var(--color-ink)] mb-7 md:mb-9 flex items-center gap-3">
        <span class="tick-orange"></span>
        {site.location} · {site.availability}
      </p>

      <h1 class="font-impact text-white leading-[0.88] tracking-[-0.02em] uppercase [text-shadow:_0_2px_12px_rgba(0,0,0,0.35)]">
        <span class="block text-[clamp(2.75rem,8vw,6.5rem)]">Software que entrega</span>
        <span class="block text-[clamp(3.5rem,11vw,9rem)] mt-1">
          <span class="text-[var(--color-ink)]">resultados</span>
          <span class="text-[var(--color-ink)]">.</span>
        </span>
      </h1>

      <p class="mt-8 md:mt-10 font-mono text-sm md:text-base text-white max-w-2xl leading-relaxed [text-shadow:_0_1px_6px_rgba(0,0,0,0.4)]">
        Construyo ese software para PyMEs argentinas.
      </p>

      <p class="mt-5 text-base md:text-lg text-[var(--color-ink)] max-w-2xl leading-relaxed font-medium">
        Hola, soy <strong class="text-[var(--color-ink)] font-semibold">{site.name}</strong>. Desarrollo
        freelance full-stack. Si tu proyecto mueve la aguja del negocio, estás en el lugar correcto.
      </p>

      <div class="mt-9 md:mt-11 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <a
          href="/proyectos"
          class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[var(--color-ink)] text-[var(--color-blanco-humo)] font-medium hover:bg-[var(--color-azul)] border-2 border-[var(--color-ink)] hover:border-[var(--color-azul)]"
        >
          Ver proyectos
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/contacto"
          class="tactile inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-azul-deep)]"
        >
          Hablemos de tu proyecto
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div
    class="float-card hidden lg:flex items-center gap-3"
    style="top: clamp(60px, 10vh, 100px); right: clamp(20px, 5vw, 60px); transform: rotate(-3deg);"
    aria-label="Watch reel — preview"
  >
    <span
      class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-gradient-cool)] text-white shrink-0"
      aria-hidden="true"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
        <path d="M3 1.5L12 7L3 12.5V1.5Z" />
      </svg>
    </span>
    <div class="leading-tight">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
        Watch reel
      </p>
      <p class="font-display font-semibold text-sm text-[var(--color-ink)]">
        90 segundos
      </p>
    </div>
  </div>

  <div
    class="float-card float-card--orange hidden lg:flex items-center gap-3 px-5 py-4"
    style="bottom: clamp(20px, 5vh, 60px); right: clamp(20px, 5vw, 80px); transform: rotate(2deg);"
    aria-label="CTA — hablemos"
  >
    <a
      href="/contacto"
      class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-[var(--color-blanco-humo)]"
    >
      Hablemos de tu proyecto
      <span aria-hidden="true" class="text-base">→</span>
    </a>
  </div>
</section>