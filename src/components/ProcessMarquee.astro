---
// Una sola línea, lenta y decorativa: solo términos de servicio, sin nombres de clientes.
const terms = [
  "Páginas web",
  "Landing pages",
  "Catálogos online",
  "Ecommerce",
  "Software a medida",
  "Automatizaciones",
  "Integraciones",
];
---

<div class="marquee marquee--terms" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <div class="flex shrink-0">
          {[...terms, ...terms].map((t) => (
            <span class="terms__item">
              {t}
              <i>·</i>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
