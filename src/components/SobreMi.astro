---
import site from "../data/site.json";
---

<section class="relative py-20 md:py-28 border-b border-[var(--color-border)] overflow-hidden">
  <div class="container-page reveal">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-4 flex flex-col items-start gap-6">
        <div
          class="relative w-36 h-36 md:w-44 md:h-44"
          role="img"
          aria-label="Avatar con iniciales MF — placeholder hasta tener foto real"
        >
          <div class="absolute inset-0 rounded-md bg-[var(--color-dorado)] translate-x-2 translate-y-2"></div>
          <div class="absolute inset-0 rounded-md bg-[var(--color-azul)] flex items-center justify-center">
            <span class="font-impact text-6xl md:text-7xl text-white leading-none">
              MF
            </span>
          </div>
        </div>
        <div>
          <p class="font-impact text-xl md:text-2xl tracking-tight text-[var(--color-ink)] leading-tight">
            Marcial Fantini
          </p>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mt-1.5">
            Full-stack freelance · Córdoba AR
          </p>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mt-1">
            2017 → hoy
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">
          01 · Sobre mí
        </p>

        <h2 class="font-impact text-[clamp(2rem,5vw,3.75rem)] leading-[0.95] text-[var(--color-ink)] max-w-3xl">
          Construyo software para que tu PyME <span class="text-[var(--color-azul)]">cierre más ventas</span> y deje de depender de mí.
        </h2>

        <div class="mt-7 max-w-3xl space-y-5 text-[var(--color-ink-soft)] text-lg leading-relaxed">
          <p>
            Soy {site.name}, desarrollador full-stack freelance desde 2017. Trabajo
            con <strong class="text-[var(--color-ink)] font-semibold">PyMEs argentinas</strong> de
            e-commerce, servicios profesionales y retail que necesitan presencia
            digital seria o un producto a medida que no encuentran en Shopify, Wix ni WordPress.
          </p>
          <p>
            Lo que entrego <strong class="text-[var(--color-ink)] font-semibold">cobra por proyecto
            con KPI pactado, no por hora</strong>. Mis clientes suelen quedarse entre
            18 y 36 meses derivando colegas. Si después de un año no aprendiste a
            medir tu canal online, fallé.
          </p>
        </div>

        <div class="mt-9 flex flex-col sm:flex-row gap-4 sm:gap-6">
          <a
            href="/sobre-mi"
            class="tactile inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-azul)] border-b border-[var(--color-ink)] hover:border-[var(--color-azul)] pb-1"
          >
            Cómo pienso el trabajo
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/ahora"
            class="tactile inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-azul)] border-b border-[var(--color-ink)] hover:border-[var(--color-azul)] pb-1"
          >
            En qué estoy trabajando
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>