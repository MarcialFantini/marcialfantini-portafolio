---
import site from "../data/site.json";
import sobre from "../data/sobre.json";

// Solo se muestra lo que está cargado en src/data/sobre.json: sin datos, sin bloque.
const datos = sobre.datos.filter((d) => String(d.valor).trim() !== "");
const rubros = sobre.rubros.filter((r: string) => r.trim() !== "");

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";
const perfiles = [
  { k: "LinkedIn", href: site.social.linkedin },
  { k: "GitHub", href: site.social.github },
].filter((p) => p.href);

const compromisos = [
  { t: "Un responsable, no un call center", d: "Hablás con quien diseña y construye tu sistema." },
  { t: "Nada sin propuesta escrita", d: "Alcance, plazos y precio antes de escribir una línea de código." },
  { t: "Lo tuyo es tuyo", d: "Código, datos y accesos quedan a nombre de tu empresa." },
];
---

<section class="relative py-20 md:py-28" aria-labelledby="sobre-title">
  <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-x-12 items-start">
    <!-- Credencial del responsable -->
    <aside class="cred order-2 lg:order-none lg:col-span-5 lg:sticky lg:top-28" aria-label={`${site.name}, responsable de los proyectos`}>
      {
        sobre.foto && (
          <figure class="cred__photo">
            <img src={sobre.foto} alt={`${site.name}`} loading="lazy" decoding="async" />
          </figure>
        )
      }
      <div class="cred__body">
        <p class="cred__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l4 6-10 12L2 9z" /><path d="M2 9h20M9 3 7.5 9 12 21l4.5-12L15 3" /></svg>
          Responsable del proyecto
        </p>
        <p class="cred__name">{site.name}</p>
        <p class="cred__role">{sobre.rol}</p>

        <dl class="cred__rows">
          <div>
            <dt>Base</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt>Contacto directo</dt>
            <dd>
              {whatsappUrl ? (
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
              ) : null}
              {whatsappUrl ? " · " : null}
              <a href={`mailto:${site.email}`}>Email</a>
            </dd>
          </div>
          {
            perfiles.length > 0 && (
              <div>
                <dt>Perfiles</dt>
                <dd>
                  {perfiles.map((p, i) => (
                    <>
                      {i > 0 && " · "}
                      <a href={p.href} target="_blank" rel="noopener noreferrer">
                        {p.k}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </aside>

    <div class="lg:col-span-7">
      <h2 id="sobre-title" class="display-md max-w-[18ch]">
        Tu sistema tiene <span class="display-accent">nombre y apellido.</span>
      </h2>

      <blockquote class="quote">
        <p>“{sobre.frase}”</p>
        <footer>— {site.name}</footer>
      </blockquote>

      {
        datos.length > 0 && (
          <dl class="facts">
            {datos.map((d) => (
              <div>
                <dt>{d.etiqueta}</dt>
                <dd>{d.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        rubros.length > 0 && (
          <p class="rubros">
            <span>Rubros:</span> {rubros.join(" · ")}
          </p>
        )
      }

      <ul class="vows">
        {
          compromisos.map((c) => (
            <li>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </li>
          ))
        }
      </ul>

      <h3 class="stack-t">Con qué construimos</h3>
      <ul class="stack">
        {
          sobre.stack.map((s) => (
            <li>
              <p class="stack__a">{s.area}</p>
              <p class="stack__p">{s.para}</p>
              <p class="stack__tec">
                {s.tec.map((t) => (
                  <span>{t}</span>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- Credencial ---------- */
  .cred {
    border-radius: var(--radius-card);
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 210, 74, 0.7), rgba(232, 241, 255, 0.25) 40%, rgba(255, 210, 74, 0.35));
  }
  .cred__photo { margin: 0; border-radius: 15px 15px 0 0; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-navy-950); }
  .cred__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cred__photo + .cred__body { border-radius: 0 0 15px 15px; }
  .cred__body {
    border-radius: 15px;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background:
      radial-gradient(380px 200px at 100% 0%, rgba(255, 210, 74, 0.08), transparent 70%),
      var(--color-navy-950);
  }
  .cred__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neon);
  }
  .cred__badge svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
  .cred__name {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-ivory);
  }
  .cred__role { margin-top: 0.6rem; color: var(--color-ivory-dim); font-size: 1rem; }
  .cred__rows { margin: 1.75rem 0 0; }
  .cred__rows > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(246, 241, 228, 0.12);
  }
  @media (max-width: 479px) {
    .cred__rows > div { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
  }
  .cred__rows dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #a9aec4; padding-top: 0.15rem; }
  .cred__rows dd { margin: 0; color: var(--color-ivory); }
  .cred__rows a { color: var(--color-ivory); text-decoration: underline; text-decoration-color: rgba(255, 210, 74, 0.5); text-underline-offset: 3px; transition: color 200ms, text-decoration-color 200ms; }
  .cred__rows a:hover { color: var(--color-neon); text-decoration-color: var(--color-neon); }

  /* ---------- Declaración ---------- */
  .quote { margin: 1.75rem 0 0; padding: 0 0 0 1.25rem; border-left: 2px solid var(--color-neon); max-width: 56ch; }
  .quote p { font-size: clamp(1.125rem, 1rem + 0.5vw, 1.35rem); line-height: 1.5; color: var(--color-ivory); text-wrap: pretty; }
  .quote footer { margin-top: 0.75rem; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--color-ivory-dim); }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin: 2.25rem 0 0;
    padding: 1.25rem 0;
    border-block: 1px solid rgba(246, 241, 228, 0.14);
  }
  .facts > div { display: flex; flex-direction: column-reverse; gap: 0.3rem; }
  .facts dd { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem); letter-spacing: -0.04em; line-height: 1; color: var(--color-neon); font-variant-numeric: tabular-nums; }
  .facts dt { font-size: 0.85rem; color: var(--color-ivory-dim); }
  .rubros { margin-top: 1rem; color: var(--color-ivory-dim); }
  .rubros span { color: var(--color-ivory); font-weight: 600; }

  .vows {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) { .vows { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .vows li { padding-top: 1rem; border-top: 1px solid rgba(255, 210, 74, 0.45); }
  .vows h3 { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.015em; line-height: 1.2; color: var(--color-ivory); }
  .vows p { margin-top: 0.4rem; font-size: 0.925rem; line-height: 1.5; color: var(--color-ivory-dim); }

  /* ---------- Stack en idioma de negocio ---------- */
  .stack-t {
    margin-top: 3rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }
  .stack {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stack li {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid rgba(246, 241, 228, 0.12);
    background: rgba(246, 241, 228, 0.03);
    transition: border-color 250ms var(--ease-out-quart);
  }
  .stack li:hover { border-color: rgba(255, 210, 74, 0.45); }
  .stack__a { font-weight: 600; color: var(--color-ivory); }
  .stack__p { margin-top: 0.3rem; font-size: 0.9rem; line-height: 1.45; color: var(--color-ivory-dim); }
  .stack__tec { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .stack__tec span {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: rgba(255, 210, 74, 0.1);
    color: var(--color-neon);
  }
</style>
