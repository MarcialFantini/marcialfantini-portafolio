---
import site from "../data/site.json";
---

<section class="relative py-20 md:py-28 border-b border-[var(--color-border)] overflow-hidden">
  <div class="container-page reveal">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-4 flex flex-col items-start gap-6">
        <div
          class="relative w-36 h-36 md:w-44 md:h-44"
          role="img"
          aria-label="Iniciales MF"
        >
          <div class="absolute inset-0 rounded-control bg-[var(--color-dorado)] translate-x-2 translate-y-2"></div>
          <div class="absolute inset-0 rounded-control bg-[var(--color-azul)] flex items-center justify-center">
            <span class="font-impact text-6xl md:text-7xl text-white leading-none">
              MF
            </span>
          </div>
        </div>
        <div>
          <p class="font-impact text-xl md:text-2xl tracking-tight text-[var(--color-ink)] leading-tight">
            Marcial Fantini
          </p>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mt-1.5">
            Agencia full-stack · Córdoba AR
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">
          Quiénes somos
        </p>

        <h2 class="font-impact text-[clamp(2rem,5vw,3.75rem)] leading-[0.95] text-[var(--color-ink)] max-w-3xl">
          Armamos sitios web para que tu PyME <span class="text-[var(--color-azul)]">consiga más clientes</span> y se haga ver.
        </h2>

        <div class="mt-7 max-w-3xl space-y-5 text-[var(--color-ink-soft)] text-lg leading-relaxed">
          <p>
            Somos {site.name}, una agencia de desarrollo full-stack. Hacemos páginas web,
            páginas empresariales, ecommerce y software a medida para
            <strong class="text-[var(--color-ink)] font-semibold">PyMEs argentinas</strong> que
            necesitan una presencia digital seria.
          </p>
          <p>
            Trabajamos <strong class="text-[var(--color-ink)] font-semibold">por proyecto, con un
            presupuesto claro por escrito</strong> antes de empezar. Hablamos 15 minutos, te pasamos
            una propuesta y entregamos con 2 rondas de revisión.
          </p>
        </div>

        <div class="mt-9 flex flex-col sm:flex-row gap-4 sm:gap-6">
          <a
            href="/sobre-mi"
            class="tactile inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-azul)] border-b border-[var(--color-ink)] hover:border-[var(--color-azul)] pb-1"
          >
            Cómo trabajamos
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>