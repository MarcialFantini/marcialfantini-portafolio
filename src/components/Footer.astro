---
import site from "../data/site.json";
import fotos from "../data/fotos.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
const creditos = Object.values(fotos);

const socials = [
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.github, label: "GitHub" },
  { href: site.social.twitter, label: "X" },
].filter((s) => s.href);

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";

const showRss = await hasPublishedPosts();
const links = [
  { href: "/servicios", label: "Servicios" },
  ...((await hasPublishedProjects()) ? [{ href: "/proyectos", label: "Proyectos" }] : []),
  ...(showRss ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/contacto", label: "Contacto" },
  { href: "/privacidad", label: "Privacidad" },
  ...(showRss ? [{ href: "/rss.xml", label: "RSS" }] : []),
];
---

<footer class="ft">
  <div class="ft__top wrap">
    <div class="ft__contact">
      <p class="soft">Escribinos</p>
      <a href={`mailto:${site.email}`} class="ft__mail">{site.email}</a>
      {whatsappUrl && (
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="ft__wa">WhatsApp</a>
      )}
    </div>

    {site.newsletterEndpoint && (
      <form id="newsletter-form" class="ft__news" data-endpoint={site.newsletterEndpoint} aria-label="Newsletter mensual">
        <p class="soft">Un email por mes con lo que aprendimos. Te das de baja cuando quieras.</p>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
        <div class="ft__field">
          <label class="sr-only" for="newsletter-email">Tu email</label>
          <input type="email" id="newsletter-email" name="email" required autocomplete="email" placeholder="tu@email.com" />
          <button type="submit" >Suscribirme</button>
        </div>
        <p id="newsletter-msg" class="ft__msg" role="status" aria-live="polite" hidden></p>
      </form>
    )}

    <nav class="ft__links" aria-label="Pie de página">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
    </nav>
  </div>

  <p class="ft__name" aria-hidden="true" data-footer-name>Fantini</p>
  <p class="ft__legal wrap soft">© {year} {site.name}, {site.location}</p>
  {isHome && (
    <p class="ft__credits wrap soft">
      {creditos.length > 1 ? "Fotografías:" : "Fotografía:"}{" "}
      {creditos.map((f, i) => (
        <>
          <a href={f.url} target="_blank" rel="noopener noreferrer">{f.autor}</a> ({f.licencia}, Wikimedia Commons){i < creditos.length - 1 ? ", " : "."}
        </>
      ))}
    </p>
  )}
</footer>

<script>
  function bindNewsletter() {
    const form = document.getElementById("newsletter-form");
    const msg = document.getElementById("newsletter-msg");
    const input = document.getElementById("newsletter-email") as HTMLInputElement | null;
    if (!form || !msg || !input || form.dataset.bound) return;
    form.dataset.bound = "1";
    const endpoint = form.getAttribute("data-endpoint");
    if (!endpoint) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    const show = (text: string) => {
      msg.textContent = text;
      msg.hidden = false;
    };
    try {
      if (localStorage.getItem("mf-newsletter-subscribed") === "1") show("Ya estás suscripto. Gracias.");
    } catch {}
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email || (honeypot && honeypot.value)) return;
      if (button) button.disabled = true;
      show("Enviando…");
      try {
        // Apps Script no devuelve CORS: no-cors envía el POST y la respuesta es opaca.
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ email, source: location.pathname }),
        });
        try {
          localStorage.setItem("mf-newsletter-subscribed", "1");
        } catch {}
        show("Listo, te anotamos.");
        input.value = "";
      } catch {
        show("No pudimos anotarte. Probá de nuevo en un rato.");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
  document.addEventListener("astro:page-load", bindNewsletter);
</script>

<style>
  .ft {
    margin-top: var(--section-gap);
    background: var(--color-surface);
    overflow: hidden;
  }
  .ft__top {
    display: grid;
    gap: 3rem;
    padding-block: 5rem 3rem;
  }
  @media (min-width: 900px) {
    .ft__top { grid-template-columns: 1fr 1fr; column-gap: 4rem; }
    .ft__links { grid-column: 1 / -1; }
  }
  .ft__contact p, .ft__news > p { font-size: var(--step-small); margin-bottom: 0.75rem; }
  .ft__mail {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--step-statement);
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-decoration: none;
    word-break: break-all;
  }
  .ft__wa { display: inline-flex; align-items: center; min-height: 2.75rem; margin-top: 0.5rem; }

  .ft__field { display: flex; max-width: 28rem; background: var(--color-surface-2); }
  .ft__field input {
    flex: 1;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 1rem;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font: inherit;
  }
  .ft__field input:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent); } /* taste-skill-ignore: focus ring */
  .ft__field button {
    padding-inline: 1.25rem;
    font-weight: 500;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: 0;
    font-size: var(--step-small);
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-quart);
  }
  .ft__field button:hover { background: var(--color-accent-hi); }
  .ft__msg { margin-top: 0.75rem; font-size: var(--step-small); }

  .ft__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .ft__links a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; }

  .ft__name {
    font-family: var(--font-serif);
    font-size: clamp(6rem, 29vw, 30rem);
    line-height: 0.78;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: var(--color-fg);
    margin: 0 0 0 -0.04em;
    transform-origin: 0 100%;
  }
  .ft__legal { font-size: var(--step-small); padding-block: 1.5rem 2rem; }
  .ft__credits { font-size: var(--step-small); padding-bottom: 2rem; margin-top: -1rem; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The name settles as the page ends */
      .ft__name { animation: name-settle linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }
      @keyframes name-settle { from { transform: translateY(18%) scale(0.94); opacity: 0.4; } to { transform: none; opacity: 1; } }
    }
  }

</style>
