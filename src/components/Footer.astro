---
/* Footer: quiet chrome on one surface step.
   Who and how to reach me on the left, the site and the elsewhere links in two short columns,
   the newsletter on its own band, and a single legal line. Same column width as .wrap. */
import site from "../data/site.json";
import fotos from "../data/fotos.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
const creditos = Object.values(fotos);

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";

const showPosts = await hasPublishedPosts();
const sitio = [
  { href: "/servicios", label: "Servicios" },
  ...((await hasPublishedProjects()) ? [{ href: "/proyectos", label: "Proyectos demo" }] : []),
  ...(showPosts ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/contacto", label: "Contacto" },
];

const afuera = [
  { href: site.social.linkedin, label: "LinkedIn", ext: true },
  { href: site.social.github, label: "GitHub", ext: true },
  { href: site.social.twitter, label: "X", ext: true },
  ...(showPosts ? [{ href: "/rss.xml", label: "RSS", ext: false }] : []),
].filter((s) => s.href);
---

<footer class="ft">
  <div class="ft__main wrap">
    <div class="ft__who">
      <p class="ft__name">{site.name}</p>
      <p class="ft__tag soft">{site.tagline}</p>
      <a href={`mailto:${site.email}`} class="ft__mail">{site.email}</a>
      {whatsappUrl && (
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="ft__wa">Escribime por WhatsApp</a>
      )}
    </div>

    <nav class="ft__col" aria-labelledby="ft-sitio">
      <p id="ft-sitio" class="ft__label soft">Sitio</p>
      <ul>
        {sitio.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="ft__col" aria-labelledby="ft-afuera">
      <p id="ft-afuera" class="ft__label soft">En otros lados</p>
      <ul>
        {afuera.map((s) => (
          <li>
            <a href={s.href} target={s.ext ? "_blank" : undefined} rel={s.ext ? "noopener noreferrer" : undefined}>{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {site.newsletterEndpoint && (
    <div class="ft__band">
      <form id="newsletter-form" class="ft__news wrap" data-endpoint={site.newsletterEndpoint} aria-label="Newsletter mensual">
        <div class="ft__news-text">
          <p class="ft__news-h">Un email por mes</p>
          <p class="soft">Lo que aprendí armando sistemas. Te das de baja cuando quieras.</p>
        </div>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
        <div class="ft__news-side">
          <div class="ft__field">
            <label class="sr-only" for="newsletter-email">Tu email</label>
            <input type="email" id="newsletter-email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            <button type="submit">Suscribirme</button>
          </div>
          <p id="newsletter-msg" class="ft__msg" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>
  )}

  <div class="ft__legal wrap soft">
    <p>© {year} {site.name} · {site.location}</p>
    <p><a href="/privacidad">Privacidad</a></p>
    {isHome && (
      <p class="ft__credits">
        {creditos.length > 1 ? "Fotografías:" : "Fotografía:"}{" "}
        {creditos.map((f, i) => (
          <>
            <a href={f.url} target="_blank" rel="noopener noreferrer">{f.autor}</a> ({f.licencia}, Wikimedia Commons){i < creditos.length - 1 ? ", " : ""}
          </>
        ))}
      </p>
    )}
  </div>
</footer>

<script>
  function bindNewsletter() {
    const form = document.getElementById("newsletter-form");
    const msg = document.getElementById("newsletter-msg");
    const input = document.getElementById("newsletter-email") as HTMLInputElement | null;
    if (!form || !msg || !input || form.dataset.bound) return;
    form.dataset.bound = "1";
    const endpoint = form.getAttribute("data-endpoint");
    if (!endpoint) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    const show = (text: string) => {
      msg.textContent = text;
      msg.hidden = false;
    };
    try {
      if (localStorage.getItem("mf-newsletter-subscribed") === "1") show("Ya estás suscripto. Gracias.");
    } catch {}
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email || (honeypot && honeypot.value)) return;
      if (button) button.disabled = true;
      show("Enviando…");
      try {
        // Apps Script no devuelve CORS: no-cors envía el POST y la respuesta es opaca.
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ email, source: location.pathname }),
        });
        try {
          localStorage.setItem("mf-newsletter-subscribed", "1");
        } catch {}
        show("Listo, te anoté.");
        input.value = "";
      } catch {
        show("No pude anotarte. Probá de nuevo en un rato.");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
  document.addEventListener("astro:page-load", bindNewsletter);
</script>

<style>
  .ft {
    margin-top: var(--section-gap);
    background: var(--color-surface);
    font-size: var(--step-small);
  }

  /* Who, then two short link columns */
  .ft__main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    padding-block: 4rem 3rem;
  }
  .ft__who { grid-column: 1 / -1; display: grid; justify-items: start; gap: 0.5rem; }
  @media (min-width: 900px) {
    .ft__main { grid-template-columns: minmax(0, 6fr) minmax(0, 3fr) minmax(0, 3fr); column-gap: 3rem; }
    .ft__who { grid-column: auto; }
  }

  .ft__name {
    font-family: var(--font-display);
    font-size: var(--step-statement);
    font-weight: 500;
    line-height: 1;
    color: var(--color-fg);
  }
  .ft__tag { max-width: 36ch; font-size: var(--step-body); margin-bottom: 1rem; }
  .ft__mail {
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 160ms var(--ease-out-quart);
  }
  .ft__mail:hover { color: var(--color-accent-hi); }
  .ft__wa { display: inline-flex; align-items: center; min-height: 2.75rem; }

  .ft__label { margin-bottom: 0.75rem; }
  .ft__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .ft__col a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: var(--step-body);
    text-decoration: none;
    transition: color 160ms var(--ease-out-quart);
  }
  .ft__col a:hover { color: var(--color-accent-hi); }

  /* Newsletter on its own band, one surface step up */
  .ft__band { background: var(--color-surface-2); }
  .ft__news {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .ft__news { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); column-gap: 3rem; }
  }
  .ft__news-h { font-family: var(--font-display); font-size: var(--step-lead); font-weight: 500; line-height: 1.1; color: var(--color-fg); margin-bottom: 0.25rem; }
  .ft__news-side { min-width: 0; }
  .ft__field { display: flex; max-width: 32rem; background: var(--color-bg); }
  .ft__field input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1rem;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font: inherit;
    font-size: var(--step-body);
  }
  .ft__field input::placeholder { color: var(--color-placeholder); }
  .ft__field input:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent); } /* taste-skill-ignore: focus ring */
  .ft__field button {
    flex: none;
    padding-inline: 1.25rem;
    font: inherit;
    font-weight: 500;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: 0;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-quart), transform 160ms var(--ease-out-quart);
  }
  .ft__field button:hover { background: var(--color-accent-hi); }
  .ft__field button:active { transform: scale(0.97); }
  .ft__field button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .ft__msg { margin-top: 0.75rem; }

  /* One quiet legal line */
  .ft__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 2rem;
  }
  .ft__legal a { display: inline-block; padding-block: 0.25rem; }
  .ft__credits { flex-basis: 100%; }
  @media (min-width: 900px) {
    .ft__credits { flex-basis: auto; margin-left: auto; }
  }
</style>
