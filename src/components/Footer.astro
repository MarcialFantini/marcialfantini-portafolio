---
import site from "../data/site.json";

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: "GitHub" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.twitter, label: "Twitter" },
  { href: `mailto:${site.email}`, label: "Email" },
];

const links = [
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<footer class="relative bg-[var(--color-ink)] text-[var(--color-blanco-humo)] overflow-hidden">
  <div class="container-page py-14 md:py-20">
    <div class="mb-10 md:mb-14 reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-azul)] mb-3">
        {site.location} · {year}
      </p>
      <a
        href="/"
        class="block font-impact uppercase leading-[0.85] tracking-[-0.03em] text-[var(--color-blanco-humo)] hover:text-[var(--color-azul)] transition-colors text-[clamp(3rem,12vw,9rem)]"
        aria-label={`${site.name} — ir al inicio`}
      >
        Marcial Fantini
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-[2fr_1fr_1fr_1fr] gap-10 md:gap-8 mb-12">
      <div class="col-span-2 md:col-span-1 max-w-md">
        <p class="text-sm text-[var(--color-blanco-humo)]/80 leading-relaxed">
          {site.description}
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-5 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-[var(--color-azul)] hover:text-[var(--color-blanco-humo)]"
        >
          {site.email} <span aria-hidden="true">→</span>
        </a>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-4">
          Navegación
        </p>
        <ul class="space-y-2.5 text-sm">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tactile text-[var(--color-blanco-humo)]/85 hover:text-[var(--color-azul)] font-medium">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-4">
          Conectá
        </p>
        <ul class="space-y-2.5 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  class="tactile text-[var(--color-blanco-humo)]/85 hover:text-[var(--color-azul)] font-medium inline-flex items-center gap-1"
                >
                  {s.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-4">
          Stack
        </p>
        <p class="font-mono text-sm text-[var(--color-blanco-humo)]/80 leading-relaxed">
          Astro · TypeScript<br />
          Tailwind v4 · Vercel
        </p>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--color-blanco-humo)]/15 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
        © {year} {site.name} · Córdoba, Argentina
      </p>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
        Hecho en casa · Sin frameworks de moda
      </p>
    </div>
  </div>
</footer>