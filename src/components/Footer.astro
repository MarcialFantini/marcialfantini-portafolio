---
import site from "../data/site.json";

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: "GitHub" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.twitter, label: "Twitter" },
  { href: `mailto:${site.email}`, label: "Email" },
];

const links = [
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<footer class="relative border-t-[8px] border-[var(--color-ink)] mt-24 bg-[var(--color-azul)] text-[var(--color-ink)] overflow-hidden isolate">
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <div
      class="brush-stroke brush-stroke-1"
      style="top: 12%; right: -4%; transform: rotate(4deg);"
    ></div>
  </div>

  <div class="container-page py-14 md:py-16 relative z-[1]">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-12 md:gap-10 mb-14">
      <div class="max-w-md">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group">
          <span class="tactile inline-flex items-center justify-center w-10 h-10 rounded-md bg-[var(--color-ink)] text-[var(--color-azul)] font-impact text-base uppercase tracking-wide group-hover:bg-[var(--color-azul)] group-hover:text-[var(--color-ink)] border-2 border-[var(--color-ink)]">
            MF
          </span>
          <span class="font-impact text-[clamp(1.5rem,2.5vw,2.25rem)] uppercase leading-none tracking-tight text-[var(--color-ink)]">
            {site.name}
          </span>
        </a>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          {site.description}
        </p>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-ink)] mb-4">
          Navegación
        </p>
        <ul class="space-y-2.5 text-sm">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tactile text-[var(--color-ink)]/80 hover:text-[var(--color-ink)] font-medium">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-ink)] mb-4">
          Conectá
        </p>
        <ul class="space-y-2.5 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  class="tactile text-[var(--color-ink)]/80 hover:text-[var(--color-ink)] font-medium inline-flex items-center gap-1"
                >
                  {s.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t-2 border-[var(--color-ink)] flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="text-xs text-[var(--color-ink)] font-mono font-semibold">
        © {year} {site.name} · Córdoba, Argentina
      </p>
      <p class="text-xs text-[var(--color-ink)] font-mono font-semibold">
        Astro · TypeScript · Tailwind v4
      </p>
    </div>
  </div>
</footer>
