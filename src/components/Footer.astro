---
import site from "../data/site.json";

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: "GitHub" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.twitter, label: "Twitter" },
  { href: `mailto:${site.email}`, label: "Email" },
];

const links = [
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<footer class="border-t border-[var(--color-border)] mt-24 bg-[var(--color-blanco-humo)]">
  <div class="container-page py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-12 md:gap-10 mb-14">
      <div class="max-w-md">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group">
          <span class="tactile inline-flex items-center justify-center w-9 h-9 rounded-md bg-[var(--color-ink)] text-[var(--color-blanco)] font-display font-bold text-sm group-hover:bg-[var(--color-azul)]">
            MF
          </span>
          <span class="font-display font-semibold tracking-tight text-[var(--color-ink)]">
            {site.name}
          </span>
        </a>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          {site.description}
        </p>
      </div>

      <div>
        <ul class="space-y-2.5 text-sm">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tactile text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <ul class="space-y-2.5 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  class="tactile text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] inline-flex items-center gap-1"
                >
                  {s.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--color-border)] flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="text-xs text-[var(--color-mute)] font-mono">
        © {year} {site.name} · Córdoba, Argentina
      </p>
      <p class="text-xs text-[var(--color-mute)] font-mono">
        Astro · TypeScript · Tailwind v4
      </p>
    </div>
  </div>
</footer>
