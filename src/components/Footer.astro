---
import site from "../data/site.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: "GitHub" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.twitter, label: "X" },
  { href: `mailto:${site.email}`, label: "Email" },
];

const links = [
  { href: "/servicios", label: "Servicios" },
  { href: "/sobre-mi", label: "Nosotros" },
  ...((await hasPublishedProjects()) ? [{ href: "/proyectos", label: "Proyectos" }] : []),
  ...((await hasPublishedPosts()) ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/contacto", label: "Contacto" },
  { href: "/privacidad", label: "Privacidad" },
];

const resourceLinks = [
  ...((await hasPublishedPosts()) ? [{ href: "/rss.xml", label: "RSS" }] : []),
];
---

<footer class="relative bg-[var(--color-ink)] text-[var(--color-blanco-humo)] overflow-hidden">
  <div class="container-page py-14 md:py-20">
    <div class="mb-10 md:mb-14 reveal grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-10 items-end">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
          {site.location} · {year}
        </p>
        <a
          href="/"
          class="block font-impact leading-[0.9] tracking-[-0.04em] text-white hover:text-[var(--color-dorado)] transition-colors text-[clamp(2.5rem,10vw,7rem)]"
          aria-label={`${site.name} — ir al inicio`}
        >
          {site.name}
        </a>
        <p class="mt-4 max-w-md text-sm text-white/70 leading-relaxed">
          {site.description}
        </p>
      </div>

      {site.newsletterEndpoint && (
      <form
        id="newsletter-form"
        data-endpoint={site.newsletterEndpoint}
        class="rounded-lg bg-[var(--color-azul-deep)] p-6 md:p-7 border border-white/10"
        aria-label="Newsletter — recibí un email mensual con lo que aprendimos"
      >
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-2">
          Newsletter mensual
        </p>
        <h2 class="font-impact text-2xl md:text-3xl uppercase leading-[0.95] text-white mb-2">
          Lo que aprendimos este mes.
        </h2>
        <p class="text-sm text-white/70 mb-5 leading-relaxed">
          Un email por mes con novedades y consejos para tu sitio. Te podés dar de baja cuando quieras.
        </p>
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />
        <div class="flex flex-col sm:flex-row gap-2">
          <label class="sr-only" for="newsletter-email">Tu email</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@email.com"
            class="flex-1 min-w-0 px-4 py-3 rounded-md bg-white/95 text-[var(--color-ink)] placeholder:text-[var(--color-mute)] focus:outline-none focus:ring-2 focus:ring-[var(--color-dorado)]"
          />
          <button
            type="submit"
            class="tactile px-5 py-3 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white"
          >
            Suscribirme
          </button>
        </div>
        <p
          id="newsletter-msg"
          class="hidden mt-3 text-sm text-[var(--color-dorado)] font-mono uppercase tracking-[0.18em]"
          role="status"
          aria-live="polite"
        >
        </p>
        <p class="mt-3 text-xs text-white/60 leading-relaxed">
          Usamos tu email solo para el newsletter. Más en nuestra
          <a href="/privacidad" class="underline hover:text-[var(--color-dorado)]">política de privacidad</a>.
        </p>
      </form>
      )}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-[2fr_1fr_1fr_1fr] gap-10 md:gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55 mb-3">
          Contacto
        </p>
        <a
          href={`mailto:${site.email}`}
          class="tactile font-mono text-sm text-[var(--color-dorado)] hover:text-white font-semibold inline-flex items-center gap-1.5 break-all"
        >
          {site.email} <span aria-hidden="true">→</span>
        </a>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55 mb-4">
          Navegación
        </p>
        <ul class="space-y-2 text-sm">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tactile text-white/80 hover:text-[var(--color-dorado)] font-medium">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        resourceLinks.length > 0 && (
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55 mb-4">
          Recursos
        </p>
        <ul class="space-y-2 text-sm">
          {
            resourceLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tactile text-white/80 hover:text-[var(--color-dorado)] font-medium">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
        )
      }

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55 mb-4">
          Conectá
        </p>
        <ul class="space-y-2 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  class="tactile text-white/80 hover:text-[var(--color-dorado)] font-medium inline-flex items-center gap-1"
                >
                  {s.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-white/15 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55">
        © {year} {site.name} · Córdoba, Argentina
      </p>
    </div>
  </div>
</footer>

<script>
  (function () {
    const form = document.getElementById('newsletter-form');
    const msg = document.getElementById('newsletter-msg');
    const input = document.getElementById('newsletter-email') as HTMLInputElement | null;
    if (!form || !msg || !input) return;

    const endpoint = form.getAttribute('data-endpoint');
    if (!endpoint) return;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const honeypot = form.querySelector('input[name="website"]') as HTMLInputElement | null;

    const show = (text: string) => {
      msg.textContent = text;
      msg.classList.remove('hidden');
    };

    try {
      if (localStorage.getItem('mf-newsletter-subscribed') === '1') {
        show('Ya estás suscripto. Gracias.');
      }
    } catch {}

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email || (honeypot && honeypot.value)) return;
      if (button) button.disabled = true;
      show('Enviando…');
      try {
        // Apps Script no devuelve CORS: no-cors envía el POST y la respuesta es opaca.
        // Solo un fallo de red cae en catch; el éxito real se confirma en la hoja.
        await fetch(endpoint, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ email, source: location.pathname }),
        });
        try {
          localStorage.setItem('mf-newsletter-subscribed', '1');
        } catch {}
        show('¡Listo! Te anotamos.');
        input.value = '';
      } catch {
        show('No pudimos anotarte. Probá de nuevo en un rato.');
      } finally {
        if (button) button.disabled = false;
      }
    });
  })();
</script>