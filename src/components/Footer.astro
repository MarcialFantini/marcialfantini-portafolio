---
import site from "../data/site.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: "GitHub" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.twitter, label: "X" },
];

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";

const links = [
  { href: "/servicios", label: "Servicios" },
  { href: "/sobre-mi", label: "Nosotros" },
  ...((await hasPublishedProjects()) ? [{ href: "/proyectos", label: "Proyectos" }] : []),
  ...((await hasPublishedPosts()) ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/contacto", label: "Contacto" },
  { href: "/privacidad", label: "Privacidad" },
];

const resourceLinks = [
  ...((await hasPublishedPosts()) ? [{ href: "/rss.xml", label: "RSS" }] : []),
];
---

<footer class="site-footer surface-night relative overflow-hidden">
  <div class="container-page pt-14 md:pt-20">
    <nav aria-label="Pie de página" class="flex flex-wrap gap-x-7 gap-y-1 pb-6 border-b border-[var(--color-hair)]">
      {
        [...links, ...resourceLinks].map((l) => (
          <a href={l.href} class="tactile footer-link">{l.label}</a>
        ))
      }
    </nav>

    <div class="sd-reveal grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 py-10 md:py-14">
      <div>
        <p class="field-label">Contacto</p>
        <a
          href={`mailto:${site.email}`}
          class="tactile block py-1 font-display text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-ink)] hover:text-[var(--color-dorado)] break-all"
        >
          {site.email}
        </a>
        {whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile mt-1 inline-flex min-h-11 items-center gap-1.5 font-mono text-[12px] uppercase tracking-[0.16em] text-[var(--color-ink-soft)] hover:text-[var(--color-dorado)]"
          >
            WhatsApp <span aria-hidden="true">↗</span>
          </a>
        )}
        <p class="mt-3 max-w-sm text-sm text-[var(--color-ink-soft)] leading-relaxed">{site.description}</p>
      </div>

      {site.newsletterEndpoint && (
      <form
        id="newsletter-form"
        data-endpoint={site.newsletterEndpoint}
        aria-label="Newsletter — recibí un email mensual con lo que aprendimos"
      >
        <p class="field-label">Newsletter mensual</p>
        <p class="text-sm text-[var(--color-ink-soft)] mb-2 leading-relaxed">
          Un email por mes con lo que aprendimos. Te podés dar de baja cuando quieras.
        </p>
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />
        <div class="footer-news">
          <label class="sr-only" for="newsletter-email">Tu email</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@email.com"
          />
          <button type="submit" class="tactile" aria-label="Suscribirme al newsletter">
            <span aria-hidden="true">→</span>
          </button>
        </div>
        <p
          id="newsletter-msg"
          class="hidden mt-3 text-sm text-[var(--color-dorado)] font-mono uppercase tracking-[0.18em]"
          role="status"
          aria-live="polite"
        >
        </p>
        <p class="mt-3 text-xs text-[var(--color-ink-soft)] leading-relaxed">
          Usamos tu email solo para el newsletter. Más en nuestra
          <a href="/privacidad" class="underline underline-offset-2 hover:text-[var(--color-dorado)]">política de privacidad</a>.
        </p>
      </form>
      )}
    </div>

    <div class="py-5 border-t border-[var(--color-hair)] flex flex-col md:flex-row md:items-center justify-between gap-1">
      <ul class="flex flex-wrap gap-x-6">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel="noopener noreferrer"
                target="_blank"
                class="tactile footer-link"
              >
                {s.label}<span aria-hidden="true" class="ml-1">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-mute)]">
        © {year} {site.name} · Córdoba, Argentina
      </p>
    </div>
  </div>

  <p class="footer-mark sd-reveal" aria-hidden="true">
    <span>Marcial</span>
    <span>Fantini</span>
  </p>
</footer>

<script>
  (function () {
    const form = document.getElementById('newsletter-form');
    const msg = document.getElementById('newsletter-msg');
    const input = document.getElementById('newsletter-email') as HTMLInputElement | null;
    if (!form || !msg || !input) return;

    const endpoint = form.getAttribute('data-endpoint');
    if (!endpoint) return;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const honeypot = form.querySelector('input[name="website"]') as HTMLInputElement | null;

    const show = (text: string) => {
      msg.textContent = text;
      msg.classList.remove('hidden');
    };

    try {
      if (localStorage.getItem('mf-newsletter-subscribed') === '1') {
        show('Ya estás suscripto. Gracias.');
      }
    } catch {}

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email || (honeypot && honeypot.value)) return;
      if (button) button.disabled = true;
      show('Enviando…');
      try {
        // Apps Script no devuelve CORS: no-cors envía el POST y la respuesta es opaca.
        // Solo un fallo de red cae en catch; el éxito real se confirma en la hoja.
        await fetch(endpoint, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ email, source: location.pathname }),
        });
        try {
          localStorage.setItem('mf-newsletter-subscribed', '1');
        } catch {}
        show('¡Listo! Te anotamos.');
        input.value = '';
      } catch {
        show('No pudimos anotarte. Probá de nuevo en un rato.');
      } finally {
        if (button) button.disabled = false;
      }
    });
  })();
</script>