---
import site from "../../data/site.json";
import SceneDudas from "../robots/scenes/SceneDudas.astro";

const faqs = [
  {
    q: "¿Cuánto cuesta?",
    a: "Depende del problema. Después de la primera charla te pasamos un precio cerrado, por escrito.",
  },
  {
    q: "¿Cuánto tarda?",
    a: "La primera parte la usás en pocas semanas. El resto se suma por etapas.",
  },
  {
    q: "¿Mi equipo va a saber usarlo?",
    a: "Sí. Lo armamos según cómo ya trabajan, y les enseñamos a usarlo.",
  },
  {
    q: "¿Funciona con lo que ya uso?",
    a: "Casi siempre: Excel, WhatsApp, tu tienda online y tu facturación.",
  },
];

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "/contacto";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<section id="dudas" class="dudas wrap" aria-labelledby="dudas-title">
  <div class="dudas__side">
    <h2 id="dudas-title" class="dudas__h" data-split>Preguntas frecuentes</h2>
    <SceneDudas class="dudas__crew" />
  </div>

  <div class="dudas__text">
    {
      faqs.map((f, i) => (
        <p data-rise style={`--i:${i % 4}`}>
          <strong>{f.q}</strong> {f.a}
        </p>
      ))
    }
    <p class="dudas__more" data-rise>
      ¿Otra duda?{" "}
      <a href={whatsappUrl} target={site.whatsapp ? "_blank" : undefined} rel={site.whatsapp ? "noopener noreferrer" : undefined}>
        Escribinos por WhatsApp
      </a>.
    </p>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</section>

<style>
  .dudas {
    margin-top: var(--section-gap);
    display: grid;
    gap: 2.5rem;
  }
  :global(.dudas__crew) { width: min(100%, 20rem); margin-top: 2rem; }
  .dudas__text p {
    font-size: var(--step-body);
    line-height: 1.55;
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }
  .dudas__text strong { font-weight: 500; }

  @media (min-width: 1024px) {
    .dudas { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .dudas__side { grid-column: 1 / span 4; align-self: start; }
    .dudas__text { grid-column: 5 / -1; columns: 2; column-gap: 3.5rem; }
  }
</style>
