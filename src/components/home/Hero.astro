---
/* Hero: one promise, one action, and the product floating over the robot crew's floor.
   The orders panel is an illustrative example, labelled as such. */
import SceneHero from "../robots/scenes/SceneHero.astro";

const pedidos = [
  { n: "Pedido 1042", d: "12 cajas", e: "Nuevo", tone: "new" },
  { n: "Pedido 1041", d: "3 bultos", e: "En preparación", tone: "mid" },
  { n: "Pedido 1040", d: "8 cajas", e: "Despachado", tone: "mid" },
  { n: "Pedido 1039", d: "1 caja", e: "Entregado", tone: "ok" },
];

const tabs = [
  { href: "#conectar", t: "Conectar" },
  { href: "#crear", t: "Crear" },
  { href: "#informar", t: "Informar" },
  { href: "#respaldar", t: "Respaldar" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero__sky" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="hero-dots" width="24" height="24" patternUnits="userSpaceOnUse">
        <rect x="11" y="11" width="2" height="2" class="hero__dot" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-dots)" />
  </svg>

  <div class="hero__copy wrap">
    <h1 id="hero-title" class="hero__title" data-rise>Tu negocio ya funciona.<br /> Lo hago funcionar mejor.</h1>
    <p class="hero__lead" data-rise style="--i:1">Conecto lo que ya usás, creo lo que falta, te muestro los números y dejo todo respaldado. Me adapto a cómo trabajan, no al revés.</p>
    <div class="hero__actions" data-rise style="--i:2">
      <a href="/contacto?servicio=Diagn%C3%B3stico%20gratis" class="btn">Contame tu problema</a>
      <a href="#conectar" class="hero__ghost">Ver cómo funciona</a>
    </div>
    <p class="hero__note soft" data-rise style="--i:3">La primera charla es gratis y dura 30 minutos.</p>
  </div>

  <div class="hero__stage wrap" data-rise style="--i:2">
    <div class="hero__floor">
    <figure class="hero__panel" aria-label="Ejemplo de pantalla: pedidos del día con su estado" data-orders>
      <figcaption class="hero__cap">
        <span>Pedidos de hoy</span>
        <span class="soft">Ejemplo</span>
      </figcaption>
      <ul class="hero__rows" aria-live="off">
        {
          pedidos.map((p) => (
            <li>
              <span class="hero__pn">{p.n}</span>
              <span class="soft">{p.d}</span>
              <span class:list={["hero__state", `hero__state--${p.tone}`]}>{p.e}</span>
            </li>
          ))
        }
      </ul>
    </figure>
    <SceneHero class="hero__crew" />
    </div>

    <nav class="hero__tabs" aria-label="Qué hago">
      {tabs.map((t) => <a href={t.href}>{t.t}</a>)}
    </nav>
  </div>

</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(3rem, 6vw, 5rem);
    text-align: center;
  }
  .hero__sky { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .hero__dot { fill: var(--color-grid); }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.75rem, 1.4rem + 5vw, 6.5rem);
    line-height: 0.95;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .hero__lead { font-size: var(--step-lead); line-height: 1.3; max-width: 32ch; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.5rem; margin-top: 0.5rem; }
  .hero__ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 0.25rem;
    font-weight: 500;
  }
  .hero__note { font-size: var(--step-small); }

  .hero__stage {
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: clamp(2rem, 5vh, 3.5rem) auto 0;
    text-align: left;
  }
  /* Panel and crew share one floor: the crew works beside the orders it moves. */
  .hero__floor { display: grid; gap: 1rem; align-items: end; }
  @media (min-width: 1024px) {
    .hero__floor { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 2rem; }
  }
  .hero__panel {
    margin: 0;
    background: var(--color-surface);
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }
  .hero__cap { display: flex; justify-content: space-between; gap: 1rem; font-weight: 500; margin-bottom: 1rem; }
  .hero__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hero__rows li {
    display: grid;
    transition: background-color 400ms var(--ease-out-quart);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-surface-2);
    font-size: var(--step-small);
  }
  .hero__rows li > .soft { grid-row: 2; }
  .hero__rows .hero__state { grid-row: 1 / span 2; grid-column: 2; }
  @media (min-width: 640px) {
    .hero__rows li { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto; }
    .hero__rows li > .soft, .hero__rows .hero__state { grid-row: auto; grid-column: auto; }
  }
  .hero__pn { font-weight: 500; }
  .hero__rows li.is-fresh { background: var(--color-accent-deep); }
  .hero__state { padding: 0.25rem 0.5rem; background: var(--color-bg); color: var(--color-soft); white-space: nowrap; }
  .hero__state--new { background: var(--color-accent); color: var(--color-accent-ink); }
  .hero__state--ok { color: var(--color-ok); }

  :global(.hero__crew) { width: 100%; justify-self: stretch; overflow: hidden; }
  :global(.hero__crew > svg) { overflow: hidden; }
  @media (max-width: 1023px) { :global(.hero__crew) { order: -1; max-width: 22rem; } }

  .hero__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 1.5rem;
  }
  .hero__tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    background: var(--color-surface);
    font-size: var(--step-small);
    text-decoration: none;
    transition: background-color 180ms var(--ease-out-quart), color 180ms var(--ease-out-quart);
  }
  .hero__tabs a:hover { background: var(--color-surface-2); color: var(--color-fg); }
  .hero__tabs a:active { background: var(--color-accent); color: var(--color-accent-ink); }

</style>
