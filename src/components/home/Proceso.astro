---
/* "Cómo trabajamos" as one production line: a single floor, three stations,
   and an AGV carrying the project from station to station. Each step's text sits under its station.
   Station plates light up while the AGV is parked at them (same 12 s clock, opacity only). */
import Agv from "../robots/Agv.astro";
import Cobot from "../robots/Cobot.astro";

const pasos = [
  { t: "Me contás el problema.", d: "Una charla de 30 minutos, gratis." },
  { t: "Te paso un precio cerrado.", d: "Por escrito y por etapas. Sin sorpresas." },
  { t: "Lo usás desde la primera etapa.", d: "Te enseño a usarlo y queda a tu nombre." },
];
const estaciones = [200, 600, 1000];
---

<section id="como-trabajamos" class="proceso wrap" aria-labelledby="proceso-title">
  <div class="proceso__head">
    <h2 id="proceso-title" data-split>Cómo trabajo</h2>
    <p class="proceso__lead soft" data-rise>De la primera charla al sistema en uso, en tres pasos.</p>
  </div>

  <div class="rbs linea" data-rb aria-hidden="true">
    <svg viewBox="0 0 1200 240" focusable="false">
      <rect x="0" y="220" width="1200" height="8" class="r-floor" />

      {estaciones.map((x, i) => (
        <g>
          <rect x={x - 3} y="62" width="6" height="158" class="ln-post" />
          <rect x={x - 22} y="22" width="44" height="44" class="ln-plate" />
          <rect x={x - 22} y="22" width="44" height="44" class:list={["r-acc", "ln-on", `ln-on--${i + 1}`]} />
          <text x={x} y="52" text-anchor="middle" class="ln-n">{i + 1}</text>
        </g>
      ))}

      <!-- Station 1: the conversation -->
      <rect x="222" y="84" width="74" height="48" class="ln-sign" />
      <rect x="234" y="98" width="50" height="5" class="r-dark" />
      <rect x="234" y="110" width="34" height="5" class="r-dark" />
      <rect x="222" y="132" width="12" height="10" class="ln-sign" />

      <!-- Station 2: the written quote -->
      <rect x="622" y="72" width="62" height="70" class="ln-sign" />
      <rect x="634" y="84" width="38" height="5" class="r-dark" />
      <rect x="634" y="96" width="38" height="5" class="r-dark" />
      <rect x="634" y="108" width="24" height="5" class="r-dark" />
      <rect x="634" y="124" width="38" height="10" class="r-acc" />

      <!-- Station 3: the system in use, the cobot stacks what arrives -->
      <g class="ln-cobot"><Cobot x={1062} y={80} /></g>
      <rect x="1166" y="196" width="24" height="24" class="r-acc" />
      <rect x="1166" y="172" width="24" height="24" class="r-acc ln-stack" />

      <g class="ln-agv">
        <Agv x={0} y={160}><rect x="46" y="-10" width="28" height="28" class="r-acc" /></Agv>
      </g>
    </svg>
  </div>

  <ol class="proceso__list">
    {
      pasos.map((p, i) => (
        <li class="paso" data-rise style={`--i:${i}`}>
          <span class="paso__n">{i + 1}</span>
          <h3 class="paso__t">{p.t}</h3>
          <p class="paso__d soft">{p.d}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .proceso { margin-top: var(--section-gap); }
  .proceso__head { display: grid; gap: 1rem; align-items: end; }
  .proceso__head h2 { min-width: 0; overflow-wrap: break-word; }
  .proceso__lead { font-size: var(--step-lead); line-height: 1.3; max-width: 30ch; }
  @media (min-width: 900px) {
    .proceso__head { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--gutter); }
    .proceso__lead { text-align: right; }
  }

  .linea { margin-top: clamp(2rem, 4vw, 3rem); }
  .ln-post { fill: var(--color-rb-floor); }
  .ln-plate { fill: var(--color-surface-2); }
  .ln-sign { fill: var(--color-rb-soft); }
  .ln-n { fill: var(--color-fg); font-family: var(--font-serif); font-size: 28px; }
  .ln-on { opacity: 0; }
  .ln-stack { opacity: 0; }
  .ln-agv { transform: translateX(140px); }
  .ln-agv, .ln-cobot, .ln-on, .ln-stack { transform-box: fill-box; }

  @media (prefers-reduced-motion: no-preference) {
    .ln-agv { animation: ln-drive 12s ease-in-out infinite; transform: none; }
    .linea :global(.a-wheel) { animation: ln-wheel 12s ease-in-out infinite; }
    .ln-on--1 { animation: ln-on-1 12s linear infinite; }
    .ln-on--2 { animation: ln-on-2 12s linear infinite; }
    .ln-on--3 { animation: ln-on-3 12s linear infinite; }
    .linea :global(.c-up) { animation: ln-up 12s ease-in-out infinite; }
    .linea :global(.c-fore) { animation: ln-fore 12s ease-in-out infinite; }
    .ln-stack { animation: ln-stack 12s steps(1, end) infinite; }
  }

  /* Park at each station: x 140, 540, 940 (the AGV is 120 wide, so its centre meets the post) */
  @keyframes ln-drive {
    0% { transform: translateX(-140px); opacity: 0; }
    3% { opacity: 1; }
    9%, 25% { transform: translateX(140px); }
    35%, 52% { transform: translateX(540px); }
    62%, 82% { transform: translateX(940px); }
    96% { transform: translateX(1240px); opacity: 1; }
    100% { transform: translateX(1240px); opacity: 0; }
  }
  @keyframes ln-wheel {
    0% { transform: rotate(0); }
    9%, 25% { transform: rotate(540deg); }
    35%, 52% { transform: rotate(1260deg); }
    62%, 82% { transform: rotate(1980deg); }
    100% { transform: rotate(2880deg); }
  }
  @keyframes ln-on-1 { 0%, 8% { opacity: 0; } 10%, 25% { opacity: 1; } 27%, 100% { opacity: 0; } }
  @keyframes ln-on-2 { 0%, 34% { opacity: 0; } 36%, 52% { opacity: 1; } 54%, 100% { opacity: 0; } }
  @keyframes ln-on-3 { 0%, 61% { opacity: 0; } 63%, 82% { opacity: 1; } 84%, 100% { opacity: 0; } }
  @keyframes ln-up { 0%, 64% { transform: rotate(0); } 70%, 76% { transform: rotate(-38deg); } 82%, 100% { transform: rotate(0); } }
  @keyframes ln-fore { 0%, 64% { transform: rotate(0); } 70%, 76% { transform: rotate(-60deg); } 82%, 100% { transform: rotate(0); } }
  @keyframes ln-stack { 0%, 78% { opacity: 0; } 79%, 97% { opacity: 1; } 98%, 100% { opacity: 0; } }

  .proceso__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    /* Each step sits under its station: the stations are the centres of three equal columns */
    .proceso__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); text-align: center; }
    .paso__n { display: none; }
  }
  .paso { display: grid; gap: 0.5rem; justify-items: inherit; }
  @media (max-width: 767px) {
    .paso { grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: 0.75rem; }
    .paso__n { grid-row: 1 / span 2; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; background: var(--color-surface-2); color: var(--color-fg); font-weight: 500; }
  }
  .paso__t { font-family: var(--font-sans); font-size: var(--step-lead); font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
  .paso__d { font-size: var(--step-body); }
</style>
