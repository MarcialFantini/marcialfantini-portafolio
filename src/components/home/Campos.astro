---
/* "Qué resolvemos": cuatro campos de color, una frase enorme y su explicación en diagonal.
   Each field has its own robot crew acting out the claim. */
import SceneStock from "../robots/scenes/SceneStock.astro";
import ScenePedidos from "../robots/scenes/ScenePedidos.astro";
import SceneRepetitivo from "../robots/scenes/SceneRepetitivo.astro";
import SceneNumeros from "../robots/scenes/SceneNumeros.astro";
const scenes = [SceneStock, ScenePedidos, SceneRepetitivo, SceneNumeros];
const campos = [
  {
    t: "Stock que cierra.",
    d: "Stock real por depósito, con alertas antes de quedarte sin nada. Se terminó contar cajas para saber qué hay.",
    tone: "surface",
  },
  {
    t: "Pedidos sin perseguir.",
    d: "Cada pedido con etapas, responsable y estado. Sabés dónde está sin preguntarle a nadie.",
    tone: "bg",
  },
  {
    t: "Lo repetitivo, solo.",
    d: "Carga de datos, facturas y mails se hacen solos. Excel, ERP, tienda y facturación hablan entre sí.",
    tone: "accent",
  },
  {
    t: "Tus números, a la vista.",
    d: "Tableros e informes que se actualizan solos, y un aviso cuando algo se desvía, antes de que lo note el cliente.",
    tone: "surface",
  },
];
---

<section id="que-resolvemos" class="campos" aria-label="Qué resolvemos">
  {
    campos.map((c, i) => {
      const Scene = scenes[i];
      return (
      <article class:list={["campo", `campo--${c.tone}`, i % 2 === 1 && "campo--mirror"]}>
        <p class="campo__d" data-rise>{c.d}</p>
        <Scene class="campo__scene" />
        <h2 class="campo__t" data-split style="--i:1">{c.t}</h2>
      </article>
      );
    })
  }
</section>

<style>
  .campos { margin-top: 0; } /* the first field starts where the hero crops the word, so the crop reads as an edge */

  .campo {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: var(--gutter);
    min-height: 64svh;
    padding: var(--gutter);
    padding-block: 1.75rem;
  }
  .campo--surface { background: var(--color-surface); }
  .campo--bg { background: var(--color-bg); }
  .campo--accent { background: var(--color-accent); color: var(--color-accent-ink); }
  .campo--accent .campo__t { color: var(--color-accent-ink); }

  .campo__d {
    grid-column: 1 / span 11;
    grid-row: 1;
    font-size: var(--step-body);
    line-height: 1.5;
    max-width: 30ch;
  }
  :global(.campo__scene) {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: center;
    width: 100%;
    max-width: 22rem;
    margin-block: 1.5rem;
  }
  .campo--mirror :global(.campo__scene) { justify-self: end; }
  .campo__t {
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: end;
    font-size: 11.5vw;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  @media (min-width: 768px) {
    .campo { min-height: 76svh; }
    .campo__d { grid-column: 8 / span 4; }
    .campo__t { font-size: clamp(3.5rem, 9vw, 9.375rem); max-width: 11ch; }

    .campo--mirror .campo__d { grid-column: 2 / span 4; }
    :global(.campo__scene) { grid-column: 2 / span 5; max-width: 30rem; margin-block: 0 2.5rem; }
    .campo--mirror :global(.campo__scene) { grid-column: 7 / span 5; }
    .campo--mirror .campo__t { justify-self: end; text-align: right; }
  }
  @media (max-width: 767px) {
    .campo--mirror .campo__d { justify-self: end; text-align: right; }
  }

</style>
