---
import site from "../../data/site.json";
import sobre from "../../data/sobre.json";
import MediaSlot from "./MediaSlot.astro";
import SceneTorre from "../robots/scenes/SceneTorre.astro";

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";

const foto = sobre.foto || site.aboutPhoto || "";

const compromisos = [
  { t: "Un solo responsable", d: "No un call center" },
  { t: "Precio por escrito", d: "Antes de cada cambio" },
  { t: "Todo a tu nombre", d: "El sistema y tus datos" },
];
---

<section id="sobre-mi" class="sobre wrap" aria-labelledby="sobre-title">
  <div class="sobre__media">
    {
      foto ? (
        <MediaSlot kind="foto" src={foto} alt={`Retrato de ${site.name}`} label="" ratio="4 / 5" />
      ) : (
        <SceneTorre class="sobre__tower" />
      )
    }
  </div>

  <div class="sobre__body">
    <h2 id="sobre-title" data-split>Quién lo hace</h2>
    <p class="sobre__p" data-rise>
      Soy {site.name.split(" ")[0]}. Armo cada sistema y respondo por él después. Hablás con quien hace el trabajo.
    </p>
    <ul class="rec" data-rise style="--i:1">
      {compromisos.map((c) => <li><span>{c.t}</span><span class="soft">{c.d}</span></li>)}
    </ul>
    <p class="sobre__links soft" data-rise style="--i:2">
      {site.location}. Escribime por{" "}
      {whatsappUrl && <><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>, </>}
      <a href={`mailto:${site.email}`}>email</a> o{" "}
      <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
  </div>
</section>

<style>
  .sobre {
    margin-top: var(--section-gap);
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .sobre { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(2rem, 5vw, 5rem); }
  }
  .sobre__media :global(.slot) { overflow: hidden; }
  :global(.sobre__tower) { width: 100%; max-width: 30rem; margin-inline: auto; }
  .sobre__body { display: grid; gap: 1.75rem; }
  .sobre__body h2 { min-width: 0; overflow-wrap: break-word; }
  .sobre__p { font-size: var(--step-lead); line-height: 1.35; max-width: 34ch; }
  .rec { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-width: 30rem; }
  .rec li { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.75rem 1rem; background: var(--color-surface); font-size: var(--step-small); }
  .rec li span:first-child { font-weight: 500; }
  .rec li span:last-child { text-align: right; }
  .sobre__links { font-size: var(--step-small); }
  .sobre__links a { display: inline-block; padding-block: 0.25rem; }
</style>
