---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
  compact?: boolean;
}

const { post, index = 0, compact = false } = Astro.props;
const { title, description, pubDate, category, readingTime } = post.data;
const placeholderIndex = String(index + 1).padStart(2, "0");
---

<a
  href={`/blog/${post.id}`}
  class="group card-pop block rounded-xl bg-[var(--color-blanco-humo)] shadow-sm border-2 border-[var(--color-ink)] tactile transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-azul)] h-full overflow-hidden relative p-1"
>
  <div class="placeholder-image placeholder-image--azul h-32 relative overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="font-impact text-7xl text-white/15 select-none tabular-nums leading-none">
        {placeholderIndex}
      </span>
    </div>
  </div>

  <div class="p-6">
    <div class="flex items-center gap-3 mb-4 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
      <FormattedDate date={pubDate} format="short" />
      <span class="w-1 h-1 rounded-full bg-[var(--color-border)]" aria-hidden="true"></span>
      <span class="text-[var(--color-azul)] font-semibold">{category}</span>
    </div>

    <h3
      class="font-impact text-xl uppercase leading-[1] tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-azul)] transition-colors mb-3"
    >
      {title}
    </h3>

    {!compact && (
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed line-clamp-3 mb-4">
        {description}
      </p>
    )}

    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] flex items-center gap-2 pt-4 border-t border-[var(--color-border)]">
      <span>{readingTime} min</span>
      <span class="text-[var(--color-azul)] font-semibold ml-auto">Leer →</span>
    </p>
  </div>
</a>