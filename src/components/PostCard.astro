---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: CollectionEntry<"blog">;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, description, pubDate, category, readingTime } = post.data;
---

<a
  href={`/blog/${post.id}`}
  class="group block border border-[var(--color-border)] rounded-md p-6 bg-[var(--color-blanco)] hover:border-[var(--color-dorado)] transition-colors h-full"
>
  <div class="flex items-center gap-3 mb-4 text-xs font-mono text-[var(--color-mute)]">
    <FormattedDate date={pubDate} format="short" />
    <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
    <span class="text-[var(--color-dorado)] font-semibold">{category}</span>
  </div>

  <h3
    class="font-display font-semibold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-dorado)] transition-colors leading-snug"
  >
    {title}
  </h3>

  {!compact && (
    <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed line-clamp-3">
      {description}
    </p>
  )}

  <p class="mt-5 text-xs font-mono text-[var(--color-mute)] flex items-center gap-2">
    <span>{readingTime} min</span>
    <span class="opacity-0 group-hover:opacity-100 text-[var(--color-dorado)] transition-opacity">
      · Leer →
    </span>
  </p>
</a>
