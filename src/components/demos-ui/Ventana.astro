---
// Window frame shared by the drawn demo interfaces. Everything inside is sample data.
// Motion hooks read by Demos.astro: data-row, data-grow-x, data-grow-y, data-count (assemble on scroll);
// data-off / data-on / data-fill / data-bump (looping state change A -> B -> A).
interface Props {
  ui: string;
  title: string;
  where: string;
  label: string;
}
const { ui, title, where, label } = Astro.props;
---

<div class="win" data-ui={ui} role="img" aria-label={label}>
  <div class="win__bar">
    <span class="win__marks"><i></i><i></i><i></i></span>
    <span class="win__title">{title}</span>
    <span class="win__where">{where}</span>
    <span class="win__demo">Demo</span>
  </div>
  <div class="win__body"><slot /></div>
</div>

<style>
  .win {
    background: #fff; color: var(--color-ink);
    font-size: 0.875rem; line-height: 1.3; font-variant-numeric: tabular-nums;
  }
  .win__bar {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.9rem;
    background: var(--color-field-night); color: var(--color-paper);
  }
  .win__marks { display: flex; gap: 0.3rem; flex: none; }
  .win__marks i { display: block; width: 0.55rem; height: 0.55rem; background: var(--color-soft); }
  .win__title { font-weight: 500; white-space: nowrap; }
  .win__where { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: 0.75; }
  .win__demo {
    margin-left: auto; flex: none; padding: 0.15rem 0.5rem; font-size: 0.8125rem; font-weight: 500;
    background: var(--color-field-lime); color: var(--color-ink);
  }
  .win__body { padding: 0.9rem; display: grid; gap: 0.9rem; }

  /* Shared primitives for the slotted screens */
  .win :global(.chip) {
    display: inline-block; padding: 0.2rem 0.5rem; font-size: 0.8125rem; font-weight: 500; line-height: 1.2; white-space: nowrap;
    background: var(--color-field-mist); color: var(--color-ink);
  }
  .win :global(.chip--low) { background: var(--color-accent); color: var(--color-accent-ink); }
  .win :global(.chip--new) { background: var(--color-field-lime); }
  .win :global(.chip--ink) { background: var(--color-field-night); color: var(--color-paper); }
  /* Two states stacked in one cell: the looping change cross-fades between them */
  .win :global(.swap) { display: inline-grid; }
  .win :global(.swap > *) { grid-area: 1 / 1; }
  .win :global([data-on]) { opacity: 0; }
  .win :global([data-fill]) { transform: scaleX(0); transform-origin: 0 50%; }
  .win :global(.soft) { color: var(--color-soft); }

  @media (min-width: 900px) {
    .win__body { padding: 1.25rem; gap: 1.1rem; }
  }
</style>
