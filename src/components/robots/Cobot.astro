---
/* Collaborative arm with a wrist camera and a two-finger gripper.
   Local box 120 x 140. Shoulder (60,124), elbow (60,68), wrist (104,68). Load sits between the fingers. */
interface Props { x?: number; y?: number; s?: number; class?: string }
const { x = 0, y = 0, s = 1, class: cls } = Astro.props;
---

<svg class:list={["rb rb-cobot", cls]} x={x} y={y} width={120 * s} height={140 * s} viewBox="0 0 120 140" overflow="visible">
  <rect x="42" y="126" width="36" height="14" rx="3" class="r-soft" />
  <g class="c-up">
    <rect x="54" y="64" width="12" height="64" rx="6" class="r-ink" />
    <circle cx="60" cy="124" r="9" class="r-soft" />
    <g class="c-fore">
      <rect x="56" y="62" width="54" height="12" rx="6" class="r-ink" />
      <circle cx="60" cy="68" r="8" class="r-soft" />
      <g class="c-wrist">
        <circle cx="104" cy="68" r="7" class="r-soft" />
        <rect x="95" y="52" width="18" height="10" rx="3" class="r-dark" />
        <rect x="98" y="55" width="4" height="5" rx="1" class="r-acc r-eye" />
        <rect x="106" y="55" width="4" height="5" rx="1" class="r-acc r-eye" />
        <rect x="97" y="74" width="14" height="5" rx="2" class="r-soft" />
        <g class="c-load"><slot /></g>
        <rect x="95" y="78" width="4" height="12" rx="1.5" class="r-soft c-fl" />
        <rect x="109" y="78" width="4" height="12" rx="1.5" class="r-soft c-fr" />
      </g>
    </g>
  </g>
</svg>
