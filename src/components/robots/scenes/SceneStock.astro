---
/* Stock: the AGV brings a box under the gantry; the gantry picks it and fills the empty
   slot on the shelf. 9 s loop. Gantry at (10,50): tool centre = 38 + X, load top = 124 + Z.
   Pick (AGV box centre 62, top 154.4): X 24, Z 30.4. Place (slot centre 236, top 168): X 198, Z 44. */
import Agv from "../Agv.astro";
import Gantry from "../Gantry.astro";
interface Props { class?: string }
const { class: cls } = Astro.props;
const slot = (i: number) => 128 + i * 34;
---

<div class:list={["rbs sc-stock", cls]} data-rb aria-hidden="true">
  <svg viewBox="0 0 360 210" focusable="false">
    <rect x="0" y="200" width="360" height="8" class="r-floor" />
    <!-- shelf -->
    <rect x="120" y="180" width="214" height="5" class="r-soft" />
    <rect x="120" y="160" width="4" height="40" class="r-soft" />
    <rect x="330" y="160" width="4" height="40" class="r-soft" />
    {[0, 1, 2, 4, 5].map((i) => <rect x={slot(i)} y="168" width="12" height="12" class="r-acc" />)}
    {[0, 1, 2, 3, 4, 5].map((i) => <rect x={slot(i)} y="188" width="12" height="12" class="r-acc" />)}
    <rect x={slot(3)} y="168" width="12" height="12" class="r-acc st-new" />

    <g class="st-agv">
      <Agv x={14} y={152} s={0.8}><rect x="52.5" y="3" width="15" height="15" class="r-acc st-agvbox" /></Agv>
    </g>
    <Gantry x={10} y={50} w={340} h={150}><rect x="22" y="74" width="12" height="12" class="r-acc st-grip" /></Gantry>
  </svg>
</div>

<style>
  .st-new, .st-grip { opacity: 0; }
  .sc-stock :global(.g-x) { transform: translateX(24px); }

  @media (prefers-reduced-motion: no-preference) {
    .sc-stock :global(*) { animation-duration: 9s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
    .st-agv { animation-name: st-agv; }
    .sc-stock :global(.a-wheel) { animation-name: st-wheel; }
    .st-agvbox { animation-name: st-agvbox; animation-timing-function: step-end; }
    .sc-stock :global(.g-x) { animation-name: st-x; }
    .sc-stock :global(.g-z) { animation-name: st-z; }
    .sc-stock :global(.g-fl) { animation-name: st-fl; }
    .sc-stock :global(.g-fr) { animation-name: st-fr; }
    .st-grip { animation-name: st-grip; animation-timing-function: step-end; }
    .st-new { animation-name: st-new; }
    .sc-stock :global(.r-eye) { animation-name: r-blink; animation-duration: 5s; }
  }

  @keyframes st-agv {
    0% { transform: translateX(-150px); opacity: 0; }
    6% { opacity: 1; }
    20%, 52% { transform: none; opacity: 1; }
    62% { opacity: 0; }
    66%, 100% { transform: translateX(-150px); opacity: 0; }
  }
  @keyframes st-wheel { 0% { transform: rotate(0); } 20%, 52% { transform: rotate(540deg); } 66%, 100% { transform: rotate(0); } }
  @keyframes st-agvbox { 0% { opacity: 1; } 34%, 100% { opacity: 0; } }
  @keyframes st-x { 0%, 44% { transform: translateX(24px); } 64%, 88% { transform: translateX(198px); } 98%, 100% { transform: translateX(24px); } }
  @keyframes st-z { 0%, 20% { transform: none; } 30%, 36% { transform: translateY(30.4px); } 44%, 64% { transform: none; } 72%, 78% { transform: translateY(44px); } 88%, 100% { transform: none; } }
  @keyframes st-fl { 0%, 31% { transform: none; } 33%, 75% { transform: translateX(2px); } 77%, 100% { transform: none; } }
  @keyframes st-fr { 0%, 31% { transform: none; } 33%, 75% { transform: translateX(-2px); } 77%, 100% { transform: none; } }
  @keyframes st-grip { 0% { opacity: 0; } 34% { opacity: 1; } 76%, 100% { opacity: 0; } }
  @keyframes st-new { 0%, 75% { opacity: 0; } 76%, 93% { opacity: 1; } 99%, 100% { opacity: 0; } }
</style>
