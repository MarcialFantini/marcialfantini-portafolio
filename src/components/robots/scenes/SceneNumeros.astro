---
/* Numbers: the cobot watches a screen of bars. One bar drops, the cobot turns and points at it,
   an AGV brings stock, the bar recovers. 8 s loop. */
import Agv from "../Agv.astro";
import Cobot from "../Cobot.astro";
interface Props { class?: string }
const { class: cls } = Astro.props;
const bars = [0.7, 0.85, 0.9, 0.55, 0.75];
---

<div class:list={["rbs sc-num rb-on-surface", cls]} data-rb aria-hidden="true">
  <svg viewBox="0 0 360 210" focusable="false">
    <rect x="0" y="200" width="360" height="8" class="r-floor" />
    <rect x="240" y="150" width="16" height="44" class="r-soft" />
    <rect x="220" y="192" width="56" height="8" rx="2" class="r-soft" />
    <rect x="150" y="24" width="196" height="128" rx="6" class="r-dark" />
    {bars.map((h, i) => (
      <rect x={170 + i * 34} y={140 - 96} width="20" height="96" class:list={["r-acc nb", `nb${i}`]} style={`--h:${h}`} />
    ))}

    <g class="nm-agv">
      <Agv x={100} y={152} s={0.8}><rect x="52.5" y="3" width="15" height="15" class="r-acc nm-box" /></Agv>
    </g>
    <Cobot x={0} y={60} />
  </svg>
</div>

<style>
  .nb { transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(var(--h)); }
  .nm-agv { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .sc-num :global(*) { animation-duration: 8s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
    .nb { animation-name: nm-bar; animation-duration: 4s; }
    .nb1 { animation-delay: -1s; }
    .nb3 { animation-delay: -2.2s; }
    .nb4 { animation-delay: -3s; }
    .nb2 { animation-name: nm-drop; animation-duration: 8s; }
    .nm-agv { animation-name: nm-agv; }
    .sc-num :global(.a-wheel) { animation-name: nm-wheel; }
    .nm-box { animation-name: nm-box; animation-timing-function: step-end; }
    .sc-num :global(.c-up) { animation-name: nm-up; }
    .sc-num :global(.c-fore) { animation-name: nm-fore; }
    .sc-num :global(.c-wrist) { animation-name: nm-wrist; }
    .sc-num :global(.rb-cobot .r-eye) { animation-name: nm-alert; animation-timing-function: steps(2, jump-none); }
  }
  @media (prefers-reduced-motion: reduce) { .nm-agv { opacity: 1; } }

  @keyframes nm-bar { 0%, 100% { transform: scaleY(var(--h)); } 50% { transform: scaleY(calc(var(--h) * 0.82)); } }
  @keyframes nm-drop { 0%, 14% { transform: scaleY(0.9); } 22%, 56% { transform: scaleY(0.25); } 70%, 100% { transform: scaleY(0.9); } }
  @keyframes nm-agv {
    0%, 28% { transform: translateX(-150px); opacity: 0; }
    34% { opacity: 1; }
    45%, 62% { transform: none; opacity: 1; }
    76% { opacity: 0; }
    80%, 100% { transform: translateX(-150px); opacity: 0; }
  }
  @keyframes nm-wheel { 0%, 28% { transform: rotate(0); } 45%, 62% { transform: rotate(540deg); } 80%, 100% { transform: rotate(0); } }
  @keyframes nm-box { 0% { opacity: 1; } 56%, 100% { opacity: 0; } }
  /* watch the screen -> point at the falling bar -> turn to the AGV -> back to watching */
  @keyframes nm-up { 0%, 20% { transform: rotate(10deg); } 28%, 40% { transform: rotate(32deg); } 48%, 58% { transform: rotate(18deg); } 72%, 100% { transform: rotate(10deg); } }
  @keyframes nm-fore { 0%, 20% { transform: rotate(-20deg); } 28%, 40% { transform: rotate(-38deg); } 48%, 58% { transform: rotate(40deg); } 72%, 100% { transform: rotate(-20deg); } }
  @keyframes nm-wrist { 0%, 20% { transform: rotate(10deg); } 28%, 40% { transform: rotate(6deg); } 48%, 58% { transform: rotate(-58deg); } 72%, 100% { transform: rotate(10deg); } }
  @keyframes nm-alert { 0%, 22% { opacity: 1; } 24%, 26%, 28%, 30%, 32% { opacity: 0.2; } 25%, 27%, 29%, 31%, 34%, 100% { opacity: 1; } }
</style>
