---
/* Questions: an AGV arrives with a question, the cobot (facing it) inspects the box,
   the question turns into an answer, the AGV leaves. 8 s loop. */
import Agv from "../Agv.astro";
import Cobot from "../Cobot.astro";
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<div class:list={["rbs sc-dq", cls]} data-rb aria-hidden="true">
  <svg viewBox="0 0 300 190" focusable="false">
    <rect x="0" y="180" width="300" height="8" class="r-floor" />
    <g class="dq-agv">
      <Agv x={40} y={126} s={0.9}>
        <rect x="46" y="-10" width="28" height="28" rx="2" class="r-acc" />
        <text x="60" y="12" text-anchor="middle" font-size="22" class="r-text dq-q">?</text>
        <text x="60" y="12" text-anchor="middle" font-size="22" class="r-text dq-a">!</text>
      </Agv>
    </g>
    <g transform="translate(300 0) scale(-1 1)"><Cobot x={0} y={40} /></g>
  </svg>
</div>

<style>
  .dq-a { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .sc-dq :global(*) { animation-duration: 8s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
    .dq-agv { animation-name: dq-agv; }
    .sc-dq :global(.a-wheel) { animation-name: dq-wheel; }
    .dq-q { animation-name: dq-q; animation-timing-function: step-end; }
    .dq-a { animation-name: dq-a; animation-timing-function: step-end; }
    .sc-dq :global(.c-up) { animation-name: dq-up; }
    .sc-dq :global(.c-fore) { animation-name: dq-fore; }
    .sc-dq :global(.c-wrist) { animation-name: dq-wrist; }
  }

  @keyframes dq-agv {
    0% { transform: translateX(-140px); opacity: 0; }
    6% { opacity: 1; }
    20%, 66% { transform: none; opacity: 1; }
    80% { opacity: 0; }
    84%, 100% { transform: translateX(-140px); opacity: 0; }
  }
  @keyframes dq-wheel { 0% { transform: rotate(0); } 20%, 66% { transform: rotate(540deg); } 84%, 100% { transform: rotate(0); } }
  @keyframes dq-q { 0% { opacity: 1; } 44%, 100% { opacity: 0; } }
  @keyframes dq-a { 0% { opacity: 0; } 44%, 99% { opacity: 1; } }
  /* lean toward the box, look closely, tap, sit back */
  @keyframes dq-up { 0%, 20% { transform: rotate(0); } 30%, 46% { transform: rotate(38deg); } 58%, 100% { transform: rotate(0); } }
  @keyframes dq-fore { 0%, 20% { transform: rotate(0); } 30% { transform: rotate(10deg); } 38% { transform: rotate(24deg); } 42% { transform: rotate(14deg); } 46% { transform: rotate(24deg); } 58%, 100% { transform: rotate(0); } }
  @keyframes dq-wrist { 0%, 20% { transform: rotate(0); } 30% { transform: rotate(-48deg); } 38% { transform: rotate(-62deg); } 42% { transform: rotate(-52deg); } 46% { transform: rotate(-62deg); } 58%, 100% { transform: rotate(0); } }
</style>
