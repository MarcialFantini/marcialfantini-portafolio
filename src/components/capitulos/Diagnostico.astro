---
import data from "../../data/diagnostico.json";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";
import { stock } from "../../lib/stock";

// Operations imagery only (warehouse, dispatch, paperwork), one slot per photo spot so nothing repeats.
const photos = [
  "hero-deposito", "rubro-pedidos", "ciclo-estanterias", "rubro-distribuidora", "caos-tickets", "rubro-mayorista",
  "hero-alt-autoelevador", "ciclo-cajas", "rubro-ferreteria", "caos-biblioratos", "ciclo-escaneo", "caos-papeles",
  "rubro-muebles", "equipo-reunion", "caos-postits", "rubro-auditoria", "caos-anotando",
].map((name) => stock(name, 640));

// Floating objects. [kind, left%, top%, size px, rotation deg, mobile?: [left%, top%, size px]]
// kind: "p" = operations photo, or a drawn back-office object. Every piece is unique.
// Centre zone (30-70% x) stays clear. Phones show only the six spots with a mobile tuple:
// three above the title, three below it.
type Spot = [string, number, number, number, number, [number, number, number]?];
const spots: Spot[] = [
  ["p", 2, 4, 150, -6, [4, 2.5, 128]],
  ["label", 15, 2, 130, 5, [44, 1.5, 132]],
  ["p", 6, 24, 110, 4, [64, 8, 108]],
  ["bubble", 16, 25, 160, -3],
  ["p", 1, 46, 170, -4],
  ["receipt", 19, 46, 112, 6],
  ["p", 5, 70, 120, 5, [5, 79, 118]],
  ["chart", 18, 67, 130, -5, [39, 85, 104]],
  ["p", 2, 86, 130, -3],
  ["cal", 17, 87, 100, 4],
  ["p", 30, 2, 90, -5],
  ["p", 44, 0, 120, 4],
  ["p", 58, 3, 100, -4],
  ["p", 31, 88, 110, 5],
  ["label2", 46, 90, 124, -3],
  ["p", 60, 87, 120, 4],
  ["p", 76, 4, 130, 5],
  ["count", 90, 2, 100, -5],
  ["p", 80, 20, 170, -4],
  ["stock", 76, 44, 130, 5],
  ["p", 88, 48, 120, -6],
  ["order", 79, 66, 116, -5],
  ["p", 90, 72, 100, 4],
  ["p", 75, 84, 150, 5, [67, 77, 112]],
  ["bubble2", 85, 90, 150, -4],
  ["p", 23, 8, 84, 6],
  ["p", 69, 90, 96, -5],
];
let pi = 0;
const floats = spots.map(([kind, l, t, s, r, m], i) => ({
  kind, l, t, s, r, m, i,
  photo: kind === "p" ? photos[pi++ % photos.length] : null,
}));

const qs = data.preguntas.map((q) => ({
  ...q,
  opciones: q.opciones.map((o) => ({ ...o, img: stock(o.foto, 640) })),
}));

const payload = {
  preguntas: data.preguntas,
  porque: data.porque,
  pasos: data.pasos,
  whatsapp: site.whatsapp,
  servicios: servicios.map((s) => ({ id: s.id, titulo: s.titulo, duracion: s.duracion })),
};
---

<section id="diagnostico" class="dg" data-field="lime" aria-labelledby="diagnostico-title">
  <div class="dg__floats" aria-hidden="true">
    {floats.map((f) => (
      <div
        class:list={["dg__o", `dg__o--${f.kind}`, { "has-m": !!f.m, "no-js-hide": f.i % 3 !== 0 }]}
        data-float
        data-depth={(f.i % 3) + 1}
        data-cx={f.l + f.s / 28}
        data-cy={f.t}
        style={`--l:${f.l}%;--t:${f.t}%;--s:${f.s}px;--rot:${f.r}deg;${f.m ? `--ml:${f.m[0]}%;--mt:${f.m[1]}%;--ms:${f.m[2]}px;` : ""}`}
      >
        {f.photo && <img src={f.photo.src} srcset={f.photo.srcset} sizes="180px" alt="" width="180" height="180" loading="lazy" decoding="async" />}
        {f.kind === "receipt" && (
          <>
            <b>Remito 0412</b><i style="width:90%"></i><i style="width:70%"></i><i style="width:80%"></i><i style="width:55%"></i>
            <span>Total <i style="width:40%"></i></span>
          </>
        )}
        {f.kind === "label" && <b>30x40 · 142 u.</b>}
        {f.kind === "label2" && <b>Lote 18 · 60 u.</b>}
        {f.kind === "bubble" && <span>¿Hay stock?</span>}
        {f.kind === "bubble2" && <span>Te lo mando hoy</span>}
        {f.kind === "chart" && (
          <div class="dg__bars"><i style="height:40%"></i><i style="height:65%"></i><i style="height:50%"></i><i style="height:85%"></i><i style="height:100%"></i></div>
        )}
        {f.kind === "cal" && (<><em>Mar</em><strong>14</strong></>)}
        {f.kind === "count" && (<><strong>7</strong><em>sin facturar</em></>)}
        {f.kind === "stock" && (
          <>
            <b>Stock</b>
            <div class="dg__rows"><i style="width:85%"></i><i style="width:55%"></i><i style="width:20%"></i><i style="width:65%"></i></div>
          </>
        )}
        {f.kind === "order" && (
          <>
            <b>Pedido 2087</b>
            <span><u class="is-on"></u><i style="width:70%"></i></span>
            <span><u class="is-on"></u><i style="width:50%"></i></span>
            <span><u></u><i style="width:60%"></i></span>
          </>
        )}
      </div>
    ))}
  </div>

  <div class="dg__stage">
    <div class="dg__intro" id="dg-intro">
      <h2 id="diagnostico-title" class="dg__title">¿Dónde <small>se</small> traba <small>tu</small> operación?</h2>
      <p class="dg__lead">{data.titulo}</p>
      <button type="button" class="btn dg__start" id="dg-start" hidden>Empezar el diagnóstico <span aria-hidden="true">→</span></button>
    </div>

    <div class="dg__panel" id="dg-panel" tabindex="-1">
      <div class="dg__bar" id="dg-bar" aria-hidden="true" hidden><i></i></div>
      <div class="dg__body">
        <form class="dg__form" id="dg-form" action="/contacto" method="get">
          {qs.map((q, qi) => (
            <fieldset class="dg__step" data-step={qi}>
              <legend class="dg__legend">{q.texto}</legend>
              <div class="dg__opts">
                {q.opciones.map((o, oi) => (
                  <label class="dg__opt">
                    <input type="radio" name={q.id} value={o.label} data-i={oi} required />
                    <span class="dg__tile">
                      <img src={o.img.src} srcset={o.img.srcset} sizes="(min-width: 640px) 340px, 80px" alt="" width="320" height="180" loading="lazy" decoding="async" />
                      <span class="dg__txt">{o.label}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="dg__nav">
            <p class="dg__progress" id="dg-progress" aria-live="polite" hidden></p>
            <button type="button" class="dg__back" id="dg-back" hidden>Volver</button>
            <button type="submit" class="btn" id="dg-next">Enviar respuestas</button>
          </div>
        </form>

        <div class="dg__result" id="dg-result" tabindex="-1" hidden>
          <h3 class="dg__rtitle" id="dg-rtitle"></h3>
          <p class="dg__rmeta" id="dg-rmeta"></p>
          <p class="dg__rwhy" id="dg-rwhy"></p>
          <p class="dg__rsub">Por dónde empezaríamos</p>
          <ul class="dg__steps" id="dg-steps"></ul>
          <div class="dg__actions">
            <a class="btn" id="dg-wa" href="#" target="_blank" rel="noopener">Mandarlo por WhatsApp</a>
            <a class="dg__link" id="dg-form-link" href="/contacto">Prefiero el formulario</a>
          </div>
          <button type="button" class="dg__back" id="dg-restart">Empezar de nuevo</button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="dg-data" set:html={JSON.stringify(payload)} />
</section>

<style>
  .dg {
    position: relative; overflow: hidden; min-height: max(44rem, 100svh);
    display: grid; align-items: center; padding: clamp(4rem, 8vw, 7rem) var(--gutter);
  }

  /* Floating objects */
  .dg__floats { position: absolute; inset: 0; pointer-events: none; }
  .dg__o {
    position: absolute; left: var(--l); top: var(--t); width: var(--s); rotate: var(--rot);
    color: var(--color-ink); will-change: transform;
  }
  .dg__o img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .dg__o--receipt { background: #fff; padding: 0.7rem 0.7rem 0.8rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .dg__o--receipt b { font-size: 0.8125rem; font-weight: 600; line-height: 1.1; }
  .dg__o--receipt i { display: block; height: 6px; background: #C9D3EA; }
  .dg__o--receipt span { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; font-weight: 600; margin-top: 0.2rem; }
  .dg__o--receipt span i { background: var(--color-ink); }
  .dg__o--label, .dg__o--label2 { background: var(--color-ink); color: var(--color-paper); padding: 0.75rem 0.85rem; }
  .dg__o--label2 { background: var(--color-accent); color: #fff; }
  .dg__o--label b, .dg__o--label2 b { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; line-height: 1; white-space: nowrap; }
  .dg__o--bubble span, .dg__o--bubble2 span {
    display: block; background: #fff; padding: 0.7rem 0.9rem; font-size: 0.9375rem; font-weight: 500; line-height: 1.2;
  }
  .dg__o--bubble2 span { background: var(--color-paper); }
  .dg__o--chart { background: var(--color-paper); padding: 0.85rem; aspect-ratio: 1; }
  .dg__bars { height: 100%; display: flex; align-items: flex-end; gap: 6%; }
  .dg__bars i { flex: 1; background: var(--color-ink); }
  .dg__bars i:nth-child(4), .dg__bars i:nth-child(5) { background: var(--color-accent); }
  .dg__o--cal { background: var(--color-paper); aspect-ratio: 1; display: flex; flex-direction: column; }
  .dg__o--cal em { font-style: normal; font-size: 0.8125rem; font-weight: 600; background: var(--color-accent); color: #fff; padding: 0.3rem 0.6rem; }
  .dg__o--cal strong { flex: 1; display: grid; place-items: center; font-family: var(--font-display); font-weight: 600; font-size: 2.75rem; line-height: 1; }

  .dg__o--count { background: var(--color-ink); color: var(--color-paper); aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; padding: 0.75rem; }
  .dg__o--count strong { font-family: var(--font-display); font-weight: 600; font-size: 3rem; line-height: 0.9; }
  .dg__o--count em { font-style: normal; font-size: 0.875rem; font-weight: 500; line-height: 1.15; margin-top: 0.3rem; }
  .dg__o--stock { background: #fff; padding: 0.8rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .dg__o--stock b, .dg__o--order b { font-size: 0.875rem; font-weight: 600; line-height: 1.1; }
  .dg__rows { display: grid; gap: 0.45rem; }
  .dg__rows i { display: block; height: 10px; background: var(--color-ink); }
  .dg__rows i:nth-child(3) { background: var(--color-accent); }
  .dg__o--order { background: var(--color-paper); padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .dg__o--order span { display: flex; align-items: center; gap: 0.45rem; }
  .dg__o--order u { flex: none; width: 12px; height: 12px; background: #C9D3EA; text-decoration: none; }
  .dg__o--order u.is-on { background: var(--color-accent); }
  .dg__o--order i { display: block; height: 6px; background: var(--color-ink); }

  /* Stage: intro and panel share one cell */
  .dg__stage { position: relative; z-index: 1; display: grid; justify-items: center; }
  .dg__stage > * { grid-area: 1 / 1; }
  .dg__intro { text-align: center; max-width: 44rem; }
  .dg__title {
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: clamp(3.25rem, 8vw, 7rem); line-height: 0.92; margin: 0 0 1.25rem; text-wrap: balance;
  }
  .dg__title small { font-family: var(--font-sans); font-weight: 500; text-transform: none; font-size: 0.4em; }
  .dg__lead { font-size: var(--step-lead); margin: 0 auto 2.25rem; max-width: 30rem; }
  .dg__start { font-size: 1.25rem; padding: 1.15rem 2.25rem; }

  /* Paper panel */
  .dg__panel { width: 100%; max-width: 47.5rem; background: var(--color-paper); color: var(--color-ink); outline: none; }
  .dg__bar { height: 6px; background: #D5DCEC; }
  .dg__bar i { display: block; height: 100%; background: var(--color-ink); transform-origin: left; transform: scaleX(0.25); transition: transform 0.5s var(--ease-out-quart); }
  .dg__body { padding: clamp(1.5rem, 4vw, 3rem); }

  .dg__step { border: 0; padding: 0; margin: 0 0 2rem; min-width: 0; }
  .dg__legend {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.02; padding: 0; margin-bottom: 1.25rem; text-wrap: balance;
  }
  .dg__opts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .dg__opt:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .dg__opt { position: relative; display: block; cursor: pointer; }
  .dg__opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .dg__tile {
    display: flex; flex-direction: column; height: 100%; background: #E3E9F6; color: var(--color-ink);
    transition: background-color 0.2s var(--ease-out-quart), color 0.2s var(--ease-out-quart);
  }
  .dg__tile img { display: block; width: 100%; height: 7.5rem; object-fit: cover; }
  .dg__txt { display: block; padding: 0.9rem 1rem 1rem; font-size: 1.125rem; font-weight: 600; line-height: 1.2; }
  .dg__opt:hover .dg__tile { background: #D2DBF0; }
  .dg__opt input:checked + .dg__tile { background: var(--color-ink); color: var(--color-paper); }
  .dg__opt input:focus-visible + .dg__tile { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .dg__opt:last-child:nth-child(odd) .dg__tile { flex-direction: row; align-items: center; }
  .dg__opt:last-child:nth-child(odd) .dg__tile img { width: 9rem; height: 5.5rem; flex: none; }

  .dg__nav { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .dg__progress { font-size: 1.0625rem; font-weight: 500; margin: 0 auto 0 0; }
  .dg__nav .btn:disabled { background: #D5DCEC; color: var(--color-ink); opacity: 1; cursor: not-allowed; }
  .dg__back {
    background: none; border: 0; padding: 0.75rem 0; min-height: 44px; font: inherit; font-weight: 500;
    color: inherit; text-decoration: underline; text-underline-offset: 0.25em; cursor: pointer;
  }
  .dg__back:focus-visible, .dg__link:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }

  .dg__result { outline: none; }
  .dg__rtitle { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.25rem, 6vw, 3.75rem); line-height: 0.98; margin: 0 0 1rem; text-wrap: balance; }
  .dg__rmeta { font-size: 1.125rem; font-weight: 600; margin: 0 0 0.75rem; }
  .dg__rwhy { font-size: 1.125rem; margin: 0 0 1.75rem; }
  .dg__rsub { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; line-height: 1; margin: 0 0 0.75rem; }
  .dg__steps { margin: 0 0 2rem; padding-left: 1.25rem; list-style: disc; display: grid; gap: 0.6rem; font-size: 1.125rem; }
  .dg__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-bottom: 0.5rem; }
  .dg__link { color: inherit; font-weight: 500; text-decoration: underline; text-underline-offset: 0.25em; padding-block: 0.75rem; }

  /* JS: one question at a time, intro first */
  .dg.is-js .dg__panel { display: none; }
  .dg.is-js .dg__step { display: none; margin-bottom: 1.5rem; }
  .dg.is-js .dg__step.is-active { display: block; }
  .dg.is-quiz .dg__intro { display: none; }
  .dg.is-quiz .dg__panel { display: block; }

  /* No JS: fewer objects, title above the full form */
  .dg:not(.is-js) .dg__stage { display: block; }
  .dg:not(.is-js) .dg__intro { margin-inline: auto; }
  .dg:not(.is-js) .dg__panel { margin-inline: auto; }
  .dg:not(.is-js) .no-js-hide { display: none; }

  /* Phone */
  @media (max-width: 760px) {
    .dg { padding-inline: 0; padding-block: 3rem; align-items: center; }
    .dg__intro { padding-inline: var(--gutter); }
    .dg__o { display: none; }
    .dg__o.has-m { display: block; left: var(--ml); top: var(--mt); width: var(--ms); }
    .dg__o--chart.has-m { padding: 0.7rem; }
    .dg:not(.is-js) .dg__o:not(.has-m) { display: none; }
    .dg__opts { grid-template-columns: 1fr; gap: 0.6rem; }
    .dg__tile, .dg__opt:last-child:nth-child(odd) .dg__tile { flex-direction: row; align-items: center; }
    .dg__tile img, .dg__opt:last-child:nth-child(odd) .dg__tile img { width: 5rem; height: 4.5rem; flex: none; }
    .dg__txt { padding: 0.6rem 0.9rem; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, onPage, reduced } from "../../scripts/motion";

  onPage(() => {
    const root = document.getElementById("diagnostico");
    const dataEl = document.getElementById("dg-data");
    if (!root || !dataEl) return;
    const D = JSON.parse(dataEl.textContent || "{}");
    const form = root.querySelector<HTMLFormElement>("#dg-form")!;
    const steps = [...root.querySelectorAll<HTMLElement>(".dg__step")];
    const progress = root.querySelector<HTMLElement>("#dg-progress")!;
    const back = root.querySelector<HTMLButtonElement>("#dg-back")!;
    const next = root.querySelector<HTMLButtonElement>("#dg-next")!;
    const result = root.querySelector<HTMLElement>("#dg-result")!;
    const panel = root.querySelector<HTMLElement>("#dg-panel")!;
    const bar = root.querySelector<HTMLElement>("#dg-bar")!;
    const barFill = bar.querySelector<HTMLElement>("i")!;
    const start = root.querySelector<HTMLButtonElement>("#dg-start")!;
    const floats = [...root.querySelectorAll<HTMLElement>("[data-float]")];
    const rm = reduced();
    let cur = 0;
    let started = false;

    root.classList.add("is-js");
    progress.hidden = false;
    back.hidden = false;
    bar.hidden = false;
    start.hidden = false;
    next.type = "button";

    const picked = (i: number) => steps[i].querySelector<HTMLInputElement>("input:checked");
    const sync = () => {
      next.disabled = !picked(cur);
    };
    const setBar = (n: number) => {
      barFill.style.transform = `scaleX(${n / steps.length})`;
    };

    const show = (i: number, dir = 1) => {
      const prev = steps[cur];
      cur = i;
      steps.forEach((s, k) => s.classList.toggle("is-active", k === i));
      progress.textContent = `Pregunta ${i + 1} de ${steps.length}`;
      back.hidden = i === 0;
      next.textContent = i === steps.length - 1 ? "Ver mi recomendación" : "Siguiente";
      setBar(i + 1);
      sync();
      if (!rm && prev !== steps[i]) gsap.fromTo(steps[i], { opacity: 0, y: 24 * dir }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" });
    };

    const recommend = () => {
      const score: Record<string, number> = {};
      const order: string[] = D.servicios.map((s: any) => s.id);
      const lines: string[] = [];
      const answers = new URLSearchParams();
      D.preguntas.forEach((q: any, i: number) => {
        const el = picked(i)!;
        const o = q.opciones[Number(el.dataset.i)];
        lines.push(`- ${q.texto} ${o.label}`);
        answers.set(q.id, o.label);
        for (const [id, w] of Object.entries(o.pesos)) score[id] = (score[id] || 0) + (w as number);
      });
      // Highest score wins; ties fall back to catalogue order (software first).
      const bestId = order.reduce((a, b) => ((score[b] || 0) > (score[a] || 0) ? b : a), order[0]);
      const svc = D.servicios.find((s: any) => s.id === bestId);
      root.querySelector("#dg-rtitle")!.textContent = `Te conviene: ${svc.titulo}`;
      root.querySelector("#dg-rmeta")!.textContent = `Plazo orientativo: ${svc.duracion.toLowerCase()}. El precio lo cerramos en la propuesta.`;
      root.querySelector("#dg-rwhy")!.textContent = D.porque[bestId];
      const list = root.querySelector("#dg-steps")!;
      list.replaceChildren(...(D.pasos[bestId] || []).map((t: string) => Object.assign(document.createElement("li"), { textContent: t })));
      const msg = `Hola Marcial, hice el diagnóstico en tu web.\n${lines.join("\n")}\nMe recomendó: ${svc.titulo}.\nQuiero que lo charlemos.`;
      (root.querySelector("#dg-wa") as HTMLAnchorElement).href = `https://wa.me/${D.whatsapp}?text=${encodeURIComponent(msg)}`;
      // Same param names the no-JS form submits, so /contacto prefills the message either way.
      answers.set("servicio", svc.titulo);
      (root.querySelector("#dg-form-link") as HTMLAnchorElement).href = `/contacto?${answers.toString()}`;
      form.hidden = true;
      result.hidden = false;
      setBar(steps.length);
      if (!rm) gsap.fromTo(result, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" });
      result.focus({ preventScroll: true });
    };

    const ctx = gsap.context(() => {}, root);
    const drifts: gsap.core.Tween[] = [];
    const parts: gsap.core.Tween[] = [];

    const startDrift = () => {
      if (rm) return;
      floats.forEach((el, i) => {
        drifts.push(gsap.to(el, { y: i % 2 ? -14 : 14, x: i % 3 ? 8 : -8, duration: 4 + (i % 5) * 0.8, ease: "sine.inOut", yoyo: true, repeat: -1 }));
      });
    };
    const startParting = () => {
      if (rm) return;
      // Objects part a little to the sides and drift at their own depth while scrolling.
      floats.forEach((el) => {
        const d = Number(el.dataset.depth || 1);
        const side = Number(el.dataset.cx || 50) < 50 ? -1 : 1;
        parts.push(gsap.fromTo(el, { xPercent: -side * 10 * d, yPercent: 10 * d }, {
          xPercent: side * 14 * d, yPercent: -10 * d, ease: "none",
          scrollTrigger: { trigger: root, start: "top bottom", end: "bottom top", scrub: true },
        }));
      });
    };
    ctx.add(() => { startDrift(); startParting(); });

    const outward = (instant: boolean) => {
      drifts.splice(0).forEach((t) => t.kill());
      parts.splice(0).forEach((t) => { t.scrollTrigger?.kill(); t.kill(); });
      const w = window.innerWidth;
      floats.forEach((el, i) => {
        const dx = (Number(el.dataset.cx || 50) - 50) / 50;
        const dy = (Number(el.dataset.cy || 50) - 45) / 45;
        gsap.to(el, { x: dx * w * 0.4, y: dy * 260, xPercent: 0, yPercent: 0, opacity: 0.22, duration: instant || rm ? 0 : 1.1, delay: instant || rm ? 0 : (i % 6) * 0.03, ease: "power3.inOut" });
      });
    };

    const onStart = (instant = false) => {
      if (started) return;
      started = true;
      root.classList.add("is-quiz");
      outward(instant);
      if (!instant && !rm) gsap.fromTo(panel, { y: 80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.25, ease: "power3.out" });
      show(0);
      panel.focus({ preventScroll: true });
    };
    const onStartClick = () => onStart(false);

    const onNext = () => {
      if (!picked(cur)) return;
      if (cur === steps.length - 1) recommend();
      else show(cur + 1, 1);
    };
    const onBack = () => { if (cur > 0) show(cur - 1, -1); };
    const onRestart = () => {
      form.reset();
      result.hidden = true;
      form.hidden = false;
      show(0, -1);
    };
    const onSubmit = (e: Event) => e.preventDefault();
    const restart = root.querySelector("#dg-restart")!;

    start.addEventListener("click", onStartClick);
    next.addEventListener("click", onNext);
    back.addEventListener("click", onBack);
    form.addEventListener("change", sync);
    form.addEventListener("submit", onSubmit);
    restart.addEventListener("click", onRestart);
    show(0);

    // Test hooks: ?demo-step=N opens question N (1-based); ?demo-result jumps to the result.
    const qp = new URLSearchParams(location.search);
    const demoStep = Number(qp.get("demo-step"));
    if (qp.has("demo-result") || demoStep > 0) {
      onStart(true);
      const upto = qp.has("demo-result") ? steps.length : demoStep - 1;
      steps.forEach((s, k) => { if (k < upto) (s.querySelector("input") as HTMLInputElement).checked = true; });
      if (qp.has("demo-result")) recommend();
      else show(Math.min(demoStep - 1, steps.length - 1));
    }

    return () => {
      ctx.revert();
      start.removeEventListener("click", onStartClick);
      next.removeEventListener("click", onNext);
      back.removeEventListener("click", onBack);
      form.removeEventListener("change", sync);
      form.removeEventListener("submit", onSubmit);
      restart.removeEventListener("click", onRestart);
    };
  });
</script>
