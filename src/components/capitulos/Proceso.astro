---
/* Chapter: how the work goes. The three steps are the star: big numerals, big type, one CTA.
   Desktop (>= 1024px wide, >= 680px tall): the stage pins for one viewport and scroll reveals the steps in order;
   at the settled state title, steps and CTA sit together in one viewport.
   Mobile / short viewports / no JS / reduced motion: a plain vertical sequence, nothing pinned. */
import { stock } from "../../lib/stock";
import { cta, ctaTarget } from "../../lib/cta";

const foto = stock("proceso-cuaderno", 800);
const pasos = [
  { t: "Me contás el problema.", d: "Una charla de 30 minutos, gratis." },
  { t: "Te paso un precio cerrado.", d: "Por escrito y por etapas. Sin sorpresas." },
  { t: "Lo usás desde la primera etapa.", d: "Te enseño a usarlo y queda a tu nombre." },
];
---

<section id="proceso" class="pr" data-field="mist" aria-labelledby="proceso-title">
  <div class="pr__stage" data-stage>
    <div class="wrap pr__in">
      <h2 id="proceso-title" class="pr__title">CÓMO <small>se</small> TRABAJA</h2>

      <div class="pr__ph" data-ph>
        <img
          src={foto.src}
          srcset={foto.srcset}
          sizes="(min-width: 1024px) 30vw, 100vw"
          alt={foto.alt}
          width={foto.width}
          height={foto.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="pr__body">
        <ol class="pr__steps">
          {
            pasos.map((p, i) => (
              <li data-step>
                <span class="pr__n" data-n aria-hidden="true">{i + 1}</span>
                <div class="pr__txt" data-txt>
                  <h3>{p.t}</h3>
                  <p>{p.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="btn pr__cta" data-cta href={cta.href} {...ctaTarget}>{cta.label}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, onPage } from "../../scripts/motion";

  onPage(() => {
    const root = document.querySelector<HTMLElement>("#proceso");
    if (!root) return;
    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();
      const stage = root.querySelector<HTMLElement>("[data-stage]")!;
      const steps = gsap.utils.toArray<HTMLElement>("[data-step]", root);
      const photo = root.querySelector<HTMLElement>("[data-ph]")!;
      const cta = root.querySelector<HTMLElement>("[data-cta]")!;
      const motion = "(prefers-reduced-motion: no-preference)";

      // Desktop: pin for one viewport; the reveal starts a little before the pin so step 1 is never missing on arrival.
      mm.add(`(min-width: 1024px) and (min-height: 680px) and ${motion}`, () => {
        root.classList.add("is-live");

        ScrollTrigger.create({ trigger: stage, start: "top top", end: "+=100%", pin: true, anticipatePin: 1 });

        // 1.45 timeline units = 1.45 viewports of scroll: 0.45 on the way in, 1 while pinned.
        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          scrollTrigger: { trigger: stage, start: "top 45%", end: "+=145%", scrub: 0.6 },
        });
        tl.fromTo(photo, { clipPath: "inset(0 0 100% 0)" }, { clipPath: "inset(0 0 0% 0)", duration: 0.45, ease: "power2.inOut" }, 0);
        tl.fromTo(photo.querySelector("img"), { scale: 1.15 }, { scale: 1, duration: 0.6, ease: "none" }, 0);

        const starts = [0.1, 0.55, 0.9];
        steps.forEach((li, i) => {
          const at = starts[i] ?? 0.9;
          tl.fromTo(li.querySelector("[data-n]"), { scale: 0.4, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.2, ease: "back.out(1.6)" }, at);
          tl.fromTo(li.querySelector("[data-txt]"), { y: 40, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.28 }, at + 0.03);
          // Connector down to the next step grows once this one has landed
          if (i < steps.length - 1) tl.fromTo(li, { "--k": 0 }, { "--k": 1, duration: 0.2, ease: "none" }, at + 0.22);
        });
        tl.fromTo(cta, { y: 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.15 }, 1.2);
        tl.to({}, { duration: 0.1 }, 1.35); // hold on the settled state

        return () => root.classList.remove("is-live");
      });

      // Everything else with motion allowed: each step rises as it enters, no pin.
      mm.add(`${motion} and (max-width: 1023px), ${motion} and (max-height: 679px)`, () => {
        steps.forEach((li) => {
          const st = { trigger: li, start: "top 85%", once: true };
          gsap.from(li.querySelector("[data-n]"), { scale: 0.4, autoAlpha: 0, duration: 0.6, ease: "back.out(1.6)", scrollTrigger: st });
          gsap.from(li.querySelector("[data-txt]"), { y: 28, autoAlpha: 0, duration: 0.8, ease: "power4.out", delay: 0.08, scrollTrigger: st });
          gsap.fromTo(li, { "--k": 0 }, { "--k": 1, duration: 0.6, ease: "power2.out", delay: 0.3, scrollTrigger: st });
        });
        gsap.from(cta, { y: 20, autoAlpha: 0, duration: 0.7, ease: "power4.out", scrollTrigger: { trigger: cta, start: "top 92%", once: true } });
      });

      // Chapters can be created out of DOM order; keep refresh order by position so earlier pins are measured first.
      ScrollTrigger.sort();
    }, root);
    return () => ctx.revert();
  });
</script>

<style>
  .pr {
    --tile: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    --gap: clamp(1.75rem, 1.2rem + 1.6vw, 2.25rem);
    overflow-x: clip;
  }

  .pr__stage { padding-block: clamp(4rem, 9vw, 6rem); }
  .pr__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }

  .pr__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.25rem, 1.4rem + 8.4vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }
  .pr__title small { font-family: var(--font-sans); font-weight: 400; font-size: 0.32em; text-transform: none; letter-spacing: 0; }

  .pr__ph { position: relative; overflow: hidden; aspect-ratio: 3 / 2; }
  .pr__ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  .pr__body { display: grid; gap: var(--gap); justify-items: start; }

  .pr__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); width: 100%; }
  .pr__steps li {
    --k: 1;
    position: relative;
    display: grid;
    grid-template-columns: var(--tile) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }
  /* Thick connector between numerals: the steps read as one sequence */
  .pr__steps li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--tile) / 2 - 3px);
    top: var(--tile);
    bottom: calc(-1 * var(--gap));
    width: 6px;
    background: var(--color-ink);
    transform: scaleY(var(--k));
    transform-origin: 50% 0;
  }

  .pr__n {
    display: grid;
    place-items: center;
    width: var(--tile);
    aspect-ratio: 1 / 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--tile) * 0.66);
    line-height: 1;
    background: var(--color-field-lime);
    color: var(--color-ink);
  }
  .pr__steps li:nth-child(2) .pr__n { background: var(--color-field-cornflower); }
  .pr__steps li:nth-child(3) .pr__n { background: var(--color-field-night); color: var(--color-paper); }

  .pr__txt { min-height: var(--tile); display: grid; align-content: center; gap: 0.35rem; }
  .pr__txt h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem);
    line-height: 0.98;
    margin: 0;
    text-wrap: balance;
  }
  .pr__txt p { margin: 0; font-size: var(--step-lead); line-height: 1.3; }

  .pr__cta { width: 100%; min-height: 3.5rem; padding-block: 0.75rem; text-align: center; }

  @media (min-width: 640px) {
    .pr__cta { width: auto; margin-left: calc(var(--tile) + clamp(1rem, 2vw, 1.5rem)); }
  }

  /* Wide: title across the top, the notebook on the left, the steps on the right */
  @media (min-width: 1024px) {
    .pr__in {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-areas: "title title" "photo body";
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: clamp(1.5rem, 3vw, 2.5rem);
      width: 100%;
    }
    .pr__title { grid-area: title; }
    .pr__ph { grid-area: photo; aspect-ratio: auto; min-height: 18rem; }
    .pr__body { grid-area: body; }
  }

  /* Live (pinned) mode, enabled from JS: everything is sized against the viewport height so it frames whole */
  .is-live { --tile: min(5.5rem, 11svh); --gap: min(2.25rem, 3.6svh); }
  .is-live .pr__stage { height: 100svh; padding-block: 2rem; display: grid; align-items: center; }
  .is-live .pr__in { row-gap: min(2.5rem, 4svh); }
  .is-live .pr__title { font-size: min(8rem, 9vw, 15svh); }
  .is-live .pr__ph { min-height: 0; }
  .is-live .pr__txt h3 { font-size: min(3.5rem, 3.6vw, 6.2svh); }
</style>
