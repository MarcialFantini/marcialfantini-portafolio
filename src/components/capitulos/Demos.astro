---
// Chapter "Sistemas que podés ver": three demo systems shown as drawn, live-looking interfaces.
// They are demos, never client work; every figure inside a window is sample data.
import demos from "../../data/demos.json";
import { getPublishedProjects } from "../../lib/content";
import StockUI from "../demos-ui/StockUI.astro";
import VentasUI from "../demos-ui/VentasUI.astro";
import PedidosUI from "../demos-ui/PedidosUI.astro";

// Demo id -> sector label.
const SECTOR: Record<string, string> = {
  "inventario-distribuidora": "Distribución",
  "dashboard-ventas": "Venta mayorista",
  "tracker-pedidos": "Pedidos",
  "integracion-mercadolibre-erp": "Comercio online",
  "automatizacion-crm-whatsapp": "Salud",
  "catalogo-ferreteria": "Ferretería",
  "ecommerce-marca": "Muebles",
  "blog-consultora": "Consultoría",
};

const projects = await getPublishedProjects();
const published = new Set(projects.map((p) => p.id));

// The home shows only three demos, all built end to end in-house (no third-party platform):
// stock, sales KPIs and order tracking. The full list lives on /proyectos.
const FEATURED = [
  {
    id: "inventario-distribuidora",
    slot: "lead",
    Ui: StockUI,
    line: "Stock por depósito siempre al día, con aviso de reposición antes de que falte mercadería.",
  },
  {
    id: "dashboard-ventas",
    slot: "left",
    Ui: VentasUI,
    line: "Las ventas del mes, los productos que más salen y la comparación con el año anterior, en una sola pantalla.",
  },
  {
    id: "tracker-pedidos",
    slot: "right",
    Ui: PedidosUI,
    line: "Cada cliente mayorista sigue el estado de su pedido en tiempo real, sin llamar para preguntar.",
  },
];

const cards = FEATURED.flatMap((f) => {
  const d = demos.find((x) => x.id === f.id);
  if (!d) return [];
  return [{ ...f, nombre: d.nombre, sector: SECTOR[d.id] ?? "", href: published.has(d.id) ? `/proyectos/${d.id}` : null }];
});

// Text strip: the sectors of the remaining demos, each linking to its own page.
const featuredIds = new Set(FEATURED.map((f) => f.id));
const others = demos
  .filter((d) => !featuredIds.has(d.id) && SECTOR[d.id] && published.has(d.id))
  .map((d) => ({ sector: SECTOR[d.id], nombre: d.nombre, href: `/proyectos/${d.id}` }));
---

<section id="demos" class="cap-demos" data-field="paper" aria-labelledby="demos-title">
  <div class="wrap cap-demos__inner">
    <header class="head">
      <h2 id="demos-title">SISTEMAS <small>que</small><br />PODÉS VER</h2>
      <div class="head__copy">
        <p class="head__lead">Stock, ventas y pedidos: tres sistemas de operación armados de punta a punta, para que veas el software antes de hablar.</p>
        <p class="head__note">Son sistemas de demostración, no trabajos para clientes. Muestran el punto de partida que adapto a cada empresa.</p>
      </div>
    </header>

    <ul class="cards" role="list">
      {cards.map((c) => {
        const Ui = c.Ui;
        const inner = (
          <>
            <div class="card__ui"><Ui /></div>
            <div class="card__cap">
              <span class="card__sector">{c.sector}</span>
              <span class="card__name">{c.nombre}</span>
              <span class="card__line">{c.line}</span>
              {c.href && <span class="card__go">Ver el sistema <span class="card__arr" aria-hidden="true">→</span></span>}
            </div>
          </>
        );
        return (
          <li class={`card card--${c.slot}`}>
            {c.href ? <a class="card__link" href={c.href}>{inner}</a> : <div class="card__link">{inner}</div>}
          </li>
        );
      })}
    </ul>

    {others.length > 0 && (
      <div class="more">
        <p class="more__t">También hay demos para otros rubros</p>
        <ul class="more__list" role="list">
          {others.map((o) => <li><a href={o.href} title={o.nombre}>{o.sector}</a></li>)}
        </ul>
        <a class="more__all" href="/proyectos">Ver todos los proyectos demo</a>
      </div>
    )}
  </div>
</section>

<style>
  .cap-demos { padding-block: clamp(4rem, 8vw, 6rem); overflow-x: clip; }
  .cap-demos__inner { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); }

  h2 {
    margin: 0; font-family: var(--font-display); font-weight: 600; line-height: 0.9;
    font-size: clamp(3.25rem, 15vw, 5rem); text-transform: uppercase; letter-spacing: -0.01em;
  }
  h2 small { font-family: var(--font-sans); font-weight: 400; font-size: 0.4em; text-transform: none; letter-spacing: 0; }
  .head { display: grid; gap: 1.5rem; }
  .head__copy { display: grid; gap: 0.75rem; max-width: 34rem; }
  .head__copy p { margin: 0; }
  .head__lead { font-size: var(--step-lead); line-height: 1.3; }
  .head__note { font-size: var(--step-body); color: var(--color-soft); }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 3.5rem; }
  .card { min-width: 0; }
  .card__link { display: grid; gap: 1.1rem; color: inherit; text-decoration: none; }
  .card__ui { min-width: 0; transition: transform 0.5s var(--ease-out-expo); }
  .card__cap { display: grid; gap: 0.3rem; justify-items: start; }
  .card__sector { font-size: 1rem; color: var(--color-soft); }
  .card__name { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem); line-height: 1; }
  .card__line { font-size: var(--step-body); line-height: 1.45; max-width: 38ch; }
  .card__go { margin-top: 0.4rem; font-weight: 500; text-decoration: underline; text-underline-offset: 0.25em; }
  .card__arr { display: inline-block; transition: transform 0.35s var(--ease-out-expo); }
  a.card__link:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 6px; }
  @media (hover: hover) {
    a.card__link:hover .card__ui { transform: translateY(-6px); }
    a.card__link:hover .card__arr { transform: translateX(0.4rem); }
    a.card__link:hover .card__go { color: var(--color-accent); }
  }

  .more { display: grid; gap: 0.9rem; justify-items: start; }
  .more__t { margin: 0; font-size: var(--step-body); font-weight: 500; }
  .more__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .more__list a {
    display: block; padding: 0.5rem 0.8rem; background: var(--color-field-mist); color: var(--color-ink);
    font-size: 1rem; font-weight: 500; text-decoration: none; transition: background-color 0.18s, color 0.18s;
  }
  .more__list a:hover, .more__list a:focus-visible { background: var(--color-field-night); color: var(--color-paper); }
  .more__all { color: var(--color-ink); font-weight: 500; text-underline-offset: 0.25em; }

  @media (min-width: 900px) {
    h2 { font-size: clamp(5rem, 9vw, 9rem); }
    .head { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: 3rem; }
    .head__copy { justify-self: end; padding-bottom: 0.5rem; }

    /* One large lead interface with its caption beside it, then two smaller ones on offset rows */
    .cards { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; row-gap: 5rem; align-items: start; }
    .card--lead { grid-column: 1 / -1; }
    .card--lead .card__link { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: 2rem; align-items: end; }
    .card--left { grid-column: 1 / span 5; }
    .card--right { grid-column: 7 / -1; margin-top: 6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__ui, .card__arr { transition: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, onPage, reduced } from "../../scripts/motion";

  onPage(() => {
    const root = document.getElementById("demos");
    // Reduced motion: each screen stays in its static, fully drawn state.
    if (!root || reduced()) return;
    const fmt = new Intl.NumberFormat("es-AR");

    const ctx = gsap.context(() => {
      root.querySelectorAll<HTMLElement>("[data-ui]").forEach((ui) => {
        const all = (sel: string) => Array.from(ui.querySelectorAll<HTMLElement>(sel));

        // 1. Assemble once on scroll: rows in, bars growing, figures counting up.
        const intro = gsap.timeline({ paused: true, defaults: { ease: "power3.out" } });
        intro.from(all("[data-row]"), { opacity: 0, y: 14, duration: 0.5, stagger: 0.06 }, 0);
        const gx = all("[data-grow-x]");
        if (gx.length) intro.from(gx, { scaleX: 0, transformOrigin: "0% 50%", duration: 0.8, stagger: 0.04 }, 0.2);
        const gy = all("[data-grow-y]");
        if (gy.length) intro.from(gy, { scaleY: 0, transformOrigin: "50% 100%", duration: 0.8, stagger: 0.04 }, 0.2);
        all("[data-count]").forEach((el) => {
          const to = Number(el.dataset.count);
          const pre = el.dataset.pre ?? "";
          const o = { v: 0 };
          intro.to(o, { v: to, duration: 1.1, ease: "power2.out", onUpdate: () => { el.textContent = pre + fmt.format(Math.round(o.v)); } }, 0.15);
        });

        // 2. One small state change, played forwards and back for as long as the screen is visible.
        const loop = gsap.timeline({ paused: true, repeat: -1, yoyo: true, repeatDelay: 2.6, delay: 1.2, defaults: { ease: "power2.out" } });
        const off = all("[data-off]"), on = all("[data-on]"), fill = all("[data-fill]"), bump = all("[data-bump]");
        if (off.length) loop.to(off, { opacity: 0, duration: 0.3 }, 0);
        if (on.length) loop.to(on, { opacity: 1, duration: 0.4 }, 0.2);
        if (fill.length) loop.to(fill, { scaleX: 1, duration: 0.7 }, 0.2);
        if (bump.length) loop.to(bump, { scaleY: 1.03, transformOrigin: "50% 100%", duration: 0.6 }, 0.2);

        let visible = false, ready = false;
        intro.eventCallback("onComplete", () => { ready = true; if (visible) loop.play(); });
        ScrollTrigger.create({ trigger: ui, start: "top 82%", once: true, onEnter: () => intro.play() });
        // Paused while off-screen.
        ScrollTrigger.create({
          trigger: ui, start: "top bottom", end: "bottom top",
          onToggle: (self) => {
            visible = self.isActive;
            if (!ready) return;
            if (visible) loop.play(); else loop.pause();
          },
        });
      });
    }, root);
    return () => ctx.revert();
  });
</script>
