---
import demos from "../../data/demos.json";
import { stock, stockGroup } from "../../lib/stock";
import { getPublishedProjects } from "../../lib/content";
import Video from "./Video.astro";

// Demo id -> placeholder stock photo + sector label shown under the tile.
const MAP: Record<string, { photo: string; sector: string }> = {
  "inventario-distribuidora": { photo: "rubro-distribuidora", sector: "Distribución" },
  "dashboard-ventas": { photo: "rubro-mayorista", sector: "Venta mayorista" },
  "tracker-pedidos": { photo: "rubro-pedidos", sector: "Pedidos" },
  "dashboard-cobranzas": { photo: "caos-ticket-mano", sector: "Cobranzas" },
  "integracion-mercadolibre-erp": { photo: "ciclo-escaneo", sector: "Comercio online" },
  "pos-mobile-pyme": { photo: "rubro-dietetica", sector: "Dietética" },
  "automatizacion-crm-whatsapp": { photo: "rubro-clinica", sector: "Salud" },
  "panel-reservas-restaurante": { photo: "rubro-restaurante", sector: "Gastronomía" },
  "reservas-peluqueria": { photo: "rubro-peluqueria", sector: "Peluquería" },
  "catalogo-ferreteria": { photo: "rubro-ferreteria", sector: "Ferretería" },
  "ecommerce-marca": { photo: "rubro-muebles", sector: "Muebles" },
  "checkout-artesanal": { photo: "rubro-panaderia", sector: "Panadería" },
  "tienda-shopify-headless": { photo: "rubro-moda", sector: "Indumentaria" },
  "auditoria-performance-ecommerce": { photo: "rubro-auditoria", sector: "Tienda online" },
  "leads-inmobiliaria": { photo: "rubro-inmobiliaria", sector: "Inmobiliaria" },
  "estudio-juridico-morales": { photo: "rubro-juridico", sector: "Servicios jurídicos" },
  "landing-lanzamiento-producto": { photo: "rubro-lanzamiento", sector: "Lanzamiento" },
  "blog-consultora": { photo: "rubro-consultora", sector: "Consultoría" },
  "migracion-wordpress-editorial": { photo: "rubro-revista", sector: "Editorial" },
};

const projects = await getPublishedProjects();
const published = new Set(projects.map((p) => p.id));
const lineOf = new Map(projects.map((p) => [p.id, p.data.descripcion]));

// The home shows only three demos, all built end to end in-house (no third-party platform):
// stock, sales KPIs and order tracking. The full list lives on /proyectos.
const FEATURED = ["inventario-distribuidora", "dashboard-ventas", "tracker-pedidos"];

const tiles = FEATURED.map((id) => demos.find((d) => d.id === id))
  .filter((d): d is (typeof demos)[number] => !!d && !!MAP[d.id])
  .map((d, i) => ({
    id: d.id,
    nombre: d.nombre,
    sector: MAP[d.id].sector,
    line: lineOf.get(d.id) ?? "",
    photo: stock(MAP[d.id].photo, 800),
    href: published.has(d.id) ? `/proyectos/${d.id}` : null,
    shape: i % 3 === 1 ? "tall" : i % 3 === 2 ? "short" : "mid",
  }));

// Photo band: mixed placeholder photos + two short videos, varied ratios.
const pool = [...stockGroup("rubro-", 640), ...stockGroup("caos-", 640), ...stockGroup("equipo-", 640)];
const pick = [0, 7, 14, 3, 10, 17, 5, 12, 1, 8, 15, 4].map((i) => pool[i % pool.length]);
const RATIOS = ["3-4", "1-1", "3-2", "1-1", "3-4", "3-2"];
type Item =
  | { kind: "img"; p: (typeof pool)[number]; r: string }
  | { kind: "vid"; name: "local" | "reparto"; r: string };
const band: Item[] = pick.map((p, i) => ({ kind: "img", p, r: RATIOS[i % RATIOS.length] }));
band.splice(3, 0, { kind: "vid", name: "local", r: "3-2" });
band.splice(9, 0, { kind: "vid", name: "reparto", r: "3-4" });
---

<section id="demos" class="cap-demos" data-field="paper" aria-labelledby="demos-title">
  <div class="cap-demos__inner">
    <!-- Title first: under the strip, each tile's sector line would read as a label above it -->
    <div class="cap-demos__foot wrap">
      <h2 id="demos-title">PROYECTOS <small>de</small> DEMO</h2>
      <div class="cap-demos__copy">
        <p>Son demos que armé para mostrar cómo funciona cada solución. Ninguno es un cliente: los negocios y las cifras son escenarios de ejemplo.</p>
        <a class="cap-demos__all" href="/proyectos">Ver todos los proyectos demo</a>
      </div>
    </div>
    <div class="cap-demos__carousel">
      <ul class="cap-demos__strip" role="list" tabindex="0" aria-label="Proyectos demo">
        {tiles.map((t) => {
          const inner = (
            <>
              <span class="tile__photo">
                <img src={t.photo.src} srcset={t.photo.srcset} sizes="(min-width: 768px) 33vw, 72vw" alt="" width={t.photo.width} height={t.photo.height} loading="lazy" decoding="async" draggable="false" />
                <span class="tile__chip">Demo</span>
              </span>
              <span class="tile__name">{t.nombre}</span>
              <span class="tile__sector">{t.sector}</span>
              <span class="tile__line">{t.line}</span>
            </>
          );
          return (
            <li class={`tile tile--${t.shape}`}>
              {t.href ? <a class="tile__link" href={t.href} draggable="false">{inner}</a> : <div class="tile__link">{inner}</div>}
            </li>
          );
        })}
      </ul>
      <div class="cap-demos__controls wrap" data-controls hidden>
        <div class="cap-demos__track" aria-hidden="true"><span class="cap-demos__thumb"></span></div>
        <div class="cap-demos__btns">
          <button type="button" class="cap-demos__btn" aria-label="Proyectos anteriores">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M20 12H4M10 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="cap-demos__btn" aria-label="Proyectos siguientes">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M4 12h16M14 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="band" aria-hidden="true">
      <div class="band__run">
        {[0, 1].map(() => (
          <ul class="band__set" role="presentation">
            {band.map((b) => (
              <li class={`band__item r-${b.r}`}>
                {b.kind === "img" ? <img src={b.p.src} alt="" width={b.p.width} height={b.p.height} loading="lazy" decoding="async" draggable="false" /> : <Video name={b.name} />}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cap-demos { padding-block: clamp(4rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem); overflow-x: clip; }
  .cap-demos__inner { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); }

  .cap-demos__strip {
    list-style: none; margin: 0; padding: 0 var(--gutter);
    display: flex; align-items: flex-start; gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain; scrollbar-width: none;
  }
  .cap-demos__strip::-webkit-scrollbar { display: none; }
  .cap-demos__strip:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }
  .cap-demos__strip.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .cap-demos__strip.is-dragging :global(a) { pointer-events: none; }

  .tile { flex: 0 0 72vw; scroll-snap-align: start; }
  .tile__link { display: block; color: inherit; text-decoration: none; }
  .tile__photo { position: relative; display: block; overflow: hidden; background: var(--color-field-mist); }
  .tile img { display: block; width: 100%; object-fit: cover; aspect-ratio: 4 / 5; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .tile--tall img { aspect-ratio: 3 / 4; }
  .tile--short img { aspect-ratio: 5 / 6; }
  .tile__chip {
    position: absolute; top: 0; left: 0; padding: 0.4rem 0.75rem;
    background: var(--color-ink); color: var(--color-paper); font-size: 0.875rem; font-weight: 500; line-height: 1;
  }
  .tile__name { display: block; margin-top: 0.75rem; font-size: 1.0625rem; font-weight: 500; line-height: 1.25; }
  .tile__sector { display: block; margin-top: 0.125rem; font-size: 1rem; color: var(--color-soft); }
  /* Reserved height so the reveal never shifts the layout. */
  .tile__line { display: block; margin-top: 0.25rem; min-height: 4.5em; font-size: 1rem; line-height: 1.5; }
  a.tile__link:hover .tile__name, a.tile__link:focus-visible .tile__name { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (hover: hover) {
    .tile__line { opacity: 0; transform: translateY(0.75rem); transition: opacity 0.35s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .tile__link:hover .tile__line, .tile__link:focus-visible .tile__line { opacity: 1; transform: none; }
    .tile__link:hover img, .tile__link:focus-visible img { transform: scale(1.04); }
  }

  .cap-demos__controls { display: flex; align-items: center; gap: 1.5rem; }
  .cap-demos__controls[hidden] { display: none; }
  .cap-demos__track { position: relative; flex: 1; height: 4px; background: var(--color-field-mist); }
  .cap-demos__thumb { position: absolute; inset: 0 auto 0 0; width: 20%; background: var(--color-ink); will-change: transform; }
  .cap-demos__btns { display: flex; gap: 0.5rem; }
  .cap-demos__btn {
    width: 3rem; height: 3rem; display: grid; place-items: center; cursor: pointer;
    background: var(--color-ink); color: var(--color-paper); border: 0; border-radius: 0;
  }
  .cap-demos__btn:hover:not(:disabled) { background: var(--color-accent); color: #fff; }
  .cap-demos__btn:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .cap-demos__btn:disabled { opacity: 0.35; cursor: default; }

  h2 {
    margin: 0; font-family: var(--font-display); font-weight: 600; line-height: 0.9;
    font-size: clamp(3.25rem, 15vw, 5rem); text-transform: uppercase; letter-spacing: -0.01em;
  }
  h2 small { font-family: var(--font-sans); font-weight: 400; font-size: 0.4em; text-transform: none; letter-spacing: 0; }
  .cap-demos__foot { display: grid; gap: 1.25rem; align-items: end; }
  .cap-demos__copy p { margin: 0 0 0.75rem; font-size: var(--step-body); max-width: 44ch; }
  .cap-demos__all { color: var(--color-ink); font-weight: 500; text-underline-offset: 0.25em; }

  /* Photo band: two identical sets, the run slides by exactly one set width. */
  .band { --bh: 120px; overflow: hidden; margin-top: clamp(0.5rem, 2vw, 1.5rem); }
  .band__run { display: flex; width: max-content; animation: band-drift 70s linear infinite; }
  .band:hover .band__run { animation-play-state: paused; }
  .band__set { list-style: none; margin: 0; padding: 0 0.75rem 0 0; display: flex; gap: 0.75rem; }
  .band__item { flex: none; height: var(--bh); overflow: hidden; background: var(--color-field-mist); }
  .band__item.r-3-4 { aspect-ratio: 3 / 4; }
  .band__item.r-1-1 { aspect-ratio: 1 / 1; }
  .band__item.r-3-2 { aspect-ratio: 3 / 2; }
  .band__item img, .band__item :global(.vslot) { width: 100%; height: 100%; object-fit: cover; display: block; }
  @keyframes band-drift { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .band__run { animation: none; } }

  @media (min-width: 768px) {
    /* Three demos share the content width: no carousel, every description visible */
    .cap-demos__strip {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible;
      max-width: var(--content-max); margin-inline: auto; width: 100%; box-sizing: border-box;
    }
    .tile:nth-child(even) { margin-top: clamp(1rem, 3vw, 3rem); }
    .tile__line { opacity: 1 !important; transform: none !important; }
    .cap-demos__foot { gap: 1rem; }
    .cap-demos__copy { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 2.5rem; padding-bottom: 0.6em; }
    .cap-demos__copy p { margin: 0; }
    h2 { font-size: clamp(5rem, 9.5vw, 10rem); white-space: nowrap; }
    .band { --bh: 180px; }
    .tile__line { min-height: 3em; }
  }
</style>

<script>
  import { onPage } from "../../scripts/motion";

  onPage(() => {
    const root = document.querySelector<HTMLElement>("#demos");
    const strip = root?.querySelector<HTMLElement>(".cap-demos__strip");
    const controls = root?.querySelector<HTMLElement>("[data-controls]");
    const thumb = root?.querySelector<HTMLElement>(".cap-demos__thumb");
    if (!root || !strip || !controls || !thumb) return;
    controls.hidden = false;
    const [prev, next] = Array.from(controls.querySelectorAll<HTMLButtonElement>(".cap-demos__btn"));
    const ac = new AbortController();
    const { signal } = ac;

    const update = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      const ratio = strip.scrollWidth ? strip.clientWidth / strip.scrollWidth : 1;
      const w = Math.max(0.12, Math.min(1, ratio));
      thumb.style.width = `${w * 100}%`;
      const p = max > 0 ? strip.scrollLeft / max : 0;
      thumb.style.transform = `translateX(${p * (1 / w - 1) * 100}%)`;
      // Three tiles fit on desktop: the controls only appear when the row really scrolls.
      controls.hidden = max <= 2;
      prev.disabled = strip.scrollLeft <= 2;
      next.disabled = strip.scrollLeft >= max - 2;
    };
    const go = (dir: number) =>
      strip.scrollBy({ left: dir * Math.max(240, strip.clientWidth * 0.7), behavior: "smooth" });
    prev.addEventListener("click", () => go(-1), { signal });
    next.addEventListener("click", () => go(1), { signal });
    strip.addEventListener("scroll", update, { passive: true, signal });
    window.addEventListener("resize", update, { signal });
    strip.addEventListener(
      "keydown",
      (e) => {
        if (e.target !== strip) return;
        if (e.key === "ArrowRight") { e.preventDefault(); go(1); }
        else if (e.key === "ArrowLeft") { e.preventDefault(); go(-1); }
        else if (e.key === "Home") { e.preventDefault(); strip.scrollTo({ left: 0, behavior: "smooth" }); }
        else if (e.key === "End") { e.preventDefault(); strip.scrollTo({ left: strip.scrollWidth, behavior: "smooth" }); }
      },
      { signal },
    );

    // Mouse drag-to-scroll; a drag never counts as a click on a tile.
    let down = false, moved = false, startX = 0, startLeft = 0;
    strip.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        down = true; moved = false; startX = e.clientX; startLeft = strip.scrollLeft;
      },
      { signal },
    );
    window.addEventListener(
      "pointermove",
      (e) => {
        if (!down) return;
        const dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 5) { moved = true; strip.classList.add("is-dragging"); }
        if (moved) strip.scrollLeft = startLeft - dx;
      },
      { signal },
    );
    const end = () => {
      if (!down) return;
      down = false;
      if (!moved) return;
      strip.classList.remove("is-dragging");
      // Re-snap to the nearest tile after releasing.
      const items = Array.from(strip.children) as HTMLElement[];
      const pad = parseFloat(getComputedStyle(strip).paddingLeft);
      const target = items.reduce((a, b) =>
        Math.abs(b.offsetLeft - pad - strip.scrollLeft) < Math.abs(a.offsetLeft - pad - strip.scrollLeft) ? b : a,
      );
      strip.scrollTo({ left: target.offsetLeft - pad, behavior: "smooth" });
    };
    window.addEventListener("pointerup", end, { signal });
    window.addEventListener("pointercancel", end, { signal });
    strip.addEventListener(
      "click",
      (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } },
      { capture: true, signal },
    );
    strip.addEventListener("dragstart", (e) => e.preventDefault(), { signal });

    update();
    return () => ac.abort();
  });
</script>
