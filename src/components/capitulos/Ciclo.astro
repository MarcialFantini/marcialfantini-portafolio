---
/* Chapter: the answer to Caos. The same sources from the mess (WhatsApp, web shop, spreadsheet, invoicing)
   flow into one system and come out as results (dashboard, alert, invoice, backup).
   Desktop (>= 1024px wide, >= 700px tall, motion allowed): the section pins and scroll walks the four steps:
     Conectar: the tilted source cards straighten and wire in.
     Crear: the system fills its log and the stock figure settles on one number.
     Informar / Respaldar: results come out on the right.
   Other sizes: stacked flow that assembles once on entry. No JS / reduced motion: final state, all visible.
   Everything in the cards is sample data. */
import Ventana from "../demos-ui/Ventana.astro";

const inputs = [
  { src: "WhatsApp", text: "Pedido Sra. Gómez: 3 cajas 30x40" },
  { src: "Tienda web", text: "Pedido #2087 · 2 cajas 30x40" },
  { src: "Planilla", text: "Stock_FINAL.xlsx · 142 u." },
  { src: "Facturación", text: "Rosales · factura pendiente" },
];

const log = [
  { src: "Planilla", what: "Stock importado", val: "+142" },
  { src: "WhatsApp", what: "Pedido Sra. Gómez", val: "−3" },
  { src: "Tienda web", what: "Pedido #2087", val: "−2" },
  { src: "Facturación", what: "Factura A a Rosales", val: "Emitida" },
];

const outputs = [
  { kind: "Tablero del día", text: "23 pedidos · $ 1.284.300", tone: "" },
  { kind: "Aviso de reposición", text: "Caja 30x40 bajo el mínimo", tone: "alert" },
  { kind: "Factura", text: "A 0003-00012845 enviada a Rosales", tone: "" },
  { kind: "Respaldo", text: "Copia de hoy 03:00 · Guardada", tone: "" },
];

const steps = [
  { name: "Conectar", p: "WhatsApp, la tienda, las planillas y la facturación cargan en un mismo lugar." },
  { name: "Crear", p: "Un sistema hecho a cómo ya trabajás: cada dato se carga una sola vez." },
  { name: "Informar", p: "Tablero, avisos y facturas salen solos, sin armar informes a mano." },
  { name: "Respaldar", p: "Copias diarias, procesos por escrito y soporte directo si algo falla." },
];
---

<section id="ciclo" class="cap-ciclo" data-field="night" aria-labelledby="ciclo-title">
  <div class="stage" data-stage>
    <div class="wrap stage__in">
      <header class="head">
        <h2 id="ciclo-title" class="title">Así <small>se</small> ordena</h2>
        <p class="lead">Lo que hoy vive en cuatro lugares pasa a uno solo. Se carga una vez y se ve en todos lados.</p>
      </header>

      <div class="flow" data-flow>
        <div class="col col--in">
          {
            inputs.map((c) => (
              <div class="card card--in" data-in>
                <span class="card__src">{c.src}</span>
                <span class="card__t">{c.text}</span>
              </div>
            ))
          }
        </div>

        <div class="col col--lin" aria-hidden="true">
          {inputs.map(() => <span class="link" data-lin><i class="link__run"><b></b></i></span>)}
        </div>
        <span class="vlink" data-vlink aria-hidden="true"><i class="vlink__run"><b></b></i></span>

        <div class="core" data-core>
          <Ventana ui="sistema" title="Tu sistema" where="Stock y pedidos" label="Ejemplo: el sistema reúne los cuatro movimientos y muestra un solo número de stock, 137 unidades de caja 30x40.">
            <div class="sku">
              <span class="sku__name">Caja 30x40 reforzada</span>
              <span class="sku__n"><b data-stock>137</b> u.</span>
              <span class="sku__note soft">Un solo número, en todos los depósitos</span>
            </div>
            <ol class="log">
              {
                log.map((r) => (
                  <li class="log__row" data-log>
                    <span class="chip">{r.src}</span>
                    <span class="log__what">{r.what}</span>
                    <span class="log__val">{r.val}</span>
                  </li>
                ))
              }
            </ol>
          </Ventana>
        </div>

        <span class="vlink" data-vlink aria-hidden="true"><i class="vlink__run"><b></b></i></span>
        <div class="col col--lout" aria-hidden="true">
          {outputs.map(() => <span class="link" data-lout><i class="link__run"><b></b></i></span>)}
        </div>

        <div class="col col--out">
          {
            outputs.map((c) => (
              <div class:list={["card card--out", c.tone && `card--${c.tone}`]} data-out>
                <span class="card__src">{c.kind}</span>
                <span class="card__t">{c.text}</span>
              </div>
            ))
          }
        </div>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-step>
              <span class="step__bar" data-stepbar aria-hidden="true" />
              <h3 class="step__h">
                <span class="step__n">{i + 1}</span> {s.name}
              </h3>
              <p class="step__p">{s.p}</p>
            </li>
          ))
        }
      </ol>

      <a class="more" href="#diagnostico">¿Por dónde empezar en tu empresa? Hacé el diagnóstico <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cap-ciclo { position: relative; overflow: hidden; }
  .stage { padding-block: clamp(4rem, 9vw, 7rem); }
  .stage__in { display: grid; gap: 2.5rem; }

  /* Heading: mirrors "ASÍ se trabaja HOY" from Caos */
  .head { display: grid; gap: 1rem; }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(3.25rem, 1.5rem + 8vw, 7.5rem);
    line-height: 0.9;
    margin: 0;
  }
  .title :global(small) {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: none;
    font-size: 0.36em;
  }
  .lead { font-size: var(--step-lead); line-height: 1.3; max-width: 30ch; margin: 0; opacity: 0.9; }

  /* ---------- Flow: inputs → system → results ---------- */
  .flow { display: grid; gap: 0.75rem; }
  .col--in, .col--out { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .col--lin, .col--lout { display: none; }

  .card {
    display: grid; gap: 0.2rem; align-content: start;
    padding: 0.75rem 0.85rem;
    background: var(--color-paper); color: var(--color-ink);
    font-size: 0.9375rem; line-height: 1.25;
  }
  .card__src { display: flex; align-items: center; gap: 0.45rem; font-size: 0.8125rem; font-weight: 600; }
  .card__src::before { content: ""; width: 0.55rem; height: 0.55rem; flex: none; background: var(--color-field-cornflower); }
  .card--out .card__src::before { background: var(--color-field-night); }
  .card--alert { background: var(--color-field-lime); }
  .card__t { font-variant-numeric: tabular-nums; }

  .core :global(.win) { font-size: 0.9375rem; }
  /* The frame bar would vanish into the night field: lift it one step */
  .core :global(.win__bar) { background: #262c38; }
  .sku { display: grid; gap: 0.1rem; }
  .sku__name { font-weight: 600; }
  .sku__n { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.75rem, 2rem + 2vw, 3.75rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .sku__note { font-size: 0.875rem; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .log__row {
    display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) auto; gap: 0.6rem; align-items: center;
    padding: 0.45rem 0.55rem; background: var(--color-paper); font-variant-numeric: tabular-nums;
  }
  .log__row .chip { justify-self: start; }
  .log__what { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .log__val { font-weight: 600; }

  /* Connectors: a line with a lime square travelling along it while the chapter is on screen */
  .link, .vlink { position: relative; display: block; overflow: hidden; }
  /* The box is 8px thick so the travelling square is not clipped; the visible line is the 2px ::before */
  .link { height: 8px; transform-origin: 0 50%; }
  .vlink { width: 8px; height: 2.25rem; justify-self: center; }
  .link::before, .vlink::before { content: ""; position: absolute; background: rgba(242, 241, 236, 0.35); }
  .link::before { left: 0; right: 0; top: 3px; height: 2px; }
  .vlink::before { top: 0; bottom: 0; left: 3px; width: 2px; }
  .link__run, .vlink__run { position: absolute; inset: 0; display: block; }
  .link__run b, .vlink__run b { position: absolute; width: 8px; height: 8px; background: var(--color-field-lime); }
  .link__run b { right: 0; top: 0; }
  .vlink__run b { bottom: 0; left: 0; }
  .cap-ciclo.is-flowing .link__run { animation: run-x 1.6s linear infinite; }
  .cap-ciclo.is-flowing .vlink__run { animation: run-y 1.4s linear infinite; }
  .cap-ciclo.is-flowing [data-lin]:nth-child(2) .link__run,
  .cap-ciclo.is-flowing [data-lout]:nth-child(2) .link__run { animation-delay: -0.5s; }
  .cap-ciclo.is-flowing [data-lin]:nth-child(3) .link__run,
  .cap-ciclo.is-flowing [data-lout]:nth-child(3) .link__run { animation-delay: -1.1s; }
  .cap-ciclo.is-flowing [data-lin]:nth-child(4) .link__run,
  .cap-ciclo.is-flowing [data-lout]:nth-child(4) .link__run { animation-delay: -0.8s; }
  .link__run, .vlink__run { transform: translateX(-100%); }
  .vlink__run { transform: translateY(-100%); }
  @keyframes run-x { from { transform: translateX(-100%); } to { transform: translateX(0); } }
  @keyframes run-y { from { transform: translateY(-100%); } to { transform: translateY(0); } }

  /* ---------- Steps ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .step { position: relative; display: grid; gap: 0.35rem; padding-top: 0.9rem; }
  .step__bar { position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--color-field-lime); transform-origin: 0 50%; }
  .step__h { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1; margin: 0; }
  .step__n { color: var(--color-field-lime); }
  .step__p { margin: 0; font-size: 1rem; line-height: 1.4; max-width: 34ch; opacity: 0.85; }

  .more { justify-self: start; color: var(--color-paper); font-weight: 500; text-decoration: underline; text-underline-offset: 0.25em; }
  .more:hover { color: var(--color-field-lime); }
  .more:focus-visible { outline: 3px solid var(--color-field-lime); outline-offset: 4px; }

  @media (min-width: 700px) {
    .steps { grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; }
  }

  /* ---------- Desktop: one row, sources left, system centre, results right ---------- */
  @media (min-width: 1024px) {
    .stage__in { gap: clamp(1.75rem, 4svh, 2.75rem); }
    .head { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: 3rem; }
    .lead { justify-self: end; }

    .flow {
      grid-template-columns: minmax(0, 1fr) clamp(2.5rem, 5vw, 5rem) minmax(0, 1.3fr) clamp(2.5rem, 5vw, 5rem) minmax(0, 1fr);
      grid-template-rows: repeat(4, auto);
      gap: 0.6rem 0;
      align-items: center;
    }
    .col { display: contents; }
    .vlink { display: none; }
    .col--in > :nth-child(1), .col--lin > :nth-child(1) { grid-row: 1; }
    .col--in > :nth-child(2), .col--lin > :nth-child(2) { grid-row: 2; }
    .col--in > :nth-child(3), .col--lin > :nth-child(3) { grid-row: 3; }
    .col--in > :nth-child(4), .col--lin > :nth-child(4) { grid-row: 4; }
    .col--out > :nth-child(1), .col--lout > :nth-child(1) { grid-row: 1; }
    .col--out > :nth-child(2), .col--lout > :nth-child(2) { grid-row: 2; }
    .col--out > :nth-child(3), .col--lout > :nth-child(3) { grid-row: 3; }
    .col--out > :nth-child(4), .col--lout > :nth-child(4) { grid-row: 4; }
    .col--in > * { grid-column: 1; }
    .col--lin > * { grid-column: 2; }
    .core { grid-column: 3; grid-row: 1 / span 4; }
    .col--lout > * { grid-column: 4; }
    .col--out > * { grid-column: 5; }

    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
    .step__p { font-size: 0.9375rem; }
  }

  /* Pinned mode (set from JS): everything framed in one screen */
  .is-live .stage { min-height: 100svh; display: grid; align-items: center; padding-block: 2rem; }
  .is-live .title { font-size: clamp(3rem, 1rem + 6vw, 6.5rem); }

  @media (prefers-reduced-motion: reduce) {
    .link__run b, .vlink__run b { display: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, onPage, reduced } from "../../scripts/motion";

  onPage(() => {
    const root = document.querySelector<HTMLElement>("#ciclo");
    if (!root) return;

    const q = <T extends Element = HTMLElement>(s: string) => gsap.utils.toArray<T>(s, root);
    const ins = q("[data-in]");
    const lins = q("[data-lin]");
    const louts = q("[data-lout]");
    const outs = q("[data-out]");
    const rows = q("[data-log]");
    const vlinks = q("[data-vlink]");
    const bars = q("[data-stepbar]");
    const steps = q("[data-step]");
    const stock = root.querySelector<HTMLElement>("[data-stock]")!;
    const FINAL = 137;
    const START = 142;
    const counter = { v: START };
    const paint = () => (stock.textContent = String(Math.round(counter.v)));

    // Connectors run only while the chapter is on screen
    const flowing = ScrollTrigger.create({
      trigger: root,
      start: "top bottom",
      end: "bottom top",
      toggleClass: { targets: root, className: "is-flowing" },
    });

    if (reduced()) return () => flowing.kill();

    const mm = gsap.matchMedia();
    const ctx = gsap.context(() => {
      // Pinned, scroll-scrubbed walk through the four steps
      mm.add("(min-width: 1024px) and (min-height: 700px)", () => {
        root.classList.add("is-live");
        const tilt = [
          { rotation: -7, x: -70, y: 26 },
          { rotation: 5, x: -24, y: -18 },
          { rotation: -4, x: -96, y: 14 },
          { rotation: 8, x: -40, y: -26 },
        ];
        const tl = gsap.timeline({
          defaults: { ease: "power2.out" },
          scrollTrigger: { trigger: root, start: "top top", end: "+=240%", pin: true, scrub: 0.6, anticipatePin: 1 },
        });
        const stepOn = (i: number, at: number) => {
          tl.fromTo(steps[i], { opacity: 0.35 }, { opacity: 1, duration: 0.2 }, at);
          tl.fromTo(bars[i], { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "none" }, at);
        };

        // 1 Conectar: the mess straightens and wires in
        ins.forEach((el, i) => tl.fromTo(el, tilt[i], { rotation: 0, x: 0, y: 0, duration: 0.7 }, i * 0.08));
        tl.fromTo(lins, { scaleX: 0, autoAlpha: 0 }, { scaleX: 1, autoAlpha: 1, duration: 0.4, stagger: 0.08 }, 0.45);
        stepOn(0, 0);

        // 2 Crear: the log fills and the stock settles on one number
        tl.fromTo(rows, { autoAlpha: 0, x: -16 }, { autoAlpha: 1, x: 0, duration: 0.25, stagger: 0.18 }, 1);
        tl.fromTo(counter, { v: START }, { v: FINAL, duration: 0.8, ease: "none", onUpdate: paint }, 1.1);
        stepOn(1, 1);

        // 3 Informar: results come out
        tl.fromTo(louts.slice(0, 3), { scaleX: 0, autoAlpha: 0 }, { scaleX: 1, autoAlpha: 1, duration: 0.3, stagger: 0.1 }, 2);
        tl.fromTo(outs.slice(0, 3), { autoAlpha: 0, x: -24 }, { autoAlpha: 1, x: 0, duration: 0.3, stagger: 0.12 }, 2.15);
        stepOn(2, 2);

        // 4 Respaldar
        tl.fromTo(louts[3], { scaleX: 0, autoAlpha: 0 }, { scaleX: 1, autoAlpha: 1, duration: 0.3 }, 3);
        tl.fromTo(outs[3], { autoAlpha: 0, x: -24 }, { autoAlpha: 1, x: 0, duration: 0.3 }, 3.15);
        stepOn(3, 3);
        tl.to({}, { duration: 0.6 }); // hold on the finished picture

        ScrollTrigger.sort();
        return () => {
          root.classList.remove("is-live");
          counter.v = FINAL;
          paint();
        };
      });

      // Everything else: the same story, played once on entry
      mm.add("not all and (min-width: 1024px) and (min-height: 700px)", () => {
        const tl = gsap.timeline({
          defaults: { ease: "power2.out" },
          scrollTrigger: { trigger: root.querySelector("[data-flow]"), start: "top 75%", once: true },
        });
        tl.from(ins, { rotation: (i) => [-6, 5, -4, 7][i], y: 18, duration: 0.6, stagger: 0.06 });
        tl.from(vlinks[0], { scaleY: 0, transformOrigin: "50% 0", duration: 0.3 }, "-=0.2");
        tl.from(rows, { autoAlpha: 0, x: -12, duration: 0.25, stagger: 0.12 });
        tl.fromTo(counter, { v: START }, { v: FINAL, duration: 0.7, ease: "none", onUpdate: paint }, "<");
        tl.from(vlinks[1], { scaleY: 0, transformOrigin: "50% 0", duration: 0.3 });
        tl.from(outs, { autoAlpha: 0, y: 14, duration: 0.3, stagger: 0.1 });
        tl.from(bars, { scaleX: 0, duration: 0.5, stagger: 0.12 }, "-=0.3");
        return () => {
          counter.v = FINAL;
          paint();
        };
      });
    }, root);

    return () => {
      flowing.kill();
      mm.revert();
      ctx.revert();
    };
  });
</script>
