---
// Chapter "Así trabajan hoy": a dense collage of how an SME runs on paper, chats and mail.
import { stock } from "../../lib/stock";
import Video from "./Video.astro";

const photos = [
  { slot: "caos-postits", cls: "p-postits", speed: -40 },
  { slot: "caos-biblioratos", cls: "p-biblio", speed: 30 },
  { slot: "caos-anotando", cls: "p-anotando", speed: -30 },
  { slot: "caos-papeles", cls: "p-papeles", speed: 40 },
  { slot: "caos-tickets", cls: "p-tickets", speed: -30 },
  { slot: "caos-celular", cls: "p-celular", speed: 50 },
  { slot: "caos-ticket-mano", cls: "p-mano", speed: -40 },
].map((p) => ({ ...p, img: stock(p.slot, 1024) }));

const days = Array.from({ length: 28 }, (_, i) => i + 1);
---

<section id="caos" class="cap-caos" data-field="mist" aria-labelledby="caos-title">
  <div class="stage">
    <div class="copy">
      <h2 id="caos-title">ASÍ <small>se trabaja</small><br />HOY</h2>
      <p>
        El stock vive en cuatro planillas, los pedidos llegan por WhatsApp, el mismo dato se tipea tres
        veces y nadie sabe cuál es el número real.
      </p>
      <a class="btn cta" href="#ciclo">Ver cómo se ordena <span class="arr" aria-hidden="true">→</span></a>
    </div>

    {photos.map((p) => (
      <figure class={`piece ${p.cls}`} data-speed={p.speed}>
        <div class="tilt">
          <img src={p.img.src} srcset={p.img.srcset} sizes="(min-width: 768px) 24vw, 70vw" alt={p.img.alt} width={p.img.width} height={p.img.height} loading="eager" decoding="async" />
        </div>
      </figure>
    ))}

    <div class="piece p-chat" data-speed="-20">
      <div class="tilt chat" role="group" aria-label="Conversación de WhatsApp de ejemplo">
        <p class="in">¿Te queda stock del 30x40?</p>
        <p class="out">Fijate en el Excel de Juan</p>
        <p class="in">¿Cuál? Hay tres</p>
      </div>
    </div>

    <div class="piece p-chat2" data-speed="35">
      <div class="tilt chat" role="group" aria-label="Otra conversación de WhatsApp de ejemplo">
        <p class="in">¿Ya salió lo de Rosales?</p>
        <p class="out">No sé, preguntale a Marta</p>
      </div>
    </div>

    <div class="piece p-sheet" data-speed="30">
      <div class="tilt sheet" role="group" aria-label="Planillas con números que no coinciden">
        <span class="h">Planilla</span><span class="h">Stock 30x40</span>
        <span>Stock_FINAL</span><span class="n">142</span>
        <span>Stock_FINAL2</span><span class="n bad">118</span>
        <span>Juan (copia)</span><span class="n">131</span>
      </div>
    </div>

    <div class="piece p-order" data-speed="-30">
      <p class="tilt order">Pedido Sra. Gómez: 3 cajas 30x40, paga el viernes</p>
    </div>

    <div class="piece p-receipt" data-speed="40">
      <div class="tilt receipt">
        <p>Caja 30x40 x3</p><p>Caja 20x25 x1</p><p>Total: a confirmar</p><p>Paga el viernes</p>
      </div>
    </div>

    <div class="piece p-cal" data-speed="-35">
      <div class="tilt cal" role="img" aria-label="Hoja de calendario con el día 14 marcado">
        <b>Noviembre</b>
        <div class="days">{days.map((d) => <span class={d === 14 ? "on" : ""}>{d}</span>)}</div>
      </div>
    </div>

    <div class="piece p-mail" data-speed="25">
      <div class="tilt mail" role="group" aria-label="Notificación de mail de ejemplo">
        <span class="av" aria-hidden="true">M</span>
        <div>
          <b>Marta, Depósito</b>
          <p>Re: Re: RE: stock actualizado (final2)</p>
          <small>Te lo mando de nuevo, adjunto la planilla</small>
        </div>
      </div>
    </div>

    <div class="piece p-invoice" data-speed="-25">
      <div class="tilt invoice" role="img" aria-label="Esquina de una factura impresa">
        <b>Factura</b><span>Cliente: Rosales</span><i></i><i></i><i class="s"></i>
        <em>Total a revisar</em>
      </div>
    </div>

    <div class="piece p-video" data-speed="-45">
      <div class="tilt vwrap"><Video name="cobro" /></div>
    </div>

    <div class="piece p-n1" data-speed="-50"><p class="tilt note">llamar al proveedor ANTES del viernes</p></div>
    <div class="piece p-n2" data-speed="45"><p class="tilt note n-pink">¿Quién tiene la llave del depósito?</p></div>
    <div class="piece p-n3" data-speed="-40"><p class="tilt note n-lime">Cobrar a Rosales!!</p></div>
    <div class="piece p-n4" data-speed="50"><p class="tilt note n-blue">contar de nuevo el 20x25</p></div>

    <p class="piece chip c1" data-speed="-20"><span class="tilt">Lun 9:14 · Falta stock del 30x40</span></p>
    <p class="piece chip c2" data-speed="25"><span class="tilt">Mar 18:40 · Pedido duplicado</span></p>
    <p class="piece chip c3" data-speed="-30"><span class="tilt">Vie 11:02 · ¿Quién cobró a Rosales?</span></p>
    <p class="piece chip c4" data-speed="20"><span class="tilt">Mié 16:30 · Excel_FINAL3 sin guardar</span></p>
    <p class="piece chip c5" data-speed="-25"><span class="tilt">Jue 8:05 · Otra cotización por WhatsApp</span></p>
  </div>
</section>

<style>
  .cap-caos { overflow: clip; padding-block: clamp(4rem, 9vw, 6rem); }
  .stage { position: relative; }
  .copy { position: relative; z-index: 3; padding-inline: var(--gutter); max-width: 44rem; margin-inline: auto; text-align: center; }
  h2 {
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: clamp(4.25rem, 15vw, 11rem); line-height: 0.88; letter-spacing: -0.01em; margin: 0;
  }
  h2 small { font-family: var(--font-sans); font-weight: 500; text-transform: none; font-size: 0.32em; letter-spacing: 0; margin-inline: 0.1em; }
  .copy p { font-size: var(--step-lead); line-height: 1.4; margin: 1.5rem auto 0; max-width: 34rem; }
  .cta { margin-top: 1.75rem; }
  .cta .arr { display: inline-block; transition: transform 0.35s var(--ease-out-expo, ease-out); }
  .cta:hover .arr, .cta:focus-visible .arr { transform: translateX(0.4rem); }

  .piece { margin: 0; }
  .piece img { display: block; width: 100%; height: auto; }
  .tilt { rotate: var(--r, 0deg); }

  .chat { display: flex; flex-direction: column; gap: 0.5rem; padding: 1rem; background: #cfd9ee; }
  .chat p { margin: 0; padding: 0.6rem 0.9rem; font-size: 1rem; line-height: 1.3; max-width: 85%; color: #0e1116; }
  .chat .in { background: #fff; align-self: flex-start; border-radius: 0 0.6rem 0.6rem 0.6rem; }
  .chat .out { background: #d9fdd3; align-self: flex-end; border-radius: 0.6rem 0 0.6rem 0.6rem; }

  .sheet { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2px; background: #0e1116; padding: 2px; }
  .sheet span { background: #fff; color: #0e1116; padding: 0.5rem 0.7rem; font-size: 1rem; }
  .sheet .h { background: #c8d1e6; font-weight: 500; }
  .sheet .n { text-align: right; font-weight: 500; }
  .sheet .bad { background: var(--color-accent); color: var(--color-accent-ink); }

  .note { margin: 0; padding: 1.2rem 1.1rem 1.4rem; background: #f6e27a; color: #0e1116; font-weight: 500; font-size: 1.3rem; line-height: 1.15; }
  .n-pink { background: #f4b8c8; } .n-lime { background: #d7f25c; } .n-blue { background: #a9c8f5; }

  .order { margin: 0; padding: 1.4rem 1.2rem; background: #fbf8ee; color: #23378f; font-style: italic; font-weight: 500; font-size: 1.4rem; line-height: 1.25; }
  .receipt { background: #fff; color: #0e1116; padding: 1rem 0.9rem 1.6rem; clip-path: polygon(0 0, 100% 0, 100% 96%, 90% 100%, 80% 96%, 70% 100%, 60% 96%, 50% 100%, 40% 96%, 30% 100%, 20% 96%, 10% 100%, 0 96%); }
  .receipt p { margin: 0 0 0.45rem; font-size: 1rem; line-height: 1.25; }
  .cal { background: #fff; color: #0e1116; }
  .cal b { display: block; background: var(--color-accent); color: var(--color-accent-ink); padding: 0.45rem 0.8rem; font-weight: 500; font-size: 1rem; }
  .days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.15rem; padding: 0.6rem; }
  .days span { text-align: center; font-size: 0.85rem; line-height: 1.7; }
  .days .on { background: #c8321f; color: #fff; border-radius: 50%; font-weight: 600; }
  .mail { display: flex; gap: 0.8rem; align-items: flex-start; background: #fff; color: #0e1116; padding: 1rem; }
  .mail .av { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--color-accent); color: #fff; display: grid; place-items: center; font-weight: 600; }
  .mail b { font-weight: 600; font-size: 1rem; }
  .mail p { margin: 0.15rem 0; font-size: 1rem; line-height: 1.25; font-weight: 500; }
  .mail small { font-size: 0.9rem; color: #4a5160; line-height: 1.3; display: block; }
  .invoice { background: #fbf8ee; color: #0e1116; padding: 1rem 1rem 1.2rem; clip-path: polygon(0 0, 88% 0, 100% 14%, 100% 100%, 0 100%); display: flex; flex-direction: column; gap: 0.5rem; }
  .invoice b { font-size: 1.3rem; font-weight: 600; }
  .invoice span { font-size: 1rem; }
  .invoice i { display: block; height: 0.55rem; background: #cfd3dc; }
  .invoice i.s { width: 55%; }
  .invoice em { font-style: normal; font-weight: 600; font-size: 1rem; }
  .vwrap { background: #0e1116; aspect-ratio: 4 / 3; }
  .vwrap :global(.vslot) { width: 100%; height: 100%; }

  .chip { display: block; }
  .chip span { display: block; background: #0e1116; color: #f2f1ec; padding: 0.55rem 0.9rem; font-size: 0.95rem; line-height: 1.25; font-weight: 500; }

  .p-postits { --r: -4deg; } .p-biblio { --r: 3deg; } .p-anotando { --r: -3deg; } .p-papeles { --r: 4deg; }
  .p-tickets { --r: 5deg; } .p-celular { --r: -5deg; } .p-mano { --r: 3deg; } .p-chat { --r: 2deg; } .p-chat2 { --r: -3deg; }
  .p-sheet { --r: -2deg; } .p-order { --r: -3deg; } .p-receipt { --r: 4deg; } .p-cal { --r: 5deg; } .p-mail { --r: -2deg; }
  .p-invoice { --r: 4deg; } .p-video { --r: -3deg; } .p-n1 { --r: -6deg; } .p-n2 { --r: 5deg; } .p-n3 { --r: -4deg; } .p-n4 { --r: 6deg; }
  .c1 { --r: -2deg; } .c2 { --r: 2deg; } .c3 { --r: -1.5deg; } .c4 { --r: 2.5deg; } .c5 { --r: -2deg; }

  /* Mobile: a loose overlapping stack under the text */
  @media (max-width: 767px) {
    .stage { display: flex; flex-direction: column; }
    .piece { display: none; width: 66%; margin-top: -1rem; position: relative; }
    .copy { order: 0; }
    .p-postits, .p-order, .p-chat, .p-n1, .p-sheet, .p-mail, .p-cal, .p-video, .p-celular, .p-chat2, .p-receipt, .c1, .c3 { display: block; }
    .p-postits { order: 1; margin-left: 6%; width: 60%; margin-top: 2.5rem; }
    .p-order { order: 2; margin-left: 40%; width: 56%; z-index: 1; }
    .c1 { order: 3; margin-left: 8%; width: auto; align-self: flex-start; z-index: 2; margin-top: -0.6rem; max-width: 80%; }
    .p-chat { order: 4; margin-left: 24%; width: 72%; }
    .p-n1 { order: 5; margin-left: 4%; width: 46%; z-index: 1; }
    .p-cal { order: 6; margin-left: 49%; width: 46%; margin-top: -3rem; z-index: 2; }
    /* The sheet sits above its neighbours: the calendar and the mail only tuck under its edges, so no cell is covered */
    .p-sheet { order: 7; margin-left: 5%; width: 80%; margin-top: -0.5rem; z-index: 3; }
    .p-mail { order: 8; margin-left: 12%; width: 84%; margin-top: -0.4rem; z-index: 1; }
    .p-video { order: 9; margin-left: 6%; width: 52%; }
    .p-receipt { order: 10; margin-left: 52%; width: 40%; margin-top: -4rem; z-index: 1; }
    .c3 { order: 11; margin-left: 14%; width: auto; align-self: flex-start; max-width: 80%; z-index: 2; }
    .p-chat2 { order: 12; margin-left: 4%; width: 74%; }
    .p-celular { order: 13; margin-left: 46%; width: 48%; margin-top: -1.5rem; }
    .cta { margin-top: 1.5rem; }
  }

  /* Desktop: absolute collage around a clear central zone */
  @media (min-width: 768px) {
    .cap-caos { padding-block: 0; min-height: 1560px; display: grid; }
    .stage { min-height: 1560px; }
    .copy { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(40rem, 50%); }
    .piece { position: absolute; }
    /* top band */
    .p-postits { left: 2%; top: 2%; width: 17%; }
    .p-papeles { left: 21%; top: 1%; width: 15%; }
    .p-order { left: 38%; top: 3%; width: 16%; }
    .p-biblio { left: 56%; top: 2%; width: 17%; }
    .p-chat { left: 75%; top: 3%; width: 22%; }
    .p-n3 { left: 38%; top: 15%; width: 9%; }
    .c2 { left: 49%; top: 20%; }
    .p-n2 { left: 66%; top: 13%; width: 10%; }
    /* left column */
    .p-n1 { left: 4%; top: 25%; width: 12%; }
    /* Kept left of the headline column so its month label never sits above the title */
    .p-cal { left: 14%; top: 22%; width: 9%; }
    .c1 { left: 3%; top: 41%; }
    .p-tickets { left: 2%; top: 46%; width: 16%; }
    .p-receipt { left: 20%; top: 41%; width: 9%; }
    /* right column */
    .p-anotando { left: 79%; top: 24%; width: 18%; }
    .p-mail { left: 74%; top: 38%; width: 23%; }
    .c4 { left: 75%; top: 51%; }
    .p-invoice { left: 83%; top: 56%; width: 14%; }
    .p-n4 { left: 74%; top: 57%; width: 8.5%; }
    /* bottom band */
    .p-celular { left: 3%; top: 69%; width: 14%; }
    .p-chat2 { left: 19%; top: 72%; width: 20%; }
    .c5 { left: 19%; top: 85%; }
    .p-mano { left: 4%; top: 85%; width: 13%; }
    .p-video { left: 42%; top: 76%; width: 12%; }
    .c3 { left: 41%; top: 91%; }
    .p-sheet { left: 60%; top: 73%; width: 25%; }
  }
  /* Tablet: too little room beside the headline for the calendar */
  @media (min-width: 768px) and (max-width: 1099px) {
    .p-cal { display: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, onPage, reduced } from "../../scripts/motion";

  onPage(() => {
    const root = document.getElementById("caos");
    if (!root) return;
    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();
      mm.add("(min-width: 768px)", () => {
        if (reduced()) return;
        root.querySelectorAll<HTMLElement>(".piece").forEach((el) => {
          const speed = Number(el.dataset.speed || 0);
          gsap.fromTo(el, { y: -speed }, {
            y: speed, ease: "none",
            scrollTrigger: { trigger: root, start: "top bottom", end: "bottom top", scrub: 0.6 },
          });
          // Pieces never start hidden: they settle in from slightly lower and smaller
          gsap.from(el.querySelector(".tilt"), {
            y: 40, scale: 0.96, duration: 0.9, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 90%", once: true },
          });
        });
      });
      mm.add("(max-width: 767px)", () => {
        if (reduced()) return;
        root.querySelectorAll(".piece .tilt").forEach((el) => {
          gsap.from(el, {
            y: 30, duration: 0.7, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 92%", once: true },
          });
        });
      });
    }, root);
    return () => ctx.revert();
  });
</script>
