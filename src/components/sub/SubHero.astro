---
/* Opening field of an inner page. Same voice as the home hero: giant uppercase words with small connectors.
   Slots:
     title   (required) e.g. <Fragment slot="title">Proyectos <small>que</small> podés ver</Fragment>
     actions (optional) buttons / links under the lead
     aside   (optional) a visual on the right on desktop (drawn interface, photo, figure)
   Also loads the shared inner-page motion (src/scripts/subflow.ts); the page must use <Layout bleed>. */
import type { FieldName } from "./Field.astro";

interface Props {
  field?: FieldName;
  lead?: string;
  /** Breadcrumb back link, e.g. { href: "/servicios", label: "Servicios" } */
  back?: { href: string; label: string };
}
const { field = "paper", lead, back } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<header class:list={["sh", `sh--${field}`, hasAside && "sh--aside"]} data-subflow>
  <script is:inline>
    // Hide the title before first paint so its words can rise in without a flash; subflow.ts releases it.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("sub-pre");
  </script>
  <div class="wrap sh__in">
    <div class="sh__main">
      {back && (
        <a class="sh__back" href={back.href} data-hero-follow>
          <span aria-hidden="true">←</span> {back.label}
        </a>
      )}
      <h1 class="sh__title" data-sub-title><slot name="title" /></h1>
      {lead && <p class="sh__lead" data-hero-follow>{lead}</p>}
      {Astro.slots.has("actions") && (
        <div class="sh__actions" data-hero-follow>
          <slot name="actions" />
        </div>
      )}
    </div>
    {hasAside && (
      <div class="sh__aside" data-hero-follow>
        <slot name="aside" />
      </div>
    )}
  </div>
</header>

<script>
  import "../../scripts/subflow";
</script>

<style>
  .sh { color: var(--color-ink); padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7.5rem); }
  .sh--paper { background: var(--color-paper); }
  .sh--bone { background: var(--color-surface); }
  .sh--mist { background: var(--color-field-mist); }
  .sh--cornflower { background: var(--color-field-cornflower); }
  .sh--lime { background: var(--color-field-lime); }
  .sh--night { background: var(--color-field-night); color: var(--color-paper); }
  .sh--night .sh__title { color: var(--color-paper); }

  .sh__in { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: center; }
  .sh__main { display: grid; gap: 1.5rem; align-content: start; }
  .sh__back { justify-self: start; color: inherit; font-weight: 500; text-decoration: underline; text-underline-offset: 0.25em; }
  .sh__back:hover { color: var(--color-accent); }
  .sh--night .sh__back:hover { color: var(--color-field-lime); }

  .sh__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(3.5rem, 1.2rem + 10vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .sh--aside .sh__title { font-size: clamp(3.5rem, 1.2rem + 8vw, 7.5rem); }
  .sh__title :global(small) {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: none;
    font-size: 0.34em;
  }
  .sh__title :global(.sw) { display: inline-block; }
  :global(html.sub-pre) .sh__title {
    visibility: hidden;
    /* Safety net: show the title even if the motion script never runs */
    animation: sh-show 0s 1.6s forwards;
  }
  @keyframes sh-show { to { visibility: visible; } }

  .sh__lead { margin: 0; font-size: var(--step-lead); line-height: 1.3; max-width: 36ch; }
  .sh__actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; }

  @media (min-width: 1024px) {
    .sh--aside .sh__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 4rem; }
  }
</style>
