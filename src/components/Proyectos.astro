---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import CornerBrackets from "./CornerBrackets.astro";
import SectionAnchor from "./SectionAnchor.astro";

const allProyectos = await getCollection("proyectos");
const featured = allProyectos
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const [hero, ...rest] = featured.slice(0, 3);
const rows = rest.slice(0, 2);

const gradients = ["azul", "azul-card", "dorado"] as const;
---

<section class="relative py-20 md:py-28 border-b-2 border-[var(--color-ink)] overflow-hidden">
  <div class="container-page">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12 reveal">
      <div>
        <SectionAnchor number="04" label="CASOS" />
        <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-ink)] mt-2 max-w-3xl">
          Algunos casos donde <span class="text-[var(--color-azul)]">mis decisiones</span> importaron.
        </h2>
      </div>
      <a
        href="/proyectos"
        class="tactile font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-[var(--color-ink)] hover:text-[var(--color-azul)] inline-flex items-center gap-1.5"
      >
        Ver todos <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      hero && (
        <a
          href={`/proyectos/${hero.id}`}
          class="group relative tactile block rounded-2xl bg-[var(--color-blanco)] shadow-lg border-2 border-[var(--color-ink)] hover:-translate-y-1 hover:shadow-xl transition-all duration-200 overflow-hidden reveal p-1.5"
        >
          <CornerBrackets color="var(--color-azul)" size={22} offset={10} />
          <div
            class={`placeholder-image placeholder-image--${gradients[0]} relative image-scrim overflow-hidden`}
            aria-hidden="true"
          >
<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="font-impact text-[clamp(6rem,15vw,12rem)] text-white/15 select-none tabular-nums leading-none">
              {String(allProyectos.findIndex((p) => p.id === hero.id) + 1).padStart(2, "0")}
            </span>
          </div>
          <div class="absolute inset-0 flex items-end p-6 md:p-8">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/90">
              {hero.data.cliente} · Featured
            </p>
          </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-10 p-7 md:p-10">
            <div class="flex flex-col justify-between gap-6">
              <div>
                <p class="font-impact text-[clamp(3rem,8vw,7rem)] text-[var(--color-azul)] leading-[0.9] uppercase tabular-nums">
                  {hero.data.metricas[0]?.value}
                </p>
                <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mt-2 leading-tight max-w-[160px]">
                  {hero.data.metricas[0]?.label}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {hero.data.stack.slice(0, 3).map((s) => (
                  <span class="font-mono text-[11px] px-2.5 py-1 rounded-md bg-[var(--color-blanco-humo)] border border-[var(--color-border)] text-[var(--color-ink-soft)]">
                    {s}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex flex-col">
              <h3 class="font-impact text-[clamp(1.5rem,3vw,2.5rem)] uppercase leading-[1] tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-azul)] transition-colors mb-4">
                {hero.data.title}
              </h3>
              <p class="text-[var(--color-ink-soft)] leading-relaxed mb-6">
                {hero.data.descripcion}
              </p>

              {hero.data.metricas.length > 1 && (
                <dl class="grid grid-cols-3 gap-4 mt-auto pt-6 border-t border-[var(--color-border)]">
                  {hero.data.metricas.slice(1, 4).map((m) => (
                    <div>
                      <dd class="font-impact text-xl md:text-2xl text-[var(--color-ink)] leading-none uppercase tabular-nums">
                        {m.value}
                      </dd>
                      <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)] mt-2 leading-tight">
                        {m.label}
                      </dt>
                    </div>
                  ))}
                </dl>
              )}

              <div class="mt-7 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                <span><FormattedDate date={hero.data.fecha} format="short" /> · {hero.data.duracion}</span>
                <span class="text-[var(--color-azul)] font-semibold opacity-80 group-hover:opacity-100 transition-opacity">
                  Ver caso →
                </span>
              </div>
            </div>
          </div>
        </a>
      )
    }

    {
      rows.length > 0 && (
        <ul class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
          {rows.map((p, i) => (
            <li>
              <a
                href={`/proyectos/${p.id}`}
                class="tactile group block rounded-xl bg-[var(--color-blanco)] shadow-sm border-2 border-[var(--color-ink)] hover:-translate-y-0.5 hover:shadow-md hover:border-[var(--color-azul)] transition-all overflow-hidden relative p-1"
              >
                <div
                  class={`placeholder-image placeholder-image--${gradients[(i + 1) % gradients.length]} h-32 relative overflow-hidden`}
                  aria-hidden="true"
                >
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <span class="font-impact text-7xl text-white/15 select-none tabular-nums leading-none">
                      {String(allProyectos.findIndex((pp) => pp.id === p.id) + 1).padStart(2, "0")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                      {p.data.cliente}
                    </span>
                    <span class="font-impact text-[var(--color-dorado)] text-xl uppercase tabular-nums">
                      {p.data.metricas[0]?.value}
                    </span>
                  </div>
                  <h3 class="font-impact text-xl md:text-2xl uppercase leading-[1] tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-dorado)] transition-colors mb-2">
                    {p.data.title}
                  </h3>
                  <p class="text-sm text-[var(--color-ink-soft)] leading-snug line-clamp-2 mb-4">
                    {p.data.descripcion}
                  </p>
                  <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] pt-4 border-t border-[var(--color-border)]">
                    <span><FormattedDate date={p.data.fecha} format="short" /></span>
                    <span class="text-[var(--color-dorado)] font-semibold">Ver →</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>