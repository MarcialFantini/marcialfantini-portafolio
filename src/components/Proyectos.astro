---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const allProyectos = await getCollection("proyectos");
const featured = allProyectos
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const [hero, ...rest] = featured.slice(0, 3);
const rows = rest.slice(0, 2);
---

<section class="relative py-20 md:py-28 border-b border-[var(--color-border)] overflow-hidden isolate">
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <div
      class="brush-stroke brush-stroke-1"
      style="top: 12%; right: -8%; transform: rotate(14deg);"
    ></div>
  </div>

  <div class="container-page relative z-[1]">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-12 reveal">
      <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-ink)] max-w-xl">
        Algunos casos donde <span class="text-[var(--color-dorado)]">mis decisiones</span> importaron.
      </h2>
      <a
        href="/proyectos"
        class="tactile text-sm font-medium text-[var(--color-ink)] hover:text-[var(--color-dorado)] inline-flex items-center gap-1.5"
      >
        Ver todos los proyectos <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      hero && (
        <a
          href={`/proyectos/${hero.id}`}
          class="group tactile block border-2 border-[var(--color-ink)] rounded-lg bg-[var(--color-ink)] text-[var(--color-blanco-humo)] hover:bg-[var(--color-azul)] hover:text-[var(--color-ink)] transition-colors overflow-hidden reveal"
        >
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-10 p-7 md:p-10">
            <div class="flex flex-col justify-between gap-6">
              <div>
                <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-azul)] group-hover:text-[var(--color-ink)] mb-3 transition-colors">
                  {hero.data.cliente}
                </p>
                <p class="font-impact text-[clamp(3rem,8vw,7rem)] text-[var(--color-azul)] group-hover:text-[var(--color-ink)] leading-none uppercase tabular-nums">
                  {hero.data.metricas[0]?.value}
                </p>
                <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-blanco-humo)] group-hover:text-[var(--color-ink)]/70 mt-3 leading-tight max-w-[160px] transition-colors">
                  {hero.data.metricas[0]?.label}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {hero.data.stack.slice(0, 3).map((s) => (
                  <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--color-ink)] border border-[var(--color-blanco-humo)]/40 group-hover:bg-[var(--color-ink)] group-hover:border-[var(--color-ink)] text-[var(--color-blanco-humo)] group-hover:text-[var(--color-ink)] transition-colors">
                    {s}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex flex-col">
              <h3 class="font-impact text-[clamp(1.5rem,3vw,2.5rem)] uppercase leading-[1] tracking-tight text-[var(--color-blanco-humo)] group-hover:text-[var(--color-ink)] transition-colors mb-4">
                {hero.data.title}
              </h3>
              <p class="text-[var(--color-blanco-humo)]/85 group-hover:text-[var(--color-ink)]/80 leading-relaxed mb-6 transition-colors">
                {hero.data.descripcion}
              </p>

              {hero.data.metricas.length > 1 && (
                <dl class="grid grid-cols-3 gap-4 mt-auto pt-6 border-t border-[var(--color-blanco-humo)]/30 group-hover:border-[var(--color-ink)]/40 transition-colors">
                  {hero.data.metricas.slice(1, 4).map((m) => (
                    <div>
                      <dd class="font-impact text-xl md:text-2xl text-[var(--color-azul)] group-hover:text-[var(--color-ink)] leading-none uppercase tabular-nums transition-colors">
                        {m.value}
                      </dd>
                      <dt class="font-mono text-[10px] uppercase tracking-widest text-[var(--color-blanco-humo)]/70 group-hover:text-[var(--color-ink)]/70 mt-2 leading-tight transition-colors">
                        {m.label}
                      </dt>
                    </div>
                  ))}
                </dl>
              )}

              <div class="mt-7 flex items-center justify-between font-mono text-xs text-[var(--color-blanco-humo)] group-hover:text-[var(--color-ink)] transition-colors">
                <span><FormattedDate date={hero.data.fecha} format="short" /> · {hero.data.duracion}</span>
                <span class="opacity-0 group-hover:opacity-100 transition-opacity">
                  Ver caso →
                </span>
              </div>
            </div>
          </div>
        </a>
      )
    }

    {
      rows.length > 0 && (
        <ul class="mt-5 border-t-2 border-[var(--color-ink)] reveal-stagger">
          {rows.map((p) => (
            <li class="border-b border-[var(--color-border)]">
              <a
                href={`/proyectos/${p.id}`}
                class="tactile group grid grid-cols-[auto_1fr_auto] md:grid-cols-[3rem_1fr_auto_auto] items-baseline gap-5 md:gap-8 py-6"
              >
                <span class="font-mono text-xs text-[var(--color-mute)] pt-1 tabular-nums">
                  <span class="inline-block w-6 h-px bg-[var(--color-border)] mr-2 align-middle"></span>
                  {p.data.metricas[0]?.value}
                </span>
                <div class="min-w-0">
                  <h3 class="font-display font-semibold text-lg tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-dorado)] leading-tight">
                    {p.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-snug truncate">
                    {p.data.cliente} · {p.data.descripcion}
                  </p>
                </div>
                <span class="font-mono text-xs text-[var(--color-mute)] whitespace-nowrap hidden md:inline">
                  <FormattedDate date={p.data.fecha} format="short" />
                </span>
                <span
                  aria-hidden="true"
                  class="hidden md:inline text-[var(--color-mute)] group-hover:text-[var(--color-dorado)] group-hover:translate-x-1 transition-transform"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
