---
import site from "../data/site.json";

interface FAQItem {
  pregunta: string;
  respuesta: string;
}

const faqs: FAQItem[] = [
  {
    pregunta: "¿Por qué no usar Shopify, Wix o WordPress directamente?",
    respuesta:
      "Podés, y si tu negocio es estándar, probablemente alcance. Lo que hacemos nosotros suma cuando querés un diseño a tu marca sin restricciones de plantilla, una página rápida o algo que esas plataformas no resuelven bien, como un software a medida. Si tu caso es estándar, te lo decimos antes de empezar.",
  },
  {
    pregunta: "¿Cuánto tarda un proyecto tipo?",
    respuesta:
      "Depende del alcance. Como referencia orientativa: una página web de productos o servicios, de 1 a 3 semanas; una página empresarial, de 2 a 4; un ecommerce, de 4 a 8. El software a medida se define después de conversar. Te confirmamos fechas en la propuesta.",
  },
  {
    pregunta: "¿Qué pasa si no me gusta el resultado?",
    respuesta:
      "Lo ajustamos. Cada proyecto incluye 2 rondas de revisión. Si después de eso querés más cambios, lo charlamos y te pasamos el costo por escrito antes de hacerlos.",
  },
  {
    pregunta: "¿Cuánto cuesta mantenerlo después?",
    respuesta:
      "El hosting y el dominio son aparte y no están incluidos en los precios orientativos: los cotizamos en la propuesta, junto con cualquier cambio o soporte que necesites después de publicar. Te lo aclaramos por escrito, sin sorpresas.",
  },
  {
    pregunta: "¿Cobran por hora o por proyecto?",
    respuesta:
      "Por proyecto, con un presupuesto claro por escrito antes de empezar: página web desde USD 300, página empresarial desde USD 400 y ecommerce desde USD 800 (precios orientativos en USD, sin hosting ni dominio, que se cotizan aparte en la propuesta). El software a medida se cotiza según tu proyecto. Si algo se sale del alcance, lo charlamos antes de hacerlo.",
  },
  {
    pregunta: "¿Puedo ver ejemplos antes de contratarlos?",
    respuesta:
      "Sí. En la primera charla te mostramos proyectos de complejidad parecida a lo que necesitás, sin compromiso, para que veas qué tipo de trabajo hacemos.",
  },
  {
    pregunta: "¿Qué necesito para empezar?",
    respuesta:
      "Tu logo si lo tenés, textos o ideas de lo que querés contar y fotos de tus productos. Si no tenés algo de eso, no pasa nada: charlamos 15 minutos, te hacemos unas preguntas y armamos el brief entre todos. La auditoría gratis de 15 minutos existe justamente para esto, y te respondemos en menos de 24 h hábiles.",
  },
  {
    pregunta: "¿De quién es el código y el sitio?",
    respuesta:
      "Al terminar y pagar el proyecto, el sitio es tuyo. Si querés aclarar algún detalle de la entrega, lo charlamos antes de empezar.",
  },
];

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage || "")}`
  : "";
---

<section id="faq" class="relative py-20 md:py-28" aria-label="Preguntas frecuentes">
  <div class="container-page faq-split grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow mb-4">Preguntas frecuentes</p>
      <h2 class="display-lg">
        Lo que suelen preguntarnos <span class="display-accent">antes de arrancar.</span>
      </h2>
      <p class="mt-6 max-w-md text-base md:text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Si tu duda no está acá, escribinos. Te respondemos en 24 h hábiles.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
        {whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile inline-flex min-h-12 items-center justify-center gap-2 px-6 py-3 rounded-control bg-[var(--color-action)] text-white font-mono text-[12px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-action-hover)]"
          >
            Escribinos por WhatsApp <span aria-hidden="true">↗</span>
          </a>
        )}
        <a
          href="/contacto"
          class={`tactile inline-flex min-h-12 items-center justify-center gap-2 px-6 py-3 rounded-control font-mono text-[12px] uppercase tracking-[0.18em] font-semibold ${
            whatsappUrl
              ? "border border-[var(--color-hair-strong)] text-[var(--color-ink)] hover:border-[var(--color-ink)]"
              : "bg-[var(--color-action)] text-white hover:bg-[var(--color-action-hover)]"
          }`}
        >
          Ir al formulario <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div>
      {
        faqs.map((faq) => (
          <details class="qa sd-reveal">
            <summary>
              <h3>{faq.pregunta}</h3>
            </summary>
            <div class="qa__body">
              <p class="text-base text-[var(--color-ink-soft)] leading-relaxed">{faq.respuesta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
