---
import SectionAnchor from "./SectionAnchor.astro";

interface FAQItem {
  pregunta: string;
  respuesta: string;
}

const faqs: FAQItem[] = [
  {
    pregunta: "¿Por qué no usar Shopify, Wix o WordPress directamente?",
    respuesta:
      "Podés, y si tu negocio es estándar, probablemente alcance. Lo que hacemos nosotros suma cuando querés un diseño a tu marca sin restricciones de plantilla, una página rápida o algo que esas plataformas no resuelven bien, como un software a medida. Si tu caso es estándar, te lo decimos antes de empezar.",
  },
  {
    pregunta: "¿Cuánto tarda un proyecto tipo?",
    respuesta:
      "Depende del alcance. Como referencia orientativa: una página web de productos o servicios, de 1 a 3 semanas; una página empresarial, de 2 a 4; un ecommerce, de 4 a 8. El software a medida se define después de conversar. Te confirmamos fechas en la propuesta.",
  },
  {
    pregunta: "¿Qué pasa si no me gusta el resultado?",
    respuesta:
      "Iteramos. Cada proyecto incluye 2 rondas de revisión por etapa (diseño + desarrollo). Si después de eso no estamos alineados, te quedás con todo el trabajo entregado hasta ese momento y resolvemos por escrito. No trabajamos con cláusula de satisfacción 100% garantizada porque ningún proyecto real la cumple, pero sí con honestidad sobre qué se puede y qué no se puede resolver.",
  },
  {
    pregunta: "¿Cuánto cuesta mantenerlo después?",
    respuesta:
      "Depende del proyecto y de lo que necesites después de la publicación (dominio, hosting, cambios o soporte). Te lo aclaramos por escrito en la propuesta, sin sorpresas.",
  },
  {
    pregunta: "¿Cobrás por hora o por proyecto?",
    respuesta:
      "Por proyecto, con un presupuesto claro por escrito antes de empezar: página web desde USD 300, página empresarial desde USD 400 y ecommerce desde USD 800 (precios orientativos). El software a medida se cotiza según tu proyecto. Si algo se sale del alcance, lo charlamos antes de hacerlo.",
  },
  {
    pregunta: "¿Trabajás con empresas de otros países?",
    respuesta:
      "Sí, pero con un ajuste. Trabajamos 100% remoto y async, así que la zona horaria no es problema. Lo que sí cambia es el precio: para clientes fuera de Argentina trabajamos en USD y con contratos en inglés. La calidad y el proceso son los mismos.",
  },
  {
    pregunta: "¿Puedo ver ejemplos de mi industria antes de contratarte?",
    respuesta:
      "Si tenemos un caso parecido, te lo mostramos en la primera reunión (sin compromiso). Si no tenemos un caso exacto en tu vertical, te mostramos 2-3 proyectos de complejidad similar para que veas qué tipo de problema resolvemos y cómo lo medimos.",
  },
  {
    pregunta: "¿Qué necesito tener listo antes de llamarte?",
    respuesta:
      "Nada. Si tenés una idea de lo que necesitás, un presupuesto aproximado y una fecha, mejor. Si no, charlamos 15 minutos, te hacemos unas preguntas y armamos el brief entre los dos. La auditoría gratis de 15 minutos existe justamente para esto.",
  },
];
---

<section id="faq" class="relative py-20 md:py-28 border-b-2 border-[var(--color-ink)] bg-[var(--color-blanco)] overflow-hidden">
  <div class="container-page">
    <div class="max-w-3xl mb-12 md:mb-16 reveal">
      <SectionAnchor number="07" label="FAQ" />
      <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-ink)] mt-2">
        Las preguntas que <span class="text-[var(--color-azul)]">nos hacen siempre.</span>
      </h2>
      <p class="mt-5 text-[var(--color-ink-soft)] text-lg leading-relaxed">
        8 objeciones reales, respondidas con la verdad (no con marketing).
      </p>
    </div>

    <div class="max-w-3xl space-y-3 reveal-stagger">
      {
        faqs.map((faq, i) => (
          <details
            class="group rounded-xl bg-[var(--color-blanco-humo)] border-2 border-[var(--color-ink)] overflow-hidden tactile"
          >
            <summary class="flex items-start justify-between gap-4 p-5 md:p-6 cursor-pointer list-none">
              <div class="flex items-start gap-3 flex-1 min-w-0">
                <span class="font-impact text-xl md:text-2xl text-[var(--color-azul)] tabular-nums leading-none shrink-0">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="font-display font-semibold text-base md:text-lg text-[var(--color-ink)] leading-snug">
                  {faq.pregunta}
                </h3>
              </div>
              <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border-2 border-[var(--color-ink)] text-[var(--color-ink)] group-open:bg-[var(--color-azul)] group-open:border-[var(--color-azul)] group-open:text-[var(--color-ink)] transition-all" aria-hidden="true">
                <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 16 16">
                  <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="px-5 md:px-6 pb-5 md:pb-6 pl-12 md:pl-16">
              <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                {faq.respuesta}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
