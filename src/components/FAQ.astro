---
interface FAQItem {
  pregunta: string;
  respuesta: string;
}

const faqs: FAQItem[] = [
  {
    pregunta: "¿Por qué no usar Shopify, Wix o WordPress directamente?",
    respuesta:
      "Podés, y si tu negocio es estándar, probablemente alcance. Lo que hacemos nosotros suma cuando querés un diseño a tu marca sin restricciones de plantilla, una página rápida o algo que esas plataformas no resuelven bien, como un software a medida. Si tu caso es estándar, te lo decimos antes de empezar.",
  },
  {
    pregunta: "¿Cuánto tarda un proyecto tipo?",
    respuesta:
      "Depende del alcance. Como referencia orientativa: una página web de productos o servicios, de 1 a 3 semanas; una página empresarial, de 2 a 4; un ecommerce, de 4 a 8. El software a medida se define después de conversar. Te confirmamos fechas en la propuesta.",
  },
  {
    pregunta: "¿Qué pasa si no me gusta el resultado?",
    respuesta:
      "Lo ajustamos. Cada proyecto incluye 2 rondas de revisión. Si después de eso querés más cambios, lo charlamos y te pasamos el costo por escrito antes de hacerlos.",
  },
  {
    pregunta: "¿Cuánto cuesta mantenerlo después?",
    respuesta:
      "El hosting y el dominio son aparte y no están incluidos en los precios orientativos: los cotizamos en la propuesta, junto con cualquier cambio o soporte que necesites después de publicar. Te lo aclaramos por escrito, sin sorpresas.",
  },
  {
    pregunta: "¿Cobran por hora o por proyecto?",
    respuesta:
      "Por proyecto, con un presupuesto claro por escrito antes de empezar: página web desde USD 300, página empresarial desde USD 400 y ecommerce desde USD 800 (precios orientativos en USD, sin hosting ni dominio, que se cotizan aparte en la propuesta). El software a medida se cotiza según tu proyecto. Si algo se sale del alcance, lo charlamos antes de hacerlo.",
  },
  {
    pregunta: "¿Puedo ver ejemplos antes de contratarlos?",
    respuesta:
      "Sí. En la primera charla te mostramos proyectos de complejidad parecida a lo que necesitás, sin compromiso, para que veas qué tipo de trabajo hacemos.",
  },
  {
    pregunta: "¿Qué necesito tener listo antes de escribirles?",
    respuesta:
      "Nada. Si tenés una idea de lo que necesitás, un presupuesto aproximado y una fecha, mejor. Si no, charlamos 15 minutos, te hacemos unas preguntas y armamos el brief entre todos. La auditoría gratis de 15 minutos existe justamente para esto, y te respondemos en menos de 24 h hábiles.",
  },
];
---

<section id="faq" class="relative py-20 md:py-28 border-b border-[var(--color-border)] bg-[var(--color-blanco)] overflow-hidden">
  <div class="container-page">
    <div class="max-w-3xl mb-12 md:mb-16 reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">Preguntas frecuentes</p>
      <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-ink)] mt-2">
        Las preguntas que <span class="text-[var(--color-azul)]">nos hacen seguido.</span>
      </h2>
    </div>

    <div class="max-w-3xl space-y-3 reveal-stagger">
      {
        faqs.map((faq, i) => (
          <details
            class="group rounded-card bg-[var(--color-blanco-humo)] border border-[var(--color-line)] overflow-hidden tactile"
          >
            <summary class="flex items-start justify-between gap-4 p-5 md:p-6 cursor-pointer list-none">
              <div class="flex items-start gap-3 flex-1 min-w-0">
                <span class="font-impact text-xl md:text-2xl text-[var(--color-azul)] tabular-nums leading-none shrink-0">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="font-display font-semibold text-base md:text-lg text-[var(--color-ink)] leading-snug">
                  {faq.pregunta}
                </h3>
              </div>
              <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--color-line)] text-[var(--color-ink)] group-open:bg-[var(--color-action)] group-open:border-[var(--color-action)] group-open:text-white transition-all" aria-hidden="true">
                <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 16 16">
                  <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="px-5 md:px-6 pb-5 md:pb-6 pl-12 md:pl-16">
              <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                {faq.respuesta}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
