---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="13" fill="currentColor" opacity="0.18"/>
  <circle cx="16" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
  <path d="M10 22L22 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <circle cx="22" cy="10" r="2" fill="currentColor"/>
  <circle cx="10" cy="22" r="2" fill="currentColor"/>
</svg>