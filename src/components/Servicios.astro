---
import servicios from "../data/servicios.json";
---

<section id="servicios" class="py-20 md:py-28 border-b border-[var(--color-border)]">
  <div class="container-page">
    <div class="max-w-2xl mb-14 reveal">
      <h2 class="font-display font-bold tracking-tight text-[var(--color-ink)]">
        Qué puedo hacer por tu negocio.
      </h2>
      <p class="mt-5 text-[var(--color-ink-soft)] text-lg leading-relaxed">
        Cuatro servicios con precio orientativo y entregable definido. Sin paquetes misteriosos,
        sin upsell, sin retainer obligatorio.
      </p>
    </div>

    <ol class="border-t border-[var(--color-border)] reveal-stagger">
      {
        servicios.map((s, i) => (
          <li class="group border-b border-[var(--color-border)]">
            <a
              href={`/contacto?servicio=${encodeURIComponent(s.titulo)}`}
              class="tactile grid grid-cols-[auto_1fr_auto] md:grid-cols-[3rem_1fr_auto_auto] items-baseline gap-5 md:gap-8 py-6 md:py-7"
            >
              <span class="font-mono text-xs text-[var(--color-mute)] tabular-nums pt-1">
                {String(i + 1).padStart(2, "0")} <span class="text-[var(--color-border)]">/</span> 04
              </span>
              <div class="min-w-0">
                <h3 class="font-display font-semibold text-xl md:text-2xl tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-azul)] leading-tight">
                  {s.titulo}
                </h3>
                <p class="mt-1.5 text-sm md:text-base text-[var(--color-ink-soft)] leading-snug max-w-2xl">
                  {s.descripcion}
                </p>
              </div>
              <p class="font-mono text-sm md:text-base text-[var(--color-azul)] font-medium tabular-nums whitespace-nowrap">
                {s.precioOrientativo}
              </p>
              <span
                aria-hidden="true"
                class="hidden md:inline text-[var(--color-mute)] group-hover:text-[var(--color-azul)] group-hover:translate-x-1 transition-transform"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
