---
import servicios from "../data/servicios.json";

const categoryById: Record<string, string> = {
  "web-productos-servicios": "Página web",
  "web-empresarial": "Institucional",
  "ecommerce": "Tienda online",
  "software-a-medida": "Software",
};
---

<section id="servicios" class="relative py-20 md:py-32 border-b border-[var(--color-border)] overflow-hidden">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 md:mb-20">
      <div class="lg:col-span-7 reveal">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">Servicios</p>
        <h2 class="font-impact text-[clamp(2.25rem,6vw,5rem)] uppercase leading-[0.92] text-[var(--color-ink)] mt-2">
          Qué podemos hacer{" "}<span class="text-[var(--color-azul)]">por tu negocio.</span>
        </h2>
      </div>
      <p class="lg:col-span-4 lg:col-start-9 self-end text-[var(--color-ink-soft)] text-lg leading-relaxed reveal">
        {servicios.length} servicios claros: página web, página empresarial, ecommerce y software a medida.
        Abrí uno para ver qué incluye. Los precios son orientativos.
      </p>
    </div>

    <div class="svc-list reveal-stagger border-t border-[var(--color-ink)]">
      {
        servicios.map((s, i) => (
          <details id={s.id} name="servicios" class="svc group" open={i === 0}>
            <summary class="svc__summary">
              <span class="svc__num font-mono tabular-nums">{String(i + 1).padStart(2, "0")}</span>

              <span class="svc__title">
                <span class="svc__name font-impact uppercase">{s.titulo}</span>
                <span class="svc__cat font-mono">
                  {categoryById[s.id] ?? "Servicio"}
                  {s.badge && <> · {s.badge}</>}
                </span>
              </span>

              <span class="svc__price font-mono tabular-nums">
                {s.precioDesdeUsd == null ? "A cotizar" : s.precioOrientativo}
              </span>

              <span class="svc__icon" aria-hidden="true"></span>
            </summary>

            <div class="svc__panel">
              <div class="svc__panel-inner">
                <div class="svc__col">
                  <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-azul)] font-semibold mb-3">
                    {s.subtitulo}
                  </p>
                  <p class="text-base md:text-lg text-[var(--color-ink-soft)] leading-relaxed">
                    {s.descripcion}
                  </p>
                  <p class="mt-6 pl-4 border-l-2 border-[var(--color-dorado)] text-[var(--color-ink)] font-medium leading-snug">
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)] mb-1">
                      Lo que conseguís
                    </span>
                    {s.resultadoCuantificado}
                  </p>
                </div>

                <div class="svc__col">
                  <ul class="space-y-2">
                    {s.queIncluye.slice(0, 5).map((item) => (
                      <li class="flex items-start gap-3 text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                        <span class="mt-2 h-1 w-3 shrink-0 bg-[var(--color-dorado)]" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                    <a
                      href={`/contacto?servicio=${encodeURIComponent(s.titulo)}`}
                      class="btn-sunset"
                    >
                      {s.cta} <span aria-hidden="true">→</span>
                    </a>
                    <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                      Entrega: {s.duracion}
                    </span>
                    {s.precioDesdeUsd == null && (
                      <span class="svc__quote font-mono text-[11px] uppercase tracking-[0.18em] font-semibold">
                        {s.precioOrientativo}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <p class="mt-10 reveal">
      <a
        href="/servicios"
        class="tactile font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)] border-b border-[var(--color-ink)] pb-1 hover:text-[var(--color-azul)] hover:border-[var(--color-azul)]"
      >
        Ver comparativa completa →
      </a>
    </p>
  </div>
</section>
