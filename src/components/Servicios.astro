---
import fs from "node:fs";
import path from "node:path";
import servicios from "../data/servicios.json";
import ProcessMarquee from "./ProcessMarquee.astro";

const categoryById: Record<string, string> = {
  "web-productos-servicios": "Página web",
  "web-empresarial": "Institucional",
  "ecommerce": "Tienda online",
  "software-a-medida": "Software",
};

// Slot de imagen por servicio: si existe public/servicios/<id>.<ext> se renderiza adentro del
// <figure data-service-image>; si no, el figure queda vacío y oculto (sin cambios de markup después).
const imageExts = ["avif", "webp", "jpg", "jpeg", "png"];
const serviceImage = (id: string): string | null => {
  for (const ext of imageExts) {
    if (fs.existsSync(path.join(process.cwd(), "public", "servicios", `${id}.${ext}`))) {
      return `/servicios/${id}.${ext}`;
    }
  }
  return null;
};

const steps = [
  { t: "Hablamos 15 minutos", d: "Nos contás qué vendés y qué necesitás. Sin costo y sin compromiso." },
  { t: "Propuesta con precio claro", d: "Alcance y presupuesto por escrito antes de empezar." },
  { t: "Armamos y te mostramos avances", d: "Vas viendo cómo queda mientras se arma, no solo al final." },
  {
    t: "Entrega con 2 rondas de revisión",
    d: "Ajustamos lo que haga falta. Cada servicio muestra su duración orientativa.",
  },
];
---

<section id="servicios" class="relative py-20 md:py-32 overflow-hidden">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 mb-14 md:mb-24 items-end">
      <div class="lg:col-span-9">
        <p class="eyebrow mb-5">Servicios y precios</p>
        <h2 class="display-xl">
          Tu local, tu catálogo, tu tienda <span class="display-accent">vendiendo</span> online.
        </h2>
      </div>
      <p class="lg:col-span-3 text-[var(--color-ink-soft)] text-base md:text-lg leading-relaxed">
        {servicios.length} servicios claros, con precio orientativo desde el primer día. Abrí uno para ver qué incluye.
      </p>
    </div>

    <div class="svc-list reveal-stagger">
      {
        servicios.map((s, i) => {
          const isQuote = s.precioDesdeUsd == null;
          const isLead = s.id === "ecommerce";
          const img = serviceImage(s.id);
          return (
            <div class:list={["svc-row", isLead && "svc-row--lead", isQuote && "svc-row--quote surface-night"]}>
              <details id={s.id} name="servicios" class="svc" open={i === 0}>
                <summary class="svc__summary">
                  <span class="svc__num font-mono tabular-nums">{String(i + 1).padStart(2, "0")}</span>

                  <span class="svc__title">
                    <span class="svc__cat">
                      {categoryById[s.id] ?? "Servicio"}
                      {s.badge && <> · {s.badge}</>}
                    </span>
                    <span class="svc__name font-impact">{s.titulo}</span>
                    <span class="svc__out">{s.subtitulo}</span>
                  </span>

                  <span class="svc__price price price--end">
                    <span class="sr-only">{s.precioOrientativo}</span>
                    <span class="price__from" aria-hidden="true">{isQuote ? "según tu proyecto" : "desde"}</span>
                    <strong class="price__amount" aria-hidden="true">
                      {isQuote ? "A cotizar" : <><span class="price__cur">USD</span>{s.precioDesdeUsd}</>}
                    </strong>
                  </span>

                  <span class="svc__icon" aria-hidden="true"></span>
                </summary>

                <div class="svc__panel-inner">
                  <div>
                    <p class="svc__label">Para quién</p>
                    <p class="svc__text">{s.idealPara}</p>
                    <p class="svc__label svc__label--gap">Duración orientativa</p>
                    <p class="svc__dur font-mono">{s.duracion}</p>
                  </div>

                  <div>
                    <p class="svc__label">Qué incluye</p>
                    <ul class="hair-list">
                      {s.queIncluye.slice(0, 5).map((item) => (
                        <li class="text-sm md:text-base">{item}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="svc__links">
                    {!isQuote && (
                      <a href={`/contacto?servicio=${encodeURIComponent(s.titulo)}`} class="btn-sunset">
                        {s.cta} <span aria-hidden="true">→</span>
                      </a>
                    )}
                    <a href={`/servicios/${s.id}`} class="svc__more">
                      Ver el detalle <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </details>

              {isQuote && (
                <div class="svc-row__cta">
                  <a href={`/contacto?servicio=${encodeURIComponent(s.titulo)}`} class="btn-sunset">
                    {s.cta} <span aria-hidden="true">→</span>
                  </a>
                </div>
              )}

              <figure class="svc__media" data-service-image data-service={s.id} aria-hidden="true">
                {img && <img src={img} alt="" loading="lazy" decoding="async" />}
              </figure>
            </div>
          );
        })
      }
    </div>

    <p class="mt-8 text-sm text-[var(--color-mute)]">
      Precios orientativos en USD. No incluyen hosting ni dominio.
    </p>

    <p class="mt-5">
      <a
        href="/servicios"
        class="tactile font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)] border-b border-[var(--color-ink)] pb-1 hover:text-[var(--color-azul)] hover:border-[var(--color-azul)]"
      >
        Ver comparativa completa →
      </a>
    </p>

    <div class="mt-20 md:mt-32">
      <p class="eyebrow mb-4">Cómo trabajamos</p>
      <h3 class="display-lg max-w-[18ch] mb-10 md:mb-14">Cuatro pasos, de la primera charla a la entrega.</h3>
      <ol class="process">
        {
          steps.map((st, i) => (
            <li class="process__step">
              <span class="process__num">{String(i + 1).padStart(2, "0")}</span>
              <h4 class="process__t">{st.t}</h4>
              <p class="process__d">{st.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="mt-16 md:mt-24">
    <ProcessMarquee />
  </div>
</section>
