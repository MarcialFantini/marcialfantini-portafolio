---
/* Mascota: robot de depósito que carga el paquete dorado (los datos de la empresa).
   Decorativo (aria-hidden). Cada sección lo ubica y mueve desde afuera; acá vive su "personalidad":
   parpadeo, luz de antena, balanceo, ruedas y la pose. */
interface Props {
  pose?: "carry" | "idle" | "wave" | "think";
  spin?: "none" | "loop" | "entrance";
  drop?: boolean; // deja caer el paquete después de la entrada
  tone?: "navy" | "gold" | "ivory"; // la mascota (navy) y sus amigos
  cargo?: "box" | "mail"; // qué lleva en pose "carry"
  size?: number;
  class?: string;
}
const { pose = "idle", spin = "none", drop = false, tone = "navy", cargo = "box", size = 64, class: cls } = Astro.props;
---

<span
  class:list={["bot", `bot--${pose}`, `bot--${tone}`, `bot--spin-${spin}`, drop && "bot--drop", cls]}
  style={`--bot-size:${size}px`}
  aria-hidden="true"
  data-bot
>
  <svg viewBox="0 0 72 72" width={size} height={size}>
    <g class="bot__bob">
      <path d="M36 11V5" class="bot__stroke" />
      <circle cx="36" cy="4" r="2.6" class="bot__led" />
      <rect x="18" y="11" width="36" height="22" rx="8" class="bot__shell" />
      <rect x="22.5" y="15" width="27" height="14" rx="5" class="bot__screen" />
      <g class="bot__eyes">
        <rect x="28" y="19.5" width="5" height="5" rx="0.8" transform="rotate(45 30.5 22)" />
        <rect x="39" y="19.5" width="5" height="5" rx="0.8" transform="rotate(45 41.5 22)" />
      </g>
      <rect x="33" y="33" width="6" height="4" class="bot__shell" />
      <rect x="8" y="39" width="7" height="12" rx="3" class="bot__shell" />
      <g class="bot__arm-r">
        <rect x="57" y="39" width="7" height="12" rx="3" class="bot__shell" />
      </g>
      <rect x="14" y="37" width="44" height="19" rx="6" class="bot__torso" />
      <path d="M14 47H58" class="bot__stroke bot__thin" />
      {
        pose === "carry" && cargo === "box" && (
          <g class="bot__pkt">
            <rect x="25" y="31" width="22" height="17" rx="2.5" class="bot__gold" />
            <path d="M32.5 31v6.5h7V31" class="bot__stroke bot__thin" />
          </g>
        )
      }
      {
        pose === "carry" && cargo === "mail" && (
          <g class="bot__pkt">
            <rect x="23" y="32" width="26" height="17" rx="2" class="bot__paper" />
            <path d="M23.8 33l12.2 9 12.2-9" class="bot__stroke" />
          </g>
        )
      }
      {
        pose === "think" && (
          <g class="bot__q">
            <circle cx="61" cy="9" r="8.5" class="bot__bubble" />
            <path d="M58.2 6.8a2.9 2.9 0 1 1 4.1 2.6c-.9.4-1.3 1-1.3 1.9" class="bot__stroke" />
            <circle cx="61" cy="14.2" r="1.1" class="bot__dot" />
          </g>
        )
      }
    </g>
    <g class="bot__wheel">
      <circle cx="26" cy="62" r="7" class="bot__tire" />
      <path d="M26 57.5v9M21.5 62h9" class="bot__hub" />
    </g>
    <g class="bot__wheel">
      <circle cx="46" cy="62" r="7" class="bot__tire" />
      <path d="M46 57.5v9M41.5 62h9" class="bot__hub" />
    </g>
  </svg>
</span>

<script>
  // Todas las mascotas se detienen fuera de pantalla
  document.addEventListener("astro:page-load", () => {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) (e.target as HTMLElement).classList.toggle("is-off", !e.isIntersecting);
    });
    document.querySelectorAll<HTMLElement>("[data-bot]").forEach((b) => {
      if (b.dataset.ready) return;
      b.dataset.ready = "1";
      io.observe(b);
    });
  });
</script>

<style>
  .bot {
    display: inline-block;
    width: var(--bot-size);
    height: var(--bot-size);
    line-height: 0;
    pointer-events: none;
  }
  .bot svg { display: block; overflow: visible; }

  .bot__stroke { fill: none; stroke: var(--bot-line, #0f1a3a); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .bot__thin { stroke-width: 1.2; opacity: 0.6; }
  /* Tonos: la mascota (navy) y sus amigos */
  .bot { --shell: #0f1a3a; --screen: #1b2b5c; --eye: #ffd24a; --torso: #f6f1e4; }
  .bot--gold { --shell: #f5c542; --screen: #0f1a3a; --eye: #ffd24a; --torso: #fffdf6; }
  .bot--ivory { --shell: #f6f1e4; --screen: #1b2b5c; --eye: #ffd24a; --torso: #e2c27a; }
  .bot__paper { fill: #fffdf6; stroke: #0f1a3a; stroke-width: 1.6; }
  .bot__shell { fill: var(--shell); stroke: var(--bot-line, #0f1a3a); stroke-width: 1.6; }
  .bot__screen { fill: var(--screen); }
  .bot__eyes rect { fill: var(--eye); }
  .bot__torso { fill: var(--torso); stroke: var(--bot-line, #0f1a3a); stroke-width: 1.6; }
  .bot__gold { fill: #f5c542; stroke: #0f1a3a; stroke-width: 1.6; }
  .bot__tire { fill: #0f1a3a; stroke: var(--bot-line, #0f1a3a); stroke-width: 1.6; }
  .bot__hub { fill: none; stroke: #ffd24a; stroke-width: 1.4; stroke-linecap: round; }
  .bot__led { fill: #ffd24a; }
  .bot__bubble { fill: #fffdf6; stroke: var(--bot-line, #0f1a3a); stroke-width: 1.4; }
  .bot__q .bot__stroke { stroke: #0f1a3a; }
  .bot__dot { fill: #0f1a3a; }

  /* Personalidad: balanceo, parpadeo, antena */
  .bot__bob { animation: bot-bob 1.8s ease-in-out infinite; }
  @keyframes bot-bob { 50% { transform: translateY(-1.5px); } }
  .bot__eyes { transform-box: fill-box; transform-origin: center; animation: bot-blink 4.2s infinite; }
  @keyframes bot-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  .bot__led { animation: bot-led 2s ease-in-out infinite; }
  @keyframes bot-led { 50% { opacity: 0.35; } }

  /* Ruedas */
  .bot__wheel { transform-box: fill-box; transform-origin: center; }
  .bot--spin-loop .bot__wheel { animation: bot-spin 0.9s linear infinite; }
  .bot--spin-entrance .bot__wheel { animation: bot-spin 0.9s linear 0.6s 3; }
  @keyframes bot-spin { to { transform: rotate(360deg); } }

  /* Poses */
  .bot__arm-r { transform-box: fill-box; transform-origin: 50% 0; }
  .bot--wave .bot__arm-r { animation: bot-wave 2.4s ease-in-out infinite; }
  @keyframes bot-wave {
    0%, 55%, 100% { transform: rotate(0deg); }
    65% { transform: rotate(-150deg); }
    72% { transform: rotate(-120deg); }
    79% { transform: rotate(-150deg); }
    86% { transform: rotate(-120deg); }
  }
  .bot__q { transform-box: fill-box; transform-origin: 0% 100%; animation: bot-q 3s ease-in-out infinite; }
  @keyframes bot-q {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-2px) rotate(6deg); }
  }

  /* Deja el paquete: baja y se desvanece al terminar la entrada */
  .bot--drop .bot__pkt { animation: bot-drop 700ms var(--ease-out-expo) 3.4s forwards; }
  @keyframes bot-drop {
    to { transform: translateY(26px); opacity: 0; }
  }

  /* Festejo: un ancestro con data-bot-mood="party" lo hace saltar */
  :global([data-bot-mood="party"]) .bot__bob { animation: bot-jump 1.3s var(--ease-out-quart) infinite; }
  :global([data-bot-mood="party"]) .bot__led { animation-duration: 0.5s; }
  @keyframes bot-jump {
    0%, 45%, 100% { transform: translateY(0); }
    20% { transform: translateY(-9px); }
    32% { transform: translateY(0); }
    38% { transform: translateY(-3px); }
  }

  .bot.is-off * { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .bot * { animation: none !important; }
    .bot--drop .bot__pkt { opacity: 1; }
  }
</style>
