---
import RobotRelay from "./RobotRelay.astro";
/* "Qué resolvemos": una estación ilustrada por área.
   Metáfora única: los datos de la empresa son paquetes dorados que viajan por la operación. */

// Engranaje: dientes trapezoidales alrededor de un círculo
const gear = (cx: number, cy: number, ro: number, ri: number, teeth: number) => {
  const step = (Math.PI * 2) / teeth;
  const p = (a: number, r: number) => `${(cx + Math.cos(a) * r).toFixed(1)},${(cy + Math.sin(a) * r).toFixed(1)}`;
  let d = "";
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    d += `${i ? "L" : "M"}${p(a, ri)} L${p(a + step * 0.12, ro)} L${p(a + step * 0.38, ro)} L${p(a + step * 0.5, ri)} `;
  }
  return d + "Z";
};

// Inventario: estantería 3 x 7
const slots = [0, 1, 2].flatMap((row) =>
  [0, 1, 2, 3, 4, 5, 6].map((k) => ({ row, k, x: 56 + k * 56, y: 44 + row * 50 })),
);
const goldBox = new Set(["0-1", "1-4", "2-2"]);
const emptyBox = new Set(["0-3", "2-5"]);

// Integraciones: nodos conectados a un hub central
const hub = { x: 240, y: 100 };
const nodes = [
  { label: "Excel", x: 24, y: 24, ax: 142, ay: 41 },
  { label: "ERP", x: 338, y: 24, ax: 338, ay: 41 },
  { label: "Tienda online", x: 24, y: 142, ax: 142, ay: 159 },
  { label: "Facturación", x: 338, y: 142, ax: 338, ay: 159 },
].map((n, i) => {
  const dx = hub.x - n.ax;
  const dy = hub.y - n.ay;
  return { ...n, len: Math.hypot(dx, dy) - 20, ang: (Math.atan2(dy, dx) * 180) / Math.PI, inbound: i % 2 === 0 };
});

const estaciones = [
  { id: "inventario", t: "Inventario", d: "Stock real por depósito, con alertas antes de quedarte sin nada.", size: "lg" },
  { id: "procesos", t: "Procesos", d: "Cada pedido con etapas, responsable y estado. Sin perseguir a nadie.", size: "md" },
  { id: "automatizaciones", t: "Automatizaciones", d: "Carga de datos, facturas y mails repetitivos se hacen solos.", size: "sm" },
  { id: "monitoreo", t: "Monitoreo", d: "Te avisa cuando algo se desvía, antes que el cliente.", size: "sm" },
  { id: "kpis", t: "KPIs y tableros", d: "Los números que importan, actualizados solos.", size: "sm" },
  { id: "informes", t: "Informes", d: "El reporte mensual listo en minutos, con números que cierran.", size: "md" },
  { id: "integraciones", t: "Integraciones", d: "Excel, ERP, tienda y facturación hablando entre sí.", size: "lg" },
];
---

<section id="problemas" class="relative py-20 md:py-28" aria-labelledby="problemas-title">
  <div class="container-page">
    <h2 id="problemas-title" class="display-lg max-w-[20ch]">
      Si se repite, se cuenta o se pierde, <span class="display-accent">lo resolvemos con software.</span>
    </h2>

    <div class="mt-8 md:mt-10"><RobotRelay /></div>

    <ul class="st-grid" data-stations>
      {
        estaciones.map((e) => (
          <li class:list={["st", `st--${e.size}`, `st--${e.id}`]}>
            <div class="st__art" aria-hidden="true">
              {e.id === "inventario" && (
                <svg viewBox="0 0 480 200" class="il">
                  <rect x="40" y="30" width="400" height="152" rx="4" class="il-line" />
                  <path d="M40 80H440M40 130H440" class="il-line" />
                  {slots.map((s) => {
                    const key = `${s.row}-${s.k}`;
                    if (emptyBox.has(key))
                      return (
                        <rect x={s.x} y={s.y} width="40" height="34" rx="3" class:list={["il-empty", key === "0-3" && "il-warn"]} />
                      );
                    return (
                      <g>
                        <rect x={s.x} y={s.y} width="40" height="34" rx="3" class={goldBox.has(key) ? "il-gold" : "il-box"} />
                        <path d={`M${s.x + 14} ${s.y}V${s.y + 10}H${s.x + 26}V${s.y}`} class="il-line il-thin" />
                      </g>
                    );
                  })}
                  <g class="inv-beam">
                    <rect x="40" y="26" width="2.5" height="160" class="il-goldfill" />
                    <rect x="42.5" y="26" width="26" height="160" fill="url(#beam)" />
                  </g>
                  <defs>
                    <linearGradient id="beam" x1="0" x2="1">
                      <stop offset="0" stop-color="#FFD24A" stop-opacity="0.35" />
                      <stop offset="1" stop-color="#FFD24A" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <g class="inv-tag">
                    <path d="M244 26V40" class="il-line il-thin il-dash" />
                    <rect x="208" y="6" width="72" height="20" rx="10" class="il-goldfill" />
                    <text x="244" y="20" text-anchor="middle" class="il-txt il-txt--on">REPONER</text>
                  </g>
                </svg>
              )}

              {e.id === "procesos" && (
                <svg viewBox="0 0 320 200" class="il">
                  {[
                    { x: 70, l: "PEDIDO", d: "0.9s" },
                    { x: 160, l: "ARMADO", d: "1s" },
                    { x: 250, l: "ENVÍO", d: "1.1s" },
                  ].map((s) => (
                    <g>
                      <text x={s.x} y="34" text-anchor="middle" class="il-txt">{s.l}</text>
                      <path d={`M${s.x} 62V126`} class="il-line il-thin il-dash" />
                      <rect x={s.x - 8} y="44" width="16" height="16" transform={`rotate(45 ${s.x} 52)`} class="il-box" />
                      <rect x={s.x - 8} y="44" width="16" height="16" transform={`rotate(45 ${s.x} 52)`} class="il-goldfill proc-node" style={`animation-delay:${s.d}`} />
                    </g>
                  ))}
                  <rect x="20" y="130" width="280" height="18" rx="9" class="il-line" />
                  <path d="M30 139H290" class="il-line il-thin proc-belt" />
                  {[0, -2, -4].map((d) => (
                    <g transform="translate(20 107)">
                      <g class="proc-pkt" style={`animation-delay:${d}s`}>
                        <rect width="22" height="20" rx="3" class="il-gold" />
                        <path d="M7 0V7H15V0" class="il-line il-thin" />
                      </g>
                    </g>
                  ))}
                </svg>
              )}

              {e.id === "automatizaciones" && (
                <svg viewBox="0 0 320 200" class="il">
                  <rect x="26" y="78" width="46" height="58" rx="3" transform="rotate(-9 49 107)" class="il-box" />
                  <rect x="30" y="74" width="46" height="58" rx="3" transform="rotate(5 53 103)" class="il-box" />
                  <g class="auto-paper">
                    <rect x="34" y="80" width="40" height="50" rx="3" class="il-box" />
                    <path d="M42 94H66M42 104H66M42 114H58" class="il-line il-thin" />
                  </g>
                  <g class="auto-gear">
                    <path d={gear(160, 104, 40, 32, 12)} class="il-box" />
                    <circle cx="160" cy="104" r="11" class="il-line" />
                  </g>
                  <g class="auto-gear auto-gear--sm">
                    <path d={gear(212, 64, 25, 19, 8)} class="il-gold" />
                    <circle cx="212" cy="64" r="6" class="il-line" />
                  </g>
                  <path d="M228 120H250" class="il-line il-thin" />
                  <path d="M246 115l5 5-5 5" class="il-line il-thin" />
                  <rect x="258" y="138" width="40" height="22" rx="3" class="il-gold" />
                  <rect x="258" y="114" width="40" height="22" rx="3" class="il-gold" />
                  <rect x="258" y="90" width="40" height="22" rx="3" class="il-gold auto-out" />
                </svg>
              )}

              {e.id === "monitoreo" && (
                <svg viewBox="0 0 320 200" class="il">
                  <rect x="26" y="34" width="268" height="140" rx="10" class="il-line" />
                  <path d="M26 72H294" class="il-line il-thin il-dash il-warnline" />
                  <text x="286" y="66" text-anchor="end" class="il-txt il-txt--sm">LÍMITE</text>
                  <path
                    d="M38 126H96L106 126L114 104L122 146L132 52L142 126H196L204 114L212 126H282"
                    class="mon-ekg"
                    pathLength="100"
                  />
                  <g class="mon-alert">
                    <rect x="102" y="16" width="62" height="20" rx="10" class="il-goldfill" />
                    <text x="133" y="30" text-anchor="middle" class="il-txt il-txt--on">ALERTA</text>
                  </g>
                  <g class="mon-bell">
                    <path d="M262 22c0-8 5-12 10-12s10 4 10 12v8l3 4h-26l3-4z" class="il-gold" />
                    <circle cx="272" cy="37" r="2.5" class="il-goldfill" />
                  </g>
                </svg>
              )}

              {e.id === "kpis" && (
                <svg viewBox="0 0 320 200" class="il">
                  <path d="M80 128A80 80 0 0 1 240 128" class="il-line kpi-track" />
                  <path d="M80 128A80 80 0 0 1 240 128" class="kpi-arc" pathLength="100" />
                  <g class="kpi-needle">
                    <path d="M158 128L160 62L162 128Z" class="il-goldfill" />
                  </g>
                  <circle cx="160" cy="128" r="7" class="il-box" />
                  <text x="80" y="146" text-anchor="middle" class="il-txt il-txt--sm">0</text>
                  <text x="240" y="146" text-anchor="middle" class="il-txt il-txt--sm">100</text>
                  {[0, 1, 2, 3, 4, 5, 6].map((i) => (
                    <rect
                      x={104 + i * 16}
                      y="156"
                      width="10"
                      height="32"
                      rx="2"
                      class:list={["kpi-bar", i === 5 ? "il-gold" : "il-box"]}
                      style={`animation-delay:${(-i * 0.37).toFixed(2)}s`}
                    />
                  ))}
                </svg>
              )}

              {e.id === "informes" && (
                <svg viewBox="0 0 320 200" class="il">
                  <defs>
                    <clipPath id="inf-clip">
                      <rect x="0" y="60" width="320" height="140" />
                    </clipPath>
                  </defs>
                  <g clip-path="url(#inf-clip)">
                    <g class="inf-doc">
                      <rect x="112" y="62" width="96" height="104" rx="3" class="il-box" />
                      <path d="M124 78H180M124 88H196" class="il-line il-thin" />
                      <rect x="126" y="130" width="10" height="24" class="il-box" />
                      <rect x="142" y="118" width="10" height="36" class="il-box" />
                      <rect x="158" y="110" width="10" height="44" class="il-gold" />
                      <rect x="174" y="122" width="10" height="32" class="il-box" />
                      <circle cx="190" cy="106" r="9" class="il-goldfill inf-stamp" />
                      <path d="M186 106l3 3 5-6" class="il-line il-thin inf-stamp" />
                    </g>
                  </g>
                  <rect x="86" y="14" width="148" height="48" rx="10" class="il-box" />
                  <path d="M100 60H220" class="il-line" />
                  <circle cx="214" cy="31" r="4" class="il-goldfill inf-led" />
                  <path d="M104 31H150" class="il-line il-thin" />
                </svg>
              )}

              {e.id === "integraciones" && (
                <svg viewBox="0 0 480 200" class="il">
                  {nodes.map((n) => (
                    <path d={`M${n.ax} ${n.ay}L${hub.x} ${hub.y}`} class="il-line il-thin il-dash" />
                  ))}
                  {nodes.map((n, i) => (
                    <g transform={`translate(${n.ax} ${n.ay}) rotate(${n.ang.toFixed(1)})`}>
                      <rect
                        x="-5"
                        y="-5"
                        width="10"
                        height="10"
                        transform="rotate(45)"
                        class:list={["il-goldfill", "int-pkt", !n.inbound && "int-pkt--out"]}
                        style={`--len:${n.len.toFixed(1)}px;animation-delay:${(-i * 0.6).toFixed(1)}s`}
                      />
                    </g>
                  ))}
                  {nodes.map((n) => (
                    <g>
                      <rect x={n.x} y={n.y} width="118" height="34" rx="8" class="il-box" />
                      <text x={n.x + 59} y={n.y + 21} text-anchor="middle" class="il-txt">{n.label.toUpperCase()}</text>
                    </g>
                  ))}
                  <g class="int-hub">
                    <rect x={hub.x - 20} y={hub.y - 20} width="40" height="40" rx="6" transform={`rotate(45 ${hub.x} ${hub.y})`} class="il-gold" />
                  </g>
                  <path
                    d={`M${hub.x - 9} ${hub.y - 5}h18l4 6-13 15-13-15z M${hub.x - 13} ${hub.y + 1}h26`}
                    class="il-line il-thin"
                  />
                </svg>
              )}
            </div>
            <div class="st__txt">
              <h3 class="st__t">{e.t}</h3>
              <p class="st__d">{e.d}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 md:mt-16 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8">
      <a href="/contacto?servicio=Diagn%C3%B3stico%20gratis" class="btn-sunset self-start">
        Tengo uno de estos problemas <span aria-hidden="true">→</span>
      </a>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-[44ch]">
        ¿El tuyo no está? Contanos igual: si se resuelve con software, te decimos cómo y cuánto cuesta.
      </p>
    </div>
  </div>
</section>

<script>
  // Las ilustraciones solo se animan mientras la grilla está en pantalla
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-stations]").forEach((grid) => {
      if (grid.dataset.ready) return;
      grid.dataset.ready = "1";
      new IntersectionObserver(([e]) => grid.classList.toggle("is-live", e.isIntersecting), { threshold: 0.05 }).observe(grid);
    });
  });
</script>

<style>
  .st-grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .st-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .st--lg { grid-column: span 6; }
    .st--md { grid-column: span 3; }
    .st--sm { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .st-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .st--inventario { grid-column: span 7; }
    .st--procesos { grid-column: span 5; }
    .st--sm { grid-column: span 4; }
    .st--informes { grid-column: span 5; }
    .st--integraciones { grid-column: span 7; }
  }

  .st {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-hair);
    background: var(--color-page);
    overflow: hidden;
    transition: border-color 250ms var(--ease-out-quart), background-color 250ms var(--ease-out-quart);
  }
  .st:hover { border-color: var(--color-hair-strong); }
  .st__art {
    height: clamp(170px, 14vw + 90px, 230px);
    padding: 0.75rem 0.75rem 0;
    color: var(--color-ink);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
    -webkit-mask-image: linear-gradient(180deg, #000 88%, transparent);
    mask-image: linear-gradient(180deg, #000 88%, transparent);
  }
  .st__txt { padding: 0.25rem 1.25rem 1.4rem; }
  .st__t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .st__d { margin-top: 0.4rem; color: var(--color-ink-soft); line-height: 1.5; max-width: 44ch; text-wrap: pretty; }

  /* CTA: navy con texto dorado para máximo contraste sobre el panel claro */
  #problemas :global(.btn-sunset) { background: var(--color-action); color: var(--color-neon); box-shadow: 0 8px 24px -12px rgba(15, 26, 58, 0.6); }
  #problemas :global(.btn-sunset:hover) { color: var(--color-on-gold); }
  :global(.dark) #problemas :global(.btn-sunset) { background: var(--color-neon); color: var(--color-on-gold); }

  /* ---------- Vocabulario visual compartido ---------- */
  .il { display: block; width: 100%; height: 100%; overflow: visible; }
  /* Solo las piezas que giran/escalan usan su propia caja como origen */
  .auto-gear, .kpi-needle, .kpi-bar, .mon-bell, .inf-stamp, .int-hub { transform-box: fill-box; }
  .il-line { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .il-thin { stroke-width: 1.2; opacity: 0.8; }
  .il-dash { stroke-dasharray: 3 4; }
  .il-box { fill: var(--color-blanco); stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
  .il-gold { fill: #f5c542; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
  .il-goldfill { fill: #f5c542; }
  .il-empty { fill: none; stroke: currentColor; stroke-width: 1.2; stroke-dasharray: 4 3; opacity: 0.7; }
  .il-warn { stroke: #c98a10; stroke-width: 1.8; opacity: 1; }
  .il-warnline { stroke: #d99a1e; opacity: 0.8; }
  .il-txt { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; fill: currentColor; }
  .il-txt--sm { font-size: 10px; }
  .il-txt--on { fill: #0f1a3a; font-weight: 700; }

  /* ---------- Animaciones (transform/opacity; trazos cortos con dashoffset) ---------- */
  .inv-beam { animation: inv-scan 4.5s ease-in-out infinite alternate; }
  @keyframes inv-scan { to { transform: translateX(395px); } }
  .il-warn { animation: blink 1.6s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .inv-tag { animation: bob 2.4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-3px); } }

  .proc-pkt { animation: proc-move 6s linear infinite; }
  @keyframes proc-move {
    0% { transform: translateX(0); opacity: 0; }
    6%, 94% { opacity: 1; }
    100% { transform: translateX(258px); opacity: 0; }
  }
  .proc-node { opacity: 0; animation: node 2s ease-out infinite; }
  @keyframes node {
    0% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  .proc-belt { stroke-dasharray: 2 10; animation: belt 1s linear infinite; }
  @keyframes belt { to { stroke-dashoffset: -12; } }

  .auto-gear { transform-origin: center; animation: spin 9s linear infinite; }
  .auto-gear--sm { animation-duration: 6s; animation-direction: reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .auto-paper { animation: feed 3s var(--ease-out-expo) infinite; }
  @keyframes feed {
    0% { transform: translateX(0); opacity: 1; }
    60% { transform: translateX(70px); opacity: 0; }
    61% { transform: translateX(0); opacity: 0; }
    100% { opacity: 1; }
  }
  .auto-out { animation: out 3s var(--ease-out-expo) infinite; }
  @keyframes out {
    0%, 55% { transform: translateY(-14px); opacity: 0; }
    80%, 100% { transform: none; opacity: 1; }
  }

  .mon-ekg {
    fill: none;
    stroke: #e3ac2c;
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 100;
    animation: ekg 3s linear infinite;
  }
  @keyframes ekg {
    0% { stroke-dashoffset: 100; }
    70%, 100% { stroke-dashoffset: 0; }
  }
  .mon-alert { opacity: 0; animation: alert 3s ease-out infinite; }
  @keyframes alert {
    0%, 30% { opacity: 0; transform: translateY(4px); }
    36%, 80% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  .mon-bell { transform-origin: 50% 0; animation: ring 3s ease-in-out infinite; }
  @keyframes ring {
    0%, 30%, 52%, 100% { transform: rotate(0); }
    36% { transform: rotate(14deg); }
    42% { transform: rotate(-12deg); }
    47% { transform: rotate(6deg); }
  }

  .kpi-track { stroke-width: 10; opacity: 0.12; }
  .kpi-arc { fill: none; stroke: #f5c542; stroke-width: 10; stroke-linecap: round; stroke-dasharray: 72 100; }
  .kpi-needle { transform-origin: 50% 100%; animation: needle 3.6s ease-in-out infinite alternate; }
  @keyframes needle {
    from { transform: rotate(-48deg); }
    to { transform: rotate(38deg); }
  }
  .kpi-bar { transform-origin: 50% 100%; animation: bar 2.6s ease-in-out infinite alternate; }
  @keyframes bar {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }

  .inf-doc { animation: print 5s var(--ease-out-expo) infinite; }
  @keyframes print {
    /* Opacidad explícita en cada tramo: si no, se interpola de 1 a 0 durante todo el ciclo */
    0% { transform: translateY(-104px); opacity: 1; }
    45%, 85% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(0); opacity: 0; }
  }
  .inf-stamp { opacity: 0; animation: stamp 5s ease-out infinite; }
  @keyframes stamp {
    0%, 48% { opacity: 0; transform: scale(1.6); }
    56%, 88% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; }
  }
  .inf-led { animation: blink 0.9s steps(2) infinite; }

  .int-pkt { animation: travel 2.4s ease-in-out infinite; }
  .int-pkt--out { animation-direction: reverse; }
  @keyframes travel {
    0% { translate: 0 0; opacity: 0; }
    15%, 85% { opacity: 1; }
    100% { translate: var(--len) 0; opacity: 0; }
  }
  .int-hub { transform-origin: center; animation: hub 2.4s ease-in-out infinite; }
  @keyframes hub { 50% { transform: scale(1.1); } }

  /* Fuera de pantalla: todo quieto */
  .st-grid:not(.is-live) .il * { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .il * { animation: none !important; }
    .proc-node, .mon-alert, .inf-stamp { opacity: 1; }
    .proc-pkt { transform: translateX(120px); }
    .mon-ekg { stroke-dashoffset: 0; }
  }
</style>
