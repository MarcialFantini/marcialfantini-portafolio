---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  proyecto: CollectionEntry<"proyectos">;
  compact?: boolean;
}

const { proyecto, compact = false } = Astro.props;
const { title, cliente, descripcion, stack, fecha, metricas } = proyecto.data;
const heroMetric = metricas[0];
---

<a
  href={`/proyectos/${proyecto.id}`}
  class="group block border border-[var(--color-border)] rounded-md bg-[var(--color-blanco)] hover:border-[var(--color-dorado)] transition-colors h-full overflow-hidden"
>
  <div
    class="px-6 pt-6 pb-5 border-b border-[var(--color-border)] flex items-start justify-between gap-3"
  >
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-1">
        {cliente}
      </p>
      <h3
        class="font-display font-semibold text-xl tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-dorado)] transition-colors leading-snug"
      >
        {title}
      </h3>
    </div>
    {heroMetric && (
      <div class="shrink-0 text-right">
        <p class="font-impact text-[var(--color-dorado)] text-2xl uppercase tabular-nums leading-none">
          {heroMetric.value}
        </p>
        <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--color-mute)] mt-1 leading-tight max-w-[80px]">
          {heroMetric.label}
        </p>
      </div>
    )}
  </div>

  <div class="p-6">
    {!compact && (
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed line-clamp-3 mb-5">
        {descripcion}
      </p>
    )}

    <div class="flex flex-wrap gap-1.5 mb-5">
      {stack.slice(0, 4).map((s) => (
        <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--color-blanco-humo)] border border-[var(--color-border)] text-[var(--color-ink-soft)]">
          {s}
        </span>
      ))}
    </div>

    <div class="flex items-center justify-between text-xs font-mono text-[var(--color-mute)]">
      <FormattedDate date={fecha} format="short" />
      <span class="opacity-0 group-hover:opacity-100 text-[var(--color-dorado)] transition-opacity">
        Ver caso →
      </span>
    </div>
  </div>
</a>
