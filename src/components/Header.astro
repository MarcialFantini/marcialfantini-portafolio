---
import site from "../data/site.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const navItems = [
  { href: "/servicios", label: "Servicios" },
  ...((await hasPublishedProjects()) ? [{ href: "/proyectos", label: "Proyectos" }] : []),
  ...((await hasPublishedPosts()) ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/contacto", label: "Contacto" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + "/");
---

<header class="sh wrap" data-site-header>
  <a href="/" class="sh__name plain" aria-label={`${site.name}, ir al inicio`}>{site.name}</a>

  <nav class="sh__nav" aria-label="Principal">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <button type="button" class="sh__menu" aria-expanded="false" aria-controls="sh-sheet" data-menu>
    Menú
  </button>

  <div class="sh__sheet" id="sh-sheet" hidden>
    <nav aria-label="Móvil">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  function bindMenu() {
    const btn = document.querySelector<HTMLButtonElement>("[data-menu]");
    const sheet = document.getElementById("sh-sheet");
    if (!btn || !sheet || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Cerrar" : "Menú";
      sheet.hidden = !open;
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    sheet.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        set(false);
        btn.focus();
      }
    });
  }
  document.addEventListener("astro:page-load", bindMenu);
</script>

<style>
  .sh {
    position: relative;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    font-size: var(--step-small);
  }
  .sh__name {
    font-size: var(--step-body);
    font-weight: 500;
    color: var(--color-fg);
  }
  .sh__nav { display: none; gap: 1.75rem; }
  .sh__nav a {
    color: var(--color-fg);
    font-size: var(--step-body);
    transition: color 160ms var(--ease-out-quart);
  }
  .sh__nav a:hover,
  .sh__nav a[aria-current="page"] { color: var(--color-accent); }

  .sh__menu {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: var(--color-fg);
    font: inherit;
    font-size: var(--step-body);
    font-weight: 500;
    cursor: pointer;
  }
  .sh__sheet {
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--color-surface);
    padding: 1rem var(--gutter) 2rem;
  }
  .sh__sheet nav { display: flex; flex-direction: column; }
  .sh__sheet a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .sh__nav { display: flex; }
    .sh__menu, .sh__sheet { display: none; }
  }
</style>
