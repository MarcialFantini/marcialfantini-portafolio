---
import site from "../data/site.json";

const navItems = [
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-blanco-humo)]/80 dark:bg-[var(--color-blanco-humo)]/70 border-b border-[var(--color-border)]"
>
  <div class="container-page flex items-center justify-between h-16 md:h-[68px]">
    <a
      href="/"
      class="flex items-center gap-2.5 group"
      aria-label={`${site.name} - ir al inicio`}
    >
      <span
        class="tactile inline-flex items-center justify-center w-9 h-9 rounded-md bg-[var(--color-ink)] text-[var(--color-azul)] font-impact text-sm uppercase tracking-wide group-hover:bg-[var(--color-azul)] group-hover:text-[var(--color-ink)] border-2 border-[var(--color-ink)] group-hover:border-[var(--color-ink)]"
      >
        MF
      </span>
      <span class="font-display font-semibold text-[var(--color-ink)] text-[15px] hidden sm:inline tracking-tight">
        {site.shortName}<span class="text-[var(--color-mute)]">.dev</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden md:flex items-center gap-7">
      {
        navItems.map((item) => {
          const active =
            item.href === "/"
              ? pathname === "/"
              : pathname.startsWith(item.href.split("#")[0]) && item.href !== "/";
          return (
            <a
              href={item.href}
              class:list={[
                "tactile text-sm font-medium tracking-tight",
                active
                  ? "text-[var(--color-dorado)] underline underline-offset-[6px] decoration-2"
                  : "text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href="/contacto"
        class="tactile inline-flex items-center justify-center px-4 py-2 rounded-md bg-[var(--color-ink)] text-[var(--color-azul)] text-sm font-semibold hover:bg-[var(--color-azul)] hover:text-[var(--color-ink)] border-2 border-[var(--color-ink)]"
      >
        Hablemos
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-trigger"
      class="tactile md:hidden p-2 -mr-2 text-[var(--color-ink)]"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-blanco-humo)]">
    <nav aria-label="Móvil" class="container-page flex flex-col py-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="tactile py-3 text-base font-medium text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] border-b border-[var(--color-border)] last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="tactile mt-3 inline-flex items-center justify-center px-4 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-azul)] text-base font-semibold border-2 border-[var(--color-ink)]"
      >
        Hablemos
      </a>
    </nav>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const menu = document.getElementById('mobile-menu');
  if (trigger && menu) {
    trigger.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      trigger.setAttribute('aria-expanded', String(open));
    });
  }
</script>
