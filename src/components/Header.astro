---
import site from "../data/site.json";

const navItems = [
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-blanco-humo)]/80 border-b border-[var(--color-border)]"
>
  <div class="container-page flex items-center justify-between h-16 md:h-[72px] gap-6">
    <a
      href="/"
      class="flex items-center gap-1.5 group shrink-0"
      aria-label={`${site.name} — ir al inicio`}
    >
      <span class="font-impact text-[22px] md:text-[26px] leading-none uppercase text-[var(--color-ink)] tracking-[-0.02em]">
        M<span class="text-[var(--color-azul)]">F</span>
      </span>
      <span aria-hidden="true" class="font-impact text-[22px] md:text-[26px] leading-none text-[var(--color-border)]">[</span>
      <span class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] hidden sm:inline">
        dev
      </span>
      <span aria-hidden="true" class="font-impact text-[22px] md:text-[26px] leading-none text-[var(--color-border)] hidden sm:inline">]</span>
    </a>

    <nav aria-label="Principal" class="hidden md:flex items-center gap-1">
      {
        navItems.map((item) => {
          const active =
            item.href === "/"
              ? pathname === "/"
              : pathname.startsWith(item.href.split("#")[0]) && item.href !== "/";
          return (
            <a
              href={item.href}
              class:list={[
                "tactile font-mono text-[11px] uppercase tracking-[0.18em] px-3 py-2 rounded-md",
                active
                  ? "text-[var(--color-ink)] bg-[var(--color-border)]/40"
                  : "text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] hover:bg-[var(--color-border)]/30",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a
      href="/contacto"
      class="tactile hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-azul)] text-[var(--color-blanco-humo)] text-[11px] font-mono uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul-deep)]"
    >
      Hablemos
      <span aria-hidden="true">→</span>
    </a>

    <button
      type="button"
      id="mobile-menu-trigger"
      class="tactile md:hidden p-2 -mr-2 text-[var(--color-ink)]"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-blanco-humo)]">
    <nav aria-label="Móvil" class="container-page flex flex-col py-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="tactile py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] border-b border-[var(--color-border)] last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="tactile mt-4 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-[var(--color-azul)] text-[var(--color-blanco-humo)] font-mono text-[11px] uppercase tracking-[0.18em] font-semibold"
      >
        Hablemos
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const menu = document.getElementById('mobile-menu');
  if (trigger && menu) {
    trigger.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      trigger.setAttribute('aria-expanded', String(open));
    });
  }
</script>