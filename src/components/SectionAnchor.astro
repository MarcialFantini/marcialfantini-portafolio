---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="flex items-baseline gap-2 mb-3">
  <span class="font-impact text-2xl tabular-nums text-[var(--color-azul)] leading-none">
    {number}
  </span>
  <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-current opacity-60 leading-none">
    / {label}
  </span>
</div>
