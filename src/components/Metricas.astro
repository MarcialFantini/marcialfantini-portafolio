---
import metricas from "../data/metricas.json";
import SectionAnchor from "./SectionAnchor.astro";

const isNumeric = (v: string) => /^[+\d.,kKmM\s%]+$/.test(v.trim());

const parseCount = (v: string): number | null => {
  if (!isNumeric(v)) return null;
  const cleaned = v.replace(/[^\d.]/g, "");
  const n = parseFloat(cleaned);
  return Number.isFinite(n) ? n : null;
};
---

<section
  class="relative py-20 md:py-28 bg-[var(--color-ink)] text-[var(--color-blanco-humo)] border-y border-[var(--color-ink)] overflow-hidden isolate"
  aria-label="Métricas destacadas"
>
  <div class="container-page relative z-[1]">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12 md:mb-16 reveal">
      <div>
        <SectionAnchor number="02" label="TRACK RECORD" />
        <h2 class="font-impact text-[clamp(2rem,5vw,4rem)] uppercase leading-[0.95] text-[var(--color-blanco-humo)] max-w-xl mt-2">
          Resultados <span class="text-[var(--color-azul)]">medibles</span> en producción.
        </h2>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-blanco-humo)]/60 max-w-xs leading-relaxed">
        Números acumulados. Sin vanity metrics, sin inflar.
      </p>
    </div>

    <div class="timeline-line text-[var(--color-azul)] mb-12 md:mb-16" aria-hidden="true">
      <span class="timeline-line__dot" style="margin-left: 0;"></span>
      <span class="timeline-line__dot"></span>
      <span class="timeline-line__dot"></span>
      <span class="timeline-line__dot"></span>
      <span class="timeline-line__dot" style="margin-right: 0;"></span>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-10 reveal-stagger">
      {
        metricas.map((m) => {
          const numeric = isNumeric(m.value);
          const count = parseCount(m.value);
          return (
            <div class="stat-ticket">
              <span class="stat-ticket__dot" aria-hidden="true"></span>
              <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-blanco-humo)]/70 mb-4 leading-tight">
                {m.label}
              </dt>
              {numeric ? (
                <dd class="font-impact text-[clamp(2.75rem,7vw,5.5rem)] text-[var(--color-blanco-humo)] leading-[0.92] uppercase tabular-nums tracking-[-0.02em]">
                  {count !== null ? (
                    <span class="stat-count" data-value={String(count)}>{m.value}</span>
                  ) : (
                    <span>{m.value}</span>
                  )}
                  <span class="text-[var(--color-azul)]">{m.sufijo}</span>
                </dd>
              ) : (
                <dd class="font-mono text-base md:text-lg font-semibold text-[var(--color-azul)] leading-tight break-words">
                  {m.value}
                </dd>
              )}
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var stats = Array.from(document.querySelectorAll('.stat-count[data-value]')) as HTMLElement[];

    if (reduce) {
      stats.forEach(function (el) {
        var raw = el.dataset.value ?? '';
        var n = parseFloat(raw);
        el.textContent = Number.isFinite(n) ? String(Math.round(n)) : el.textContent;
      });
      return;
    }

    function easeOutCubic(t: number) {
      return 1 - Math.pow(1 - t, 3);
    }

    function animate(el: HTMLElement) {
      var raw = el.dataset.value ?? '';
      var target = parseFloat(raw);
      if (!Number.isFinite(target)) return;
      var duration = 1200;
      var start = performance.now();

      function tick(now: number) {
        var t = Math.min((now - start) / duration, 1);
        var v = Math.round(target * easeOutCubic(t));
        el.textContent = String(v);
        if (t < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = String(Math.round(target));
        }
      }

      requestAnimationFrame(tick);
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );

    stats.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>