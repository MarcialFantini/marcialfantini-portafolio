---
import Layout from "../layouts/Layout.astro";
import Contacto from "../components/Contacto.astro";
import site from "../data/site.json";
---

<Layout
  title={`Contacto — ${site.name}`}
  description={`Contanos qué problema querés resolver: software a medida, página web o tienda online. Escribinos a ${site.email} o usá el formulario y te respondemos en 24 h hábiles.`}
>
  <section class="cp wrap" aria-labelledby="cp-title">
    <h1 id="cp-title" class="cp__h1" data-split>Contanos el problema.</h1>
    <p class="cp__lead" data-rise style="--i:1">
      Tres cosas alcanzan: qué negocio tenés, qué te duele hoy y por qué ahora. Te respondemos en 24 h hábiles, y si querés
      arrancamos con un diagnóstico gratis de 30 minutos.
    </p>
  </section>

  <Contacto />
</Layout>

<style>
  .cp { padding-top: clamp(3rem, 8vw, 6rem); }
  .cp__h1 { font-size: clamp(3rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; max-width: 11ch; }
  .cp__lead { margin-top: 2rem; font-size: var(--step-lead); line-height: 1.3; max-width: 42ch; }
</style>
