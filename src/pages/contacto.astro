---
import Layout from "../layouts/Layout.astro";
import Contacto from "../components/Contacto.astro";
import site from "../data/site.json";
---

<Layout
  title={`Contacto — ${site.name}`}
  description={`Contanos qué necesitás: página web, ecommerce o software a medida. Escribinos a ${site.email} o usá el formulario y te respondemos en 24 h hábiles.`}
>
  <section class="pt-16 md:pt-24 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <h1 class="font-impact text-[clamp(2.25rem,5.5vw,4.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-6">
        Empecemos por <span class="text-[var(--color-dorado)]">una conversación.</span>
      </h1>
      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
        Contanos tres cosas: qué negocio tenés, qué te duele hoy y por qué ahora. Te respondemos en
        24 h hábiles, y si querés arrancamos con una auditoría gratis de 15 minutos.
      </p>
    </div>
  </section>

  <Contacto compact />
</Layout>
