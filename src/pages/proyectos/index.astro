---
import Layout from "../../layouts/Layout.astro";
import demos from "../../data/demos.json";
import { getPublishedProjects } from "../../lib/content";

/* Proyectos demo: construidos para mostrar qué se puede hacer. Nunca se presentan como clientes. */
const orden = demos.map((d) => d.id);
const proyectos = (await getPublishedProjects())
  .sort((a, b) => orden.indexOf(a.id) - orden.indexOf(b.id))
  .map((p) => ({ ...p, nombre: demos.find((d) => d.id === p.id)?.nombre ?? p.data.title }));
const empty = proyectos.length === 0;
---

<Layout
  title="Proyectos demo"
  description="Proyectos de demostración de software a medida para PyMEs: inventario, pedidos, tableros, integraciones y webs. Construidos para mostrar qué se puede hacer."
  noindex={empty}
>
  <section class="pi wrap">
    <h1 class="pi__h1" data-split>Proyectos demo</h1>
    <p class="pi__lead" data-rise style="--i:1">
      {empty
        ? "Estamos preparando los demos. Mientras tanto, contanos qué necesitás y te respondemos en 24 horas hábiles."
        : `${proyectos.length} proyectos construidos para mostrar qué se puede hacer. Los negocios y sus cifras son escenarios de ejemplo, no clientes.`}
    </p>

    {
      empty ? (
        <a href="/contacto" class="btn pi__cta">Contanos el problema</a>
      ) : (
        <ul class="pi__list">
          {proyectos.map((p) => (
            <li class="pi__item" data-rise>
              <a href={`/proyectos/${p.id}`} class="pi__name">{p.nombre}</a>
              <p class="pi__desc">{p.data.descripcion} <span class="soft">Con {p.data.stack.join(", ")}.</span></p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<style>
  .pi { padding-top: clamp(3rem, 8vw, 6rem); }
  .pi__h1 { font-size: clamp(3.5rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; }
  .pi__lead { margin-top: 2rem; font-size: var(--step-lead); line-height: 1.3; max-width: 44ch; }
  .pi__cta { margin-top: 2rem; }

  .pi__list { list-style: none; margin: clamp(4rem, 8vw, 7rem) 0 0; padding: 0; display: grid; gap: 3rem; }
  .pi__item { display: grid; gap: 0.5rem; }
  .pi__name {
    font-family: var(--font-display);
    font-size: var(--step-statement);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color 200ms var(--ease-out-quart);
  }
  .pi__name:hover { color: var(--color-accent); }
  .pi__desc { max-width: 60ch; }

  @media (min-width: 1024px) {
    .pi__item { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: baseline; }
    .pi__name { grid-column: 1 / span 6; }
    .pi__desc { grid-column: 7 / span 6; }
  }
</style>
