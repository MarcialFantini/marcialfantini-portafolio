---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProyectos = await getCollection("proyectos");
const proyectos = allProyectos.sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);
const [hero, ...rest] = proyectos;
---

<Layout
  title="Proyectos — Marcial Fantini"
  description="Casos donde mis decisiones importaron: cada proyecto con problema, solución, resultado y métricas concretas."
>
  <section class="pt-16 md:pt-24 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <h1 class="font-display font-bold tracking-tight mb-6 text-[var(--color-ink)]">
        Casos donde mis decisiones importaron.
      </h1>
      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
        Cada proyecto con problema, solución, resultado y métricas concretas. Sin animar
        capturas: los repos hablan por sí mismos.
      </p>
    </div>
  </section>

  {
    hero && (
      <section class="border-b border-[var(--color-border)]">
        <div class="container-page py-10 md:py-14">
          <a
            href={`/proyectos/${hero.id}`}
            class="tactile group block border-2 border-[var(--color-ink)] rounded-lg bg-[var(--color-ink)] text-[var(--color-blanco-humo)] hover:bg-[var(--color-azul)] hover:text-[var(--color-ink)] p-7 md:p-10 reveal"
          >
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <div>
                <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-azul)] group-hover:text-[var(--color-ink)] mb-3 transition-colors">
                  {hero.data.cliente}
                </p>
                <p class="font-impact text-[clamp(3rem,7vw,6rem)] uppercase text-[var(--color-azul)] group-hover:text-[var(--color-ink)] leading-[0.95] tabular-nums transition-colors">
                  {hero.data.metricas[0]?.value}
                </p>
                <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-blanco-humo)]/70 group-hover:text-[var(--color-ink)]/70 mt-3 leading-tight max-w-[180px] transition-colors">
                  {hero.data.metricas[0]?.label}
                </p>
              </div>
              <div class="lg:col-span-2">
                <h2 class="font-impact text-[clamp(1.5rem,3vw,2.5rem)] uppercase leading-[1] text-[var(--color-blanco-humo)] group-hover:text-[var(--color-ink)] tracking-tight mb-4 transition-colors">
                  {hero.data.title}
                </h2>
                <p class="text-[var(--color-blanco-humo)]/85 group-hover:text-[var(--color-ink)]/85 leading-relaxed transition-colors">
                  {hero.data.descripcion}
                </p>
              </div>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="py-10 md:py-14">
    <div class="container-page">
      <ol class="border-t border-[var(--color-border)] reveal-stagger">
        {
          rest.map((p) => (
            <li class="border-b border-[var(--color-border)]">
              <a
                href={`/proyectos/${p.id}`}
                class="tactile group grid grid-cols-[auto_1fr_auto] md:grid-cols-[3rem_1fr_auto_auto] items-baseline gap-5 md:gap-8 py-6"
              >
                <span class="font-mono text-xs text-[var(--color-mute)] pt-1 tabular-nums">
                  <span class="inline-block w-6 h-px bg-[var(--color-border)] mr-2 align-middle"></span>
                  {p.data.metricas[0]?.value}
                </span>
                <div class="min-w-0">
                  <h3 class="font-display font-semibold text-lg tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-dorado)] leading-tight">
                    {p.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-snug truncate">
                    {p.data.cliente} · {p.data.descripcion}
                  </p>
                </div>
                <span class="font-mono text-xs text-[var(--color-mute)] whitespace-nowrap hidden md:inline">
                  {p.data.fecha.toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric" })}
                </span>
                <span
                  aria-hidden="true"
                  class="hidden md:inline text-[var(--color-mute)] group-hover:text-[var(--color-dorado)] group-hover:translate-x-1 transition-transform"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>
