---
import Layout from "../../layouts/Layout.astro";
import MediaSlot from "../../components/home/MediaSlot.astro";
import demos from "../../data/demos.json";
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const proyectos = await getPublishedProjects();
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}) satisfies GetStaticPaths;

/* Proyecto demo: construido para mostrar qué se puede hacer. El negocio y las cifras son un escenario de ejemplo. */
const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { title, cliente, descripcion, problema, resultado, stack, role, url, metricas } = proyecto.data;

const demo = demos.find((d) => d.id === proyecto.id);
const nombre = demo?.nombre ?? title;

const orden = demos.map((d) => d.id);
const published = await getPublishedProjects();
const otros = published
  .filter((p) => p.id !== proyecto.id)
  .sort((a, b) => orden.indexOf(a.id) - orden.indexOf(b.id))
  .slice(0, 4)
  .map((p) => ({ id: p.id, nombre: demos.find((d) => d.id === p.id)?.nombre ?? p.data.title }));
---

<Layout title={`${nombre} (proyecto demo)`} description={descripcion} pageType="article">
  <article class="pd wrap">
    <header class="pd__head">
      <h1 class="pd__h1">{nombre}</h1>
      <p class="pd__lead" data-rise>{descripcion}</p>
      <p class="pd__demo" data-rise style="--i:1">
        Proyecto demo, construido para mostrar qué se puede hacer. El negocio ({cliente}) y sus cifras son un escenario de ejemplo, no un cliente.
      </p>
    </header>

    <MediaSlot
      kind="captura"
      src={demo?.captura || undefined}
      alt={`Captura de ${nombre}`}
      label={`Captura: ${nombre} (pendiente)`}
      ratio="16 / 9"
      class="pd__shot"
      eager
    />

    <div class="pd__body">
      <aside class="pd__facts" data-rise>
        <dl>
          <div><dt>Rol</dt><dd>{role}</dd></div>
          <div><dt>Con qué</dt><dd>{stack.join(", ")}</dd></div>
          {url && <div><dt>En vivo</dt><dd><a href={url} target="_blank" rel="noopener noreferrer">Ver la demo</a></dd></div>}
        </dl>
      </aside>

      <div class="pd__main">
        <section data-rise>
          <h2 class="pd__h2">El escenario</h2>
          <p class="pd__statement">{problema}</p>
        </section>

        <section data-rise>
          <h2 class="pd__h2">Lo que construí</h2>
          <div class="prose-mf pd__prose"><Content /></div>
        </section>

        <section data-rise>
          <h2 class="pd__h2">Lo que resuelve</h2>
          <p class="pd__statement">{resultado}</p>
        </section>

        {metricas.length > 0 && (
          <section data-rise>
            <h2 class="pd__h2">Datos del escenario</h2>
            <dl class="pd__nums">
              {metricas.map((m) => (
                <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
              ))}
            </dl>
          </section>
        )}

        <div class="pd__cta" data-rise>
          <a href="/contacto" class="btn">Hablemos de uno similar</a>
        </div>
      </div>
    </div>
  </article>

  {otros.length > 0 && (
    <section class="pd-more wrap" aria-labelledby="pd-more-title">
      <h2 id="pd-more-title" class="pd__h2">Otros demos (<a href="/proyectos">ver los {published.length}</a>)</h2>
      <p class="pd-more__list">
        {otros.map((o, i) => (
          <>
            <a href={`/proyectos/${o.id}`}>{o.nombre}</a>
            {i < otros.length - 1 ? ", " : "."}
          </>
        ))}
      </p>
    </section>
  )}
</Layout>

<style>
  .pd__head { padding-top: clamp(2rem, 5vw, 4rem); }
  .pd__h1 { font-size: clamp(2.25rem, 7vw, 7.5rem); line-height: 0.9; letter-spacing: -0.03em; }
  .pd__lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .pd__demo { margin-top: 1.5rem; font-size: var(--step-small); color: var(--color-soft); max-width: 60ch; }

  :global(.pd__shot) { margin-top: clamp(3rem, 6vw, 5rem); }

  .pd__body { display: grid; gap: 3rem; margin-top: clamp(4rem, 8vw, 7rem); }
  .pd__facts dl { display: grid; gap: 1.25rem; font-size: var(--step-small); }
  .pd__facts dt { color: var(--color-soft); }
  .pd__facts dd { margin: 0.15rem 0 0; }
  .pd__main { display: grid; gap: 4.5rem; }
  .pd__h2 { font-size: var(--step-lead); font-family: var(--font-sans); font-weight: 500; letter-spacing: 0; line-height: 1.2; margin-bottom: 1rem; }
  .pd__statement { font-size: var(--step-lead); line-height: 1.35; max-width: 44ch; }
  .pd__prose { max-width: 65ch; }

  .pd__nums { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem var(--gutter); }
  .pd__nums div { display: flex; flex-direction: column-reverse; gap: 0.5rem; }
  .pd__nums dd { font-family: var(--font-serif); font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.02em; margin: 0; }
  .pd__nums dt { font-size: var(--step-small); color: var(--color-soft); }

  .pd-more { margin-top: var(--section-gap); }
  .pd-more__list { font-size: var(--step-statement); line-height: 1.25; max-width: 40ch; }
  .pd-more__list a { text-decoration: none; color: var(--color-soft); transition: color 200ms var(--ease-out-quart); }
  .pd-more__list a:hover { color: var(--color-fg); }

  @media (min-width: 1024px) {
    .pd__body { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .pd__facts { grid-column: 1 / span 3; }
    .pd__main { grid-column: 5 / span 7; }
    .pd__nums { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
