---
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import ProyectoCard from "../../components/ProyectoCard.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}) satisfies GetStaticPaths;

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { title, cliente, descripcion, problema, resultado, stack, fecha, duracion, role, repo, url, tags, categoria, metricas } =
  proyecto.data;

const allProyectos = await getCollection("proyectos");
const sortedAll = allProyectos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const projectIndex = sortedAll.findIndex((p) => p.id === proyecto.id) + 1;
const placeholderIndex = String(projectIndex).padStart(2, "0");
const related = sortedAll
  .filter((p) => p.id !== proyecto.id && p.data.tags.some((t) => tags.includes(t)))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  landing: "Landing",
  ecommerce: "E-commerce",
  panel: "Panel",
  blog: "Blog / Editorial",
  integracion: "Integración",
  dashboard: "Dashboard",
  reservas: "Reservas",
  otro: "Otro",
};

const canonicalURL = new URL(`/proyectos/${proyecto.id}`, Astro.site ?? "https://marcialfantini.com").toString();
const shareText = `${title} — caso de ${cliente}`;
---

<Layout
  title={`${title} — Proyecto de ${cliente}`}
  description={descripcion}
  pageType="article"
>
  <div class="scroll-progress-bar" aria-hidden="true"></div>

  <article>
    <header class="pt-12 md:pt-20 pb-10 md:pb-14 border-b border-[var(--color-border)]">
      <div class="container-page max-w-4xl reveal">
        <nav class="mb-8 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-[var(--color-azul)]">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/proyectos" class="hover:text-[var(--color-azul)]">Proyectos</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[var(--color-ink)] truncate max-w-[60vw]">{title}</li>
          </ol>
        </nav>

        <div class="placeholder-image placeholder-image--azul h-56 md:h-72 rounded-lg mb-8 shadow-md relative overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="font-impact text-[clamp(8rem,20vw,16rem)] text-white/15 select-none tabular-nums leading-none">
              {placeholderIndex}
            </span>
          </div>
        </div>

        <div class="flex items-center flex-wrap gap-3 mb-5 text-xs font-mono text-[var(--color-mute)]">
          <span class="px-2.5 py-1 rounded-md bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)] font-semibold uppercase tracking-[0.18em]">
            {categoryLabels[categoria] ?? categoria}
          </span>
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <span class="font-semibold text-[var(--color-ink-soft)]">{cliente}</span>
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <FormattedDate date={fecha} format="long" />
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <span>{duracion}</span>
        </div>

        <h1 class="font-impact text-[clamp(2rem,5vw,3.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-6">
          {title}
        </h1>
        <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
          {descripcion}
        </p>

        {tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {
              tags.map((t) => (
                <a
                  href={`/proyectos?tag=${t}`}
                  class="font-mono text-xs px-2.5 py-1 rounded-md border border-[var(--color-border)] text-[var(--color-ink-soft)] hover:border-[var(--color-azul)] hover:text-[var(--color-azul)] tactile"
                >
                  #{t}
                </a>
              ))
            }
          </div>
        )}
      </div>
    </header>

    {metricas.length > 0 && (
      <section class="py-10 md:py-12 bg-[var(--color-azul)] text-white">
        <div class="container-page reveal">
          <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-dorado)] mb-6">
            Resultados medibles
          </p>
          <dl class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {metricas.map((m) => (
              <div class="border-l-2 border-[var(--color-dorado)] pl-4">
                <dd class="font-impact text-3xl md:text-4xl text-white uppercase tabular-nums tracking-tight leading-none">
                  {m.value}
                </dd>
                <dt class="font-mono text-[10px] uppercase tracking-widest text-white/70 mt-2 leading-tight block">
                  {m.label}
                </dt>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <div class="container-page py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
        <aside class="lg:col-span-1 space-y-7 text-sm reveal">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Cliente
            </p>
            <p class="text-[var(--color-ink)]">{cliente}</p>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Rol
            </p>
            <p class="text-[var(--color-ink)]">{role}</p>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Duración
            </p>
            <p class="text-[var(--color-ink)]">{duracion}</p>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Categoría
            </p>
            <p class="text-[var(--color-ink)]">{categoryLabels[categoria] ?? categoria}</p>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Stack
            </p>
            <ul class="flex flex-wrap gap-1.5">
              {stack.map((s) => (
                <li class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--color-azul-soft)] border border-[var(--color-border)] text-[var(--color-ink-soft)]">
                  {s}
                </li>
              ))}
            </ul>
          </div>
          {(url || repo) && (
            <div class="pt-2 border-t border-[var(--color-border)]">
              <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)] mb-3">
                Links
              </p>
              <div class="flex flex-col gap-2">
                {url && (
                  <a
                    href={url}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="tactile text-[var(--color-azul)] hover:text-[var(--color-dorado-deep)] inline-flex items-center gap-1 font-semibold"
                  >
                    Ver sitio en vivo <span aria-hidden="true">↗</span>
                  </a>
                )}
                {repo && (
                  <a
                    href={repo}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="tactile text-[var(--color-azul)] hover:text-[var(--color-dorado-deep)] inline-flex items-center gap-1 font-semibold"
                  >
                    Repositorio en GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </aside>

        <div class="lg:col-span-2 space-y-12 reveal">
          <section>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-azul)] mb-3">
              01 · El problema
            </p>
            <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-[var(--color-ink)] mb-4">
              {problema}
            </h2>
          </section>

          <section>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-azul)] mb-3">
              02 · Lo que entregué
            </p>
            <div class="prose-editorial" data-post-body>
              <Content />
            </div>
          </section>

          <section>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-azul)] mb-3">
              03 · El resultado
            </p>
            <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-[var(--color-ink)] mb-4">
              {resultado}
            </h2>
          </section>

          <div class="pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-start sm:items-center gap-4 justify-between">
            <div class="flex flex-col sm:flex-row gap-2">
              <button
                type="button"
                data-share="copy"
                data-share-url={canonicalURL}
                class="tactile inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-md bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:bg-[var(--color-azul)] hover:text-white"
              >
                <span aria-hidden="true">⎘</span>
                <span data-share-label>Copiar link</span>
              </button>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="tactile inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-md border border-[var(--color-border)] text-[var(--color-ink-soft)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-azul)] hover:text-[var(--color-azul)]"
              >
                Twitter <span aria-hidden="true">↗</span>
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="tactile inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-md border border-[var(--color-border)] text-[var(--color-ink-soft)] font-mono text-[10px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-azul)] hover:text-[var(--color-azul)]"
              >
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            </div>
            <a
              href="/contacto"
              class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-[var(--color-ink)] text-white font-semibold hover:bg-[var(--color-azul)] border-2 border-[var(--color-ink)]"
            >
              Hablemos de uno similar
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="py-16 md:py-24 border-t border-[var(--color-border)] bg-[var(--color-blanco)]">
      <div class="container-page">
        <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-10 reveal">
          Proyectos similares.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal-stagger">
          {related.map((p) => <ProyectoCard proyecto={p} />)}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  (function () {
    // Scroll progress bar
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bar = document.querySelector('.scroll-progress-bar') as HTMLElement | null;
    if (bar && !reduce) {
      const update = () => {
        const article = document.querySelector('article') as HTMLElement | null;
        if (!article) return;
        const rect = article.getBoundingClientRect();
        const winH = window.innerHeight;
        const total = rect.height - winH;
        const scrolled = -rect.top;
        const pct = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : 0;
        bar.style.setProperty('--scroll-progress', `${Math.round(pct * 100)}%`);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      document.addEventListener('astro:page-load', update);
    }

    // Share buttons
    document.querySelectorAll('[data-share]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.getAttribute('data-share');
        const url = btn.getAttribute('data-share-url') ?? window.location.href;
        if (action === 'copy') {
          const label = btn.querySelector('[data-share-label]');
          try {
            await navigator.clipboard.writeText(url);
            if (label) label.textContent = '¡Copiado!';
            setTimeout(() => { if (label) label.textContent = 'Copiar link'; }, 2200);
          } catch {
            if (label) label.textContent = 'No se pudo copiar';
            setTimeout(() => { if (label) label.textContent = 'Copiar link'; }, 2200);
          }
        }
      });
    });
  })();
</script>