---
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import ProyectoCard from "../../components/ProyectoCard.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}) satisfies GetStaticPaths;

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { title, cliente, descripcion, problema, resultado, stack, fecha, duracion, role, repo, url, tags, metricas } =
  proyecto.data;

const allProyectos = await getCollection("proyectos");
const related = allProyectos
  .filter((p) => p.id !== proyecto.id && p.data.tags.some((t) => tags.includes(t)))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);
---

<Layout
  title={`${title} — Proyecto de ${cliente}`}
  description={descripcion}
  pageType="article"
>
  <article>
    <header class="pt-12 md:pt-20 pb-10 md:pb-14 border-b border-[var(--color-border)]">
      <div class="container-page max-w-4xl">
        <a
          href="/proyectos"
          class="inline-flex items-center gap-1.5 text-sm text-[var(--color-mute)] hover:text-[var(--color-azul)] mb-8 font-mono"
        >
          <span aria-hidden="true">←</span> Volver a proyectos
        </a>

        <div class="flex items-center gap-3 mb-5 text-xs font-mono text-[var(--color-mute)]">
          <span class="text-[var(--color-azul)]">{cliente}</span>
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <FormattedDate date={fecha} format="long" />
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <span>{duracion}</span>
        </div>

        <h1 class="font-display font-bold text-[var(--color-ink)] tracking-tight mb-6">
          {title}
        </h1>
        <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
          {descripcion}
        </p>

        <div class="mt-8 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="font-mono text-xs px-2.5 py-1 rounded border border-[var(--color-border)] text-[var(--color-ink-soft)]">
              {t}
            </span>
          ))}
        </div>
      </div>
    </header>

    {metricas.length > 0 && (
      <section class="py-10 md:py-12 bg-[var(--color-ink)] text-[var(--color-blanco-humo)]">
        <div class="container-page">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-blanco-humo)]/50 mb-6">
            Resultados medibles
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {metricas.map((m) => (
              <div class="border-l border-[var(--color-dorado)] pl-4">
                <p class="font-display font-bold text-3xl md:text-4xl text-[var(--color-blanco)] tracking-tight">
                  {m.value}
                </p>
                <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-blanco-humo)]/60 mt-2 leading-tight">
                  {m.label}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <div class="container-page py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
        <aside class="lg:col-span-1 space-y-7 text-sm">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Cliente
            </p>
            <p class="text-[var(--color-ink)]">{cliente}</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Rol
            </p>
            <p class="text-[var(--color-ink)]">{role}</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Duración
            </p>
            <p class="text-[var(--color-ink)]">{duracion}</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-2">
              Stack
            </p>
            <ul class="flex flex-wrap gap-1.5">
              {stack.map((s) => (
                <li class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--color-blanco-humo)] border border-[var(--color-border)] text-[var(--color-ink-soft)]">
                  {s}
                </li>
              ))}
            </ul>
          </div>
          {(url || repo) && (
            <div class="pt-2 border-t border-[var(--color-border)]">
              <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-mute)] mb-3">
                Links
              </p>
              <div class="flex flex-col gap-2">
                {url && (
                  <a
                    href={url}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="text-[var(--color-azul)] hover:text-[var(--color-dorado)] inline-flex items-center gap-1"
                  >
                    Ver sitio en vivo <span aria-hidden="true">↗</span>
                  </a>
                )}
                {repo && (
                  <a
                    href={repo}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="text-[var(--color-azul)] hover:text-[var(--color-dorado)] inline-flex items-center gap-1"
                  >
                    Repositorio en GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </aside>

        <div class="lg:col-span-2 space-y-12">
          <section>
            <h2 class="font-display font-bold text-2xl tracking-tight text-[var(--color-ink)] mb-4 flex items-center gap-3">
              <span class="font-mono text-sm text-[var(--color-dorado)]">01</span>
              El problema
            </h2>
            <p class="text-[var(--color-ink-soft)] text-lg leading-relaxed">
              {problema}
            </p>
          </section>

          <section>
            <h2 class="font-display font-bold text-2xl tracking-tight text-[var(--color-ink)] mb-6 flex items-center gap-3">
              <span class="font-mono text-sm text-[var(--color-dorado)]">02</span>
              Lo que entregué
            </h2>
            <div class="prose-editorial">
              <Content />
            </div>
          </section>

          <section>
            <h2 class="font-display font-bold text-2xl tracking-tight text-[var(--color-ink)] mb-4 flex items-center gap-3">
              <span class="font-mono text-sm text-[var(--color-dorado)]">03</span>
              El resultado
            </h2>
            <p class="text-[var(--color-ink-soft)] text-lg leading-relaxed">
              {resultado}
            </p>
          </section>

          <div class="pt-2 border-t border-[var(--color-border)]">
            <a
              href="/contacto"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-[var(--color-ink)] text-[var(--color-blanco-humo)] font-medium hover:bg-[var(--color-azul)] transition-colors"
            >
              Hablemos de un proyecto similar
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="py-16 md:py-24 border-t border-[var(--color-border)] bg-[var(--color-blanco)]">
      <div class="container-page">
        <h2 class="font-display font-bold text-[var(--color-ink)] tracking-tight mb-10">
          Proyectos similares
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {related.map((p) => <ProyectoCard proyecto={p} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
