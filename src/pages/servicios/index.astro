---
import Layout from "../../layouts/Layout.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";

const faqsGenerales = [
  {
    pregunta: "¿Cuánto cuesta una página web o una tienda online?",
    respuesta:
      "Los precios de cada tarjeta son orientativos y marcan desde dónde arrancamos: página web de productos o servicios desde USD 300, página empresarial desde USD 400 y ecommerce desde USD 800. Son valores en USD y no incluyen hosting ni dominio. El valor final depende de lo que necesites y te lo pasamos por escrito antes de empezar.",
  },
  {
    pregunta: "¿Cuánto cuesta el software a medida?",
    respuesta:
      "Depende de cada proyecto, por eso no tiene un precio fijo. Empezamos con una conversación para entender qué necesitás y después te pasamos una propuesta con alcance, etapas y presupuesto.",
  },
  {
    pregunta: "¿Cuánto tarda?",
    respuesta:
      "Cada tarjeta muestra un plazo orientativo. El tiempo real depende del alcance y de qué tan rápido nos pases textos, fotos y definiciones. Te confirmamos fechas en la propuesta.",
  },
  {
    pregunta: "¿Y si no estoy seguro de qué necesito?",
    respuesta:
      "Escribinos igual. Con una charla corta te orientamos hacia la opción que mejor te sirve, aunque no sea la más cara. Podés empezar por la auditoría gratis de 15 minutos.",
  },
];
---

<Layout
  title={`Servicios — ${site.name}`}
  description="Página web de productos o servicios desde USD 300, página empresarial desde USD 400, ecommerce desde USD 800 y software a medida. Contanos qué necesitás."
>
  <div class="panel--oro">
  <section class="pt-16 md:pt-24 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        Servicios
      </p>
      <h1 class="font-impact text-[clamp(2.25rem,5.5vw,4.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-6">
        Página web, ecommerce <span class="text-[var(--color-azul)]">y software a medida.</span>
      </h1>
      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
        Te ayudamos a tener tu página web, tu tienda online o el software que tu negocio
        necesita. Precios orientativos y claros desde el principio; para software a medida,
        empezamos con una conversación.
      </p>
      <p class="mt-4 text-sm text-[var(--color-mute)] max-w-3xl">
        Precios orientativos en USD. No incluyen hosting ni dominio. El valor en pesos se confirma en la propuesta.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-[var(--color-border)]">
    <div class="container-page">
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
        {
          servicios.map((s, i) => (
            <li
              id={s.id}
              class="group relative rounded-card bg-[var(--color-blanco)] border border-[var(--color-line)] tactile transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-azul)] overflow-hidden"
            >
              <div class="h-1 bg-[var(--color-dorado)]" aria-hidden="true"></div>
              {s.badge && (
                <div class="absolute top-4 right-4 z-10">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-control bg-[var(--color-deep)] text-white font-mono text-[9px] uppercase tracking-[0.22em] font-bold">
                    {s.badge}
                  </span>
                </div>
              )}

              <div class="p-7 md:p-9">
                <div class="flex items-start justify-between gap-3 mb-4">
                  <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-mute)] tabular-nums">
                    0{i + 1}
                  </span>
                  <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                    {s.duracion}
                  </span>
                </div>

                <h2 class="font-impact text-[clamp(1.5rem,2.5vw,2.25rem)] uppercase leading-[0.98] text-[var(--color-ink)] tracking-tight mb-2">
                  {s.titulo}
                </h2>
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] font-semibold mb-5">
                  {s.subtitulo}
                </p>

                <p class="text-base text-[var(--color-ink-soft)] leading-relaxed mb-6">
                  {s.descripcion}
                </p>

                <div class="mb-6 p-4 rounded-control bg-[var(--color-azul-soft)] border-l-4 border-[var(--color-azul)]">
                  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-azul)] mb-1.5 font-semibold">
                    Lo que conseguís
                  </p>
                  <p class="text-sm text-[var(--color-ink)] font-medium leading-snug">
                    {s.resultadoCuantificado}
                  </p>
                </div>

                <ul class="space-y-2 mb-6">
                  {s.queIncluye.slice(0, 4).map((item) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--color-ink-soft)] leading-relaxed">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-[var(--color-azul)]" fill="none" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                  {s.queIncluye.length > 4 && (
                    <li class="text-xs text-[var(--color-mute)] pl-6">
                      +{s.queIncluye.length - 4} ítems más — ver detalle
                    </li>
                  )}
                </ul>

                <div class="flex items-end justify-between gap-3 pt-5 border-t border-[var(--color-border)]">
                  <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-1">Precio orientativo</p>
                    <p class="font-mono text-base md:text-lg text-[var(--color-oro-price)] font-bold tabular-nums">
                      {s.precioOrientativo}
                    </p>
                  </div>
                  <a
                    href={`/servicios/${s.id}`}
                    class="tactile font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-white bg-[var(--color-deep)] px-4 py-2.5 rounded-control group-hover:bg-[var(--color-action)] transition-colors"
                  >
                    {s.precioDesdeUsd == null ? s.cta : "Ver detalle"} →
                  </a>
                </div>

                <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                  Ideal para: {s.idealPara}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  </div>

  <section class="py-16 md:py-20 border-b border-[var(--color-border)]">
    <div class="container-page max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        FAQ
      </p>
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-10">
        Lo que nos preguntan{" "}<span class="text-[var(--color-azul)]">antes de firmar.</span>
      </h2>
      <div class="space-y-3">
        {
          faqsGenerales.map((faq) => (
            <details class="group rounded-control bg-[var(--color-blanco)] border border-[var(--color-line)] tactile">
              <summary class="flex items-start justify-between gap-4 p-5 cursor-pointer list-none">
                <h3 class="font-display font-semibold text-base md:text-lg text-[var(--color-ink)] leading-snug flex-1">
                  {faq.pregunta}
                </h3>
                <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--color-line)] text-[var(--color-ink)] group-open:bg-[var(--color-action)] group-open:border-[var(--color-action)] group-open:text-white transition-all" aria-hidden="true">
                  <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 16 16">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                  {faq.respuesta}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-[var(--color-deep)] text-white border-t border-[var(--color-ink)]">
    <div class="container-page text-center max-w-2xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        Próximo paso
      </p>
      <h2 class="font-impact text-[clamp(2rem,5vw,3.5rem)] uppercase leading-[0.95] text-white mb-5">
        ¿Te encaja alguno? <span class="text-[var(--color-dorado)]">Hablemos.</span>
      </h2>
      <p class="text-lg text-white/80 leading-relaxed mb-8">
        Contanos qué necesitás y te orientamos. Podés empezar por una auditoría gratis de 15 minutos o escribirnos directamente: si tu caso no entra en estos servicios, te lo decimos y te orientamos hacia otra opción.
      </p>
      <a
        href="/contacto?servicio=Quiero%20hablar%20de%20mi%20proyecto"
        class="tactile inline-flex items-center justify-center gap-2 px-7 py-4 rounded-control bg-[var(--color-dorado)] text-[var(--color-on-gold)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-[var(--color-ivory)]"
      >
        Contanos qué necesitás
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>