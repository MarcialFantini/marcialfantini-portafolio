---
import Layout from "../../layouts/Layout.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";

const faqsGenerales = [
  {
    pregunta: "¿Cuánto cuesta una página web o una tienda online?",
    respuesta:
      "Los precios de cada servicio son orientativos y marcan desde dónde arrancamos: página web de productos o servicios desde USD 300, página empresarial desde USD 400 y ecommerce desde USD 800. Son valores en USD y no incluyen hosting ni dominio. El valor final depende de lo que necesites y te lo pasamos por escrito antes de empezar.",
  },
  {
    pregunta: "¿Cuánto cuesta el software a medida?",
    respuesta:
      "Depende de cada proyecto, por eso no tiene un precio fijo. Empezamos con una conversación para entender qué necesitás y después te pasamos una propuesta con alcance, etapas y presupuesto.",
  },
  {
    pregunta: "¿Cuánto tarda?",
    respuesta:
      "Cada servicio muestra un plazo orientativo. El tiempo real depende del alcance y de qué tan rápido nos pases textos, fotos y definiciones. Te confirmamos fechas en la propuesta.",
  },
  {
    pregunta: "¿Y si no estoy seguro de qué necesito?",
    respuesta:
      "Escribinos igual. Con una charla corta te orientamos hacia la opción que mejor te sirve, aunque no sea la más cara. Podés empezar por la auditoría gratis de 15 minutos.",
  },
];

const incluyeTodos = [
  "Un presupuesto claro, por escrito, antes de arrancar.",
  "Una persona real del equipo que te responde en 24 horas hábiles.",
  "2 rondas de revisión incluidas.",
  "Una auditoría de 15 minutos, sin costo.",
];

const noIncluye = [
  "Hosting ni dominio: los precios orientativos no los incluyen.",
  "Promesas de resultados que dependen de cosas que no controlamos.",
  "Empezar sin propuesta: no arrancamos sin que sepas qué hacemos y cuánto cuesta.",
];

const steps = [
  { t: "Hablamos 15 minutos", d: "Nos contás qué vendés y qué necesitás. Sin costo y sin compromiso." },
  { t: "Propuesta con precio claro", d: "Alcance y presupuesto por escrito antes de empezar." },
  { t: "Armamos y te mostramos avances", d: "Vas viendo cómo queda mientras se arma, no solo al final." },
  { t: "Entrega con 2 rondas de revisión", d: "Ajustamos lo que haga falta. Cada servicio muestra su duración orientativa." },
];
---

<Layout
  title={`Servicios — ${site.name}`}
  description="Página web de productos o servicios desde USD 300, página empresarial desde USD 400, ecommerce desde USD 800 y software a medida. Contanos qué necesitás."
>
  <div class="panel--oro">
    <section class="pt-16 md:pt-24 pb-14 md:pb-20 border-b border-[var(--color-border)]">
      <div class="container-page">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-9 reveal">
            <p class="eyebrow mb-5">Servicios y precios</p>
            <h1 class="display-xl">
              Página web, ecommerce <span class="display-accent">y software a medida.</span>
            </h1>
          </div>
          <div class="lg:col-span-3 reveal">
            <p class="text-base md:text-lg text-[var(--color-ink-soft)] leading-relaxed">
              Te ayudamos a tener tu página web, tu tienda online o el software que tu negocio
              necesita. Precios orientativos y claros desde el principio; para software a medida,
              empezamos con una conversación.
            </p>
            <p class="mt-4 text-sm text-[var(--color-mute)]">
              Precios orientativos en USD. No incluyen hosting ni dominio. El valor en pesos se confirma en la propuesta.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-20">
      <div class="container-page">
        <ol class="ptab reveal-stagger">
          {
            servicios.map((s, i) => {
              const isQuote = s.precioDesdeUsd == null;
              const isLead = s.id === "ecommerce";
              return (
                <li
                  id={s.id}
                  class:list={["ptab__row", isLead && "ptab__row--lead", isQuote && "ptab__row--quote surface-night"]}
                >
                  <span class="font-mono text-xs tracking-[0.18em] text-[var(--color-mute)] tabular-nums pt-2">
                    {String(i + 1).padStart(2, "0")}
                  </span>

                  <div>
                    {s.badge && (
                      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-3">
                        {s.badge}
                      </p>
                    )}
                    <h2 class="m-0">
                      <a href={`/servicios/${s.id}`} class="ptab__name">{s.titulo}</a>
                    </h2>
                    <p class="mt-4 text-[var(--color-ink)] font-medium leading-snug">{s.subtitulo}</p>
                    <p class="mt-3 text-[var(--color-ink-soft)] leading-relaxed max-w-[54ch]">{s.descripcion}</p>
                  </div>

                  <div class="flex flex-col gap-5">
                    <div>
                      <p class="svc__label">Para quién</p>
                      <p class="svc__text text-sm">{s.idealPara}</p>
                    </div>
                    <div>
                      <p class="svc__label">Duración orientativa</p>
                      <p class="svc__dur font-mono">{s.duracion}</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                      <a href={`/contacto?servicio=${encodeURIComponent(s.titulo)}`} class="btn-sunset">
                        {isQuote ? s.cta : "Quiero este servicio"} <span aria-hidden="true">→</span>
                      </a>
                      <a href={`/servicios/${s.id}`} class="svc__more">
                        Ver el detalle <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>

                  <p class="price price--end">
                    <span class="sr-only">{s.precioOrientativo}</span>
                    <span class="price__from" aria-hidden="true">{isQuote ? "según tu proyecto" : "desde"}</span>
                    <strong class="price__amount" aria-hidden="true">
                      {isQuote ? "A cotizar" : <><span class="price__cur">USD</span>{s.precioDesdeUsd}</>}
                    </strong>
                  </p>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>
  </div>

  <section class="py-16 md:py-28 border-b border-[var(--color-border)]">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-x-10">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-5">Para quién</p>
          <h2 class="display-md">
            Para PyMEs, comercios y profesionales que quieren <span class="display-accent">verse bien y vender online.</span>
          </h2>
        </div>
        <div class="lg:col-span-3 lg:col-start-7">
          <p class="svc__label">Qué incluye, siempre</p>
          <ul class="hair-list">
            {incluyeTodos.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="lg:col-span-3">
          <p class="svc__label">Qué no incluye</p>
          <ul class="hair-list">
            {noIncluye.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-28 border-b border-[var(--color-border)]">
    <div class="container-page">
      <p class="eyebrow mb-4">Cómo trabajamos</p>
      <h2 class="display-lg max-w-[18ch] mb-10 md:mb-14">Cuatro pasos, de la primera charla a la entrega.</h2>
      <ol class="process">
        {
          steps.map((st, i) => (
            <li class="process__step">
              <span class="process__num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="process__t">{st.t}</h3>
              <p class="process__d">{st.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-4">FAQ</p>
          <h2 class="display-md">Lo que nos preguntan <span class="display-accent">antes de firmar.</span></h2>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          {
            faqsGenerales.map((faq) => (
              <details class="qa">
                <summary>
                  <h3 class="font-display font-semibold text-base md:text-xl text-[var(--color-ink)] leading-snug flex-1">
                    {faq.pregunta}
                  </h3>
                </summary>
                <div class="qa__body">
                  <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">{faq.respuesta}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="surface-night py-16 md:py-24">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8 reveal">
        <p class="eyebrow mb-4">Próximo paso</p>
        <h2 class="display-lg">¿Te encaja alguno? <span class="display-accent">Hablemos.</span></h2>
        <p class="mt-6 text-lg text-[var(--color-ink-soft)] leading-relaxed max-w-[56ch]">
          Contanos qué necesitás y te orientamos. Podés empezar por una auditoría gratis de 15 minutos o escribirnos directamente: si tu caso no entra en estos servicios, te lo decimos y te orientamos hacia otra opción.
        </p>
      </div>
      <div class="lg:col-span-4 lg:justify-self-end">
        <a href="/contacto?servicio=Quiero%20hablar%20de%20mi%20proyecto" class="btn-sunset">
          Contanos qué necesitás <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
