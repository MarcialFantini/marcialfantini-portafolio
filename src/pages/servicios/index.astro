---
import Layout from "../../layouts/Layout.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";

const categorias = [
  { id: "todos", label: "Todos" },
  { id: "landing", label: "Landing" },
  { id: "ecommerce", label: "E-commerce" },
  { id: "performance", label: "Performance" },
  { id: "integracion", label: "Integración" },
];

const faqsGenerales = [
  {
    pregunta: "¿Cuánto cuesta un proyecto?",
    respuesta:
      "Cada servicio tiene un rango en la tarjeta. El precio final depende del alcance detallado que armamos en la auditoría. Si el proyecto es más chico que el piso del servicio, te recomiendo un freelance con tickets más bajos — no me hago cargo.",
  },
  {
    pregunta: "¿Cuánto tarda?",
    respuesta:
      "De 2 a 8 semanas según alcance. Cada tarjeta muestra el plazo estimado. Si te urge, hay un recargo del 20% por sprint express.",
  },
  {
    pregunta: "¿Cómo se cobra?",
    respuesta:
      "40-50% de anticipo al firmar, saldo al entregar. Para proyectos largos hay hitos intermedios. No acepto pagar después del anticipo.",
  },
  {
    pregunta: "¿Y si no me gusta el resultado?",
    respuesta:
      "Iteramos 2 rondas de revisión por etapa. Si después no estamos alineados, te quedás con todo el trabajo entregado hasta el momento y resolvemos por escrito. Sin cláusula de satisfacción 100% garantizada porque ningún proyecto real la cumple.",
  },
];
---

<Layout
  title={`Servicios — ${site.name}`}
  description="4 servicios con precio cerrado, KPI pactado y garantía por escrito. Sistemas de ventas online, e-commerce, rescate de conversión y automatizaciones."
>
  <section class="pt-16 md:pt-24 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        Servicios
      </p>
      <h1 class="font-impact text-[clamp(2.25rem,5.5vw,4.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-6">
        4 servicios con precio cerrado <span class="text-[var(--color-azul)]">y KPI pactado.</span>
      </h1>
      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
        Nada de retainer obligatorio, nada de "podemos charlar". Cada servicio tiene un
        rango de precio y un entregable concreto. Si tu caso entra en uno, te conviene.
        Si no, te recomiendo otro freelance.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-[var(--color-border)]">
    <div class="container-page">
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
        {
          servicios.map((s, i) => (
            <li
              id={s.id}
              class="group relative rounded-lg bg-[var(--color-blanco)] border-2 border-[var(--color-ink)] tactile transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-azul)] overflow-hidden"
            >
              <div class="h-1 bg-[var(--color-dorado)]" aria-hidden="true"></div>
              {s.badge && (
                <div class="absolute top-4 right-4 z-10">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-[var(--color-ink)] text-white font-mono text-[9px] uppercase tracking-[0.22em] font-bold">
                    {s.badge}
                  </span>
                </div>
              )}

              <div class="p-7 md:p-9">
                <div class="flex items-start justify-between gap-3 mb-4">
                  <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-mute)] tabular-nums">
                    0{i + 1}
                  </span>
                  <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                    {s.duracion}
                  </span>
                </div>

                <h2 class="font-impact text-[clamp(1.5rem,2.5vw,2.25rem)] uppercase leading-[0.98] text-[var(--color-ink)] tracking-tight mb-2">
                  {s.titulo}
                </h2>
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] font-semibold mb-5">
                  {s.subtitulo}
                </p>

                <p class="text-base text-[var(--color-ink-soft)] leading-relaxed mb-6">
                  {s.descripcion}
                </p>

                <div class="mb-6 p-4 rounded-md bg-[var(--color-azul-soft)] border-l-4 border-[var(--color-azul)]">
                  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-azul)] mb-1.5 font-semibold">
                    Resultado cuantificado
                  </p>
                  <p class="text-sm text-[var(--color-ink)] font-medium leading-snug">
                    {s.resultadoCuantificado}
                  </p>
                </div>

                <ul class="space-y-2 mb-6">
                  {s.queIncluye.slice(0, 4).map((item) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--color-ink-soft)] leading-relaxed">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-[var(--color-azul)]" fill="none" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                  {s.queIncluye.length > 4 && (
                    <li class="text-xs text-[var(--color-mute)] pl-6">
                      +{s.queIncluye.length - 4} ítems más — ver detalle
                    </li>
                  )}
                </ul>

                <div class="flex items-end justify-between gap-3 pt-5 border-t border-[var(--color-border)]">
                  <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-1">Desde</p>
                    <p class="font-mono text-base md:text-lg text-[var(--color-ink)] font-bold tabular-nums">
                      {s.precioOrientativo}
                    </p>
                  </div>
                  <a
                    href={`/servicios/${s.id}`}
                    class="tactile font-mono text-[11px] uppercase tracking-[0.18em] font-semibold text-white bg-[var(--color-ink)] px-4 py-2.5 rounded-md group-hover:bg-[var(--color-azul)] transition-colors"
                  >
                    Ver detalle →
                  </a>
                </div>

                <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                  Ideal para: {s.idealPara}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-20 border-b border-[var(--color-border)]">
    <div class="container-page max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        FAQ
      </p>
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-10">
        Lo que me preguntan <span class="text-[var(--color-azul)]">antes de firmar.</span>
      </h2>
      <div class="space-y-3">
        {
          faqsGenerales.map((faq) => (
            <details class="group rounded-md bg-white border-2 border-[var(--color-ink)] tactile">
              <summary class="flex items-start justify-between gap-4 p-5 cursor-pointer list-none">
                <h3 class="font-display font-semibold text-base md:text-lg text-[var(--color-ink)] leading-snug flex-1">
                  {faq.pregunta}
                </h3>
                <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border-2 border-[var(--color-ink)] text-[var(--color-ink)] group-open:bg-[var(--color-azul)] group-open:border-[var(--color-azul)] group-open:text-white transition-all" aria-hidden="true">
                  <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 16 16">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                  {faq.respuesta}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-[var(--color-ink)] text-white border-t border-[var(--color-ink)]">
    <div class="container-page text-center max-w-2xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        Próximo paso
      </p>
      <h2 class="font-impact text-[clamp(2rem,5vw,3.5rem)] uppercase leading-[0.95] text-white mb-5">
        ¿Te encaja alguno? <span class="text-[var(--color-dorado)]">Hablemos.</span>
      </h2>
      <p class="text-lg text-white/80 leading-relaxed mb-8">
        Auditoría gratis de 30 minutos para ver si tu caso entra en uno de estos servicios. Si no entra, te recomiendo otro freelance.
      </p>
      <a
        href="/contacto?servicio=Auditor%C3%ADa%20gratis"
        class="tactile inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white"
      >
        Reservá tu auditoría
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>