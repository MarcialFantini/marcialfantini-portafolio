---
import Layout from "../../layouts/Layout.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";

const sistema = servicios.find((s) => s.grupo === "sistema")!;
const canales = servicios.filter((s) => s.grupo === "canal");

type Cifra = { v: number; suf?: string };
const cifra = (c: Cifra) => `${c.v.toLocaleString("es-AR")}${c.suf ?? ""}`;
const ejemplo = (g: { label: string; antes: Cifra; ahora: Cifra }) =>
  `Ejemplo: de ${cifra(g.antes)} a ${cifra(g.ahora)}. ${g.label}.`;

const faqsGenerales = [
  {
    q: "¿Cuánto cuesta?",
    a: "Cada proyecto se cotiza aparte, porque depende del problema y del alcance. Después del diagnóstico gratis de 30 minutos te pasamos una propuesta cerrada por escrito: alcance, etapas, plazos y precio. Si algo cambia en el camino, se cotiza antes de hacerlo.",
  },
  {
    q: "¿Puedo empezar por la web y sumar el sistema después?",
    a: "Sí. La página o la tienda se construyen pensando en conectarse después con pedidos, stock o facturación, así no hay que rehacer nada cuando des el siguiente paso.",
  },
  {
    q: "¿Cuánto tarda?",
    a: "Las webs tienen un plazo orientativo en cada servicio. El software a medida se entrega por etapas: cada parte entra en uso antes de empezar la siguiente. Te confirmamos fechas en la propuesta.",
  },
  {
    q: "¿Y si no estoy seguro de qué necesito?",
    a: "Escribinos igual. En el diagnóstico gratis de 30 minutos vemos dónde se traba tu operación y te orientamos hacia la opción que mejor te sirve, aunque sea la más chica.",
  },
];

const incluyeTodos = [
  "Diagnóstico gratis de 30 minutos",
  "Propuesta cerrada por escrito antes de arrancar",
  "Una persona real que te responde en 24 horas hábiles",
  "Entregas que podés ver y probar mientras se arma",
];

const noIncluye = [
  "Hosting ni dominio: se contratan aparte y te ayudamos a elegirlos",
  "Promesas de resultados que dependen de cosas que no controlamos",
  "Empezar sin propuesta escrita",
];

const contactoHref = (titulo: string) => `/contacto?servicio=${encodeURIComponent(titulo)}`;
---

<Layout
  title={`Servicios — ${site.name}`}
  description="Software a medida para PyMEs (inventario, procesos, automatizaciones, KPIs e informes) y canales digitales conectados: página web, sitio institucional y tienda online. Propuesta cerrada después de un diagnóstico gratis."
>
  <section class="sv-hero wrap" aria-labelledby="svc-title">
    <h1 id="svc-title" class="sv-hero__h1" data-split>Un sistema para tu operación.</h1>
    <div class="sv-hero__row">
      <p class="sv-hero__lead" data-rise style="--i:1">
        Software a medida para ordenar tu PyME, y los canales digitales que lo alimentan: página, sitio institucional o tienda online.
      </p>
      <a href={contactoHref("Diagnóstico gratis")} class="btn" data-rise style="--i:2">Contanos el problema</a>
    </div>
  </section>

  <section id={sistema.id} class="sv-core" aria-labelledby="sistema-title">
    <div class="sv-core__in wrap">
      <h2 id="sistema-title" class="sv-core__h" data-split>{sistema.titulo}</h2>
      <div class="sv-core__body">
        <p class="sv-core__lead" data-rise>{sistema.descripcion}</p>
        <p data-rise style="--i:1"><strong>Para quién.</strong> {sistema.idealPara}</p>
        <p class="sv-core__ej" data-rise style="--i:2">{ejemplo(sistema.grafico)}</p>
        <div class="sv-core__inc" data-rise style="--i:2">
          <p><strong>Qué incluye</strong></p>
          <ul>{sistema.queIncluye.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="sv-core__actions" data-rise style="--i:3">
          <a href={contactoHref(sistema.titulo)} class="btn sv-core__btn">{sistema.cta}</a>
          <a href={`/servicios/${sistema.id}`}>Ver el detalle</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sv-ch wrap" aria-labelledby="canales-title">
    <h2 id="canales-title" class="sv-ch__h" data-split>La puerta de entrada</h2>
    <p class="sv-ch__lead" data-rise style="--i:1">
      Por acá te encuentran, te consultan y te compran. Lo que entra queda ordenado y listo para pasar al sistema cuando lo sumes.
    </p>
    <ul class="sv-ch__list">
      {
        canales.map((s) => (
          <li id={s.id} class="sv-ch__item" data-rise>
            <a href={`/servicios/${s.id}`} class="sv-ch__name">{s.titulo}</a>
            <div class="sv-ch__info">
              <p class="sv-ch__sub">{s.subtitulo}. {s.conecta} <a href={contactoHref(s.titulo)}>{s.cta}</a></p>
              <p class="soft">{s.duracion}. {ejemplo(s.grafico)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sv-terms wrap" aria-label="Qué incluye siempre">
    <div data-rise>
      <h2 class="sv-terms__h">Siempre incluye</h2>
      <ul>{incluyeTodos.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div data-rise style="--i:1">
      <h2 class="sv-terms__h">No incluye</h2>
      <ul>{noIncluye.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>

  <section class="sv-faq wrap" aria-labelledby="sv-faq-title">
    <h2 id="sv-faq-title" class="sv-faq__h" data-split>Antes de firmar</h2>
    <div class="sv-faq__text">
      {faqsGenerales.map((f, i) => <p data-rise style={`--i:${i}`}><strong>{f.q}</strong> {f.a}</p>)}
    </div>
  </section>

  <section class="sv-end wrap" aria-labelledby="sv-end-title">
    <h2 id="sv-end-title" class="sv-end__h" data-split>¿Dónde se traba tu operación?</h2>
    <p class="sv-end__p" data-rise style="--i:1">
      Empezá por el diagnóstico gratis de 30 minutos. Si tu caso no se resuelve con nada de esto, te lo decimos y te orientamos hacia otra opción.
    </p>
    <a href={contactoHref("Quiero hablar de mi proyecto")} class="btn" data-rise style="--i:2">Contanos qué necesitás</a>
  </section>
</Layout>

<style>
  .sv-hero { padding-top: clamp(3rem, 8vw, 6rem); }
  .sv-hero__h1 { font-size: clamp(3.5rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; max-width: 12ch; }
  .sv-hero__row { display: grid; gap: 1.5rem; margin-top: 2.5rem; justify-items: start; }
  .sv-hero__lead { font-size: var(--step-lead); line-height: 1.3; max-width: 34ch; }

  .sv-core { margin-top: var(--section-gap); background: var(--color-accent); color: var(--color-accent-ink); }
  .sv-core__in { display: grid; gap: 2.5rem; padding-block: clamp(4rem, 8vw, 7rem); }
  .sv-core__h { font-size: clamp(3.5rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; color: var(--color-accent-ink); max-width: 9ch; }
  .sv-core__body { display: grid; gap: 1.5rem; max-width: 60ch; }
  .sv-core__lead { font-size: var(--step-lead); line-height: 1.3; }
  .sv-core strong { font-weight: 500; }
  .sv-core__inc ul { margin: 0.5rem 0 0; padding-left: 1.2em; display: grid; gap: 0.35rem; }
  .sv-core__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .sv-core__actions a:not(.btn) { display: inline-block; padding-block: 0.5rem; }
  .sv-core__btn { background: var(--color-accent-ink); color: var(--color-fg); }
  .sv-core__btn:hover { background: var(--color-surface); color: var(--color-fg); }

  .sv-ch { margin-top: var(--section-gap); }
  .sv-ch__lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .sv-ch__list { list-style: none; margin: 4rem 0 0; padding: 0; display: grid; gap: 5.5rem; }
  .sv-ch__item { display: grid; gap: 1rem; }
  .sv-ch__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color 200ms var(--ease-out-quart);
  }
  .sv-ch__name:hover { color: var(--color-accent); }
  .sv-ch__info { display: grid; gap: 0.5rem; max-width: 52ch; }
  .sv-ch__info a { display: inline-block; padding-block: 0.4rem; }

  .sv-terms { margin-top: var(--section-gap); display: grid; gap: 3rem; }
  .sv-terms__h { font-family: var(--font-sans); font-size: var(--step-lead); font-weight: 500; letter-spacing: 0; line-height: 1.2; }
  .sv-terms ul { margin: 1rem 0 0; padding-left: 1.2em; display: grid; gap: 0.5rem; max-width: 46ch; }

  .sv-faq { margin-top: var(--section-gap); display: grid; gap: 2.5rem; }
  .sv-faq__text p { margin-bottom: 1.25rem; break-inside: avoid; }
  .sv-faq__text strong { font-weight: 500; }

  .sv-end { margin-top: var(--section-gap); display: grid; gap: 1.5rem; justify-items: start; }
  .sv-end__h { max-width: 16ch; }
  .sv-end__p { max-width: 52ch; }

  @media (min-width: 1024px) {
    .sv-hero__row { grid-template-columns: 1fr auto; align-items: end; }
    .sv-core__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sv-core__h { grid-column: 1 / span 6; }
    .sv-core__body { grid-column: 7 / span 6; align-self: end; }
    .sv-ch__item { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: baseline; }
    .sv-ch__name { grid-column: 1 / span 7; }
    .sv-ch__info { grid-column: 8 / span 5; }
    .sv-ch__list { margin-left: 0; }
    .sv-ch__h, .sv-ch__lead { margin-left: calc((100% - 11 * var(--gutter)) / 12 * 7 + 7 * var(--gutter)); }
    .sv-terms { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sv-terms > div:first-child { grid-column: 1 / span 5; }
    .sv-terms > div:last-child { grid-column: 7 / span 5; }
    .sv-faq { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sv-faq__h { grid-column: 1 / span 4; align-self: start; }
    .sv-faq__text { grid-column: 5 / -1; columns: 2; column-gap: 3.5rem; }
  }
</style>
