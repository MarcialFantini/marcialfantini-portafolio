---
import Layout from "../../layouts/Layout.astro";
import SubHero from "../../components/sub/SubHero.astro";
import Field from "../../components/sub/Field.astro";
import StockUI from "../../components/demos-ui/StockUI.astro";
import Navegador from "../../components/servicios/Navegador.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  return servicios.map((s) => ({
    params: { slug: s.id },
    props: { servicio: s },
  }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;

// Big-title pattern per service: [big, small connector, big]. Falls back to the plain title.
const bigTitle: Record<string, [string, string, string]> = {
  "software-a-medida": ["Software", "a", "medida"],
  "web-productos-servicios": ["Página web", "de", "productos"],
  "web-empresarial": ["Web", "de tu", "empresa"],
  ecommerce: ["Tienda", "para vender", "online"],
};
const title = bigTitle[servicio.id];

const tipoWeb: Record<string, "web" | "empresa" | "tienda"> = {
  "web-productos-servicios": "web",
  "web-empresarial": "empresa",
  ecommerce: "tienda",
};

// Duration as a figure: the number part big, the qualifier small.
const orientativo = servicio.duracion.includes("(orientativo)");
const duracion = servicio.duracion.replace(/\s*\(orientativo\)/, "");

const cotiza = {
  pregunta: "¿Cuánto cuesta?",
  respuesta:
    "Se cotiza según tu caso. Después del diagnóstico de 30 minutos te paso una propuesta cerrada por escrito, con alcance, plazos y precio. Si algo cambia en el camino, se cotiza antes de hacerlo.",
};

const faqsPorServicio: Record<string, { pregunta: string; respuesta: string }[]> = {
  "web-productos-servicios": [
    cotiza,
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 1 y 3 semanas. Depende de qué tan rápido me pases textos, fotos y definiciones. La fecha queda en la propuesta.",
    },
    {
      pregunta: "¿Tengo que tener los textos y las fotos listos?",
      respuesta: "No es obligatorio. Te ayudo a ordenar qué contar y cómo. Si ya tenés material, mejor; si no, lo vemos juntos.",
    },
    {
      pregunta: "¿Voy a poder hacer cambios después?",
      respuesta: "Sí. Te muestro cómo hacer cambios simples, o los hago por vos si preferís. Queda aclarado en la propuesta.",
    },
  ],
  "web-empresarial": [
    cotiza,
    {
      pregunta: "¿En qué se diferencia de una página web simple?",
      respuesta: "Tiene más secciones y más cuidado en la imagen: quiénes son, qué hacen, sus servicios y cómo contactarlos. Está pensada para generar confianza en clientes, proveedores y candidatos.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 2 y 4 semanas, según el alcance y qué tan rápido esté el contenido.",
    },
  ],
  ecommerce: [
    cotiza,
    {
      pregunta: "¿Qué medios de pago puedo usar?",
      respuesta: "Integro medios de pago habituales, como Mercado Pago. Definimos juntos cuál conviene según tu forma de cobrar.",
    },
    {
      pregunta: "¿Se conecta con mi stock y mi facturación?",
      respuesta: "Puede hacerlo. Si ya usás un sistema, lo integro; si no, la tienda queda preparada para sumar control de stock y facturación más adelante sin rehacerla.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 4 y 8 semanas. Cuanto antes estén productos, fotos y precios, más rápido se publica.",
    },
  ],
  "software-a-medida": [
    {
      pregunta: "¿Cuánto cuesta un software a medida?",
      respuesta: "Depende del problema, por eso no hay un precio fijo. Después del diagnóstico te paso una propuesta cerrada con alcance, etapas, plazos y precio por escrito.",
    },
    {
      pregunta: "¿Cómo empezamos?",
      respuesta: "Con el diagnóstico de 30 minutos. Contame qué proceso querés mejorar y te digo con honestidad si conviene hacerlo a medida o usar algo que ya exista.",
    },
    {
      pregunta: "¿Voy a ver avances durante el desarrollo?",
      respuesta: "Sí. Trabajo por etapas: cada parte entra en uso antes de empezar la siguiente, así se ajusta el rumbo a tiempo.",
    },
  ],
};

const faqItems = faqsPorServicio[servicio.id] ?? [];
const contactoHref = `/contacto?servicio=${encodeURIComponent(servicio.titulo)}`;
const diagnostico = "/contacto?servicio=Diagn%C3%B3stico%20gratis";

const noIncluye = [
  "hosting ni dominio: se contratan aparte y te ayudo a elegirlos",
  "promesas de resultados que dependen de cosas que no controlo",
  "empezar sin propuesta escrita",
];

type Cifra = { v: number; suf?: string };
const g = servicio.grafico;
const pct = (c: Cifra) => `${Math.max(Math.round((c.v / Math.max(g.antes.v, g.ahora.v)) * 100), 6)}%`;
const otros = servicios.filter((s) => s.id !== servicio.id);
---

<Layout title={`${servicio.titulo} — ${site.name}`} description={servicio.descripcion} bleed>
  <SubHero field="paper" lead={`${servicio.subtitulo}.`} back={{ href: "/servicios", label: "Servicios" }}>
    <Fragment slot="title">
      {title ? <>{title[0]} <small>{title[1]}</small> {title[2]}</> : servicio.titulo}
    </Fragment>
    <Fragment slot="actions">
      <dl class="sd-facts">
        <div>
          <dt>Duración</dt>
          <dd><b>{duracion}</b>{orientativo && <span>orientativo</span>}</dd>
        </div>
        <div>
          <dt>Cómo se cotiza</dt>
          <dd><b>Precio cerrado</b><span>por escrito, después del diagnóstico de 30 minutos</span></dd>
        </div>
      </dl>
      <a href={contactoHref} class="btn">{servicio.cta}</a>
    </Fragment>
    <Fragment slot="aside">
      {servicio.id === "software-a-medida" ? <StockUI /> : <Navegador tipo={tipoWeb[servicio.id] ?? "web"} />}
    </Fragment>
  </SubHero>

  <Field field="mist" id="para-quien">
    <Fragment slot="title">Para <small>quién</small> es</Fragment>
    <div class="sd-who">
      <div class="sd-who__text" data-reveal>
        <p class="sd-who__lead">{servicio.idealPara}</p>
        <p>{servicio.descripcion}</p>
      </div>
      <figure class="sd-ex" data-reveal="right">
        <p class="sd-ex__statement">{servicio.resultadoCuantificado}</p>
        <div class="sd-ex__bars">
          <div class="sd-ex__row">
            <span>Antes</span>
            <span class="sd-ex__track"><i style={`width:${pct(g.antes)}`} data-grow></i></span>
            <b><span data-count={g.antes.v}>{g.antes.v}</span>{g.antes.suf}</b>
          </div>
          <div class="sd-ex__row sd-ex__row--now">
            <span>Después</span>
            <span class="sd-ex__track"><i style={`width:${pct(g.ahora)}`} data-grow></i></span>
            <b><span data-count={g.ahora.v}>{g.ahora.v}</span>{g.ahora.suf}</b>
          </div>
        </div>
        <figcaption>Ejemplo ilustrativo: {g.label.toLowerCase()}.</figcaption>
      </figure>
    </div>
  </Field>

  <Field field="lime" id="incluye">
    <Fragment slot="title">Qué <small>incluye</small></Fragment>
    <ol class="sd-inc" data-stagger>
      {
        servicio.queIncluye.map((item, i) => (
          <li>
            <span class="sd-inc__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ol>
    <p class="sd-no" data-reveal><strong>No incluye:</strong> {noIncluye.join("; ")}.</p>
    <p class="sd-conecta" data-reveal><strong>Cómo se conecta.</strong> {servicio.conecta}</p>
  </Field>

  {
    faqItems.length > 0 && (
      <Field field="bone" id="preguntas">
        <Fragment slot="title">Preguntas <small>concretas</small></Fragment>
        <dl class="sd-faq" data-stagger>
          {faqItems.map((f) => (
            <div>
              <dt>{f.pregunta}</dt>
              <dd>{f.respuesta}</dd>
            </div>
          ))}
        </dl>
      </Field>
    )
  }

  <Field field="night" id="empezar" class="sd-end">
    <Fragment slot="title">¿Te <small>sirve</small> esto?</Fragment>
    <div class="sd-end__row" data-reveal>
      <p>El primer paso es un diagnóstico de 30 minutos, sin costo. Si no es lo que te conviene, te lo digo y te oriento.</p>
      <a href={diagnostico} class="btn">Agendar diagnóstico de 30 minutos</a>
    </div>
    <nav class="sd-more" aria-label="Otros servicios">
      <p>Otros servicios</p>
      <ul data-stagger>
        {otros.map((o) => <li><a href={`/servicios/${o.id}`}>{o.titulo}</a></li>)}
      </ul>
    </nav>
  </Field>
</Layout>

<style>
  /* Hero figures */
  .sd-facts { flex: 1 1 100%; margin: 0; display: grid; gap: 1.25rem; }
  .sd-facts > div { padding-top: 0.75rem; border-top: 3px solid var(--color-ink); }
  .sd-facts dt { font-weight: 500; color: var(--color-soft); }
  .sd-facts dd { margin: 0.25rem 0 0; display: grid; gap: 0.2rem; }
  .sd-facts b { font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem); line-height: 0.95; }
  .sd-facts dd span { max-width: 26ch; }

  /* Para quién */
  .sd-who { display: grid; gap: 3rem; align-items: start; }
  .sd-who__text { display: grid; gap: 1.25rem; max-width: 52ch; }
  .sd-who__text p { margin: 0; }
  .sd-who__lead { font-size: var(--step-lead); line-height: 1.3; font-weight: 500; }

  .sd-ex { margin: 0; display: grid; gap: 1.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: #fff; }
  .sd-ex__statement { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--step-statement); line-height: 1.1; }
  .sd-ex__bars { display: grid; gap: 0.75rem; }
  .sd-ex__row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 4rem; align-items: center; gap: 0.75rem; font-weight: 500; }
  .sd-ex__row b { text-align: right; font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1; }
  .sd-ex__track { display: block; height: 0.9rem; background: var(--color-surface); }
  .sd-ex__track i { display: block; height: 100%; background: var(--color-field-night); }
  .sd-ex__row--now .sd-ex__track i { background: var(--color-accent); }
  .sd-ex__row--now b { color: var(--color-accent); }
  .sd-ex figcaption { color: var(--color-soft); font-size: var(--step-small); }

  /* Qué incluye */
  .sd-inc { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .sd-inc li {
    display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; align-items: baseline;
    padding-block: 1rem; border-top: 3px solid var(--color-ink);
    font-size: var(--step-lead); line-height: 1.25;
  }
  .sd-inc__n { font-family: var(--font-display); font-weight: 600; }
  .sd-no, .sd-conecta { margin: 0; max-width: 70ch; }
  .sd-no strong, .sd-conecta strong { font-weight: 600; }

  /* FAQ */
  .sd-faq { margin: 0; display: grid; gap: 2rem; }
  .sd-faq dt { font-weight: 600; font-size: var(--step-lead); line-height: 1.2; }
  .sd-faq dd { margin: 0.5rem 0 0; max-width: 52ch; }

  /* Closing */
  :global(.sd-end) { margin-bottom: calc(-1 * var(--section-gap)); }
  .sd-end__row { display: grid; gap: 1.5rem; justify-items: start; }
  .sd-end__row p { margin: 0; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .sd-more { display: grid; gap: 0.75rem; padding-top: 1.5rem; border-top: 3px solid var(--color-paper); }
  .sd-more p { margin: 0; font-weight: 500; }
  .sd-more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
  .sd-more a { display: inline-block; padding-block: 0.4rem; color: var(--color-paper); }
  .sd-more a:hover { color: var(--color-field-lime); }

  @media (min-width: 720px) {
    .sd-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
    .sd-inc { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
    .sd-faq { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3.5rem; }
  }

  @media (min-width: 1024px) {
    .sd-who { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 5rem; }
    .sd-end__row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 4rem; }
  }
</style>
