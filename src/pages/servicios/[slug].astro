---
import Layout from "../../layouts/Layout.astro";

import servicios from "../../data/servicios.json";
import site from "../../data/site.json";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  return servicios.map((s) => ({
    params: { slug: s.id },
    props: { servicio: s },
  }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;

const cotiza = {
  pregunta: "¿Cuánto cuesta?",
  respuesta:
    "Se cotiza según tu caso. Después del diagnóstico gratis de 30 minutos te pasamos una propuesta cerrada por escrito, con alcance, plazos y precio. Si algo cambia en el camino, se cotiza antes de hacerlo.",
};

// Preguntas frecuentes por servicio.
const faqsPorServicio: Record<string, { pregunta: string; respuesta: string }[]> = {
  "web-productos-servicios": [
    cotiza,
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 1 y 3 semanas. Depende de qué tan rápido nos pases textos, fotos y definiciones. Te confirmamos la fecha en la propuesta.",
    },
    {
      pregunta: "¿Tengo que tener los textos y las fotos listos?",
      respuesta: "No es obligatorio. Te ayudamos a ordenar qué contar y cómo. Si ya tenés material, mejor; si no, lo vemos juntos.",
    },
    {
      pregunta: "¿Podré hacer cambios después?",
      respuesta: "Sí. Te mostramos cómo hacer cambios simples, o los hacemos por vos si preferís. Lo dejamos aclarado en la propuesta.",
    },
  ],
  "web-empresarial": [
    cotiza,
    {
      pregunta: "¿En qué se diferencia de una página web simple?",
      respuesta: "Tiene más secciones y más cuidado en la imagen: quiénes son, qué hacen, sus servicios y cómo contactarlos. Está pensada para generar confianza en clientes, proveedores y candidatos.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 2 y 4 semanas, según el alcance y la rapidez con la que tengamos el contenido.",
    },
  ],
  "ecommerce": [
    cotiza,
    {
      pregunta: "¿Qué medios de pago puedo usar?",
      respuesta: "Integramos medios de pago habituales, como Mercado Pago. Definimos cuál conviene según tu negocio y tu forma de cobrar.",
    },
    {
      pregunta: "¿Se conecta con mi stock y mi facturación?",
      respuesta: "Puede hacerlo. Si ya usás un sistema, lo integramos; si no, la tienda queda preparada para sumar control de stock y facturación más adelante sin rehacerla.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 4 y 8 semanas. Cuanto antes tengamos productos, fotos y precios, más rápido se publica.",
    },
  ],
  "software-a-medida": [
    {
      pregunta: "¿Cuánto cuesta un software a medida?",
      respuesta: "Depende del problema, por eso no hay un precio fijo. Después del diagnóstico te pasamos una propuesta cerrada con alcance, etapas, plazos y precio por escrito.",
    },
    {
      pregunta: "¿Cómo empezamos?",
      respuesta: "Con el diagnóstico gratis de 30 minutos. Contanos qué proceso querés mejorar y te decimos con honestidad si conviene hacerlo a medida o usar algo que ya exista.",
    },
    {
      pregunta: "¿Voy a ver avances durante el desarrollo?",
      respuesta: "Sí. Trabajamos por etapas: cada parte entra en uso antes de empezar la siguiente, así ajustamos el rumbo a tiempo.",
    },
  ],
};

const faqItems = faqsPorServicio[servicio.id] ?? [];
const contactoHref = `/contacto?servicio=${encodeURIComponent(servicio.titulo)}`;

const noIncluye = [
  "Hosting ni dominio: se contratan aparte y te ayudamos a elegirlos.",
  "Promesas de resultados que dependen de cosas que no controlamos.",
  "Empezar sin propuesta escrita.",
];

type Cifra = { v: number; suf?: string };
const cifra = (c: Cifra) => `${c.v.toLocaleString("es-AR")}${c.suf ?? ""}`;
const otros = servicios.filter((s) => s.id !== servicio.id);
---

<Layout title={`${servicio.titulo} — ${site.name}`} description={servicio.descripcion}>
  <section class="sd-hero wrap" aria-labelledby="sd-title">
    <h1 id="sd-title" class="sd-hero__h1" data-split>{servicio.titulo}</h1>
    <div class="sd-hero__grid">
      <div class="sd-hero__copy">
        <p class="sd-hero__lead" data-rise style="--i:1">{servicio.subtitulo}.</p>
        <p data-rise style="--i:2">{servicio.descripcion}</p>
      </div>
      <dl class="sd-hero__facts" data-rise style="--i:2">
        <div><dt class="soft">Duración</dt><dd>{servicio.duracion}</dd></div>
        <div><dt class="soft">Cómo se cotiza</dt><dd>Propuesta cerrada por escrito, después del diagnóstico gratis de 30 minutos.</dd></div>
        <div><a href={contactoHref} class="btn">{servicio.cta}</a></div>
      </dl>
    </div>
  </section>

  <section class="sd-get" aria-labelledby="sd-get-title">
    <div class="sd-get__in wrap">
      <h2 id="sd-get-title" class="sr-only">Lo que conseguís</h2>
      <p class="sd-get__statement" data-rise>{servicio.resultadoCuantificado}</p>
      <div class="sd-get__side">
        <p data-rise style="--i:1"><strong>Para quién es.</strong> {servicio.idealPara}</p>
        <div class="sd-get__nums" data-rise style="--i:2">
          <dl>
            <div><dt class="soft">Antes</dt><dd>{cifra(servicio.grafico.antes)}</dd></div>
            <div><dt class="soft">Con el sistema</dt><dd class="is-now">{cifra(servicio.grafico.ahora)}</dd></div>
          </dl>
          <p class="sd-get__ej soft">Ejemplo ilustrativo · {servicio.grafico.label}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sd-inc wrap" aria-labelledby="sd-inc-title">
    <h2 id="sd-inc-title" class="sd-inc__h" data-split>Qué incluye</h2>
    <ul class="sd-inc__list">
      {servicio.queIncluye.map((item, i) => <li data-rise style={`--i:${i % 4}`}>{item}</li>)}
    </ul>
    <p class="sd-inc__no soft" data-rise>No incluye: {noIncluye.map((t) => t.replace(/\.$/, "").toLowerCase()).join("; ")}.</p>
  </section>

  {
    faqItems.length > 0 && (
      <section class="sd-faq wrap" aria-labelledby="sd-faq-title">
        <h2 id="sd-faq-title" class="sd-faq__h" data-split>Preguntas concretas</h2>
        <div class="sd-faq__text">
          {faqItems.map((f, i) => <p data-rise style={`--i:${i}`}><strong>{f.pregunta}</strong> {f.respuesta}</p>)}
        </div>
      </section>
    )
  }

  <section class="sd-end wrap" aria-labelledby="sd-end-title">
    <h2 id="sd-end-title" data-split>¿Te encaja?</h2>
    <p class="sd-end__p" data-rise style="--i:1">
      Empezá por el diagnóstico gratis de 30 minutos. Si no es lo que te conviene, te lo decimos y te orientamos.
    </p>
    <a href={contactoHref} class="btn" data-rise style="--i:2">{servicio.cta}</a>
    <p class="sd-end__more" data-rise style="--i:3">
      Otros servicios:{" "}
      {otros.map((o, i) => (
        <>
          <a href={`/servicios/${o.id}`}>{o.titulo}</a>
          {i < otros.length - 1 ? ", " : "."}
        </>
      ))}
    </p>
  </section>
</Layout>

<style>
  .sd-hero { padding-top: clamp(3rem, 8vw, 6rem); }
  .sd-hero__h1 { font-size: clamp(2.5rem, 6.5vw, 7rem); line-height: 0.92; letter-spacing: -0.03em; max-width: 16ch; }
  .sd-hero__grid { display: grid; gap: 2.5rem; margin-top: 3rem; }
  .sd-hero__copy { display: grid; gap: 1rem; max-width: 60ch; }
  .sd-hero__lead { font-size: var(--step-lead); line-height: 1.3; font-weight: 500; }
  .sd-hero__facts { display: grid; gap: 1.25rem; font-size: var(--step-small); align-content: start; }
  .sd-hero__facts dd { margin: 0.15rem 0 0; font-size: var(--step-body); }

  .sd-get { margin-top: var(--section-gap); background: var(--color-surface); }
  .sd-get__in { display: grid; gap: 3rem; padding-block: clamp(4rem, 8vw, 7rem); }
  .sd-get__statement { font-family: var(--font-serif); font-size: var(--step-statement); line-height: 1.15; letter-spacing: -0.01em; max-width: 38ch; }
  .sd-get__side { display: grid; gap: 2.5rem; align-content: start; max-width: 52ch; }
  .sd-get strong { font-weight: 500; }
  .sd-get__ej { font-size: var(--step-small); margin-top: 1rem; }
  .sd-get__nums dl { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .sd-get__nums dl div { display: flex; flex-direction: column-reverse; gap: 0.25rem; }
  .sd-get__nums dt { font-size: var(--step-small); }
  .sd-get__nums dd { margin: 0; font-family: var(--font-serif); font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.02em; }
  .sd-get__nums dd.is-now { color: var(--color-accent); }

  .sd-inc { margin-top: var(--section-gap); }
  .sd-inc__list { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
  .sd-inc__list li { font-size: var(--step-statement); line-height: 1.2; letter-spacing: -0.01em; max-width: 32ch; }
  .sd-inc__no { margin-top: 2.5rem; font-size: var(--step-small); max-width: 70ch; }

  .sd-faq { margin-top: var(--section-gap); display: grid; gap: 2.5rem; }
  .sd-faq__text p { margin-bottom: 1.25rem; break-inside: avoid; }
  .sd-faq__text strong { font-weight: 500; }

  .sd-end { margin-top: var(--section-gap); display: grid; gap: 1.5rem; justify-items: start; }
  .sd-end__p { max-width: 52ch; }
  .sd-end__more { font-size: var(--step-small); }
  .sd-end__more a { display: inline-block; padding-block: 0.4rem; }

  @media (min-width: 1024px) {
    .sd-hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sd-hero__copy { grid-column: 1 / span 6; }
    .sd-hero__facts { grid-column: 9 / span 4; }
    .sd-get__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sd-get__statement { grid-column: 1 / span 7; }
    .sd-get__side { grid-column: 9 / span 4; }
    .sd-inc { padding-left: calc((100% - 11 * var(--gutter)) / 12 * 4 + 4 * var(--gutter)); }
    .sd-faq { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .sd-faq__h { grid-column: 1 / span 4; align-self: start; }
    .sd-faq__text { grid-column: 5 / -1; columns: 2; column-gap: 3.5rem; }
  }
</style>
