---
import Layout from "../../layouts/Layout.astro";
import servicios from "../../data/servicios.json";
import site from "../../data/site.json";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  return servicios.map((s) => ({
    params: { slug: s.id },
    props: { servicio: s },
  }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;

// Preguntas frecuentes por servicio (plazos y precios orientativos).
const faqsPorServicio: Record<string, { pregunta: string; respuesta: string }[]> = {
  "web-productos-servicios": [
    {
      pregunta: "¿Cuánto cuesta una página web para mi negocio?",
      respuesta: "Arranca desde USD 300. El valor final depende de cuántas secciones necesites y de qué tengamos que armar; te lo pasamos por escrito antes de empezar.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 1 y 3 semanas. Depende de qué tan rápido nos pases textos, fotos y definiciones. Te confirmamos la fecha en la propuesta.",
    },
    {
      pregunta: "¿Tengo que tener los textos y las fotos listos?",
      respuesta: "No es obligatorio. Te ayudamos a ordenar qué contar y cómo. Si ya tenés material, mejor; si no, lo vemos juntos.",
    },
    {
      pregunta: "¿Podré hacer cambios después?",
      respuesta: "Sí. Te mostramos cómo hacer cambios simples, o los hacemos por vos si preferís. Lo dejamos aclarado en la propuesta.",
    },
  ],
  "web-empresarial": [
    {
      pregunta: "¿Cuánto cuesta una página empresarial?",
      respuesta: "Arranca desde USD 400. Según la cantidad de secciones y el contenido, el valor puede variar; te pasamos el presupuesto cerrado por escrito.",
    },
    {
      pregunta: "¿En qué se diferencia de una página web simple?",
      respuesta: "Tiene más secciones y más cuidado en la imagen: quiénes son, qué hacen, sus servicios y cómo contactarlos. Está pensada para generar confianza en clientes, proveedores y candidatos.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 2 y 4 semanas, según el alcance y la rapidez con la que tengamos el contenido.",
    },
  ],
  "ecommerce": [
    {
      pregunta: "¿Cuánto cuesta una tienda online?",
      respuesta: "Arranca desde USD 800. El valor final depende de la cantidad de productos, los medios de pago y las funciones que necesites; te lo detallamos en la propuesta.",
    },
    {
      pregunta: "¿Qué medios de pago puedo usar?",
      respuesta: "Integramos medios de pago habituales, como Mercado Pago. Definimos cuál conviene según tu negocio y tu forma de cobrar.",
    },
    {
      pregunta: "¿Voy a poder cargar mis propios productos?",
      respuesta: "Sí. Te dejamos un panel para cargar productos y ver los pedidos, y te enseñamos a usarlo.",
    },
    {
      pregunta: "¿Cuánto tarda?",
      respuesta: "Orientativamente entre 4 y 8 semanas. Cuanto antes tengamos productos, fotos y precios, más rápido se publica.",
    },
  ],
  "software-a-medida": [
    {
      pregunta: "¿Cuánto cuesta un software a medida?",
      respuesta: "Depende de cada proyecto, por eso no hay un precio fijo. Empezamos con una conversación, entendemos qué necesitás y te pasamos una propuesta con alcance, etapas y presupuesto.",
    },
    {
      pregunta: "¿Cómo empezamos?",
      respuesta: "Con una charla. Contanos qué proceso querés mejorar o qué idea tenés y te decimos con honestidad si conviene hacerlo a medida o usar algo que ya exista.",
    },
    {
      pregunta: "¿Voy a ver avances durante el desarrollo?",
      respuesta: "Sí. Trabajamos por etapas para que puedas ver y probar lo que se va armando, y ajustar el rumbo a tiempo.",
    },
  ],
};

const faqItems = faqsPorServicio[servicio.id] ?? [];
---

<Layout
  title={`${servicio.titulo} — ${site.name}`}
  description={servicio.descripcion}
>
  <section class="pt-16 md:pt-20 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <nav class="mb-8 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/servicios" class="hover:text-[var(--color-azul)]">Servicios</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-[var(--color-ink)]">{servicio.titulo}</li>
        </ol>
      </nav>

      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-mute)] tabular-nums">
          0{servicios.findIndex((s) => s.id === servicio.id) + 1}
        </span>
        <span class="h-px flex-1 bg-[var(--color-border)]"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
          {servicio.duracion}
        </span>
      </div>

      <h1 class="font-impact text-[clamp(2.25rem,5.5vw,4.5rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-5">
        {servicio.titulo}.<br />
        <span class="text-[var(--color-azul)]">{servicio.subtitulo}</span>
      </h1>

      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl mb-8">
        {servicio.descripcion}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-sm font-mono uppercase tracking-[0.18em] text-[var(--color-mute)]">
        <span class="px-3 py-1.5 rounded-md bg-[var(--color-dorado-soft)] text-[var(--color-dorado-deep)] font-semibold">
          {servicio.precioOrientativo}
        </span>
        <span class="px-3 py-1.5 rounded-md bg-[var(--color-azul-soft)] text-[var(--color-azul-deep)] font-semibold">
          {servicio.duracion}
        </span>
        {servicio.badge && (
          <span class="px-3 py-1.5 rounded-md bg-[var(--color-ink)] text-white font-semibold">
            {servicio.badge}
          </span>
        )}
      </div>
      {servicio.precioDesdeUsd != null && (
        <p class="mt-3 text-sm text-[var(--color-mute)]">
          Precios orientativos en USD. No incluyen hosting ni dominio.
        </p>
      )}
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-[var(--color-border)] bg-[var(--color-azul)] text-white">
    <div class="container-page max-w-3xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        Lo que conseguís
      </p>
      <p class="font-impact text-[clamp(1.5rem,3vw,2.5rem)] uppercase leading-[0.98] text-white">
        {servicio.resultadoCuantificado}
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-[var(--color-border)]">
    <div class="container-page max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        Qué incluye
      </p>
      <h2 class="font-impact text-[clamp(1.75rem,3.5vw,2.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-10">
        Todo lo que entregamos,{" "}<span class="text-[var(--color-azul)]">por escrito.</span>
      </h2>
      <ul class="space-y-3">
        {
          servicio.queIncluye.map((item) => (
            <li class="flex items-start gap-3 text-base md:text-lg text-[var(--color-ink)] leading-relaxed">
              <span class="shrink-0 inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-azul)] text-white font-mono text-xs mt-1">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-[var(--color-border)] bg-[var(--color-blanco)]">
    <div class="container-page max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        Para quién es
      </p>
      <p class="text-xl md:text-2xl text-[var(--color-ink)] leading-snug font-medium">
        {servicio.idealPara}
      </p>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="py-12 md:py-16 border-b border-[var(--color-border)]">
      <div class="container-page max-w-3xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
          FAQ del servicio
        </p>
        <h2 class="font-impact text-[clamp(1.75rem,3.5vw,2.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-10">
          Preguntas <span class="text-[var(--color-azul)]">concretas.</span>
        </h2>
        <div class="space-y-3">
          {
            faqItems.map((faq) => (
              <details class="group rounded-md bg-white border-2 border-[var(--color-ink)] tactile">
                <summary class="flex items-start justify-between gap-4 p-5 cursor-pointer list-none">
                  <h3 class="font-display font-semibold text-base md:text-lg text-[var(--color-ink)] leading-snug flex-1">
                    {faq.pregunta}
                  </h3>
                  <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border-2 border-[var(--color-ink)] text-[var(--color-ink)] group-open:bg-[var(--color-azul)] group-open:border-[var(--color-azul)] group-open:text-white transition-all" aria-hidden="true">
                    <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 16 16">
                      <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </span>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-sm md:text-base text-[var(--color-ink-soft)] leading-relaxed">
                    {faq.respuesta}
                  </p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <section class="py-12 md:py-16 bg-[var(--color-ink)] text-white border-t border-[var(--color-ink)]">
    <div class="container-page text-center max-w-2xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        {servicio.precioDesdeUsd == null ? "Iniciemos una conversación" : "Empecemos"}
      </p>
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] uppercase leading-[0.95] text-white mb-5">
        ¿Te encaja? <span class="text-[var(--color-dorado)]">Hablemos.</span>
      </h2>
      <p class="text-lg text-white/80 leading-relaxed mb-8">
        Contanos qué necesitás y te respondemos con una primera lectura de tu proyecto. Si preferís, podés empezar por una auditoría gratis de 15 minutos. Si no es lo que te conviene, te lo decimos y te orientamos.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`/contacto?servicio=${encodeURIComponent(servicio.titulo)}`}
          class="tactile inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white"
        >
          {servicio.precioDesdeUsd == null ? servicio.cta : "Quiero este servicio"}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/servicios"
          class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md border border-white/30 text-white font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-dorado)] hover:text-[var(--color-dorado)]"
        >
          Ver otros servicios
        </a>
      </div>
    </div>
  </section>
</Layout>