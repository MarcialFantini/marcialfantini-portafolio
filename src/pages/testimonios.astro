---
import Layout from "../layouts/Layout.astro";
import testimonios from "../data/testimonios.json";
import site from "../data/site.json";
import { getCollection } from "astro:content";

const proyectos = await getCollection("proyectos");
const proyectosById = Object.fromEntries(proyectos.map((p) => [p.id, p]));
---

<Layout
  title={`Testimonios — ${site.name}`}
  description="Lo que dicen los clientes que trabajaron conmigo. Métricas concretas, casos reales, sectores diversos."
>
  <section class="pt-16 md:pt-24 pb-12 border-b border-[var(--color-border)]">
    <div class="container-page max-w-4xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-3">
        Testimonios
      </p>
      <h1 class="font-impact text-[clamp(2.25rem,5.5vw,4.75rem)] uppercase leading-[0.95] text-[var(--color-ink)] tracking-tight mb-6">
        Lo que dicen los que <span class="text-[var(--color-azul)]">ya trabajaron conmigo.</span>
      </h1>
      <p class="text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
        8 clientes de sectores diversos — estudios jurídicos, ferreterías, distribuidoras, e-commerce,
        consultoras. Métricas reales, no testimonios genéricos.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
        {
          testimonios.map((t) => {
            const proyecto = proyectosById[t.proyectoSlug];
            return (
              <article class="rounded-lg bg-white border-2 border-[var(--color-ink)] p-7 tactile transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-azul)] flex flex-col">
                <div class="flex items-start gap-4 mb-5">
                  <div
                    class="shrink-0 w-14 h-14 rounded-md bg-[var(--color-azul)] text-white flex items-center justify-center font-impact text-xl tracking-tight"
                    aria-hidden="true"
                  >
                    {t.monograma}
                  </div>
                  <div class="min-w-0">
                    <p class="font-display font-semibold text-base text-[var(--color-ink)] leading-tight">
                      {t.nombre}
                    </p>
                    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] mt-1 leading-tight">
                      {t.role} · {t.empresa}
                    </p>
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-azul)] mt-1">
                      {t.sector}
                    </p>
                  </div>
                </div>

                <blockquote class="relative">
                  <span aria-hidden="true" class="absolute -left-2 -top-3 text-5xl text-[var(--color-dorado)] font-impact leading-none select-none">"</span>
                  <p class="text-base text-[var(--color-ink)] leading-relaxed pl-4">
                    {t.quote}
                  </p>
                </blockquote>

                <div class="mt-auto pt-6 border-t border-[var(--color-border)] flex items-center justify-between gap-3">
                  <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-[var(--color-dorado-soft)] text-[var(--color-dorado-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-semibold tabular-nums">
                    {t.metric}
                  </span>
                  {proyecto && (
                    <a
                      href={`/proyectos/${proyecto.id}`}
                      class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)] hover:text-[var(--color-azul)] font-semibold"
                    >
                      Ver caso →
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-[var(--color-ink)] text-white border-t border-[var(--color-ink)]">
    <div class="container-page text-center max-w-2xl reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)] mb-3">
        ¿Sos el próximo?
      </p>
      <h2 class="font-impact text-[clamp(2rem,5vw,3.5rem)] uppercase leading-[0.95] text-white mb-5">
        Si te encaja el perfil, <span class="text-[var(--color-dorado)]">hablemos.</span>
      </h2>
      <p class="text-lg text-white/80 leading-relaxed mb-8">
        Auditoría gratis de 30 minutos. Te digo en concreto si tu caso entra en alguno de mis servicios.
      </p>
      <a
        href="/contacto"
        class="tactile inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-[var(--color-dorado)] text-[var(--color-azul-deep)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white"
      >
        Reservá tu auditoría
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>