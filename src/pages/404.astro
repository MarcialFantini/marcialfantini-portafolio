---
import Layout from "../layouts/Layout.astro";
import SceneLost from "../components/robots/scenes/SceneLost.astro";
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe. Volvé al inicio o escribinos si pensás que fue un error."
  noindex
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__copy wrap">
      <h1 id="nf-title" class="nf__h1" data-split>Esta página no existe.</h1>
      <p class="nf__p" data-rise style="--i:1">
        Si llegaste desde un link, avisanos y lo corregimos. Si escribiste la dirección a mano, probablemente tenga un error.
      </p>
      <div class="nf__actions" data-rise style="--i:2">
        <a href="/" class="btn">Volver al inicio <span aria-hidden="true">→</span></a>
        <a href="/contacto">Escribinos</a>
      </div>
      <SceneLost class="nf__crew" />
    </div>
    <p class="nf__word" aria-hidden="true">404</p>
  </section>
</Layout>

<style>
  .nf { position: relative; overflow: hidden; min-height: calc(100svh - 4.5rem); }
  .nf__copy { position: relative; z-index: 1; padding-top: clamp(3rem, 10vh, 7rem); display: grid; gap: 1.5rem; justify-items: start; }
  .nf__h1 { font-size: clamp(2.5rem, 6vw, 6rem); line-height: 0.92; letter-spacing: -0.03em; max-width: 12ch; }
  .nf__p { max-width: 46ch; }
  :global(.nf__crew) { width: min(100%, 36rem); margin-top: 2rem; overflow: hidden; }
  .nf__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .nf__actions a:not(.btn) { display: inline-block; padding-block: 0.5rem; }
  .nf__word {
    position: absolute;
    right: -0.04em;
    bottom: -0.2em;
    font-family: var(--font-serif);
    font-size: clamp(14rem, 42vw, 44rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-surface-2);
    white-space: nowrap;
  }
</style>
