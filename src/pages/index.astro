---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/capitulos/Intro.astro";
import Hero from "../components/capitulos/Hero.astro";
import Caos from "../components/capitulos/Caos.astro";
import Ciclo from "../components/capitulos/Ciclo.astro";
import Demos from "../components/capitulos/Demos.astro";
import SobreMi from "../components/capitulos/SobreMi.astro";
import Diagnostico from "../components/capitulos/Diagnostico.astro";
import Journal from "../components/capitulos/Journal.astro";
import Proceso from "../components/capitulos/Proceso.astro";
import Cierre from "../components/capitulos/Cierre.astro";
import site from "../data/site.json";
---

<!--
  Chapter format (see docs/plan-rediseno-formato.md §4). Each chapter is one full field;
  neighbours never share a field colour. The field comes from data-field (styles below).
-->
<Layout title={`${site.name} · Mejoro cómo opera tu PyME`} description={site.description} bleed>
  <Intro />
  <div class="chapters">
    <Hero />
    <Caos />
    <Ciclo />
    <Demos />
    <SobreMi />
    <Diagnostico />
    <Journal />
    <Proceso />
    <Cierre />
  </div>
</Layout>

<style>
  /* Field colours per chapter, with their paired ink. Sections set data-field on their root. */
  .chapters :global([data-field]) { position: relative; }
  .chapters :global([data-field="paper"]) { background: var(--color-paper); color: var(--color-ink); }
  .chapters :global([data-field="mist"]) { background: var(--color-field-mist); color: var(--color-ink); }
  .chapters :global([data-field="cornflower"]) { background: var(--color-field-cornflower); color: var(--color-ink); }
  .chapters :global([data-field="lime"]) { background: var(--color-field-lime); color: var(--color-ink); }
  .chapters :global([data-field="night"]) { background: var(--color-field-night); color: var(--color-paper); }
  .chapters :global([data-field="night"] :is(h1, h2, h3, h4)) { color: var(--color-paper); }
  .chapters :global([data-field="cornflower"] :is(h1, h2, h3, h4)),
  .chapters :global([data-field="lime"] :is(h1, h2, h3, h4)),
  .chapters :global([data-field="mist"] :is(h1, h2, h3, h4)) { color: var(--color-ink); }
</style>
