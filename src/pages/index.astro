---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Capitulos from "../components/home/Capitulos.astro";
import MediaSlot from "../components/home/MediaSlot.astro";
import Proceso from "../components/home/Proceso.astro";
import Casos from "../components/home/Casos.astro";
import Sobre from "../components/home/Sobre.astro";
import Dudas from "../components/home/Dudas.astro";
import UnCampo from "../components/home/UnCampo.astro";
import site from "../data/site.json";
import fotos from "../data/fotos.json";

// Video band: drop the files in /public/media and fill these two paths. Until then the band shows a photograph.
const video = { src: "", poster: "" };
const banda = fotos.turnoNoche;
---

<Layout title={`${site.name} · Mejoro cómo opera tu PyME`} description={site.description}>
  <!-- 1. The promise, with the product over the robot floor -->
  <Hero />
  <!-- 2. Four chapters on one rail: order, connect, automate, numbers -->
  <Capitulos />

  <section class="band" aria-labelledby="band-title">
    <div class="band__media">
      {
        video.src ? (
          <MediaSlot kind="video" src={video.src} poster={video.poster || undefined} alt="Un sistema de pedidos en uso" label="" ratio="21 / 9" />
        ) : (
          <img class="band__img" src={banda.src} alt={banda.alt} width={banda.width} height={banda.height} loading="lazy" decoding="async" />
        )
      }
    </div>
    <h2 id="band-title" class="band__h wrap" data-split>Tu negocio sigue andando mientras lo armo.</h2>
  </section>

  <!-- 3. How, in three steps -->
  <Proceso />
  <!-- 4. Examples, before and after -->
  <Casos />
  <!-- 5. Who, questions, contact -->
  <Sobre />
  <Dudas />
  <UnCampo />
</Layout>

<style>
  .band { position: relative; margin-top: var(--section-gap); }
  .band__media { overflow: hidden; }
  .band__img, .band__media :global(.slot) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    min-height: 50svh;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* The line sits on a plate of the page ground, cut into the photo's lower edge */
  .band__h {
    max-width: 18ch;
    min-width: 0;
    overflow-wrap: break-word;
    padding-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .band__h {
      position: absolute;
      left: 0;
      bottom: 0;
      max-width: min(40rem, 60%);
      padding: 2rem var(--gutter) 0;
      background: var(--color-bg);
    }
  }
</style>
