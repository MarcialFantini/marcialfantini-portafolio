---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SobreMi from "../components/SobreMi.astro";
import Metricas from "../components/Metricas.astro";
import Servicios from "../components/Servicios.astro";
import Proyectos from "../components/Proyectos.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FAQ from "../components/FAQ.astro";
import Contacto from "../components/Contacto.astro";
import site from "../data/site.json";
---

<Layout description={site.description}>
  <div data-chapter="Inicio"><Hero /></div>
  <div class="panel" data-chapter="Sobre mí"><SobreMi /></div>
  <div class="panel" data-chapter="Resultados"><Metricas /></div>
  <div class="panel" data-chapter="Servicios"><Servicios /></div>
  <div class="panel" data-chapter="Proyectos"><Proyectos /></div>
  <div class="panel" data-chapter="Escritos"><BlogPreview /></div>
  <div class="panel" data-chapter="Dudas"><FAQ /></div>
  <div class="panel" data-chapter="Contacto"><Contacto /></div>
</Layout>
