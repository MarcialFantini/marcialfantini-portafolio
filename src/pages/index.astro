---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Problemas from "../components/Problemas.astro";
import Metodo from "../components/Metodo.astro";
import SobreMi from "../components/SobreMi.astro";
import Proyectos from "../components/Proyectos.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FAQ from "../components/FAQ.astro";
import Contacto from "../components/Contacto.astro";
import site from "../data/site.json";
import { hasPublishedPosts, hasPublishedProjects } from "../lib/content";

const showProyectos = await hasPublishedProjects();
const showBlog = await hasPublishedPosts();
---

<Layout title={`${site.name} · Software a medida para PyMEs`} description={site.description}>
  <Hero />
  <div class="panel" data-chapter="Qué resolvemos"><Problemas /></div>
  <div class="panel" data-chapter="Cómo trabajamos"><Metodo /></div>
  <div class="panel panel--night" data-chapter="Nosotros"><SobreMi /></div>
  {showProyectos && <div class="panel" data-chapter="Proyectos"><Proyectos /></div>}
  {showBlog && <div class="panel" data-chapter="Escritos"><BlogPreview /></div>}
  <div class="panel" data-chapter="Dudas"><FAQ /></div>
  <div class="panel panel--night" data-chapter="Contacto"><Contacto /></div>
</Layout>
