---
import Layout from "../layouts/Layout.astro";
import Peso from "../components/film/Peso.astro";
import Giro from "../components/film/Giro.astro";
import Solucion from "../components/film/Solucion.astro";
import Alivio from "../components/film/Alivio.astro";
import Cierre from "../components/film/Cierre.astro";
import SobreMi from "../components/SobreMi.astro";
import Servicios from "../components/Servicios.astro";
import Proyectos from "../components/Proyectos.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FAQ from "../components/FAQ.astro";
import Contacto from "../components/Contacto.astro";
import site from "../data/site.json";

// Un solo film: alto total = suma de las escenas (svh). Cada escena ocupa un tramo
// contiguo [from, to] del progreso global P (0..1); motion.ts deriva su --p local.
const scenes = [
  { key: "peso", chapter: "Inicio", len: 160 },
  { key: "giro", chapter: "La oferta", len: 130 },
  { key: "solucion", chapter: "Servicios", len: 180 },
  { key: "alivio", chapter: "El alivio", len: 150 },
  { key: "cierre", chapter: "Auditoría gratis", len: 110 },
];
const total = scenes.reduce((a, s) => a + s.len, 0);
let acc = 0;
const ranges = scenes.map((s) => {
  const from = acc / total;
  acc += s.len;
  const to = acc / total;
  return { ...s, from: +from.toFixed(5), to: +to.toFixed(5) };
});
const [rPeso, rGiro, rSol, rAlivio, rCierre] = ranges;
---

<Layout description={site.description}>
  <div class="film" data-film style={`--film-len: ${total}`}>
    {
      ranges.map((r) => (
        <span
          class="film-anchor"
          id={`film-${r.key}`}
          data-chapter={r.chapter}
          data-film-anchor={r.key}
          style={`--a-top:${(r.from * 100).toFixed(3)}%;--a-h:${((r.to - r.from) * 100).toFixed(3)}%`}
          aria-hidden="true"
        />
      ))
    }
    <div class="film-stage">
      <Peso from={rPeso.from} to={rPeso.to} />
      <Giro from={rGiro.from} to={rGiro.to} />
      <Solucion from={rSol.from} to={rSol.to} />
      <Alivio from={rAlivio.from} to={rAlivio.to} />
      <Cierre from={rCierre.from} to={rCierre.to} />
    </div>
    <a
      href="/contacto?servicio=Auditor%C3%ADa%20gratis"
      class="film-cta"
      data-film-cta
      tabindex="-1"
      aria-hidden="true"
    >
      Auditoría gratis de 15 min
    </a>
  </div>
  <div class="panel" data-chapter="Sobre mí"><SobreMi /></div>
  <div class="panel panel--oro" id="servicios-precios" data-chapter="Servicios"><Servicios /></div>
  <div class="panel" data-chapter="Proyectos"><Proyectos /></div>
  <div class="panel" data-chapter="Escritos"><BlogPreview /></div>
  <div class="panel" data-chapter="Dudas"><FAQ /></div>
  <div class="panel" data-chapter="Contacto"><Contacto /></div>
</Layout>
