---
import Layout from "../layouts/Layout.astro";
import HeroWord from "../components/home/HeroWord.astro";
import Campos from "../components/home/Campos.astro";
import MediaSlot from "../components/home/MediaSlot.astro";
import Proceso from "../components/home/Proceso.astro";
import Demos from "../components/home/Demos.astro";
import Sobre from "../components/home/Sobre.astro";
import Dudas from "../components/home/Dudas.astro";
import UnCampo from "../components/home/UnCampo.astro";
import PostList from "../components/PostList.astro";
import site from "../data/site.json";
import { getPublishedPosts } from "../lib/content";

const latest = (await getPublishedPosts()).slice(0, 3);

// Video band: drop the files in /public/media and fill these two paths.
const video = { src: "", poster: "" };
---

<Layout title={`${site.name} · Software a medida para PyMEs`} description={site.description}>
  <HeroWord />
  <Campos />

  <section class="band" aria-label="Un sistema en uso">
    <MediaSlot
      kind="video"
      src={video.src || undefined}
      poster={video.poster || undefined}
      alt="Un sistema de pedidos en uso"
      label="Video: grabación de pantalla de un sistema en uso (pendiente)"
      ratio="21 / 9"
    />
  </section>

  <Proceso />
  <Demos />
  <Sobre />
  {
    latest.length > 0 && (
      <section class="escritos wrap" aria-labelledby="escritos-title">
        <h2 id="escritos-title" data-split>Escritos</h2>
        <PostList posts={latest} />
        <p><a href="/blog">Ver todos los escritos</a></p>
      </section>
    )
  }
  <Dudas />
  <UnCampo />
</Layout>

<style>
  .band { overflow: hidden; }
  .band :global(.slot) { min-height: 50svh; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Slow push-in on the footage band */
      .band :global(.slot) { animation: band-zoom linear both; animation-timeline: view(); animation-range: cover 0% cover 100%; }
      @keyframes band-zoom { from { transform: scale(1.14); } to { transform: scale(1); } }
    }
  }

  .escritos { margin-top: var(--section-gap); display: grid; gap: 3rem; }
</style>
