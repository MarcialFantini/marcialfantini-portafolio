---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const aboutPhoto = (site as { aboutPhoto?: string }).aboutPhoto ?? "";

const build = [
  {
    title: "Páginas web",
    text: "Para mostrar lo que ofrecés y que te escriban. Desde una página simple hasta un sitio institucional de varias secciones.",
  },
  {
    title: "Ecommerce",
    text: "Tiendas online con catálogo, carrito y medios de pago, con un panel para que administres tus productos.",
  },
  {
    title: "Software a medida",
    text: "Herramientas pensadas para tu forma de trabajar: paneles, reservas, gestión interna o automatización de tareas.",
  },
];

const steps = [
  {
    title: "Hablamos 15 minutos",
    text: "Te escuchamos y hacemos una auditoría gratuita de tu sitio o de tu idea. Sin compromiso.",
  },
  {
    title: "Te pasamos una propuesta",
    text: "Alcance, plazos y presupuesto por escrito antes de empezar. Sabés qué recibís y cuánto cuesta.",
  },
  {
    title: "Construimos y entregamos",
    text: "Vas viendo avances reales. Entregamos con 2 rondas de revisión para ajustar lo que haga falta.",
  },
];

const get = [
  "Un presupuesto claro, por escrito, antes de arrancar.",
  "Un sitio que se ve bien en el celular, la tablet y la computadora.",
  "Una base de posicionamiento en Google para que te encuentren.",
  "Una persona real del equipo que te responde en 24 horas hábiles.",
  "2 rondas de revisión incluidas.",
];

const dont = [
  "No te pedimos que entiendas de tecnología: nos ocupamos de lo técnico.",
  "No te cobramos nada por la auditoría de 15 minutos.",
  "No empezamos sin que sepas qué vamos a hacer y cuánto cuesta.",
  "No te prometemos resultados que dependen de cosas que no controlamos.",
];
---

<Layout
  title="Nosotros — Marcial Fantini"
  description="Somos Marcial Fantini, una agencia que desarrolla páginas web, ecommerce y software a medida. Conocé cómo trabajamos y pedí tu auditoría gratuita de 15 minutos."
>
  <section class="relative pt-28 md:pt-36 pb-16 md:pb-24 border-b border-[var(--color-border)] overflow-hidden">
    <div class="container-page reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">
        Sobre nosotros
      </p>
      <h1 class="font-impact text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-[var(--color-ink)] max-w-4xl">
        Somos {site.name}. Hacemos que tu negocio
        <span class="text-[var(--color-azul)]">se vea y venda online.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Somos una agencia de desarrollo que construye páginas web, tiendas online y software a medida
        para PyMEs, comercios y profesionales. Trabajamos con un lenguaje simple y con las reglas
        claras desde el primer día.
      </p>

      <!--
        SLOT: foto o video del equipo.
        Para activarlo, completá `aboutPhoto` en src/data/site.json con la ruta de la imagen
        (por ejemplo "/equipo.jpg", guardada en /public). Si queda vacío, no se muestra nada.
      -->
      {
        aboutPhoto && (
          <figure class="mt-10 max-w-3xl">
            <img
              src={aboutPhoto}
              alt={`El equipo de ${site.name}`}
              loading="lazy"
              class="w-full rounded-card border border-[var(--color-border)]"
            />
          </figure>
        )
      }
    </div>
  </section>

  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <div class="container-page">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">Qué hacemos</p>
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] leading-[1] text-[var(--color-ink)] max-w-3xl mb-10">
        Tres cosas, bien hechas.
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          build.map((b) => (
            <li class="rounded-card border border-[var(--color-line)] bg-[var(--color-blanco)] p-6">
              <h3 class="font-impact text-xl uppercase leading-tight text-[var(--color-ink)] mb-3">{b.title}</h3>
              <p class="text-[var(--color-ink-soft)] leading-relaxed">{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <div class="container-page">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">Cómo trabajamos</p>
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] leading-[1] text-[var(--color-ink)] max-w-3xl mb-10">
        Simple, en tres pasos.
      </h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          steps.map((s, i) => (
            <li class="rounded-card border border-[var(--color-border)] bg-[var(--color-blanco)] p-6">
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-dorado)]">
                Paso {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-impact text-xl uppercase leading-tight text-[var(--color-ink)] mt-2 mb-3">{s.title}</h3>
              <p class="text-[var(--color-ink-soft)] leading-relaxed">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <div class="container-page grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">Qué recibís</p>
        <ul class="space-y-3 text-[var(--color-ink-soft)] text-lg leading-relaxed">
          {get.map((g) => <li class="flex gap-3"><span aria-hidden="true" class="text-[var(--color-azul)]">✓</span><span>{g}</span></li>)}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-azul)] mb-4">Qué no hacemos</p>
        <ul class="space-y-3 text-[var(--color-ink-soft)] text-lg leading-relaxed">
          {dont.map((d) => <li class="flex gap-3"><span aria-hidden="true" class="text-[var(--color-mute)]">×</span><span>{d}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <h2 class="font-impact text-[clamp(1.75rem,4vw,3rem)] leading-[1] text-[var(--color-ink)] max-w-3xl mb-4">
        Empecemos por una auditoría gratis de 15 minutos.
      </h2>
      <p class="max-w-2xl text-lg text-[var(--color-ink-soft)] leading-relaxed mb-8">
        Contanos qué necesitás y te respondemos en 24 horas hábiles.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href="/contacto?servicio=Auditor%C3%ADa%20gratis"
          class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-control bg-[var(--color-dorado)] text-[var(--color-on-gold)] font-mono text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-[var(--color-deep)] hover:text-white"
        >
          Pedir auditoría gratis
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/servicios"
          class="tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-control border border-[var(--color-ink)] text-[var(--color-ink)] font-mono text-[11px] uppercase tracking-[0.18em] font-semibold hover:border-[var(--color-azul)] hover:text-[var(--color-azul)]"
        >
          Ver servicios
        </a>
      </div>
    </div>
  </section>
</Layout>
