---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const aboutPhoto = (site as { aboutPhoto?: string }).aboutPhoto ?? "";

const build = [
  {
    title: "Páginas web",
    text: "Para mostrar lo que ofrecés y que te escriban. Desde una página simple hasta un sitio institucional de varias secciones.",
  },
  {
    title: "Ecommerce",
    text: "Tiendas online con catálogo, carrito y medios de pago, con un panel para que administres tus productos.",
  },
  {
    title: "Software a medida",
    text: "Herramientas pensadas para tu forma de trabajar: paneles, reservas, gestión interna o automatización de tareas.",
  },
];

const steps = [
  {
    title: "Hablamos 15 minutos",
    text: "Te escuchamos y hacemos una auditoría gratuita de tu sitio o de tu idea. Sin compromiso.",
  },
  {
    title: "Te pasamos una propuesta",
    text: "Alcance, plazos y presupuesto por escrito antes de empezar. Sabés qué recibís y cuánto cuesta.",
  },
  {
    title: "Construimos y entregamos",
    text: "Vas viendo avances reales. Entregamos con 2 rondas de revisión para ajustar lo que haga falta.",
  },
];

const get = [
  "Un presupuesto claro, por escrito, antes de arrancar.",
  "Un sitio que se ve bien en el celular, la tablet y la computadora.",
  "Una base de posicionamiento en Google para que te encuentren.",
  "Una persona real del equipo que te responde en 24 horas hábiles.",
  "2 rondas de revisión incluidas.",
];

const dont = [
  "No te pedimos que entiendas de tecnología: nos ocupamos de lo técnico.",
  "No te cobramos nada por la auditoría de 15 minutos.",
  "No empezamos sin que sepas qué vamos a hacer y cuánto cuesta.",
  "No te prometemos resultados que dependen de cosas que no controlamos.",
];
---

<Layout
  title="Nosotros — Marcial Fantini"
  description="Somos Marcial Fantini, una agencia que desarrolla páginas web, ecommerce y software a medida. Conocé cómo trabajamos y pedí tu auditoría gratuita de 15 minutos."
>
  <section class="surface-night relative pt-20 md:pt-28 pb-16 md:pb-28 overflow-hidden">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-x-10 items-start">
        <!--
          SLOT: foto o video del equipo.
          Para activarlo, completá `aboutPhoto` en src/data/site.json con la ruta de la imagen
          (por ejemplo "/equipo.jpg", guardada en /public). Si queda vacío, se muestra el monograma.
        -->
        <div class="lg:col-span-5 lg:order-1 order-2">
          {
            aboutPhoto ? (
              <figure class="about-media">
                <img src={aboutPhoto} alt={`El equipo de ${site.name}`} loading="lazy" decoding="async" />
                <span class="about-media__frame" aria-hidden="true"></span>
              </figure>
            ) : (
              <div class="about-media" role="img" aria-label="Iniciales MF">
                <span class="about-media__frame" aria-hidden="true"></span>
                <span class="about-media__mono" aria-hidden="true">M<i>F</i></span>
                <span class="about-media__cap" aria-hidden="true">
                  <span>{site.name}</span>
                  <span>Córdoba AR</span>
                </span>
              </div>
            )
          }
        </div>

        <div class="lg:col-span-6 lg:col-start-7 lg:order-2 order-1 reveal">
          <p class="eyebrow mb-5">Sobre nosotros</p>
          <h1 class="display-lg">
            Somos {site.name}. Hacemos que tu negocio
            <span class="display-accent">se vea y venda online.</span>
          </h1>
          <p class="mt-8 max-w-[62ch] text-lg text-[var(--color-ink-soft)] leading-relaxed">
            Somos una agencia de desarrollo que construye páginas web, tiendas online y software a medida
            para PyMEs, comercios y profesionales. Trabajamos con un lenguaje simple y con las reglas
            claras desde el primer día.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-28 border-b border-[var(--color-border)]">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-x-10">
      <div class="lg:col-span-4">
        <p class="eyebrow mb-5">Qué hacemos</p>
        <h2 class="display-md">Tres cosas, <span class="display-accent">bien hechas.</span></h2>
      </div>
      <ol class="numlist lg:col-span-7 lg:col-start-6">
        {
          build.map((b, i) => (
            <li>
              <span class="numlist__n">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="numlist__t">{b.title}</h3>
              <p class="numlist__d">{b.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-28 border-b border-[var(--color-border)]">
    <div class="container-page">
      <p class="eyebrow mb-4">Cómo trabajamos</p>
      <h2 class="display-lg max-w-[14ch] mb-10 md:mb-14">Simple, en tres pasos.</h2>
      <ol class="process" style="--steps: 3">
        {
          steps.map((s, i) => (
            <li class="process__step">
              <span class="process__num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="process__t">{s.title}</h3>
              <p class="process__d">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-28 border-b border-[var(--color-border)]">
    <div class="container-page grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-x-20">
      <div>
        <p class="svc__label">Qué recibís</p>
        <ul class="hair-list text-lg">
          {get.map((g) => <li>{g}</li>)}
        </ul>
      </div>
      <div>
        <p class="svc__label">Qué no hacemos</p>
        <ul class="hair-list text-lg">
          {dont.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="surface-night py-16 md:py-28">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <h2 class="display-lg">
          Empecemos por una <span class="display-accent">auditoría gratis</span> de 15 minutos.
        </h2>
        <p class="mt-6 max-w-[56ch] text-lg text-[var(--color-ink-soft)] leading-relaxed">
          Contanos qué necesitás y te respondemos en 24 horas hábiles.
        </p>
      </div>
      <div class="lg:col-span-4 lg:justify-self-end flex flex-col sm:flex-row lg:flex-col gap-4 items-start">
        <a href="/contacto?servicio=Auditor%C3%ADa%20gratis" class="btn-sunset">
          Pedir auditoría gratis <span aria-hidden="true">→</span>
        </a>
        <a href="/servicios" class="svc__more">Ver servicios <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>
