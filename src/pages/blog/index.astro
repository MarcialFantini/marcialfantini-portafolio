---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts } from "../../lib/content";

const posts = await getPublishedPosts();
const empty = posts.length === 0;

const tagCounts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const topTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 12);
---

<Layout
  title="Blog — Marcial Fantini"
  description="Ensayos sobre freelance, producto, código y decisiones que aprendí trabajando con PyMEs."
  noindex={empty}
>
  <section class="bi wrap">
    <h1 class="bi__h1" data-split>{empty ? "Próximamente." : "Escritos"}</h1>
    <p class="bi__lead" data-rise style="--i:1">
      {empty
        ? "Estamos preparando artículos. Mientras tanto, contanos qué necesitás y te respondemos en 24 horas hábiles."
        : "Lo que aprendo construyendo software para PyMEs: decisiones, errores y herramientas."}
    </p>

    {
      empty ? (
        <a href="/contacto" class="btn bi__cta" data-rise style="--i:2">Contanos el problema</a>
      ) : (
        <>
          <div class="bi__list"><PostList posts={posts} /></div>
          {topTags.length > 0 && (
            <p class="bi__tags" data-rise>
              Temas:{" "}
              {topTags.map(([t, n], i) => (
                <>
                  <a href={`/blog/tags/${t}`}>{t}</a> <span class="soft">({n})</span>
                  {i < topTags.length - 1 ? ", " : "."}
                </>
              ))}{" "}
              <a href="/blog/tags">Ver todos</a>
            </p>
          )}
        </>
      )
    }
  </section>
</Layout>

<style>
  .bi { padding-top: clamp(3rem, 8vw, 6rem); }
  .bi__h1 { font-size: clamp(3.5rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; }
  .bi__lead { margin-top: 2rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .bi__cta { margin-top: 2rem; }
  .bi__list { margin-top: clamp(4rem, 8vw, 7rem); }
  .bi__tags { margin-top: 5rem; max-width: 70ch; }
</style>
