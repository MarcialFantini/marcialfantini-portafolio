---
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import PostList from "../../components/PostList.astro";
import { render } from "astro:content";
import { getPublishedPosts } from "../../lib/content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, readingTime, tags } = post.data;

const sortedAll = await getPublishedPosts();
const related = sortedAll
  .filter((p) => p.id !== post.id && (p.data.category === post.data.category || p.data.tags.some((t) => tags.includes(t))))
  .slice(0, 3);

const body = post.body ?? "";
const minutes = readingTime ?? Math.max(1, Math.round(body.trim().split(/\s+/).length / 220));

// Table of contents from h2/h3 in the markdown source
const slugify = (t: string) =>
  t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-");
const toc = Array.from(body.matchAll(/^(#{2,3})\s+(.+)$/gm)).map((m) => ({ level: m[1].length, text: m[2].trim(), id: slugify(m[2].trim()) }));

const canonicalURL = new URL(`/blog/${post.id}`, Astro.site ?? "https://www.marcialfantini.site").toString();
---

<Layout title={title} description={description} pageType="article">
  <article class="bp wrap">
    <header class="bp__head">
      <h1 class="bp__h1" data-split>{title}</h1>
      <p class="bp__lead" data-rise style="--i:1">{description}</p>
      <p class="bp__meta soft" data-rise style="--i:2"><FormattedDate date={pubDate} /> · {minutes} min de lectura</p>
    </header>

    <div class="bp__grid">
      <div class="prose-mf" data-post-body><Content /></div>

      <aside class="bp__aside">
        {toc.length >= 2 && (
          <nav aria-label="En este post">
            <p class="soft">En este post</p>
            <ul>{toc.map((h) => <li class:list={[h.level === 3 && "is-sub"]}><a href={`#${h.id}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
        <div class="bp__share">
          <button type="button" data-share="copy" data-share-url={canonicalURL}><span data-share-label>Copiar link</span></button>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
        {tags.length > 0 && (
          <p class="bp__tags">Temas: {tags.map((t, i) => <><a href={`/blog/tags/${t}`}>{t}</a>{i < tags.length - 1 ? ", " : "."}</>)}</p>
        )}
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bp-rel wrap" aria-labelledby="bp-rel-title">
      <h2 id="bp-rel-title" class="bp-rel__h" data-split>Seguí leyendo</h2>
      <PostList posts={related} />
    </section>
  )}

  <section class="bp-end wrap" aria-label="Contacto">
    <p class="bp-end__p" data-rise>¿Tenés un problema operativo que querés resolver con software?</p>
    <a href="/contacto" class="btn" data-rise style="--i:1">Contanos el problema</a>
  </section>
</Layout>

<script>
  function setupPost() {
    // Anchor ids for the table of contents
    const article = document.querySelector("[data-post-body]");
    if (article instanceof HTMLElement) {
      const seen = new Set<string>();
      let i = 0;
      article.querySelectorAll("h2, h3").forEach((el) => {
        if (el.id) return;
        let id = (el.textContent ?? "").trim().toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-");
        if (!id) id = `h-${i++}`;
        let unique = id;
        let n = 2;
        while (seen.has(unique)) unique = `${id}-${n++}`;
        seen.add(unique);
        el.id = unique;
      });
    }
    document.querySelectorAll<HTMLElement>("[data-share]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const label = btn.querySelector("[data-share-label]");
        const url = btn.getAttribute("data-share-url") ?? window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = "Copiado";
        } catch {
          if (label) label.textContent = "No se pudo copiar";
        }
        setTimeout(() => { if (label) label.textContent = "Copiar link"; }, 2200);
      });
    });
  }
  document.addEventListener("astro:page-load", setupPost);
</script>

<style>
  .bp__head { padding-top: clamp(3rem, 8vw, 6rem); }
  .bp__h1 { font-size: clamp(2rem, 3.4vw, 3.25rem); line-height: 1; letter-spacing: -0.02em; max-width: 30em; }
  .bp__lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 44ch; }
  .bp__meta { margin-top: 1.25rem; font-size: var(--step-small); }

  .bp__grid { display: grid; gap: 3rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .bp__aside { display: grid; gap: 2rem; align-content: start; font-size: var(--step-small); }
  .bp__aside ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .bp__aside li.is-sub { padding-left: 1rem; }
  .bp__aside a { text-decoration: none; }
  .bp__aside a:hover { color: var(--color-accent); }
  .bp__share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .bp__share button {
    min-height: 2.75rem;
    padding: 0 1rem;
    background: var(--color-surface-2);
    color: var(--color-fg);
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-quart);
  }
  .bp__share button:hover { background: var(--color-surface); }
  .bp__tags a { text-decoration: underline; }

  .bp-rel { margin-top: var(--section-gap); display: grid; gap: 3rem; }
  .bp-end { margin-top: var(--section-gap); display: grid; gap: 1.5rem; justify-items: start; }
  .bp-end__p { font-size: var(--step-lead); line-height: 1.3; max-width: 34ch; }

  @media (min-width: 1024px) {
    .bp__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .prose-mf { grid-column: 1 / span 7; }
    .bp__aside { grid-column: 9 / span 4; position: sticky; top: 2rem; }
  }
</style>
