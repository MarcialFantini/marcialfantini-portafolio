---
import Layout from "../../../layouts/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { getPublishedPosts } from "../../../lib/content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, taggedPosts]) => ({
    params: { tag },
    props: { tag, posts: taggedPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<Layout title={`${tag} — Blog`} description={`Posts sobre ${tag}. ${posts.length} artículos.`}>
  <section class="tt wrap">
    <h1 class="tt__h1" data-split>{tag}</h1>
    <p class="tt__lead" data-rise style="--i:1">
      {posts.length} {posts.length === 1 ? "artículo" : "artículos"} sobre este tema. <a href="/blog/tags">Ver todos los temas</a>
    </p>
    <div class="tt__list"><PostList posts={posts} /></div>
  </section>
</Layout>

<style>
  .tt { padding-top: clamp(3rem, 8vw, 6rem); }
  .tt__h1 { font-size: clamp(3rem, 8vw, 8rem); line-height: 0.9; letter-spacing: -0.03em; }
  .tt__lead { margin-top: 1.5rem; font-size: var(--step-lead); }
  .tt__list { margin-top: clamp(3rem, 6vw, 5rem); }
</style>
