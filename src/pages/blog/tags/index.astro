---
import Layout from "../../../layouts/Layout.astro";
import { getPublishedPosts } from "../../../lib/content";

const posts = await getPublishedPosts();
const tagCounts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<Layout title="Temas — Blog" description={`${tags.length} temas en el blog. Filtrá por tema.`} noindex={tags.length === 0}>
  <section class="ti wrap">
    <h1 class="ti__h1" data-split>Temas</h1>
    <p class="ti__list" data-rise style="--i:1">
      {
        tags.length === 0
          ? "Todavía no hay temas publicados."
          : tags.map(([t, n], i) => (
              <>
                <a href={`/blog/tags/${t}`}>{t}</a> ({n})
                {i < tags.length - 1 ? ", " : "."}
              </>
            ))
      }
    </p>
    <p class="ti__back"><a href="/blog">Volver al blog</a></p>
  </section>
</Layout>

<style>
  .ti { padding-top: clamp(3rem, 8vw, 6rem); }
  .ti__h1 { font-size: clamp(3.5rem, 9vw, 9.375rem); line-height: 0.9; letter-spacing: -0.03em; }
  .ti__list { margin-top: 3rem; font-size: var(--step-lead); line-height: 1.5; max-width: 52ch; }
  .ti__list a { text-decoration: none; }
  .ti__list a:hover { color: var(--color-accent); }
  .ti__back { margin-top: 3rem; }
  .ti__back a { display: inline-block; padding-block: 0.5rem; }
</style>
